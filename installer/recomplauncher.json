{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Project Vekta",
  "repo": "gustavomorinaga/project-vekta",
  "inputs": [
    {
      "id": "game",
      "label": "Your Killzone HD, one of: the folder your PS3 or RPCS3 installed it in (with PARAM.SFO and USRDIR), from the USA edition (NPUA80856) or the European one (NPEA00418), version 01.00; or, with no RPCS3, a disc copied to this PC: your Killzone Trilogy disc (its folder, with PS3_GAME and PS3_EXTRA, or the Killzone HD package DATA000.PKG) or your European Killzone HD disc (BCES-01743, its folder with PS3_GAME). From the Trilogy disc or its package, the official RPCS3 is downloaded from RPCS3's own GitHub releases to install the game into the install folder, and from the European disc only to decrypt its EBOOT; on Windows 10, install 7-Zip first. A European PlayStation Store package needs its licence, so install it in your RPCS3 first and give the installed folder.",
      "role": "game",
      "formats": [{ "type": "folder" }, { "type": "file", "extensions": ["pkg"] }],
      "dumps": [{ "name": "USA (PlayStation Store, NPUA80856)", "size": 3182645568, "crc32": "9de18d66" }]
    },
    {
      "id": "eboot",
      "label": "Optional: your decrypted EBOOT.elf (19,706,080 bytes; SHA-256 c81aa91e35a76ff7d856095c392cee98bcc4b01879d7f13e5a389c6ee2d903fc for the USA edition, e4fc4f13b1bd940f52c5df16f4cc4bf0af88e17f4c1d2276b877a62490c57f52 for the European one). Leave it out when your RPCS3 has the game: it makes this copy itself.",
      "role": "update",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["elf"] }],
      "dumps": [
        { "name": "USA (NPUA80856 01.00, decrypted)", "size": 19706080, "crc32": "e3ce792f" },
        { "name": "Europe (NPEA00418 or BCES-01743 01.00, decrypted)", "size": 19706080, "crc32": "801f0cc3" }
      ]
    }
  ],
  "prepare": {
    "program": ["scripts/prepare.cmd", "scripts/prepare.sh"],
    "args": ["--game={input:game}", "--eboot={input:eboot}"],
    "label": "Checking your files and building the port on this PC (5 to 30 minutes; nothing of the game is downloaded, only the official RPCS3 when you give the disc or the package)",
    "timeout": 7200,
    "version": "stamped by tools/release/recomplauncher.py: the release's VERSION",
    "done": ["{install}/work/build-stamp.json"],
    "options": [
      {
        "id": "dlss",
        "label": "NVIDIA DLSS",
        "note": "Downloads NVIDIA's DLSS SDK from NVIDIA during the build. Without it the port builds with AMD FSR 3.1.",
        "gpu": "nvidia",
        "os": ["windows"],
        "args": ["--dlss=accept"],
        "license": { "name": "NVIDIA DLSS SDK licence", "url": "https://github.com/NVIDIA/DLSS/blob/v310.9.16/LICENSE.txt" }
      }
    ]
  },
  "start": {
    "program": ["Project Vekta.exe", "project-vekta"]
  },
  "saves": ["{install}/work/vfs/gamedata", "{install}/work/vfs/kz1hd_pc.ini", "{install}/work/vfs/kz1hd_keys.ini"],
  "config": [
    { "id": "main", "format": "ini", "file": [{ "path": "{install}/work/vfs/kz1hd_pc.ini" }] }
  ],
  "settings": [
    {"id": "display", "label": "Display Mode", "group": "Display", "defaults": {"display": "window"},
      "choices": [
        {"label": "Window", "set": {"display": "window"}},
        {"label": "Borderless", "set": {"display": "borderless"}},
        {"label": "Fullscreen", "set": {"display": "fullscreen"}}
      ] },
    {"id": "resolution", "label": "Resolution", "help": "The window's size, or the fullscreen mode. Borderless always takes the desktop's.", "group": "Display", "defaults": {"resolution": "1280x720"},
      "choices": [
        {"label": "1280x720", "set": {"resolution": "1280x720"}},
        {"label": "1600x900", "set": {"resolution": "1600x900"}},
        {"label": "1920x1080", "set": {"resolution": "1920x1080"}},
        {"label": "2560x1080", "set": {"resolution": "2560x1080"}},
        {"label": "2560x1440", "set": {"resolution": "2560x1440"}},
        {"label": "3440x1440", "set": {"resolution": "3440x1440"}},
        {"label": "3840x2160", "set": {"resolution": "3840x2160"}}
      ] },
    {"id": "vsync", "label": "V-Sync", "group": "Display", "defaults": {"vsync": "on"},
      "choices": [
        {"label": "On", "set": {"vsync": "on"}},
        {"label": "Off", "set": {"vsync": "off"}},
        {"label": "Adaptive", "set": {"vsync": "adaptive"}},
        {"label": "FIFO (VRR)", "set": {"vsync": "fifo"}}
      ] },
    {"id": "fps_limit", "label": "Frame Rate Limit", "help": "30 is the PS3's. 60 is the default.", "group": "Display", "defaults": {"fps_limit": "60"},
      "choices": [
        {"label": "30", "set": {"fps_limit": "30"}},
        {"label": "60", "set": {"fps_limit": "60"}},
        {"label": "120", "set": {"fps_limit": "120"}},
        {"label": "144", "set": {"fps_limit": "144"}},
        {"label": "165", "set": {"fps_limit": "165"}},
        {"label": "240", "set": {"fps_limit": "240"}},
        {"label": "Unlimited", "set": {"fps_limit": "0"}}
      ] },
    {"id": "reflex", "label": "NVIDIA Reflex", "help": "Lower input lag on NVIDIA cards; does nothing on others.", "group": "Display", "defaults": {"reflex": "off"},
      "choices": [
        {"label": "Off", "set": {"reflex": "off"}},
        {"label": "On", "set": {"reflex": "on"}},
        {"label": "On + Boost", "set": {"reflex": "boost"}}
      ] },
    {"id": "widescreen", "label": "Widescreen", "help": "Off: the PS3's 16:9 picture with bars.", "group": "Picture", "defaults": {"widescreen": "on"},
      "choices": [
        {"label": "On", "set": {"widescreen": "on"}},
        {"label": "Off", "set": {"widescreen": "off"}}
      ] },
    {"id": "aspect", "label": "Aspect Ratio", "group": "Picture", "when": {"widescreen": "on"}, "defaults": {"aspect": "auto"},
      "choices": [
        {"label": "Auto (Window)", "set": {"aspect": "auto"}},
        {"label": "4:3", "set": {"aspect": "4:3"}},
        {"label": "16:10", "set": {"aspect": "16:10"}},
        {"label": "16:9", "set": {"aspect": "16:9"}},
        {"label": "21:9", "set": {"aspect": "21:9"}},
        {"label": "32:9", "set": {"aspect": "32:9"}}
      ] },
    {"id": "field_of_view", "label": "Field of View", "group": "Picture", "defaults": {"field_of_view": "87"},
      "choices": [
        {"label": "87 (Original)", "set": {"field_of_view": "87"}},
        {"label": "70", "set": {"field_of_view": "70"}},
        {"label": "75", "set": {"field_of_view": "75"}},
        {"label": "80", "set": {"field_of_view": "80"}},
        {"label": "85", "set": {"field_of_view": "85"}},
        {"label": "90", "set": {"field_of_view": "90"}},
        {"label": "95", "set": {"field_of_view": "95"}},
        {"label": "100", "set": {"field_of_view": "100"}},
        {"label": "105", "set": {"field_of_view": "105"}},
        {"label": "110", "set": {"field_of_view": "110"}},
        {"label": "115", "set": {"field_of_view": "115"}},
        {"label": "120", "set": {"field_of_view": "120"}}
      ] },
    {"id": "weapon_fov", "label": "Weapon Field of View", "group": "Picture", "defaults": {"weapon_fov": "87"},
      "choices": [
        {"label": "87 (Original)", "set": {"weapon_fov": "87"}},
        {"label": "70", "set": {"weapon_fov": "70"}},
        {"label": "75", "set": {"weapon_fov": "75"}},
        {"label": "80", "set": {"weapon_fov": "80"}},
        {"label": "85", "set": {"weapon_fov": "85"}},
        {"label": "90", "set": {"weapon_fov": "90"}},
        {"label": "95", "set": {"weapon_fov": "95"}},
        {"label": "100", "set": {"weapon_fov": "100"}},
        {"label": "105", "set": {"weapon_fov": "105"}},
        {"label": "110", "set": {"weapon_fov": "110"}},
        {"label": "115", "set": {"weapon_fov": "115"}},
        {"label": "120", "set": {"weapon_fov": "120"}}
      ] },
    {"id": "hud_position", "label": "HUD Position", "help": "0 keeps the HUD in the 16:9 middle, 1 puts it at the screen's edges.", "group": "Picture", "when": {"widescreen": "on"},
      "slider": {"key": "hud_position", "min": 0, "max": 1, "step": 0.1, "format": "%.4g"}, "defaults": {"hud_position": "1"} },
    {"id": "hud_size", "label": "HUD Size", "help": "1 is the game's.", "group": "Picture",
      "slider": {"key": "hud_size", "min": 0.5, "max": 1.5, "step": 0.1, "format": "%.4g"}, "defaults": {"hud_size": "1"} },
    {"id": "crosshair_size", "label": "Crosshair Size", "help": "1 is the game's.", "group": "Picture",
      "slider": {"key": "crosshair_size", "min": 0.5, "max": 1.5, "step": 0.1, "format": "%.4g"}, "defaults": {"crosshair_size": "1"} },
    {"id": "antialiasing", "label": "Anti-aliasing", "help": "A temporal upscaler does its own anti-aliasing instead.", "group": "Picture", "when": {"temporal": "off"}, "defaults": {"antialiasing": "mlaa"},
      "choices": [
        {"label": "Original (MLAA)", "set": {"antialiasing": "mlaa"}},
        {"label": "Off", "set": {"antialiasing": "off"}}
      ] },
    {"id": "motion_blur", "label": "Motion Blur", "group": "Picture", "defaults": {"motion_blur": "100"},
      "choices": [
        {"label": "0%", "set": {"motion_blur": "0"}},
        {"label": "10%", "set": {"motion_blur": "10"}},
        {"label": "20%", "set": {"motion_blur": "20"}},
