        {"label": "AMD FSR 1", "set": {"upscaler": "fsr"}}
      ] },
    {"id": "sharpness", "label": "FSR Sharpness", "help": "0 is the sharpest.", "group": "Upscaling", "when": {"upscaler": "fsr"},
