    {"id": "temporal", "label": "Temporal Upscaler", "help": "DLSS needs an NVIDIA RTX card and a build with DLSS. FSR 3.1 works on any card.", "group": "Upscaling", "defaults": {"temporal": "off"},
      "choices": [
        {"label": "Off", "set": {"temporal": "off"}},
        {"label": "FSR 3.1 Quality", "set": {"temporal": "fsr3-quality"}},
        {"label": "FSR 3.1 Balanced", "set": {"temporal": "fsr3-balanced"}},
        {"label": "FSR 3.1 Performance", "set": {"temporal": "fsr3-performance"}},
        {"label": "FSR 3.1 Native AA", "set": {"temporal": "fsr3-native"}},
        {"label": "DLSS Quality", "set": {"temporal": "dlss-quality"}},
        {"label": "DLSS Balanced", "set": {"temporal": "dlss-balanced"}},
        {"label": "DLSS Performance", "set": {"temporal": "dlss-performance"}},
        {"label": "DLAA", "set": {"temporal": "dlss-native"}}
      ] },
    {"id": "mouse_yaw", "label": "Mouse Left/Right Sensitivity", "group": "Controls",
      "slider": {"key": "mouse_yaw", "min": 0, "max": 1, "step": 0.05, "format": "%.4f"}, "defaults": {"mouse_yaw": "0.5000"} },
    {"id": "mouse_pitch", "label": "Mouse Up/Down Sensitivity", "group": "Controls",
      "slider": {"key": "mouse_pitch", "min": 0, "max": 1, "step": 0.05, "format": "%.4f"}, "defaults": {"mouse_pitch": "0.5000"} },
    {"id": "mouse_invert", "label": "Mouse Invert Look", "group": "Controls", "defaults": {"mouse_invert": "0"},
