        {"label": "100% (Original)", "set": {"motion_blur": "100"}}
      ] },
    {"id": "film_grain", "label": "Film Grain", "group": "Picture", "defaults": {"film_grain": "100"},
      "choices": [
        {"label": "0%", "set": {"film_grain": "0"}},
        {"label": "10%", "set": {"film_grain": "10"}},
        {"label": "20%", "set": {"film_grain": "20"}},
        {"label": "30%", "set": {"film_grain": "30"}},
        {"label": "40%", "set": {"film_grain": "40"}},
        {"label": "50%", "set": {"film_grain": "50"}},
        {"label": "60%", "set": {"film_grain": "60"}},
        {"label": "70%", "set": {"film_grain": "70"}},
        {"label": "80%", "set": {"film_grain": "80"}},
        {"label": "90%", "set": {"film_grain": "90"}},
        {"label": "100% (Original)", "set": {"film_grain": "100"}}
      ] },
    {"id": "glow", "label": "Glow", "group": "Picture", "defaults": {"glow": "100"},
      "choices": [
        {"label": "0%", "set": {"glow": "0"}},
        {"label": "10%", "set": {"glow": "10"}},
        {"label": "20%", "set": {"glow": "20"}},
        {"label": "30%", "set": {"glow": "30"}},
