        {"label": "8x", "set": {"anisotropic": "8"}},
        {"label": "16x", "set": {"anisotropic": "16"}}
      ] },
    {"id": "scale", "label": "Internal Resolution", "help": "What the game draws at, as a share of the window.", "group": "Upscaling", "defaults": {"scale": "100"},
      "choices": [
        {"label": "50%", "set": {"scale": "50"}},
