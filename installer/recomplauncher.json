        {"label": "100%", "set": {"scale": "100"}},
        {"label": "150%", "set": {"scale": "150"}},
        {"label": "200%", "set": {"scale": "200"}}
      ] },
    {"id": "upscaler", "label": "Upscaling", "group": "Upscaling", "defaults": {"upscaler": "linear"},
