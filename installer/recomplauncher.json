        {"label": "100% (Original)", "set": {"glow": "100"}}
      ] },
    {"id": "anisotropic", "label": "Anisotropic Filtering", "group": "Picture", "defaults": {"anisotropic": "game"},
      "choices": [
        {"label": "Original", "set": {"anisotropic": "game"}},
        {"label": "Off", "set": {"anisotropic": "off"}},
        {"label": "2x", "set": {"anisotropic": "2"}},
