-    TEST("the line stays marked after the notify (reservations recur)");
-    CHECK(spu_coh_is_reserved(LINE_A) != 0);
+    /* The store ended the line's only reservation, so its mark is dropped
+     * (the notifier's walk stays short); SPU_COH_KEEP_MARKS=1 keeps every mark. */
