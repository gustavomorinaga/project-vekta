diff --git a/libs/video/rsx_vk_fsr3.cpp b/libs/video/rsx_vk_fsr3.cpp
new file mode 100644
index 00000000..672373be
--- /dev/null
+++ b/libs/video/rsx_vk_fsr3.cpp
@@ -0,0 +1,200 @@
+/* AMD FSR 3.1 through the FidelityFX SDK. See rsx_vk_fsr3.h. */
+#include "rsx_vk_fsr3.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef PS3RECOMP_FSR3
+
+extern "C" {
+int rsx_fsr3_init(VkInstance, VkPhysicalDevice, VkDevice, PFN_vkGetInstanceProcAddr, PFN_vkGetDeviceProcAddr) { return -1; }
+int rsx_fsr3_render_size(int, uint32_t, uint32_t, uint32_t*, uint32_t*) { return -1; }
+int rsx_fsr3_evaluate(VkCommandBuffer, const rsx_dlss_frame*) { return -1; }
+void rsx_fsr3_shutdown(void) {}
+}
+
+#else
+
+#include <bit>   /* the SDK's headers use std::popcount without it */
+#include <FidelityFX/host/ffx_fsr3upscaler.h>
+#include <FidelityFX/host/backends/vk/ffx_vk.h>
+
+#define FSR3_LOG(...) fprintf(stderr, "[RSX vulkan] FSR 3: " __VA_ARGS__)
+
+namespace {
+
+struct {
+    VkInstance instance = VK_NULL_HANDLE;
+    PFN_vkGetInstanceProcAddr gipa = nullptr;
+    PFN_vkGetDeviceProcAddr gdpa = nullptr;
+    VkDevice device = VK_NULL_HANDLE;
+    VkPhysicalDevice phys = VK_NULL_HANDLE;
+    void* scratch = nullptr;
+    FfxInterface iface = {};
+    /* the SDK casts these to structures of its own with 16-byte members */
+    alignas(64) FfxFsr3UpscalerContext ctx;
+    bool have_ctx = false, ok = false;
+    uint32_t ow = 0, oh = 0;
+} s;
+
+PFN_vkVoidFunction inst_fn(const char* name) { return s.gipa ? s.gipa(s.instance, name) : nullptr; }
+
+FfxResource resource(const rsx_dlss_image& im, VkImageUsageFlags usage, bool depth, bool uav)
+{
+    VkImageCreateInfo ci = {};
+    ci.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    ci.imageType = VK_IMAGE_TYPE_2D;
+    ci.format = im.format;
+    ci.extent = { im.w, im.h, 1 };
+    ci.mipLevels = 1; ci.arrayLayers = 1;
+    ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    ci.usage = usage | (depth ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT : 0);
+    FfxResourceDescription d = ffxGetImageResourceDescriptionVK(im.image, ci, uav ? FFX_RESOURCE_USAGE_UAV : FFX_RESOURCE_USAGE_READ_ONLY);
+    /* our images live in GENERAL, which is what FFX calls an unordered-access state */
+    return ffxGetResourceVK((void*)im.image, d, nullptr, FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+}
+
+/* The device functions the SDK's VK backend asks for. It calls some without
+ * checking that the device has them: debug names and labels, AMD's buffer
+ * markers (stand-ins that do nothing), and *2KHR functions that Vulkan 1.1
+ * made core (the core ones). */
+VKAPI_ATTR VkResult VKAPI_CALL no_object_name(VkDevice, const VkDebugUtilsObjectNameInfoEXT*) { return VK_SUCCESS; }
+VKAPI_ATTR void VKAPI_CALL no_label(VkCommandBuffer, const VkDebugUtilsLabelEXT*) {}
+VKAPI_ATTR void VKAPI_CALL no_label_end(VkCommandBuffer) {}
+VKAPI_ATTR void VKAPI_CALL no_marker(VkCommandBuffer, VkPipelineStageFlagBits, VkBuffer, VkDeviceSize, uint32_t) {}
+VKAPI_ATTR void VKAPI_CALL no_marker2(VkCommandBuffer, VkPipelineStageFlags2, VkBuffer, VkDeviceSize, uint32_t) {}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL device_fn(VkDevice d, const char* name)
+{
+    PFN_vkVoidFunction f = s.gdpa(d, name);
+    if (f) return f;
+    const size_t n = strlen(name);
+    if (n > 3 && !strcmp(name + n - 3, "KHR")) {
+        char core[128];
+        if (n - 3 < sizeof core) { memcpy(core, name, n - 3); core[n - 3] = 0; if ((f = s.gdpa(d, core))) return f; }
+    }
+    if (!strcmp(name, "vkSetDebugUtilsObjectNameEXT")) return (PFN_vkVoidFunction)no_object_name;
+    if (!strcmp(name, "vkCmdBeginDebugUtilsLabelEXT")) return (PFN_vkVoidFunction)no_label;
+    if (!strcmp(name, "vkCmdEndDebugUtilsLabelEXT")) return (PFN_vkVoidFunction)no_label_end;
+    if (!strcmp(name, "vkCmdWriteBufferMarkerAMD")) return (PFN_vkVoidFunction)no_marker;
+    if (!strcmp(name, "vkCmdWriteBufferMarker2AMD")) return (PFN_vkVoidFunction)no_marker2;
+    static int warned;
+    if (warned++ < 8) FSR3_LOG("the device has no %s\n", name);
+    return nullptr;
+}
+
+}  // namespace
+
+/* The SDK's VK backend calls these instance-level functions directly; the
+ * runtime loads Vulkan itself, so they go through its loader. */
+extern "C" {
+#define FSR3_FWD(ret, name, params, args) \
+    ret VKAPI_CALL name params { static PFN_##name f; if (!f) f = (PFN_##name)inst_fn(#name); return f args; }
+FSR3_FWD(void, vkGetPhysicalDeviceProperties, (VkPhysicalDevice p, VkPhysicalDeviceProperties* o), (p, o))
+FSR3_FWD(void, vkGetPhysicalDeviceProperties2, (VkPhysicalDevice p, VkPhysicalDeviceProperties2* o), (p, o))
+FSR3_FWD(void, vkGetPhysicalDeviceFeatures, (VkPhysicalDevice p, VkPhysicalDeviceFeatures* o), (p, o))
+FSR3_FWD(void, vkGetPhysicalDeviceFeatures2, (VkPhysicalDevice p, VkPhysicalDeviceFeatures2* o), (p, o))
+FSR3_FWD(void, vkGetPhysicalDeviceMemoryProperties, (VkPhysicalDevice p, VkPhysicalDeviceMemoryProperties* o), (p, o))
+FSR3_FWD(VkResult, vkEnumerateDeviceExtensionProperties, (VkPhysicalDevice p, const char* l, uint32_t* n, VkExtensionProperties* o), (p, l, n, o))
+#undef FSR3_FWD
+PFN_vkVoidFunction VKAPI_CALL vkGetDeviceProcAddr(VkDevice d, const char* name) { return device_fn(d, name); }
+VkResult VKAPI_CALL vkCreateBuffer(VkDevice d, const VkBufferCreateInfo* ci, const VkAllocationCallbacks* a, VkBuffer* b)
+{
+    static PFN_vkCreateBuffer f;
+    if (!f) f = (PFN_vkCreateBuffer)s.gdpa(d, "vkCreateBuffer");
+    return f(d, ci, a, b);
+}
+/* frame generation is not used: its swapchain is not built in */
+FfxErrorCode ffxSetFrameGenerationConfigToSwapchainVK(FfxFrameGenerationConfig const*) { return FFX_ERROR_INVALID_ARGUMENT; }
+
+int rsx_fsr3_init(VkInstance instance, VkPhysicalDevice phys, VkDevice device,
+                  PFN_vkGetInstanceProcAddr gipa, PFN_vkGetDeviceProcAddr gdpa)
+{
+    s.instance = instance; s.phys = phys; s.device = device; s.gipa = gipa; s.gdpa = gdpa;
+    const size_t size = ffxGetScratchMemorySizeVK(phys, 1);
+    s.scratch = aligned_alloc(64, (size + 63) & ~(size_t)63);
+    if (s.scratch) memset(s.scratch, 0, size);
+    VkDeviceContext dc = { device, phys, device_fn };
+    if (!s.scratch || ffxGetInterfaceVK(&s.iface, ffxGetDeviceVK(&dc), s.scratch, size, 1) != FFX_OK) {
+        FSR3_LOG("no FidelityFX VK interface\n");
+        free(s.scratch); s.scratch = nullptr;
+        return -1;
+    }
+    s.ok = true;
+    FSR3_LOG("available\n");
+    return 0;
+}
+
+int rsx_fsr3_render_size(int mode, uint32_t out_w, uint32_t out_h, uint32_t* w, uint32_t* h)
+{
+    if (!s.ok) return -1;
+    if (mode == RSX_FSR3_NATIVE_AA) { *w = out_w; *h = out_h; return 0; }
+    return ffxFsr3UpscalerGetRenderResolutionFromQualityMode(w, h, out_w, out_h, (FfxFsr3UpscalerQualityMode)mode) == FFX_OK ? 0 : -1;
+}
+
+static void fsr3_message(FfxMsgType type, const wchar_t* msg)
+{
+    static int n;
+    if (n++ < 16) FSR3_LOG("%s: %ls\n", type == FFX_MESSAGE_TYPE_ERROR ? "error" : "warning", msg);
+}
+
+int rsx_fsr3_evaluate(VkCommandBuffer cmd, const rsx_dlss_frame* f)
+{
+    if (!s.ok) return -1;
+    if (!s.have_ctx || s.ow != f->output.w || s.oh != f->output.h) {
+        if (s.have_ctx) { ffxFsr3UpscalerContextDestroy(&s.ctx); s.have_ctx = false; }
+        FfxFsr3UpscalerContextDescription d = {};
+        d.flags = 0;   /* LDR colour, render-size motion vectors without jitter, depth 0 near to 1 far */
+        if (getenv("PS3RECOMP_FSR3_DEBUG")) d.flags |= FFX_FSR3UPSCALER_ENABLE_DEBUG_CHECKING;
+        d.maxRenderSize = { f->output.w, f->output.h };
+        d.maxUpscaleSize = { f->output.w, f->output.h };
+        d.fpMessage = fsr3_message;
+        d.backendInterface = s.iface;
+        const FfxErrorCode r = ffxFsr3UpscalerContextCreate(&s.ctx, &d);
+        if (r != FFX_OK) { FSR3_LOG("context for %ux%u failed (%d)\n", f->output.w, f->output.h, (int)r); s.ok = false; return -1; }
+        s.have_ctx = true; s.ow = f->output.w; s.oh = f->output.h;
+        FSR3_LOG("context for %ux%u\n", s.ow, s.oh);
+    }
+    FfxFsr3UpscalerDispatchDescription e = {};
+    e.commandList = ffxGetCommandListVK(cmd);
+    e.color = resource(f->color, VK_IMAGE_USAGE_SAMPLED_BIT, false, false);
+    e.depth = resource(f->depth, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, false);
+    e.motionVectors = resource(f->motion, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, false);
+    e.output = resource(f->output, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, true);
+    /* FSR 3.1's dilated depth and motion and previous nearest depth live with
+     * the caller (frame generation would share them) */
+    e.dilatedDepth = resource(f->shared[0], VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, true);
+    e.dilatedMotionVectors = resource(f->shared[1], VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, true);
+    e.reconstructedPrevNearestDepth = resource(f->shared[2], VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, false, true);
+    /* the same convention as DLSS: the projection moved by (2 x / w, -2 y / h) */
+    e.jitterOffset = { f->jitter_x, f->jitter_y };
+    e.motionVectorScale = { f->mv_scale_x, f->mv_scale_y };
+    e.renderSize = { f->color.w, f->color.h };
+    e.upscaleSize = { f->output.w, f->output.h };
+    e.enableSharpening = f->sharpness > 0.0f;
+    e.sharpness = f->sharpness;
+    e.frameTimeDelta = f->frame_ms > 0.0f ? f->frame_ms : 16.7f;
+    e.preExposure = 1.0f;
+    e.reset = f->reset != 0;
+    e.cameraNear = f->near_z > 0.0f ? f->near_z : 1.0f;
+    e.cameraFar = f->far_z > e.cameraNear ? f->far_z : 2000.0f;
+    e.cameraFovAngleVertical = f->fov_y > 0.0f ? f->fov_y : 1.0f;
+    e.viewSpaceToMetersFactor = 1.0f;
+    const FfxErrorCode r = ffxFsr3UpscalerContextDispatch(&s.ctx, &e);
+    if (r != FFX_OK) {
+        static int n;
+        if (n++ < 4) FSR3_LOG("dispatch failed (%d)\n", (int)r);
+        return -1;
+    }
+    return 0;
+}
+
+void rsx_fsr3_shutdown(void)
+{
+    if (s.have_ctx) ffxFsr3UpscalerContextDestroy(&s.ctx);
+    free(s.scratch);
+    s = {};
+}
+
+}  // extern "C"
+#endif
diff --git a/libs/video/rsx_vk_fsr3.h b/libs/video/rsx_vk_fsr3.h
new file mode 100644
index 00000000..9187b704
--- /dev/null
+++ b/libs/video/rsx_vk_fsr3.h
@@ -0,0 +1,32 @@
+/*
+ * AMD FSR 3.1 upscaling (and native AA) for the Vulkan backend, through the
+ * FidelityFX SDK's FSR 3 upscaler and VK backend. Built only when CMake is
+ * given PS3RECOMP_FFX_LIB (a static library of those, built from the SDK with
+ * its shaders; the SDK is not part of this repository); otherwise every call
+ * says FSR 3 is not there. Frames are described as for DLSS (rsx_vk_dlss.h).
+ */
+#ifndef RSX_VK_FSR3_H
+#define RSX_VK_FSR3_H
+#include "rsx_vk_dlss.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* FSR's quality modes. */
+enum { RSX_FSR3_NATIVE_AA = 0, RSX_FSR3_QUALITY = 1, RSX_FSR3_BALANCED = 2,
+       RSX_FSR3_PERFORMANCE = 3, RSX_FSR3_ULTRA_PERFORMANCE = 4 };
+
+/* After the device. 0 when FSR 3 can run on it. */
+int rsx_fsr3_init(VkInstance instance, VkPhysicalDevice phys, VkDevice device,
+                  PFN_vkGetInstanceProcAddr gipa, PFN_vkGetDeviceProcAddr gdpa);
+int rsx_fsr3_render_size(int mode, uint32_t out_w, uint32_t out_h, uint32_t* w, uint32_t* h);
+/* Recorded into cmd; the context is made again (the caller has the device
+ * idle) when the output size changes. Every image is in VK_IMAGE_LAYOUT_GENERAL
+ * and is left there. 0 on success. */
+int rsx_fsr3_evaluate(VkCommandBuffer cmd, const rsx_dlss_frame* f);
+void rsx_fsr3_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 8516d87b..fa7de5b7 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -52,6 +52,7 @@
 #include "rsx_draw_engine.h"
 #include "rsx_temporal.h"
 #include "rsx_vk_dlss.h"
+#include "rsx_vk_fsr3.h"
 #include "vulkan/rsx_vk_motion_comp.spv.h"
 #include "vulkan/rsx_vk_fallback_vert.spv.h"
 #include "vulkan/rsx_vk_fallback_frag.spv.h"
@@ -3950,8 +3951,9 @@ static struct {
     VkPipeline pipe;
     VkDescriptorPool pool;
     VkDescriptorSet set;
-    VkImage set_for[3];               /* the images the set was written for */
-    vk_image mv; u32 mv_w, mv_h;
+    VkImage set_for[4];               /* the images the set was written for */
