+/* SPU writes over command-buffer parks.
+ *
+ * Killzone HD's PSGL reserves holes in its command ring for SPU jobs
+ * (func_003174B0): NOPs, and a self-JUMP ("park") at the start of each
+ * 128-byte line. The RSX waits on a park until a job's write lands on that
+ * line, whose first word then becomes a command header, and a packet may run
+ * on into the next line. A host memcpy makes the words visible in its own
+ * order, so a walker waiting on a park could leave it while the rest of the
+ * line, or the next line's first word, still held the old NOPs or park, and
+ * read them at the wrong alignment. So a write (DMA PUT, PUTLLC, PUTLLUC) that
+ * covers parks stores everything else first, then, after a full fence, the
+ * parks' words from the last line to the first: when the walker leaves a
+ * park, the whole write is in memory. The end result is the same bytes.
+ *   SPU_PUT_PARK_LAST=0: one memcpy, as before (A/B).
+ *   SPU_PUT_TEAR_MS=<ms> (fault injection): pause <ms> after the first part of
+ *     the copy, as a copy preempted midway.
+ * The first 8 writes over parks, then every 65536th, are logged. */
+static inline int spu_word_is_park(const uint8_t* p, uint32_t ea)
+{
+    uint32_t w;
+    memcpy(&w, p, 4);
+    w = __builtin_bswap32(w);
+    return (w & 0xE0000003u) == 0x20000000u && (w & 0x000FFFFCu) == (ea & 0x000FFFFCu);
+}
+static inline void spu_put_copy(uint8_t* dst, const uint8_t* src, uint32_t size, uint32_t ea)
+{
+    static int cfg = -1;   /* bit 0: parks last; above it: the tear in ms */
+    int c = __atomic_load_n(&cfg, __ATOMIC_RELAXED);
+    if (__builtin_expect(c < 0, 0)) {
+        const char* e = getenv("SPU_PUT_PARK_LAST");
+        const char* t = getenv("SPU_PUT_TEAR_MS");
+        int ms = t ? atoi(t) : 0;
+        ms = ms < 0 ? 0 : ms > 1000 ? 1000 : ms;
+        c = ((e && *e == '0') ? 0 : 1) | (ms << 1);
+        __atomic_store_n(&cfg, c, __ATOMIC_RELAXED);
+    }
+    const int last = c & 1, tear_ms = c >> 1;
+    /* The line starts inside the write that hold a park now. */
+    uint32_t parks[MFC_MAX_DMA_SIZE / 128u + 1u];
+    uint32_t np = 0;
+    if (size >= 4u) {
+        for (uint32_t a = (ea + 127u) & ~127u; a - ea <= size - 4u && np < sizeof parks / sizeof parks[0]; a += 128u)
+            if (spu_word_is_park(dst + (a - ea), a)) parks[np++] = a - ea;
+    }
+    if (!np) { memcpy(dst, src, size); return; }
+    { static unsigned n = 0;
+      const unsigned k = __atomic_add_fetch(&n, 1u, __ATOMIC_RELAXED);
+      if (k <= 8u || (k & 0xFFFFu) == 0u)
+          fprintf(stderr, "[spu-put] #%u over %u park(s): ea=%08X size=0x%X, first at +0x%X%s%s\n",
+                  k, np, ea, size, parks[0], last ? " (parks written last)" : "",
+                  tear_ms ? " (tear injected)" : ""); }
+    if (!last) {
+        if (tear_ms && size > 16u) {
+            memcpy(dst, src, 16);
+            Sleep((DWORD)tear_ms);
+            memcpy(dst + 16, src + 16, size - 16u);
+        } else {
+            memcpy(dst, src, size);
+        }
+        return;
+    }
+    uint32_t pos = 0;
+    for (uint32_t i = 0; i < np; i++) {
+        if (parks[i] > pos) memcpy(dst + pos, src + pos, parks[i] - pos);
+        pos = parks[i] + 4u;
+        if (tear_ms && i == 0) Sleep((DWORD)tear_ms);
+    }
+    if (size > pos) memcpy(dst + pos, src + pos, size - pos);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    for (uint32_t i = np; i-- > 0; ) {
+        uint32_t w;
+        memcpy(&w, src + parks[i], 4);
+        __atomic_store_n((uint32_t*)(void*)(dst + parks[i]), w, __ATOMIC_RELEASE);
+    }
+}
+
 /* 1 = done (rc in *rc), 0 = take the full path. */
 static inline int mfc_do_transfer_fast(spu_context* spu, uint32_t lsa, uint64_t ea,
                                        uint32_t size, uint32_t cmd, int* rc)
@@ -256,7 +332,7 @@
