                     if ((locked_lines[i >> 6] >> (i & 63u)) & 1u) {
-                        memcpy(ea_ptr + lo, ls_ptr + lo, hi - lo);
+                        spu_put_copy(ea_ptr + lo, ls_ptr + lo, hi - lo, ea32 + lo);
