                     } else if (spu_coh_is_reserved(a)) {
                         spu_coh_notify_write_except(a, spu);   /* reserved after its copy */
@@ -834,7 +910,7 @@
                 spu_lockline_unlock();
             } else if (span_reserved) {
                 spu_lockline_lock();
