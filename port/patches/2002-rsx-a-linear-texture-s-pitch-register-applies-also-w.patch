From 25a7657ecc9313ae1ffc97aad0ecbaa4cb790237 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 14 Oct 2026 02:33:57 -0300
Subject: [PATCH] rsx: a linear texture's pitch register applies also
 when smaller than its width

---
 libs/video/rsx_texture_layout.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_texture_layout.c b/libs/video/rsx_texture_layout.c
index 51a30a23..a566bf52 100644
--- a/libs/video/rsx_texture_layout.c
+++ b/libs/video/rsx_texture_layout.c
@@ -113,8 +113,12 @@ void rsx_texture_layout_pitched(u32 rsx_fmt, u32 w, u32 h, u32 pitch,
         out->bytes_per_texel = src_bpp;
         out->row_bytes = w * src_bpp;
         /* A swizzled image has no rows to space out, so the pitch register
-         * only applies to a linear one. */
-        if (pitch > out->row_bytes && (rsx_fmt & 0x20u))
+         * only applies to a linear one -- also when it is SMALLER than the
+         * texture's width: Killzone HD points a 2048x1024 texture at a
+         * 1280x720 movie frame with pitch 5120 and samples only its 1280x720
+         * corner. Reading rows 8192 bytes apart there sheared the movie into
+         * five side-by-side copies. */
+        if (pitch && (rsx_fmt & 0x20u))
             out->row_bytes = pitch;
         out->rows      = h;
         out->dst_bytes_per_texel = dst_bpp;
-- 
