From 7eb2869f24954954a523208ad5ec7a61d472fa49 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sun, 1 Nov 2026 03:41:52 -0300
Subject: [PATCH] cellAudio: mix on the title's own clock
 (ps3_audio_set_clock_ms)

A host that replays a recorded play faster or slower than real time sets
the time each frame of the recording started (ps3_audio_set_clock_ms) and
the mixer then mixes and signals blocks as that clock passes, not as the
device takes them; the device gets only what it has room for. With
ps3_audio_clock_caught_up() the host can wait for the mix before a frame
runs. ms < 0 goes back to the device's pacing. Both mix loops (POSIX and
Windows) take it.

Killzone HD's route replays (port's route.cpp): its AI agents wait for
actions to end, and with the sound mixed in real time an unpaced replay
ended those waits in other frames than the recording did, so the agents
decided differently. On this clock 4 of 5 Level 1 combat routes replay
with the player's position exact to the end.

---
 libs/audio/cellAudio.c | 49 ++++++++++++++++++++++++++++++++++++++++++
 libs/audio/cellAudio.h |  6 ++++++
 2 files changed, 55 insertions(+)

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 20d588d7..6eacb755 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -146,6 +146,17 @@ static u64            s_audio_start_us = 0;
 /* Mixing thread */
 static unsigned long long g_audio_dropped;   /* frames the device had no room for */
 static volatile int  s_mix_thread_running = 0;
+
+/* A title's own clock for the mix (ps3_audio_set_clock_ms): while it is set
+ * (>= 0), blocks are mixed as that time passes, not as the device takes them,
+ * and the device gets only what it has room for. A replayed recording runs
+ * faster or slower than real time; on this clock its sounds start and end in
+ * the frames they did when it was recorded, give or take the mixer's thread. */
+static volatile double s_title_clock_ms = -1.0;
+static volatile int s_title_clock_behind = 0;   /* blocks due on it not mixed yet */
+void ps3_audio_set_clock_ms(double ms) { if (ms >= 0.0 && ms > s_title_clock_ms) s_title_clock_behind = 1; s_title_clock_ms = ms; }
+/* 1 once every block due on the title's clock has been mixed */
+int ps3_audio_clock_caught_up(void) { return !s_title_clock_behind; }
 static thread_t      s_mix_thread;
 #ifndef _WIN32
 /* Is s_mix_thread a thread that exists and has not been joined? The Win32
@@ -611,6 +622,38 @@ static void audio_notify_event_queues(void)
     }
 }
 
+/* One pass of the mix loop on the title's clock (ps3_audio_set_clock_ms):
+ * 1 when it took the pass (mixed a block or waited for the clock), -1 once
+ * when the clock was just cleared (the loop restarts its own pacing), 0 when
+ * the device or real time paces the mix. */
+static int audio_title_clock_step(int room)
+{
+    static double base_ms = -1.0;
+    static unsigned long long base, mixed;
+    const double ms = s_title_clock_ms;
+    if (ms < 0.0) {
+        if (base_ms < 0.0) return 0;
+        base_ms = -1.0;
+        return -1;
+    }
+    if (base_ms < 0.0) base_ms = ms, base = mixed;
+    const double due = base + (ms - base_ms) * CELL_AUDIO_SAMPLE_RATE / (1000.0 * CELL_AUDIO_BLOCK_SAMPLES);
+    if ((double)mixed >= due) {
+        if (ms == s_title_clock_ms) s_title_clock_behind = 0;
+#ifdef _WIN32
+        Sleep(0);
+#else
+        usleep(100);
+#endif
+        return 1;
+    }
+    mixed++;
+    audio_mix_one_block();
+    if (room >= CELL_AUDIO_BLOCK_SAMPLES) audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+    audio_notify_event_queues();
+    return 1;
+}
+
 #ifdef _WIN32
 static unsigned long long g_audio_underruns;
 static unsigned __stdcall audio_mix_thread_func(void* arg)
@@ -641,6 +684,9 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
     unsigned long long blocks = 0;
     while (s_mix_thread_running) {
         const int room = audio_backend_room();
+        const int tc = audio_title_clock_step(room);
+        if (tc > 0) continue;
+        if (tc < 0) QueryPerformanceCounter(&q0), blocks = 0;
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
 #if AUDIO_BACKEND_WASAPI
         /* Device queue under half a block: it is about to play silence (an
@@ -716,6 +762,9 @@ static void* audio_mix_thread_func(void* arg)
     unsigned long long blocks = 0;
     while (s_mix_thread_running) {
         const int room = audio_backend_room();
+        const int tc = audio_title_clock_step(room);
+        if (tc > 0) continue;
+        if (tc < 0) clock_gettime(CLOCK_MONOTONIC, &t0), blocks = 0;
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { usleep(1000); continue; }
         if (room < 0) {
             struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
diff --git a/libs/audio/cellAudio.h b/libs/audio/cellAudio.h
index 696ed357..cef360a8 100644
--- a/libs/audio/cellAudio.h
+++ b/libs/audio/cellAudio.h
@@ -115,6 +115,12 @@ s32 cellAudioSetPersonalDevice(s32 iPersonalStream, s32 iDevice);
 /* NID: 0x28BC1409 */
 s32 cellAudioUnsetPersonalDevice(s32 iPersonalStream);
 
+/* Host side: mix on the title's own clock instead of the device's (a replay
+ * that runs faster or slower than real time); ms < 0 goes back to the device.
+ * ps3_audio_clock_caught_up() is 1 once every block due has been mixed. */
+void ps3_audio_set_clock_ms(double ms);
+int  ps3_audio_clock_caught_up(void);
+
 #ifdef __cplusplus
 }
 #endif
