 libs/video/tests/test_gcm_park_reuse.c        |  1 +
 libs/video/tests/test_gcm_resync_labels.c     |  1 +
 libs/video/tests/test_gcm_walker_prof.c       |  1 +
 libs/video/tests/test_nv3089_engine_read.c    |  1 +
