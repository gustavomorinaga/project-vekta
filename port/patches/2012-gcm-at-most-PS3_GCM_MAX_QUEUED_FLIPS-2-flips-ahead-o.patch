From 9534339f750d6548c8518a1ed766dd1ae2279bbe Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 18:00:52 -0300
Subject: [PATCH] gcm: at most PS3_GCM_MAX_QUEUED_FLIPS (2) flips ahead
 of the drain

A title that does not wait for its flips ran ahead until its ring was full:
Killzone HD queued ~600 frames (10 s) in its menus and intro movie, so
input and the movie's frame requests lagged the screen by that much.
cellGcm_flip_written_count() reports the queue.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/cellGcmSys.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 0d07d1cb..55d9ffac 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -100,6 +100,11 @@ static volatile int s_flip_lock;
  * clear+few-draws frame as a visible flicker). */
 static volatile u32 s_flip_request_count = 0;
 
+/* Flips the guest has queued into the FIFO (markers written), against
+ * s_flip_request_count, the ones the drain reached: the difference is how
+ * many frames the title is ahead of the screen. */
+static volatile u32 s_flip_written_count = 0;
+u32 cellGcm_flip_written_count(void) { return s_flip_written_count; }
 u32 cellGcm_flip_request_count(void)
 {
     return s_flip_request_count;
@@ -3232,6 +3237,7 @@ static int gcm_flip_into_fifo(u32 ctx, u32 bufferId)
     if (cur + 8 + GCM_RECYCLE_SLACK > end || gcm_ea2io(cur) == 0xFFFFFFFFu) return 0;
     vm_write32(cur, GCM_FLIP_MARKER | bufferId);
     s_fifo_flips_queued++;
+    s_flip_written_count++;
     /* Wrap here, on the guest thread, once the ring is nearly used -- what the
      * SDK's buffer-full callback does. Otherwise the drain thread recycles it
      * (see "recycled the title's own ring"), rewriting ctx->current and put
@@ -4059,6 +4065,24 @@ s32 cellGcmSetDefaultFifoSize(u32 size)
 /* NID: 0x21397818 */
 s32 _cellGcmSetFlipCommand(void* ctx, u32 bufferId)
 {
+    /* PS3_GCM_MAX_QUEUED_FLIPS=<n> (default 2, 0 = unlimited): the guest waits
+     * here while n flips it queued have not been reached by the drain. The
+     * RSX shows one flip per vblank, and a title that does not wait for its
+     * flips otherwise runs ahead until its ring is full: Killzone HD queued
+     * ~600 frames (10 s) in its menus and intro movie, so input and the
+     * movie's frame requests lagged the screen by that much. Bounded wait, in
+     * case the earlier flip sits behind a put the title has not flushed. */
+    { static int cap = -1;
+      if (cap < 0) { const char* e = getenv("PS3_GCM_MAX_QUEUED_FLIPS"); cap = e ? atoi(e) : 2; }
+      if (cap > 0) {
+          for (int i = 0; i < 1000 && (int)(s_flip_written_count - s_flip_request_count) >= cap; i++) {
+#ifdef _WIN32
+              Sleep(0);
+#else
+              usleep(100);
+#endif
+          }
+      } }
     if (gcm_flip_into_fifo((u32)(uintptr_t)ctx, bufferId))
         return gcm_flip_request(bufferId, 1);
     return cellGcmSetFlipCommand(bufferId);
-- 
