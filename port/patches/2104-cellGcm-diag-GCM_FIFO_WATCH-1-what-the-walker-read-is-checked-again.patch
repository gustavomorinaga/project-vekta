index 0000000..3f1f5d3
--- /dev/null
+++ b/libs/video/tests/test_gcm_fifo_watch.c
@@ -0,0 +1,215 @@
+/* GCM_FIFO_WATCH (gcm_fifo_watch.h, a diagnostic): a word below put that
+ * changes after the walker read it is reported, a NOP that changes is counted
+ * apart, a change after the title's write head came round the ring over it is
+ * its next lap (counted, not reported), and at a bad word the words around it
+ * are printed as read the pass before -- here a slot the second pass never
+ * wrote, still holding the first pass's float arguments, the shape of
+ * Killzone HD's split-screen resync.
+ *
+ * gcc -std=gnu17 -I include -I libs/video
+ *   libs/video/tests/test_gcm_fifo_watch.c -ffunction-sections
+ *   -fdata-sections -Wl,--gc-sections -pthread -o /tmp/test_gcm_fifo_watch
+ *   (clang on macOS: -Wl,-dead_strip)
+ */
+#include "../cellGcmSys.c"
+#include "../rsx_tiling.c"
+#include "port_links.h"
+#include <stdio.h>
+#include <stdlib.h>
+/* GCM_REPORT_SPU_HOLD_MS asks the SPU task layer whether a task round is
+ * running; there are no SPU tasks here. */
+int spu_taskset_round_busy(uint32_t* ts, uint32_t* tid) { (void)ts; (void)tid; return 0; }
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+/* The walker's other consumers: no graphics backend, no lifted program. */
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+/* Counts the probe methods the walker ran. */
+#define PROBE_METHOD 0x1EE0u
+static u32 seen_n;
+/* No microcode or constant runs here: the walker hands every word to
+ * rsx_process_method instead. */
+int  rsx_process_vp_run(rsx_state* state, u32 method, const u8* src, u32 count)
+{ (void)state; (void)method; (void)src; (void)count; return 0; }
+int  rsx_process_method(rsx_state* state, u32 method, u32 data)
+{
+    (void)state;
+    if (method == PROBE_METHOD) seen_n++;
+    (void)data;
+    return 0;
+}
+int  rsx_draw_engine_enabled(void) { return 0; }
+rsx_backend* rsx_get_backend(void) { return NULL; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_label_released(void) {}
+u32  rsx_draw_engine_surface_pitch(u32 l, u32 o) { (void)l; (void)o; return 0; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+
+#define IO_ADDR   0x00100000u
+#define IO_SIZE   0x00100000u
+#define CMD_SIZE  0x00010000u
+#define SEG_B     0x00008000u
+
+static uint32_t g_heap = 0x00400000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+static u32 put_probe(u32 io, u32 arg)
+{
+    gw32(IO_ADDR + io, (1u << 18) | PROBE_METHOD);
+    gw32(IO_ADDR + io + 4, arg);
+    return io + 8;
+}
+
+static void walk(u32 ctrl, u32 from, u32 put)
+{
+    s_fifo_getoff = from;
+    vm_write32(ctrl + 4, from);
+    vm_write32(ctrl + 0, put);
+    cellGcm_rsx_process_fifo();
+}
+
+static void sleep_ms(unsigned ms)
+{
+    struct timespec ts = { 0, (long)ms * 1000000L };
+    nanosleep(&ts, NULL);
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    setenv("GCM_FIFO_WATCH", "1", 1);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+    u32 ctx_out = host_alloc(4, 4);
+    (void)cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const uint32_t ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+
+    /* 1. Three probes and a run of NOPs, walked; then one probe's header and
+     * one NOP are written over, and the next pass, 2 ms later, checks them. */
+    u32 e = put_probe(0, 0);
+    e = put_probe(e, 1);
+    e = put_probe(e, 2);
+    e += 0x20;                                   /* 8 NOP words */
+    walk(ctrl, 0, e);
+    check(seen_n == 3, "the three probes ran");
+    gw32(IO_ADDR + 8, 0x3D60E0E2u);              /* the second probe's header */
+    gw32(IO_ADDR + 0x20, 0x00041714u);           /* a NOP */
+    sleep_ms(2);
+    walk(ctrl, e, e);                            /* nothing to walk: the checks run */
+    check(s_gw_word1 == 1, "a command word changed after it was read: reported at the 1 ms check");
+    check(s_gw_hole == 1, "a NOP changed after it was read: counted apart");
+    sleep_ms(25);
+    walk(ctrl, e, e);
+    check(s_gw_word2 == 0 && s_gw_word1 == 1, "the same change is not reported again at 5 ms");
+
+    /* 2. Untouched words are not reported. */
+    u32 f = put_probe(0x400, 3);
+    f = put_probe(f, 4);
+    walk(ctrl, 0x400, f);
+    sleep_ms(25);
+    walk(ctrl, f, f);
+    sleep_ms(2);
+    walk(ctrl, f, f);
+    check(s_gw_word1 == 1 && s_gw_word2 == 0, "words that stay as read are not reported");
+
+    /* 3. The first pass at 0x800 has a count-3 packet whose arguments at 0x808
+     * are floats; the second pass, 25 ms later, writes count-1 packets there
+     * but not the one at 0x808. The walker reads the first pass's floats as a
+     * JUMP to unmapped IO: at that bad word the watch prints the pass before. */
+    gw32(IO_ADDR + 0x800, (3u << 18) | PROBE_METHOD);
+    gw32(IO_ADDR + 0x804, 7);
+    gw32(IO_ADDR + 0x808, 0x3D60E0E2u);
+    gw32(IO_ADDR + 0x80C, 0x3DC0C0C2u);
+    u32 g = put_probe(0x810, 8);
+    walk(ctrl, 0x800, g);
+    sleep_ms(25);
+    walk(ctrl, g, g);
+    put_probe(0x800, 9);                         /* 0x800..0x807 */
+    put_probe(0x810, 10);                        /* 0x808..0x80F left as they were */
+    gw32(IO_ADDR + 0x818, 0x20000000u | 0x818);  /* park */
+    walk(ctrl, 0x800, 0x818);
+    check(s_fifo_getoff == 0x818, "the bad word was resynced over");
+    gw_page* p = gw_page_of(0x808, 0);
+    check(p && p->prev[0x808 >> 2] == 0x3D60E0E2u, "the pass before is kept for the bad word: the floats it holds now");
+    check(p && p->cur[0x800 >> 2] == ((1u << 18) | PROBE_METHOD) && p->prev[0x800 >> 2] == ((3u << 18) | PROBE_METHOD),
+          "a word the second pass wrote: read last as written, the pass before as before");
+
+    /* 4. The title's head at 512 KB when probes at 0xC00 are read, then back
+     * at the ring's start (a lap) and past 0xC00: the word changing is its
+     * next lap. Read again with the head at 512 KB and changed at once: not. */
+    const u32 ctx = vm_read32(ctx_out);
+    vm_write32(ctx + 4, IO_ADDR + IO_SIZE - 4u);  /* end: a ring as big as the IO space, so the head can move */
+    vm_write32(ctx + 8, IO_ADDR + 0x80000u);
+    walk(ctrl, f, f);                            /* the head is seen there */
+    u32 h = put_probe(0xC00, 11);
+    h = put_probe(h, 12);
+    walk(ctrl, 0xC00, h);
+    vm_write32(ctx + 8, IO_ADDR + 0x100u);
+    walk(ctrl, h, h);                            /* a lap: the head went back to the start */
+    const u32 lap = s_gw_lap;
+    vm_write32(ctx + 8, IO_ADDR + 0x1000u);      /* ...and on past 0xC00 */
+    gw32(IO_ADDR + 0xC00, 0x00041714u);
+    sleep_ms(2);
+    walk(ctrl, h, h);
+    check(lap == 1, "the head going back to the ring's start is a lap");
+    check(s_gw_reuse == 1 && s_gw_word1 == 1, "a change after the head came round over the word: reuse, not reported");
+    vm_write32(ctx + 8, IO_ADDR + 0x80000u);
+    walk(ctrl, h, h);
+    u32 q = put_probe(0xE00, 13);
+    walk(ctrl, 0xE00, q);
+    gw32(IO_ADDR + 0xE04, 0x3DC0C0C2u);          /* the probe's argument */
+    sleep_ms(2);
+    walk(ctrl, q, q);
+    check(s_gw_word1 == 2 && s_gw_reuse == 1, "a change with the head not round yet: reported");
+
+    printf("[gcm_fifo_watch] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
