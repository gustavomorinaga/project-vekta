From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sat, 28 Nov 2026 10:20:00 -0300
Subject: [PATCH] cellGcm: GCM_FIFO_WATCH=1, what the walker read is checked
 again after it read it (diagnostic)

Killzone HD's rare split-screen resync on Windows has one shape in all four
incidents seen: the walker comes linearly through the ring to a count-1
packet slot below put and finds 8 bytes of floats where a header and its
argument belong, followed by a valid 00041714. No park skip, no CALL, not
past put, no SPU PUT near the stream.

GCM_FIFO_WATCH=1 (off by default) asks three things of it:
- at a bad word, the words around it now, as the walker read them last and
  as it read them the pass before (a line read again 20 ms or more after):
  were the floats there the pass before, so this pass never wrote them?
- every line the walker reads is compared with memory 1 ms and 5 ms later:
  does a word below put change after the walker read it (a late write, or a
  writer aiming at the wrong address)? A change after the title's write head
  came round the ring over the word is its next lap (about 24 ms in a
  2-player match at 60: some 85 MB a second walked through a 2 MB ring,
  mostly the NOPs of SPU holes), counted as reuse and not reported.
- SPU DMA PUTs and line stores (PUTLLC, PUTLLUC) into the IO pages the
  walker reads are logged and listed at a bad word and at a change.
And at a bad word the 24 bytes around it are read again for 200 ms.

Totals every 10 s ("[fifo-watch] 10 s:"). Test: tools/test_gcm_fifo_watch.py
(libs/video/tests/test_gcm_fifo_watch.c). Not for merge.
---
diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index c2a9346..979f11d 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2275,6 +2275,9 @@ static u32 gcm_ea2io_range(u32 ea, u32* room)
     return 0xFFFFFFFFu;
 }
 
+/* GCM_FIFO_WATCH=1: a diagnostic of what the walker read (gcm_fifo_watch.h). */
+#include "gcm_fifo_watch.h"
+
 void gcm_forget_spu_blocks(void)
 {
     memset(s_spu_blk, 0, sizeof s_spu_blk);
@@ -2283,6 +2286,8 @@ void gcm_forget_spu_blocks(void)
 
 void gcm_note_spu_put(u32 ea, u32 size)
 {
+    if (GW_ON()) gw_spu_store(ea, size & 0x7FFFFFFFu);   /* GCM_FIFO_WATCH */
+    if (size & 0x80000000u) return;   /* a line store (PUTLLC, PUTLLUC), for the watch only */
     if (!size || size > 0x40000u) return;
     u32 room = 0;
     u32 io = gcm_ea2io_range(ea, &room);
@@ -2468,6 +2473,7 @@ static void gcm_fifo_dump_around(u32 getoff)
         fprintf(stderr, "[FIFODUMP] %+3d io=%08X w=%08X%s\n",
                 k, io, vm_read32(ea), k ? "" : "   <-- bad word");
     }
+    if (s_gw_on > 0) gw_incident(getoff);   /* GCM_FIFO_WATCH */
 }
 
 
@@ -2922,6 +2928,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
      * word that is not a command, and parks there forever. */
     atomic_thread_fence(memory_order_acquire);
     gcm_hazard_watch();
+    if (GW_ON()) gw_tick(put);   /* GCM_FIFO_WATCH: the lines read 1 ms and 20 ms ago */
 
     /* GCM_CTXDBG=1: which context the title is actually driving. Ours is written
      * once at init; if the title repoints gCellGcmCurrentContext at a buffer of
@@ -3051,6 +3058,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
         s_tr_off[s_tr_i % GCM_TRACE_N] = s_fifo_getoff;
         s_tr_w[s_tr_i % GCM_TRACE_N] = w;
         s_tr_i++;
+        if (s_gw_on > 0) gw_step(s_fifo_getoff, w);   /* GCM_FIFO_WATCH */
         if (w && ((w & 0xE0000003u) == 0x20000000u || (w & 3u) == 1u || (w & 3u) == 2u)) {
             s_cf_off[s_cf_i % 8] = s_fifo_getoff; s_cf_w[s_cf_i % 8] = w; s_cf_i++; }
         /* GCM_WORD_STATS=<secs>: NOP words vs headers vs jumps/calls/returns
@@ -3598,6 +3606,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
             fprintf(stderr, "[FIFOUW] unknown word 0x%08X at getoff 0x%X\n", w, s_fifo_getoff); }
         s_fifo_getoff += 4;                    /* unknown word: skip */
     }
+    if (s_gw_on > 0) gw_drain_end(s_fifo_getoff);   /* GCM_FIFO_WATCH: the last packet read */
 
     /* Walker watchdog. Everything above recovers from a *recognised* stall --
      * a branch we cannot take, a park the title abandoned. A walker that stops
@@ -3831,6 +3840,7 @@ static void gcm_fifo_next_segment(u32 ctx)
     const u32 io_cur = gcm_ea2io(cur), io_next = gcm_ea2io(next);
     if (io_cur == 0xFFFFFFFFu || io_next == 0xFFFFFFFFu || cur > end) return;
     vm_write32(cur, 0x20000000u | io_next);              /* JUMP -> next segment */
+    __atomic_add_fetch(&s_gw_segs, 1ull, __ATOMIC_RELAXED);   /* GCM_FIFO_WATCH: segment switches */
     /* The JUMP has to be in memory before `put` lets the walker reach it. */
     atomic_thread_fence(memory_order_release);
     vm_write32(GCM_CONTROL_GUEST_ADDR + 0, io_cur);      /* put: up to the JUMP */
diff --git a/libs/video/gcm_fifo_watch.h b/libs/video/gcm_fifo_watch.h
new file mode 100644
index 0000000..27e50ac
--- /dev/null
+++ b/libs/video/gcm_fifo_watch.h
@@ -0,0 +1,405 @@
+/*
+ * gcm_fifo_watch.h -- GCM_FIFO_WATCH=1 (diagnostic, off by default): what the
+ * FIFO walker read, compared with memory again after it read it, and at a bad
+ * word, what was there the pass before. Included once, by cellGcmSys.c.
+ *
+ * Why: Killzone HD's rare split-screen resync (Windows, 2026-11-28, four
+ * incidents) has one shape. The walker comes linearly through the ring to a
+ * slot below `put` and finds 8 bytes of float data where a count-1 header and
+ * its argument belong, followed by a valid 00041714. Not past put, not after a
+ * park skip, not through a CALL. Three questions:
+ *
+ *  1. Were those 8 bytes already there the pass before (the title never wrote
+ *     them in this pass), or are they new? At a bad word each word around it
+ *     is printed as it is now, as the walker read it last, and as it read it
+ *     the pass before (a pass: a line read again 10 ms or more after).
+ *  2. Does a word below `put` change after the walker has read it (a write
+ *     that comes late, or a writer aiming at a wrong address)? Each 128-byte
+ *     line the walker reads is compared with memory 1 ms and 5 ms later. The
+ *     title's own next lap is not that: in a 2-player match at 60 the walker
+ *     reads about 85 MB a second through the 2 MB ring (most of it the NOPs
+ *     of SPU holes), a lap of about 24 ms, so a change after the title's
+ *     write head has come round over the word since the read is counted as
+ *     reuse; any other change is reported, with get, put and the head.
+ *  3. Does an SPU store into the lines the walker reads? SPU DMA PUTs and line
+ *     stores (PUTLLC, PUTLLUC) into watched IO pages are logged; at a bad word
+ *     and at a change, the ones on that line are listed.
+ *
+ * And at a bad word the 24 bytes around it are read again for 200 ms (the
+ * walker waits): a late write shows as the words changing under it.
+ *
+ * Cost when off: one load per walker word. When on: about 2.2 MB per 1 MB IO
+ * page the walker reads, a copy of each word it consumes and two compares of
+ * it later. Totals every 10 s ("[fifo-watch] 10 s:").
+ */
+#ifndef GCM_FIFO_WATCH_H
+#define GCM_FIFO_WATCH_H
+
+#define GW_PAGES   512u               /* 1 MB IO pages: IO offsets below 512 MB */
+#define GW_PASS_US 10000ull           /* a line read again this long after: a new pass (a lap: ~24 ms) */
+#define GW_LATE1_US 1000ull           /* the first check of a line read */
+#define GW_LATE2_US 5000ull           /* ...and the second */
+#define GW_Q_N     65536u             /* lines waiting for their check */
+#define GW_SPU_N   4096u              /* SPU stores remembered */
+
+typedef struct gw_page {
+    u32 cur[262144];                  /* each word as the walker read it last */
+    u32 prev[262144];                 /* ...and the pass before */
+    unsigned long long line_us[8192]; /* when the walker last read in each line */
+    unsigned long long prev_us[8192]; /* ...and the pass before */
+    unsigned long long spu_us[8192];  /* when an SPU last stored into it */
+    u32 mask[8192];                   /* words read in the line since its check was queued */
+} gw_page;
+
+typedef struct { u32 line, mask, head, lap; unsigned long long t; } gw_q;   /* the title's head and lap at the read */
+typedef struct { u32 ea, size, w0, w1; unsigned long long t; } gw_spu;
+
+static int s_gw_on = -1;
+static gw_page* s_gw_pg[GW_PAGES];
+static u32 s_gw_prev_io = 0xFFFFFFFFu, s_gw_prev_w;
+static gw_q s_gw_q1[GW_Q_N], s_gw_q2[GW_Q_N];
+static u32 s_gw_q1h, s_gw_q1t, s_gw_q2h, s_gw_q2t;
+static gw_spu s_gw_spu[GW_SPU_N];
+static u32 s_gw_spu_i;
+static unsigned long long s_gw_lines, s_gw_word1, s_gw_word2, s_gw_reuse, s_gw_hole, s_gw_near_head, s_gw_qdrop;
+static u32 s_gw_head0 = 0xFFFFFFFFu;          /* the title's write head when this drain pass began */
+static u32 s_gw_lap;                          /* times the head went back to the ring's start */
+static unsigned long long s_gw_spu_n, s_gw_spu_read, s_gw_segs;
+
+static int gw_on_slow(void)
+{
+    const char* e = getenv("GCM_FIFO_WATCH");
+    const int on = e && atoi(e) ? 1 : 0;
+    if (__atomic_exchange_n(&s_gw_on, on, __ATOMIC_RELAXED) < 0 && on)
+        fprintf(stderr, "[fifo-watch] on: words the walker reads are checked again 1 ms and 5 ms later\n");
+    return on;
+}
+#define GW_ON() (__atomic_load_n(&s_gw_on, __ATOMIC_RELAXED) > 0 || \
+                 (__atomic_load_n(&s_gw_on, __ATOMIC_RELAXED) < 0 && gw_on_slow()))
+
+static unsigned long long gw_us(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (unsigned long long)(c.QuadPart / f.QuadPart) * 1000000ull +
+           (unsigned long long)(c.QuadPart % f.QuadPart) * 1000000ull / (unsigned long long)f.QuadPart;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000ull + (unsigned long long)ts.tv_nsec / 1000ull;
+#endif
+}
+
+static gw_page* gw_page_of(u32 io, int make)
+{
+    const u32 pi = io >> 20;
+    if (pi >= GW_PAGES) return NULL;
+    gw_page* p = __atomic_load_n(&s_gw_pg[pi], __ATOMIC_ACQUIRE);
+    if (!p && make) {   /* only the walker makes pages */
+        p = (gw_page*)calloc(1, sizeof *p);
+        if (!p) return NULL;
+        __atomic_store_n(&s_gw_pg[pi], p, __ATOMIC_RELEASE);
+        fprintf(stderr, "[fifo-watch] watching IO page 0x%08X\n", pi << 20);
+    }
+    return p;
+}
+
+/* The title's write head (its context's `current`), as an IO offset. */
+static u32 gw_head(void)
+{
+    u32 ctx = s_gcm_ctx_out_ea ? vm_read32(s_gcm_ctx_out_ea) : 0;
+    if (!ctx) ctx = s_gcm_context_ea;
+    const u32 cur = ctx ? vm_read32(ctx + 0x8) : 0;
+    return cur ? gcm_ea2io_range(cur, NULL) : 0xFFFFFFFFu;
+}
+
+static void gw_q_push(gw_q* q, u32* tail, u32 qhead, u32 line, u32 mask, u32 head, u32 lap, unsigned long long t)
+{
+    if (*tail - qhead >= GW_Q_N) { s_gw_qdrop++; return; }
+    gw_q* e = &q[*tail % GW_Q_N];
+    e->line = line; e->mask = mask; e->head = head; e->lap = lap; e->t = t;
+    (*tail)++;
+}
+
+/* Has the title's write head come round the ring over `io` since it stood at
+ * h0 in lap l0 (when the word was read) to h1 in lap l1? Then the word
+ * changing is its next lap. Everything the walker reads is behind the head:
+ * below it in the same lap, or above it at the end of the lap before. */
+static int gw_head_passed(u32 h0, u32 l0, u32 io, u32 h1, u32 l1)
+{
+    if (h0 == 0xFFFFFFFFu || h1 == 0xFFFFFFFFu) return 0;
+    if (io < h0) return l1 - l0 >= 2u || (l1 - l0 == 1u && h1 >= io);
+    return l1 != l0 || h1 >= io;
+}
+
+/* The walker consumed the words [from, to): remember them as it read them. */
+static void gw_capture(u32 from, u32 to)
+{
+    const unsigned long long now = gw_us();
+    for (u32 io = from; io < to; ) {
+        const u32 pend = (io | 0xFFFFFu) + 1u, lim = (to < pend || pend == 0) ? to : pend;
+        gw_page* p = gw_page_of(io, 1);
+        const u32 ea0 = gcm_io2ea(io), io0 = io;
+        if (!p || !ea0) { io = lim; continue; }
+        for (; io < lim; io += 4u) {
+            const u32 wi = (io & 0xFFFFFu) >> 2, li = wi >> 5;
+            if (p->line_us[li] + GW_PASS_US <= now) {   /* a new pass over this line */
+                memcpy(&p->prev[li << 5], &p->cur[li << 5], 128);
+                p->prev_us[li] = p->line_us[li];
+            }
+            p->line_us[li] = now;
+            p->cur[wi] = vm_read32(ea0 + (io - io0));
+            if (!p->mask[li]) gw_q_push(s_gw_q1, &s_gw_q1t, s_gw_q1h, io & ~127u, 0, s_gw_head0, s_gw_lap, now);
+            p->mask[li] |= 1u << (wi & 31u);
+        }
+    }
+}
+
+/* The word at `at` (w) was decoded and the walker is now at `next`: what it
+ * consumed is that word and, for a method header, its arguments (a run of
+ * NOPs up to `next`). A JUMP, CALL, RETURN or flip word is one word; `next`
+ * at `at` is a word not consumed (a park, an acquire), read again later. */
+static void gw_consumed(u32 at, u32 w, u32 next)
+{
+    if (next == at) return;
+    u32 end = at + 4u;
+    const int ctl = (w & 0xE0000003u) == 0x20000000u || (w & 3u) == 1u || (w & 3u) == 2u ||
+                    w == 0x00020000u || (w & 0xFFFF0000u) == 0xFEAD0000u;
+    if (!ctl && next > at && next - at <= 0x10000u) {
+        if (!w) end = next;
+        else { const u32 e = at + 4u + ((w >> 18) & 0x7FFu) * 4u; end = e < next ? e : next; }
+    }
+    gw_capture(at, end);
+}
+
+/* Each word the walker decodes, at the top of its loop. */
+static inline void gw_step(u32 io, u32 w)
+{
+    if (s_gw_prev_io != 0xFFFFFFFFu) gw_consumed(s_gw_prev_io, s_gw_prev_w, io);
+    s_gw_prev_io = io; s_gw_prev_w = w;
+}
+
+/* The end of a drain pass: the last packet is consumed now, not next pass. */
+static void gw_drain_end(u32 getoff)
+{
+    if (s_gw_prev_io != 0xFFFFFFFFu) gw_consumed(s_gw_prev_io, s_gw_prev_w, getoff);
+    s_gw_prev_io = 0xFFFFFFFFu;
+}
+
+static int gw_is_park(u32 io, u32 w)
+{
+    return ((w & 0xE0000003u) == 0x20000000u && (w & 0x1FFFFFFCu) == io) || ((w & 3u) == 1u && (w & ~3u) == io);
+}
+
+/* The SPU stores in the log that overlap [ea, ea + n), newest first. */
+static void gw_spu_list(const char* tag, u32 ea, u32 n, unsigned long long since)
+{
+    const unsigned long long now = gw_us();
+    const u32 top = __atomic_load_n(&s_gw_spu_i, __ATOMIC_RELAXED);
+    int shown = 0;
+    for (u32 k = 0; k < GW_SPU_N && k < top && shown < 12; k++) {
+        const gw_spu* s = &s_gw_spu[(top - 1u - k) % GW_SPU_N];
+        if (s->t < since) break;
+        if (s->ea < ea + n && s->ea + s->size > ea) {
+            fprintf(stderr, "[fifo-watch]   %s SPU store ea=%08X size=0x%X %.2f ms ago, first words %08X %08X\n",
+                    tag, s->ea, s->size, (double)(now - s->t) / 1000.0, s->w0, s->w1);
+            shown++;
+        }
+    }
+    if (!shown) fprintf(stderr, "[fifo-watch]   %s no SPU store on it in the log\n", tag);
+}
+
+/* One word found changed: stage 1 (1 ms) or 2 (5 ms) after it was read, the
+ * title's head at h0 then. */
+static void gw_report(int stage, gw_page* p, u32 line, u32 k, u32 was, u32 now_w, unsigned long long t_read,
+                      u32 h0, u32 l0, u32 put, unsigned long long now)
+{
+    const u32 io = line + k * 4u, li = (line & 0xFFFFFu) >> 7;
+    const u32 head = s_gw_head0;   /* with s_gw_lap, from the start of this pass */
+    if (gw_head_passed(h0, l0, io, head, s_gw_lap)) {   /* the title's next lap */
+        s_gw_reuse++;
+        static int nr = 0;
+        if (PS3_LOG_FIRST(nr, 2))
+            fprintf(stderr, "[fifo-watch] io=%08X changed %.2f ms after the read, the title's head having come round"
+                            " over it (%08X then, %08X now): reuse, counted, not reported\n",
+                    io, (double)(now - t_read) / 1000.0, h0, head);
+        return;
+    }
+    const int hole = !was || gw_is_park(io, was);
+    const int by_head = head != 0xFFFFFFFFu && head >= io && head - io < 0x400u;
+    if (hole) s_gw_hole++;
+    else { if (stage == 1) s_gw_word1++; else s_gw_word2++; if (by_head) s_gw_near_head++; }
+    static int nw = 0, nh = 0;
+    if (hole ? !PS3_LOG_FIRST(nh, 8) : !PS3_LOG_FIRST(nw, 64)) return;
+    const u32 ea = gcm_io2ea(line);
+    fprintf(stderr, "[fifo-watch] io=%08X changed after the walker read it (seen at the %s check, %.2f ms after,"
+                    " the title's head not round yet): %08X -> %08X, %s; get=%08X put=%08X head=%08X (%+d bytes,"
+                    " %08X at the read)%s\n",
+            io, stage == 1 ? "1 ms" : "5 ms", (double)(now - t_read) / 1000.0, was, now_w,
+            hole ? (was ? "was a park" : "was a NOP") : "was a command word or argument",
+            s_fifo_getoff, put, head, head != 0xFFFFFFFFu ? (int)(head - io) : 0, h0,
+            p->spu_us[li] >= t_read ? ", an SPU stored into this line after the read" : "");
+    if (hole) return;
+    char a[160], b[160];
+    int la = 0, lb = 0;
+    for (u32 j = (k >= 4u ? k - 4u : 0u); j < k + 4u && j < 32u; j++) {
+        la += snprintf(a + la, sizeof a - la, j == k ? " [%08X]" : " %08X", p->cur[(li << 5) + j]);
+        lb += snprintf(b + lb, sizeof b - lb, j == k ? " [%08X]" : " %08X", ea ? vm_read32(ea + j * 4u) : 0u);
+    }
+    fprintf(stderr, "[fifo-watch]   as read:%s | now:%s\n", a, b);
+    if (ea) gw_spu_list("this line:", ea, 128, t_read > 1000000ull ? t_read - 1000000ull : 0);
+}
+
+/* Lines read 1 ms ago, then 5 ms ago: compare what the walker read with memory. */
+static u32 gw_check_line(int stage, u32 line, u32 m, unsigned long long t, u32 h0, u32 l0, u32 put,
+                         unsigned long long now)
+{
+    gw_page* p = gw_page_of(line, 0);
+    const u32 ea = gcm_io2ea(line);
+    if (!p || !ea) return 0;
+    const u32 li = (line & 0xFFFFFu) >> 7;
+    u32 left = m;
+    for (u32 b = m; b; b &= b - 1u) {
+        const u32 k = (u32)__builtin_ctz(b);
+        const u32 was = p->cur[(li << 5) + k], now_w = vm_read32(ea + k * 4u);
+        if (was == now_w) continue;
+        gw_report(stage, p, line, k, was, now_w, t, h0, l0, put, now);
+        left &= ~(1u << k);
+    }
+    return left;
+}
+
+static void gw_tick(u32 put)
+{
+    const unsigned long long now = gw_us();
+    /* Everything this pass reads is behind the head as it is now. Within a
+     * lap it only moves forward (to the next block); a step back of more than
+     * 256 KB is the ring's end. */
+    const u32 h = gw_head();
+    if (h != 0xFFFFFFFFu && s_gw_head0 != 0xFFFFFFFFu && h + 0x40000u < s_gw_head0) s_gw_lap++;
+    if (h != 0xFFFFFFFFu) s_gw_head0 = h;
+    while (s_gw_q1h != s_gw_q1t) {
+        gw_q* e = &s_gw_q1[s_gw_q1h % GW_Q_N];
+        if (now - e->t < GW_LATE1_US) break;
+        gw_page* p = gw_page_of(e->line, 0);
+        const u32 li = (e->line & 0xFFFFFu) >> 7;
+        const u32 m = p ? p->mask[li] : 0u;
+        if (p) p->mask[li] = 0;
+        s_gw_lines++;
+        const u32 left = m ? gw_check_line(1, e->line, m, e->t, e->head, e->lap, put, now) : 0u;
+        if (left) gw_q_push(s_gw_q2, &s_gw_q2t, s_gw_q2h, e->line, left, e->head, e->lap, e->t);
+        s_gw_q1h++;
+    }
+    while (s_gw_q2h != s_gw_q2t) {
+        gw_q* e = &s_gw_q2[s_gw_q2h % GW_Q_N];
+        if (now - e->t < GW_LATE2_US) break;
+        gw_check_line(2, e->line, e->mask, e->t, e->head, e->lap, put, now);
+        s_gw_q2h++;
+    }
+    static unsigned long long t0, l0, s0, g0;
+    if (!t0) {
+        t0 = now;
+        fprintf(stderr, "[fifo-watch] the title's write head at IO %08X\n", s_gw_head0);
+    }
+    if (now - t0 >= 10000000ull) {
+        /* this window, then the run so far */
+        const unsigned long long spu = __atomic_load_n(&s_gw_spu_n, __ATOMIC_RELAXED),
+                                 segs = __atomic_load_n(&s_gw_segs, __ATOMIC_RELAXED);
+        fprintf(stderr, "[fifo-watch] 10 s: %llu lines read and checked (%.1f MB/s), %llu segment switches,"
+                        " %llu SPU stores into watched pages, head lap %u at %08X. Run so far: changed after the walker read them with"
+                        " the title's head not round yet: command words %llu at 1 ms and %llu at 5 ms (%llu within"
+                        " 1 KB behind the head), NOP or park words %llu; the title's next lap over them %llu;"
+                        " SPU stores into lines already read %llu; check queue drops %llu\n",
+                s_gw_lines - l0, (double)(s_gw_lines - l0) * 128.0 / (double)(now - t0), segs - g0, spu - s0,
+                s_gw_lap, s_gw_head0,
+                s_gw_word1, s_gw_word2, s_gw_near_head, s_gw_hole, s_gw_reuse,
+                __atomic_load_n(&s_gw_spu_read, __ATOMIC_RELAXED), s_gw_qdrop);
+        t0 = now; l0 = s_gw_lines; s0 = spu; g0 = segs;
+    }
+}
+
+/* An SPU stored [ea, ea + size) (after the store: what it wrote is in memory). */
+static void gw_spu_store(u32 ea, u32 size)
+{
+    if (!size) return;
+    const u32 io = gcm_ea2io_range(ea, NULL);
+    if (io == 0xFFFFFFFFu || !gw_page_of(io, 0)) return;
+    const unsigned long long now = gw_us();
+    const u32 i = __atomic_fetch_add(&s_gw_spu_i, 1u, __ATOMIC_RELAXED) % GW_SPU_N;
+    gw_spu* s = &s_gw_spu[i];
+    s->ea = ea; s->size = size; s->t = now;
+    s->w0 = vm_read32(ea & ~3u); s->w1 = vm_read32((ea & ~3u) + 4u);
+    __atomic_add_fetch(&s_gw_spu_n, 1ull, __ATOMIC_RELAXED);
+    for (u32 a = io & ~127u; a < io + size; a += 128u) {
+        gw_page* p = gw_page_of(a, 0);
+        if (!p) continue;
+        const u32 li = (a & 0xFFFFFu) >> 7;
+        if (p->line_us[li]) __atomic_add_fetch(&s_gw_spu_read, 1ull, __ATOMIC_RELAXED);
+        p->spu_us[li] = now;
+    }
+}
+
+/* A bad word at `getoff` (w): the words around it now, as read last and the
+ * pass before, the SPU stores near it, and the same words for 200 ms. */
+static void gw_incident(u32 getoff)
+{
+    const u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    const unsigned long long now = gw_us();
+    const u32 head = gw_head();
+    fprintf(stderr, "[fifo-watch] bad word at io=%08X: get=%08X put=%08X head=%08X; segment switches so far %llu\n",
+            getoff, s_fifo_getoff, put, head, __atomic_load_n(&s_gw_segs, __ATOMIC_RELAXED));
+    for (int k = -8; k <= 4; k++) {
+        const u32 io = getoff + (u32)(k * 4);
+        const u32 ea = gcm_io2ea(io);
+        gw_page* p = gw_page_of(io, 0);
+        if (!ea) continue;
+        const u32 w = vm_read32(ea);
+        if (!p) { fprintf(stderr, "[fifo-watch] %+3d io=%08X now %08X (page not watched)\n", k, io, w); continue; }
+        const u32 wi = (io & 0xFFFFFu) >> 2, li = wi >> 5;
+        const int this_pass = p->line_us[li] && now - p->line_us[li] < GW_PASS_US;
+        const u32 before = this_pass ? p->prev[wi] : p->cur[wi];
+        const unsigned long long tb = this_pass ? p->prev_us[li] : p->line_us[li];
+        fprintf(stderr, "[fifo-watch] %+3d io=%08X now %08X | read last %08X (line %.2f ms ago) | the pass before %08X (%s%.1f ms ago)%s\n",
+                k, io, w, p->cur[wi], p->line_us[li] ? (double)(now - p->line_us[li]) / 1000.0 : -1.0,
+                before, tb ? "" : "never, ", tb ? (double)(now - tb) / 1000.0 : 0.0,
+                k == 0 ? "   <-- bad word" : "");
+    }
+    const u32 bea = gcm_io2ea(getoff);
+    if (bea) gw_spu_list("near it:", bea - 128u, 256u, now > 2000000ull ? now - 2000000ull : 0);
+    /* The walker waits here: a write that comes late lands under it. */
+    static const unsigned at_us[] = { 0, 100, 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000 };
+    u32 last[7] = { 0 };
+    int changes = 0;
+    for (unsigned i = 0; i < sizeof at_us / sizeof at_us[0]; i++) {
+        const unsigned long long due = now + at_us[i];
+        for (;;) {
+            const unsigned long long t = gw_us();
+            if (t >= due) break;
+            if (due - t > 1500ull) Sleep(1);
+        }
+        u32 v[7];
+        for (int k = -2; k <= 3; k++) { const u32 e = gcm_io2ea(getoff + (u32)(k * 4)); v[k + 2] = e ? vm_read32(e) : 0; }
+        v[6] = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+        const int changed = i && memcmp(v, last, sizeof v);
+        if (!i || changed || i + 1 == sizeof at_us / sizeof at_us[0]) {
+            fprintf(stderr, "[fifo-watch] +%.1f ms: %08X %08X [%08X %08X] %08X %08X put=%08X head=%08X%s\n",
+                    (double)(gw_us() - now) / 1000.0, v[0], v[1], v[2], v[3], v[4], v[5], v[6], gw_head(),
+                    changed ? "  (changed)" : "");
+            changes += changed;
+        }
+        memcpy(last, v, sizeof v);
+    }
+    fprintf(stderr, "[fifo-watch] the words around the bad one %s in 200 ms\n", changes ? "changed" : "did not change");
+    /* The wait is not a new pass over these lines. */
+    const unsigned long long t_end = gw_us();
+    for (int k = -8; k <= 4; k += 4) {
+        gw_page* p = gw_page_of(getoff + (u32)(k * 4), 0);
+        const u32 li = ((getoff + (u32)(k * 4)) & 0xFFFFFu) >> 7;
+        if (p && p->line_us[li] && now - p->line_us[li] < GW_PASS_US) p->line_us[li] = t_end;
+    }
+}
+
+#endif
