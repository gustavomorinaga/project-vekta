diff --git a/tools/test_gcm_fifo_watch.py b/tools/test_gcm_fifo_watch.py
new file mode 100644
index 0000000..dcc98d8
--- /dev/null
+++ b/tools/test_gcm_fifo_watch.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""GCM_FIFO_WATCH (a diagnostic): a word below put that changes after the walker
+read it is reported, and at a bad word the pass before is kept
+(libs/video/tests/test_gcm_fifo_watch.c, which compiles cellGcmSys.c in)."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+if os.name == 'nt':
+    print('SKIP: the GCM watch fixture uses POSIX linking')
+    raise SystemExit(0)
+with tempfile.TemporaryDirectory(prefix='gcm-fifo-watch-') as tmp:
+    binary = Path(tmp) / 'test'
+    linker = ['-Wl,-dead_strip'] if sys.platform == 'darwin' else ['-Wl,--gc-sections', '-pthread', '-lm']
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu17', '-O1', '-UNDEBUG',
+                    '-ffunction-sections', '-fdata-sections',
+                    '-I' + str(root / 'include'), '-I' + str(root / 'libs/video'),
+                    str(root / 'libs/video/tests/test_gcm_fifo_watch.c'), *linker,
+                    '-o', str(binary)], check=True)
+    result = subprocess.run([str(binary)], timeout=30, capture_output=True, text=True)
+    print(result.stdout.strip())
+    if result.returncode:
+        print(result.stderr[-3000:])
+        raise SystemExit('test_gcm_fifo_watch failed')
