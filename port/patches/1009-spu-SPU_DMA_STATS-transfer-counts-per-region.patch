From 2e6bfe9578f1466b3c95c8335afe0c2f589e8936 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 00:31:36 -0300
Subject: [PATCH] spu: SPU_DMA_STATS transfer counts per region

---
 runtime/spu/spu_dma.h | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/runtime/spu/spu_dma.h b/runtime/spu/spu_dma.h
index 8c4ccaa8..22d83614 100644
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -15,6 +15,7 @@
 #ifndef SPU_DMA_H
 #define SPU_DMA_H
 
+#include <time.h>
 #include "spu_context.h"
 #include "../../include/ps3emu/log_first.h"
 #include "spu_coherency.h"
@@ -167,6 +168,25 @@ static inline int mfc_is_fence(uint32_t cmd)
  * Execute a single DMA transfer between local store and main memory.
  * Returns 0 on success, -1 on error.
  */
+/* SPU_DMA_STATS=1: GET/PUT counts and bytes per 4 s, by 256 MB region of the EA.
+ * Diagnostic only (unlocked counters). */
+static inline void spu_dma_stats_note(int put, uint32_t ea, uint32_t size)
+{
+    static int on = -1; if (on < 0) on = getenv("SPU_DMA_STATS") ? 1 : 0;
+    if (!on) return;
+    static unsigned long long n[2][16], b[2][16], t0;
+    n[put][ea >> 28]++; b[put][ea >> 28] += size;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const unsigned long long now = ts.tv_sec * 1000000000ull + ts.tv_nsec;
+    if (!t0) t0 = now;
+    if (now - t0 < 4000000000ull) return;
+    t0 = now;
+    for (int p = 0; p < 2; p++) for (int r = 0; r < 16; r++) if (n[p][r])
+        fprintf(stderr, "[dma-stats] %s ea=%X0000000: %llu xfers, %llu KB\n", p ? "PUT" : "GET", r, n[p][r], b[p][r] >> 10);
+    memset(n, 0, sizeof n); memset(b, 0, sizeof b);
+}
+#define SPU_DMA_STATS(put, ea, size) spu_dma_stats_note((put), (ea), (size))
+
 static inline int mfc_do_transfer(spu_context* spu, uint32_t lsa, uint64_t ea,
                                    uint32_t size, uint32_t cmd)
 {
@@ -597,6 +617,7 @@ static inline int mfc_do_transfer(spu_context* spu, uint32_t lsa, uint64_t ea,
           } }
         /* GET: main memory -> local store */
         memcpy(ls_ptr, ea_ptr, size);
+        SPU_DMA_STATS(0, (uint32_t)ea, size);
         /* SPU_STACKEA_WATCH (b): scan the just-loaded payload for a 0xD00Cxxxx
          * dword = the completion-word EA arriving in a job buffer. */
         { static int s_se = -1; if (s_se < 0) s_se = getenv("SPU_STACKEA_WATCH") ? 1 : 0;
@@ -717,6 +738,7 @@ static inline int mfc_do_transfer(spu_context* spu, uint32_t lsa, uint64_t ea,
             } else if (span_reserved) {
                 spu_lockline_lock();
                 memcpy(ea_ptr, ls_ptr, size);
+                SPU_DMA_STATS(1, (uint32_t)ea, size);
                 for (uint32_t a = a0; ; a += 128u) {
                     if (spu_coh_is_reserved(a)) spu_coh_notify_write_except(a, spu);
                     if (a == a1) break;
@@ -724,6 +746,7 @@ static inline int mfc_do_transfer(spu_context* spu, uint32_t lsa, uint64_t ea,
                 spu_lockline_unlock();
             } else {
                 memcpy(ea_ptr, ls_ptr, size);
+                SPU_DMA_STATS(1, (uint32_t)ea, size);
                 for (uint32_t a = a0; ; a += 128u) {
                     if (spu_coh_is_reserved(a)) {
                         spu_lockline_lock();
