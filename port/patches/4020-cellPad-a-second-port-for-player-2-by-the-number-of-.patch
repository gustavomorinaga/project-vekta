diff --git a/libs/input/pad_assign.h b/libs/input/pad_assign.h
new file mode 100644
index 0000000..21f693a
--- /dev/null
+++ b/libs/input/pad_assign.h
@@ -0,0 +1,50 @@
+/*
+ * Which controllers feed which PS3 port, from the controllers plugged in, the number of local players the title
+ * runs and the merged/separate choice. Pure (no SDL, no state), so a host test runs it.
+ *
+ * Slots are the backend's controller slots in their remembered order (a pad that reconnects gets its slot back).
+ * The keyboard and mouse always feed port 0 (player 1); this header decides only the pads.
+ *
+ *   1 player, merged:    every pad -> port 0 (today's behaviour)
+ *   1 player, separate:  slot n -> port n (today's behaviour)
+ *   2 players, 1 pad:    the pad -> port 1; port 0 is the keyboard and mouse alone
+ *   2 players, 2+ pads:  the first pad -> port 0 (with the keyboard and mouse), the second -> port 1, the rest none
+ *
+ * Connected, whatever the number of players (switching between 1 and 2 never plugs or unplugs a port): port 0
+ * always, port 1 whenever at least one pad is there, ports 2 and 3 while separate and their slot has a pad. A
+ * connected port that no pad feeds reads neutral: nothing pressed, sticks centred.
+ */
+#ifndef PAD_ASSIGN_H
+#define PAD_ASSIGN_H
+
+#define PA_PORTS 4
+
+typedef struct {
+    unsigned src[PA_PORTS];   /* bit s: slot s feeds this port */
+    int connected[PA_PORTS];
+} PadAssign;
+
+static inline void pad_assign(const int has[PA_PORTS], int players, int merged, PadAssign* a)
+{
+    int first = -1, second = -1, npads = 0;
+    unsigned all = 0;
+    for (int s = 0; s < PA_PORTS; s++) {
+        a->src[s] = 0;
+        if (!has[s]) continue;
+        all |= 1u << s;
+        if (first < 0) first = s; else if (second < 0) second = s;
+        npads++;
+    }
+    for (int p = 0; p < PA_PORTS; p++)
+        a->connected[p] = p == 0 || (p == 1 && npads > 0) || (!merged && has[p]);
+    if (players >= 2) {
+        if (second >= 0) { a->src[0] = 1u << first; a->src[1] = 1u << second; }
+        else if (first >= 0) a->src[1] = 1u << first;
+    } else if (merged) {
+        a->src[0] = all;
+    } else {
+        for (int s = 0; s < PA_PORTS; s++) if (has[s]) a->src[s] = 1u << s;
+    }
+}
+
+#endif
