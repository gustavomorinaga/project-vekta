From acf43005231e12b18a61f832b6c2cd510ac455bc Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 29 Oct 2026 03:15:38 -0300
Subject: [PATCH] Audio: 5.1 and 7.1 output,
 PS3RECOMP_AUDIO_CHANNELS=2|6|8

The host device opens with that many channels (SDL2: FL FR FC LFE SL/BL SR/BR
[BL BR SL SR]; WASAPI: WAVEFORMATEXTENSIBLE, masks 0x3F and 0x63F) and the
mix keeps an 8-channel port's channels: L R C LFE and the surround pair
as they are, the last pair as the 7.1 sides or folded into the surround
pair at -3 dB for 5.1. The audio out offers the title that many channels for
48 kHz LPCM and reports the configured mode in GetState/GetConfiguration
(it said stereo whatever was configured), which is what makes a title's own
mixer fill them: Killzone HD's MultiStream configures 6 channels and wrote
only L and R while the state said 2; with 6 it writes C and the surround
pair. Unset, nothing changes. AudioOutConfigure logs the request;
AUDIO_CHSTATS=1 logs an 8-channel port's levels.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/audio/cellAudio.c    | 86 +++++++++++++++++++++++++++++++--------
 libs/misc/cellAvconfExt.c | 35 ++++++++++++++--
 2 files changed, 101 insertions(+), 20 deletions(-)

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 50a43613..20d588d7 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -156,7 +156,13 @@ static int           s_mix_thread_live = 0;
 static mutex_t       s_audio_mutex;
 
 /* Output mix buffer (stereo, one block worth) */
-static float s_mix_buffer[CELL_AUDIO_BLOCK_SAMPLES * 2];
+/* The host's speakers: 2, 6 (5.1: FL FR FC LFE and the surround pair) or 8
+ * (7.1: FL FR FC LFE BL BR SL SR) -- PS3RECOMP_AUDIO_CHANNELS, read by the
+ * audio out (cellAvconfExt.c), which also tells the title. The mix buffer is
+ * interleaved at that count. */
+int cellAvconfExt_out_channels(void);
+static u32 s_out_ch = 2;
+static float s_mix_buffer[CELL_AUDIO_BLOCK_SAMPLES * 8];
 
 /* ---------------------------------------------------------------------------
  * Host audio output backend
@@ -179,11 +185,11 @@ static int audio_backend_init(void)
     memset(&want, 0, sizeof(want));
     want.freq     = CELL_AUDIO_SAMPLE_RATE;
     want.format   = AUDIO_F32SYS;
-    want.channels = 2;
+    want.channels = (Uint8)s_out_ch;
     want.samples  = CELL_AUDIO_BLOCK_SAMPLES;
     want.callback = NULL; /* We'll use SDL_QueueAudio */
 
-    s_sdl_audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+    s_sdl_audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);   /* SDL converts to the device's layout */
     if (s_sdl_audio_dev == 0) {
         printf("[cellAudio] SDL_OpenAudioDevice failed: %s\n", SDL_GetError());
         return -1;
@@ -205,7 +211,7 @@ static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
 {
     if (s_sdl_audio_dev) {
         SDL_QueueAudio(s_sdl_audio_dev, stereo_samples,
-                       num_samples * 2 * sizeof(float));
+                       num_samples * s_out_ch * sizeof(float));
     }
 }
 
@@ -213,7 +219,7 @@ static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
 static int audio_backend_room(void)
 {
     if (!s_sdl_audio_dev) return -1;
-    return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float)) <
+    return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (s_out_ch * sizeof(float)) <
            CELL_AUDIO_BLOCK_SAMPLES * 4 ? CELL_AUDIO_BLOCK_SAMPLES : 0;
 }
 
@@ -222,7 +228,7 @@ static void audio_backend_wait(void) { SDL_Delay(1); }
 static u32 audio_backend_queued_samples(void)
 {
     if (s_sdl_audio_dev) {
-        return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (2 * sizeof(float));
+        return SDL_GetQueuedAudioSize(s_sdl_audio_dev) / (s_out_ch * sizeof(float));
     }
     return 0;
 }
@@ -271,14 +277,28 @@ static int audio_backend_init(void)
         return -1;
     }
 
+    /* Float at the mix's channel count; 5.1 and 7.1 as WAVEFORMATEXTENSIBLE
+     * with the speaker mask whose order is the mix's (5.1: back pair). */
+    WAVEFORMATEXTENSIBLE wfxe;
+    memset(&wfxe, 0, sizeof wfxe);
+    WAVEFORMATEX* const pwfx = &wfxe.Format;
     WAVEFORMATEX wfx;
     wfx.wFormatTag      = WAVE_FORMAT_IEEE_FLOAT;
-    wfx.nChannels       = 2;
+    wfx.nChannels       = (WORD)s_out_ch;
     wfx.nSamplesPerSec  = CELL_AUDIO_SAMPLE_RATE;
     wfx.wBitsPerSample  = 32;
     wfx.nBlockAlign     = wfx.nChannels * (wfx.wBitsPerSample / 8);
     wfx.nAvgBytesPerSec = wfx.nSamplesPerSec * wfx.nBlockAlign;
     wfx.cbSize          = 0;
+    wfxe.Format = wfx;
+    if (s_out_ch > 2) {
+        static const GUID float_subtype = { 0x00000003, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 } };
+        wfxe.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+        wfxe.Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+        wfxe.Samples.wValidBitsPerSample = 32;
+        wfxe.dwChannelMask = s_out_ch == 6 ? 0x3Fu : 0x63Fu;   /* FL FR FC LFE BL BR (+ SL SR) */
+        wfxe.SubFormat = float_subtype;
+    }
 
     /* Event-driven, 60 ms by default (PS3_AUDIO_BUF_MS). The old 20 ms ran
      * dry whenever the mixing thread lost the CPU for a moment -- with every
@@ -304,14 +324,14 @@ static int audio_backend_init(void)
         s_wasapi_client,
         AUDCLNT_SHAREMODE_SHARED,
         AUDCLNT_STREAMFLAGS_EVENTCALLBACK | convert,
-        buf_duration, 0, &wfx, NULL);
+        buf_duration, 0, pwfx, NULL);
 
     if (FAILED(hr)) {
         /* Fallback: try without event callback */
         hr = s_wasapi_client->lpVtbl->Initialize(
             s_wasapi_client,
             AUDCLNT_SHAREMODE_SHARED,
-            convert, buf_duration, 0, &wfx, NULL);
+            convert, buf_duration, 0, pwfx, NULL);
         if (FAILED(hr)) {
             printf("[cellAudio] WASAPI Initialize failed: 0x%08lX\n", hr);
             s_wasapi_client->lpVtbl->Release(s_wasapi_client);
@@ -383,7 +403,7 @@ static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
          * path. For unattended runs. */
         static int mute = -1;
         if (mute < 0) mute = getenv("PS3_MUTE") ? 1 : 0;
-        memcpy(buf, stereo_samples, num_samples * 2 * sizeof(float));
+        memcpy(buf, stereo_samples, num_samples * s_out_ch * sizeof(float));
         s_wasapi_render->lpVtbl->ReleaseBuffer(s_wasapi_render, num_samples,
                                                mute ? AUDCLNT_BUFFERFLAGS_SILENT : 0);
     }
@@ -492,6 +512,30 @@ static void audio_mix_one_block(void)
                         p, (unsigned long long)port->read_index, block_idx, map);
             } } }
 
+        if (s_out_ch > 2) {   /* to the speakers: 8 channels L R C LFE (4 5) (6 7) */
+            const u32 oc = s_out_ch;
+            for (u32 s = 0; s < CELL_AUDIO_BLOCK_SAMPLES; s++) {
+                float* o = &s_mix_buffer[s * oc];
+                if (nch == 8) {
+                    for (u32 c = 0; c < 6; c++) o[c] += ld_be_f32(&src[s * 8 + c]) * level;
+                    const float a = ld_be_f32(&src[s * 8 + 6]) * level, b = ld_be_f32(&src[s * 8 + 7]) * level;
+                    if (oc == 8) { o[6] += a; o[7] += b; }
+                    else { o[4] += a * 0.707f; o[5] += b * 0.707f; }   /* 5.1: the sides into the surround pair */
+                } else if (nch >= 2) {
+                    o[0] += ld_be_f32(&src[s * nch + 0]) * level;
+                    o[1] += ld_be_f32(&src[s * nch + 1]) * level;
+                } else {
+                    const float m = ld_be_f32(&src[s]) * level;
+                    o[0] += m; o[1] += m;
+                }
+            }
+            memset(src, 0, CELL_AUDIO_BLOCK_SAMPLES * nch * sizeof(float));
+            port->read_index++;
+            if (port->read_idx_addr)
+                vm_write64((u32)port->read_idx_addr, port->read_index % nblock);
+            continue;
+        }
+
         for (u32 s = 0; s < CELL_AUDIO_BLOCK_SAMPLES; s++) {
             float left, right;
             if (nch >= 2) {
@@ -502,6 +546,14 @@ static void audio_mix_one_block(void)
                 left = right = ld_be_f32(&src[s]) * level;
             }
 
+            /* AUDIO_CHSTATS=1: each channel's level in 8-channel ports, every 1000 blocks */
+            if (nch == 8) { static int st = -1; static double e[8]; static unsigned n;
+              if (st < 0) st = getenv("AUDIO_CHSTATS") ? 1 : 0;
+              if (st) { for (u32 c = 0; c < 8; c++) { const float v = ld_be_f32(&src[s * 8 + c]); e[c] += (double)v * v; }
+                if (++n == CELL_AUDIO_BLOCK_SAMPLES * 1000) {
+                  fprintf(stderr, "[audio-ch] rms L %.4f R %.4f C %.4f LFE %.4f 4 %.4f 5 %.4f 6 %.4f 7 %.4f\n",
+                          sqrt(e[0] / n), sqrt(e[1] / n), sqrt(e[2] / n), sqrt(e[3] / n), sqrt(e[4] / n), sqrt(e[5] / n), sqrt(e[6] / n), sqrt(e[7] / n));
+                  memset(e, 0, sizeof e); n = 0; } } }
             /* If 7.1, mix center and other channels into stereo */
             if (nch == 8) {
                 float center = ld_be_f32(&src[s * 8 + 2]) * level * 0.707f;
@@ -534,7 +586,7 @@ static void audio_mix_one_block(void)
     mutex_unlock(&s_audio_mutex);
 
     /* Clip to [-1.0, 1.0] */
-    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * s_out_ch; i++) {
         if (s_mix_buffer[i] > 1.0f) s_mix_buffer[i] = 1.0f;
         if (s_mix_buffer[i] < -1.0f) s_mix_buffer[i] = -1.0f;
     }
@@ -614,7 +666,7 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
          * "is any port producing sound" is answerable (LBP Bink movie audio). */
         { static int _ap = -1; if (_ap < 0) _ap = getenv("AUDIO_PEAK") ? 1 : 0;
           if (_ap) { static unsigned _n = 0; float pk = 0.0f;
-            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * s_out_ch; i++) {
                 float a = s_mix_buffer[i]; if (a < 0) a = -a; if (a > pk) pk = a; }
             if ((++_n % 200) == 0 || (pk > 0.001f && _n < 40))
                 fprintf(stderr, "[audio-peak] block#%u peak=%.4f\n", _n, pk); } }
@@ -622,13 +674,13 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
          * (ffmpeg -f f32le -ar 48000 -ac 2 -i <file>). */
         { static FILE* _wf = (FILE*)-1;
           if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
-          if (_wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); }
+          if (_wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * s_out_ch, _wf); }
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         /* AUDIO_RATE=1: blocks mixed vs real time, and frames dropped. */
         { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
           if (on) { static ULONGLONG t0; static unsigned n, z; static unsigned long long d0, u0;
             ULONGLONG now = GetTickCount64(); if (!t0) t0 = now; n++;
-            { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
+            { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * s_out_ch; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
               if (!nz) z++; }
             if (now - t0 >= 5000) {
                 fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%, dropped %.0f frames/s, underruns %llu, device buf %u%c",
@@ -678,9 +730,9 @@ static void* audio_mix_thread_func(void* arg)
          * AUDIO_WAV=<file>: the mix as raw f32le stereo 48 kHz. */
         { static int on = -1; static FILE* wf;
           if (on < 0) { on = getenv("AUDIO_RATE") ? 1 : 0; const char* e = getenv("AUDIO_WAV"); wf = e ? fopen(e, "wb") : NULL; }
-          if (wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, wf);
+          if (wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * s_out_ch, wf);
           if (on) { static unsigned n, z; int nz = 0;
-            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
+            for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * s_out_ch; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
             n++; z += !nz;
             if (n == 937) { fprintf(stderr, "[audio-rate] silent %.1f%% of the last 5 s\n", 100.0 * z / n); n = z = 0; } } }
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
@@ -764,6 +816,8 @@ s32 cellAudioInit(void)
     memset(s_notify_queues, 0, sizeof(s_notify_queues));
     mutex_init(&s_audio_mutex);
 
+    { const int c = cellAvconfExt_out_channels(); s_out_ch = c ? (u32)c : 2u; }
+    if (s_out_ch > 2) printf("[cellAudio] output: %u channels\n", s_out_ch);
     if (audio_backend_init() < 0) {
         printf("[cellAudio] WARNING: Audio backend init failed, continuing silently\n");
         /* Don't fail -- games should still run without audio */
diff --git a/libs/misc/cellAvconfExt.c b/libs/misc/cellAvconfExt.c
index 2ab88b8e..47750783 100644
--- a/libs/misc/cellAvconfExt.c
+++ b/libs/misc/cellAvconfExt.c
@@ -32,8 +32,28 @@ static float s_gamma = 1.0f;
  * API implementations
  * -----------------------------------------------------------------------*/
 
+/* PS3RECOMP_AUDIO_CHANNELS=2|6|8: the speakers the host plays (cellAudio opens
+ * its device with as many). Set, it is also what the audio out offers the
+ * title (GetSoundAvailability for 48 kHz LPCM) and what its state reports once
+ * the title configures it, so a title's own mixer writes 5.1 or 7.1 into its
+ * port as on a console wired to such a receiver. Unset: stereo out, and the
+ * availability below unchanged. */
+int cellAvconfExt_out_channels(void)
+{
+    static int ch = -1;
+    if (ch < 0) {
+        const char* e = getenv("PS3RECOMP_AUDIO_CHANNELS");
+        ch = e ? atoi(e) : 0;
+        if (ch != 2 && ch != 6 && ch != 8) ch = 0;
+    }
+    return ch;
+}
+static u32 s_cfg_channel = CELL_AUDIO_OUT_CHNUM_2;   /* what the title configured */
+
 s32 cellAudioOutGetSoundAvailability(u32 audioOut, u32 type, u32 fs, u32 option)
 {
+    if (cellAvconfExt_out_channels() && type == CELL_AUDIO_OUT_CODING_TYPE_LPCM)
+        return (fs & CELL_AUDIO_OUT_FS_48KHZ) ? cellAvconfExt_out_channels() : CELL_AUDIO_OUT_CHNUM_2;
     (void)audioOut;
     (void)option;
 
@@ -121,7 +141,8 @@ s32 cellAudioOutGetConfiguration(u32 audioOut,
     config = GUEST_PTR(config, CellAudioOutConfiguration*);
 
     memset(config, 0, sizeof(CellAudioOutConfiguration));
-    config->channel = CELL_AUDIO_OUT_CHNUM_2;
+    config->channel = cellAvconfExt_out_channels() && s_cfg_channel <= (u32)cellAvconfExt_out_channels()
+                    ? (u8)s_cfg_channel : CELL_AUDIO_OUT_CHNUM_2;
     config->encoder = CELL_AUDIO_OUT_CODING_TYPE_LPCM;
 
     return CELL_OK;
@@ -150,7 +171,10 @@ s32 cellAudioOutGetState(u32 audioOut, u32 deviceIndex, void* state)
     vm_write8(ea + 3, 0);
     vm_write32(ea + 4, 0);                                  /* no down-mixer  */
     vm_write8(ea + 8, CELL_AUDIO_OUT_CODING_TYPE_LPCM);     /* soundMode      */
-    vm_write8(ea + 9, CELL_AUDIO_OUT_CHNUM_2);
+    {   /* the configured channels, when the host plays that many */
+        const u32 out = cellAvconfExt_out_channels();
+        vm_write8(ea + 9, out && s_cfg_channel <= out ? s_cfg_channel : CELL_AUDIO_OUT_CHNUM_2);
+    }
     vm_write8(ea + 10, CELL_AUDIO_OUT_FS_48KHZ);
     vm_write8(ea + 11, 0);
     vm_write32(ea + 12, 0);
@@ -218,7 +242,10 @@ float cellAvconfExt_display_gamma(void)
  * the title queries availability separately. NID 0x4692AB35. */
 s32 cellAudioOutConfigure(u32 audioOut, void* config, void* option, u32 waitForEvent)
 {
-    (void)config; (void)option; (void)waitForEvent;
-    printf("[cellAvconfExt] AudioOutConfigure(audioOut=%u) -> ok\n", audioOut);
+    (void)option; (void)waitForEvent;
+    const uint32_t ea = (uint32_t)(uintptr_t)config;
+    if (ea) s_cfg_channel = vm_read8(ea);
+    printf("[cellAvconfExt] AudioOutConfigure(audioOut=%u, channel=%u, encoder=%u, downMixer=%u) -> ok\n", audioOut,
+           ea ? vm_read8(ea) : 0u, ea ? vm_read8(ea + 1) : 0u, ea ? vm_read32(ea + 12) : 0u);
     return 0;
 }
