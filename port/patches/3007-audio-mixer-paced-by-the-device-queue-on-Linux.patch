From 0226e9c0d1ceb3deb5af7e40794dd8936151da54 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 23:02:19 -0300
Subject: [PATCH] audio: mixer paced by the device queue on Linux

The mixer produced blocks faster than SDL consumed them, so the queue
grew about 1 s every 20 s (7.7 s after 150 s): menu sounds came late.
Mix only when the device queue has room for a block; the queue now
stays at one block (21.3 ms). AUDIO_QUEUE=1 logs its depth.

---
 libs/audio/cellAudio.c | 30 +++++++++++++++++++++++-------
 1 file changed, 23 insertions(+), 7 deletions(-)

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 02b751b2..6bbfb0ac 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -654,17 +654,33 @@ static void* audio_mix_thread_func(void* arg)
     (void)arg;
     printf("[cellAudio] Mixing thread started\n");
 
+    /* Paced by the device's queue, as on Windows. The old loop mixed a block
+     * and slept 5 ms (2 ms below four queued blocks) whatever the device had
+     * left: a block is 5.33 ms, so it ran a little ahead and the queue grew
+     * without bound -- about a second of sound latency after two minutes in
+     * Killzone's menus, where every key press clicks. Keep about four blocks
+     * queued (~21 ms); with no device, pace on the clock. */
+    struct timespec t0; clock_gettime(CLOCK_MONOTONIC, &t0);
+    unsigned long long blocks = 0;
     while (s_mix_thread_running) {
+        const int room = audio_backend_room();
+        if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { usleep(1000); continue; }
+        if (room < 0) {
+            struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
+            const long long el = (now.tv_sec - t0.tv_sec) * 1000000000ll + (now.tv_nsec - t0.tv_nsec);
+            const long long due = (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * 1000000000ull / CELL_AUDIO_SAMPLE_RATE);
+            if (el < due) { usleep(1000); continue; }
+            if (el - due > 50000000ll) t0 = now, blocks = 0;   /* far behind: drop the backlog */
+        }
+        blocks++;
         audio_mix_one_block();
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         audio_notify_event_queues();
-
-        u32 queued = audio_backend_queued_samples();
-        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
-            usleep(5000);
-        } else {
-            usleep(2000);
-        }
+        /* AUDIO_QUEUE=1: the device queue (= output latency) every ~5 s. */
+        { static int on = -1; if (on < 0) on = getenv("AUDIO_QUEUE") ? 1 : 0;
+          if (on && blocks % 1000 == 0)
+              fprintf(stderr, "[audio-queue] %u samples (%.1f ms)\n", audio_backend_queued_samples(),
+                      audio_backend_queued_samples() * 1000.0 / CELL_AUDIO_SAMPLE_RATE); }
     }
 
     printf("[cellAudio] Mixing thread stopped\n");
-- 
