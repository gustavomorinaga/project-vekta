From c6f70aeae2c9f516841607aad7a5cac9dd190903 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 00:59:26 -0300
Subject: [PATCH] lv2: PS3_USLEEP_MAX_US caps guest sleeps (diagnostic)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 runtime/syscalls/sys_timer.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/runtime/syscalls/sys_timer.c b/runtime/syscalls/sys_timer.c
index 3a022815..b8ac7133 100644
--- a/runtime/syscalls/sys_timer.c
+++ b/runtime/syscalls/sys_timer.c
@@ -276,6 +276,14 @@ int64_t sys_timer_usleep(ppu_context* ctx)
         } while (qpc_now.QuadPart < qpc_deadline);
     }
 #else
+    /* PS3_USLEEP_MAX_US=<n>: cap a sleep at n us. A guest that polls a flag
+     * with usleep(100) between checks wakes up to a period late after the
+     * flag flips; a shorter nap is still a nap, so the loop is unchanged.
+     * (Diagnostic knob: a title that times something with usleep sees it run
+     * short.) */
+    { static long s_cap = -1;
+      if (s_cap < 0) { const char* e = getenv("PS3_USLEEP_MAX_US"); s_cap = e ? atol(e) : 0; }
+      if (s_cap > 0 && usec > (uint64_t)s_cap) usec = (uint64_t)s_cap; }
     if (usec > 0) {
         struct timespec ts;
         ts.tv_sec  = (time_t)(usec / 1000000);
-- 
