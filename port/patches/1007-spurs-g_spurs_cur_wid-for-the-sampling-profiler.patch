From 7ae726bafd89b5fd5129abdda675cf957bda108a Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 14 Oct 2026 22:59:06 -0300
Subject: [PATCH] spurs: g_spurs_cur_wid for the sampling profiler

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/spurs/cellSpurs.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 0431a37c..8a4f73f5 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -1733,6 +1733,9 @@ static WklPm* spurs_resolve_pm(u32 wid)
     return r->fn ? r : NULL;
 }
 
+/* The workload this thread is running a module of, -1 between modules. */
+__thread int g_spurs_cur_wid = -1;
+
 /* One persistent worker for each configured virtual SPU. A waiting policy
  * occupies only its own slot; a later runnable producer can use another slot.
  * Admission and lifecycle state are serialized per instance. Guest execution
@@ -1752,8 +1755,10 @@ static DWORD WINAPI spurs_pm_worker(LPVOID p)
             SleepConditionVariableSRW(&si->wake, &si->lock, INFINITE, 0);
         if (si->stopping && !slot->busy) break;
         ReleaseSRWLockExclusive(&si->lock);
+        g_spurs_cur_wid = (int)slot->wid;   /* for a port's sampling profiler */
         spu_run_policy_module(slot->fn, slot->image_id, slot->pm, slot->pm_size,
                               slot->data, slot->wid, slot->ea, slot->spu_num);
+        g_spurs_cur_wid = -1;
         extern SPU_THREAD_LOCAL volatile unsigned g_spurs_pm_polls;
         unsigned polls = g_spurs_pm_polls;
         AcquireSRWLockExclusive(&si->lock);
-- 
2.56.0

