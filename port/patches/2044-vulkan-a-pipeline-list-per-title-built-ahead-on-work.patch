From e9acda1967215be2850e29e319f285912e55566b Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 4 Nov 2026 04:35:55 -0300
Subject: [PATCH] vulkan: a pipeline list per title, built ahead on
 worker threads

Every pipeline variant the backend creates is appended to
<cache>/pipelines.list (shader hashes, topology, render state, target
formats). At the first draw of a run the list is read and
PS3RECOMP_VK_PREWARM worker threads (default 2, 0 records only) build
every entry at low priority. A draw that needs a listed pipeline takes
it built, builds it itself when no worker got to it, or waits for the
worker building it; nothing is skipped. VK_ENG_MAX_PIPE goes to 2048.

RSX_PIPE_STATS=1 logs what each new pipeline and variant cost the RSX
thread. Level 7 route with the driver cache and pipelines.bin deleted:
147 of 149 variants built ahead in 0.7 s, 1 waited for (15 ms), against
about 2.6 s of driver builds on the RSX thread without the list.

---
 libs/video/rsx_draw_engine.c    |  20 ++
 libs/video/rsx_vulkan_backend.c | 313 +++++++++++++++++++++++++++++---
 2 files changed, 309 insertions(+), 24 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 360458b7..b1967422 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -331,6 +331,20 @@ static u64 eng_vp_hash(const u8* uc, u32 bytes, u64 seed)
     return m->hash;
 }
 
+/* RSX_PIPE_STATS=1: one line for each pipeline built mid-frame and what it
+ * cost the RSX thread (the hitch a first sight of a program is). */
+static int eng_pipe_stats_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_PIPE_STATS"); on = e && *e && *e != '0'; }
+    return on;
+}
+static u64 eng_now_ns(void)
+{
+    struct timespec a; clock_gettime(CLOCK_MONOTONIC, &a);
+    return (u64)a.tv_sec * 1000000000ull + (u64)a.tv_nsec;
+}
+
 static u32 eng_pipeline_slot(u64 key)
 {
     return (u32)((key ^ (key >> 29)) * 0x9E3779B97F4A7C15ull >> 40) & (ENG_PIPELINE_INDEX - 1u);
@@ -2253,6 +2267,7 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
     }
     if (g.n_pipelines >= ENG_MAX_PIPELINES) return 0;
 
+    const u64 miss_t0 = eng_pipe_stats_on() ? eng_now_ns() : 0;
     u32 handle = 0;
     int vi = 1, fi = 1;
     u32 nconst = 0;
@@ -2352,6 +2367,11 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
                 vi, fi, nconst, (unsigned long long)fp_hash,
                 handle ? "ok" : "FAILED (draw dropped)"); }
 
+    if (miss_t0) {
+        const u64 t1 = eng_now_ns();
+        fprintf(stderr, "[rsx pipe] %.3f s: new pipeline %u (%u so far) %.2f ms (decompile + backend create)\n",
+                t1 / 1e9, handle, g.n_pipelines + 1u, (t1 - miss_t0) / 1e6);
+    }
     g.pipelines[g.n_pipelines].key = key;
     g.pipelines[g.n_pipelines].fp_hash = fp_hash;
     g.pipelines[g.n_pipelines].handle = handle;
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index fff0c355..70c1166f 100644
--- a/libs/video/rsx_vulkan_backend.c
