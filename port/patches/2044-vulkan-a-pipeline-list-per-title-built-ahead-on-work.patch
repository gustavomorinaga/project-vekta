     const char* dir = vk_cache_dir();
     char path[600] = "";
     if (dir) {
@@ -4297,6 +4303,7 @@ static int vk_eng_translate(const char* hlsl, int stage, VkShaderModule* out)
         u64 h = (1469598103934665603ull ^ (VK_CACHE_VERSION + (inv ? 0u : 0x100u))) + (u64)stage;
         for (const unsigned char* c = (const unsigned char*)hlsl; *c; c++) { h ^= *c; h *= 1099511628211ull; }
