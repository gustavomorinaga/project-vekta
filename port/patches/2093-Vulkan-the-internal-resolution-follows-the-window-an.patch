diff --git a/libs/video/rsx_fit_scale.h b/libs/video/rsx_fit_scale.h
index 07a7826..f177dad 100644
--- a/libs/video/rsx_fit_scale.h
+++ b/libs/video/rsx_fit_scale.h
@@ -38,6 +38,22 @@ static inline void rsx_fit_axes(int w, int h, unsigned gw, unsigned gh, float k,
     *sy = (float)h / (float)gh * k;
     if (!fill) *sx = *sy = *sx < *sy ? *sx : *sy;
 }
+/* The scale a window gives (PS3RECOMP_VK_SCALE_FIT): the forced aspect's box (0: the window), fit or fill
+ * times k, then 10 % smaller at a time until a gw x gh frame fits max_dim, the device's largest image. At
+ * start (from the window) and again whenever the window's size or k changes (from the swapchain). */
+static inline void rsx_fit_scale(int w, int h, float aspect, unsigned gw, unsigned gh, float k, int fill,
+                                 unsigned max_dim, float* sx, float* sy)
+{
+    rsx_aspect_box(w, h, aspect, &w, &h);
+    rsx_fit_axes(w, h, gw, gh, k, fill, sx, sy);
+    while ((float)gw * *sx > (float)max_dim || (float)gh * *sy > (float)max_dim) { *sx *= 0.9f; *sy *= 0.9f; }
+}
+/* A guest size v at scale s: the side of the image a target of v is drawn in, at least 1. */
+static inline unsigned rsx_scale_dim(unsigned v, float s)
+{
+    const unsigned r = (unsigned)((float)v * s + 0.5f);
+    return r ? r : 1u;
+}
 /* The picture's size in a w x h window: the forced aspect's box (or the
  * window) first; a stretched frame fills it, any other keeps the guest
  * frame's gw x gh shape inside it (a 2D screen, 16:9 with bars, stays in
