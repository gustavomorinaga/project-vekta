+/* A pixel program reading the window position (WPOS) with it in the guest's
+ * pixels: the target is s_rscale_x by s_rscale_y times larger. NULL (nothing
+ * to change) unscaled or without one; else malloc'd. */
+static char* vk_eng_wpos_scaled(const char* ps_hlsl)
+{
+    if (!vk_scaled() || !strstr(ps_hlsl, "input.position")) return NULL;
+    char with[128];
+    snprintf(with, sizeof with, "float4(input.position.xy * float2(%.9g, %.9g), input.position.zw)",
+             1.0 / s_rscale_x, 1.0 / s_rscale_y);
+    size_t n = 0; for (const char* q = ps_hlsl; (q = strstr(q, "input.position")); q += 14) n++;
+    char* scaled_ps = (char*)malloc(strlen(ps_hlsl) + n * strlen(with) + 1);
+    if (!scaled_ps) return NULL;
+    char* d = scaled_ps; const char* q = ps_hlsl; const char* hit;
+    while ((hit = strstr(q, "input.position"))) {
+        memcpy(d, q, (size_t)(hit - q)); d += hit - q;
+        strcpy(d, with); d += strlen(with); q = hit + 14;
+    }
+    strcpy(d, q);
+    return scaled_ps;
+}
