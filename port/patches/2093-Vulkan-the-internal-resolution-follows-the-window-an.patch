+/* A pipeline whose pixel program reads WPOS, made at another scale than now
+ * (vk_rescale dropped its fs, fsv and VkPipelines with the device idle): its
+ * pixel modules again, at this scale. 0 when its fs is usable. */
+static int vk_eng_pipe_wpos(vk_eng_pipe* P)
+{
+    if (!P->wpos_ps || (P->wsx == s_rscale_x && P->wsy == s_rscale_y)) return P->fs ? 0 : -1;
+    P->wsx = s_rscale_x; P->wsy = s_rscale_y;   /* one try per scale */
+    char* sp = vk_eng_wpos_scaled(P->wpos_ps);
+    const char* ps = sp ? sp : P->wpos_ps;
+    if (vk_eng_translate(ps, RSX_SHADER_STAGE_FRAGMENT, &P->fs, &P->ps_h)) { P->fs = VK_NULL_HANDLE; free(sp); return -1; }
+    if (P->vsv) {   /* its velocity variant's pixel program comes from the same source */
