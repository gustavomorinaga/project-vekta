From d1bd7689d9b3db0c4482f9f5aff1dfad74701654 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 12 Nov 2026 22:00:35 -0300
Subject: [PATCH 1/3] Vulkan: a depth target read as A8R8G8B8 carries its
 stencil byte

The depth pack (vulkan/rsx_vk_depth_pack.comp, behind depth_as_color) wrote
the stencil byte of the Z24S8 word as 0. Killzone HD's glow source is a
640x360 pass that multiplies its glow texture by exactly that byte (.z of the
depth target sampled as A8R8G8B8): the title's glow sprites write stencil 255
(ALWAYS, ref 255, REPLACE on depth pass), so with 0 the glow was black
everywhere, on the GPU and the SPU paths alike.

When the device's depth format has a stencil aspect (D32_SFLOAT_S8_UINT),
the stencil aspect is copied after the depth floats in the same buffer
(vk_pack_copy, vk_pack_size) and the shader puts it in the B byte; without
one the byte stays 0 as before. Written from the RSX's Z24S8 layout (depth in
the top 24 bits, stencil in the low byte); no RPCS3 code was read for it.
---
 libs/video/rsx_vulkan_backend.c               |  33 ++--
 libs/video/vulkan/rsx_vk_depth_pack.comp      |  18 +-
 .../video/vulkan/rsx_vk_depth_pack_comp.spv.h | 162 ++++++++++--------
 3 files changed, 125 insertions(+), 88 deletions(-)

diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index f2268df..dc5f7b1 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3629,7 +3629,7 @@ static int vk_pack_init(void)
     VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
                                             .bindingCount = 2, .pBindings = b };
     if (pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_pack.dsl) != VK_SUCCESS) return -1;
-    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 8 };
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 12 };
     VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
                                        .setLayoutCount = 1, .pSetLayouts = &s_pack.dsl,
                                        .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
@@ -3677,6 +3677,21 @@ static int vk_create_device_buffer(vk_buffer* b, VkDeviceSize size, VkBufferUsag
     return 0;
 }
 
+/* The pack's input: the depth aspect as floats and, when the target has one,
+ * the stencil aspect's bytes after them (word offset returned, 0 for none).
+ * The buffer holds w * h * 4 + w * h bytes (vk_pack_size). */
+static VkDeviceSize vk_pack_size(u32 w, u32 h) { return (VkDeviceSize)w * h * 4u + (((VkDeviceSize)w * h + 3u) & ~(VkDeviceSize)3u); }
+static u32 vk_pack_copy(VkImage zimg, VkBuffer buf, u32 w, u32 h)
+{
+    VkBufferImageCopy region[2] = {
+        { .imageSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 }, .imageExtent = { w, h, 1 } },
+        { .bufferOffset = (VkDeviceSize)w * h * 4u,
+          .imageSubresource = { VK_IMAGE_ASPECT_STENCIL_BIT, 0, 0, 1 }, .imageExtent = { w, h, 1 } } };
+    const int st = (s_vk.depth_aspect & VK_IMAGE_ASPECT_STENCIL_BIT) != 0;
+    pvkCmdCopyImageToBuffer(s_vk.cmd, zimg, VK_IMAGE_LAYOUT_GENERAL, buf, st ? 2u : 1u, region);
+    return st ? w * h : 0u;
+}
+
 static u32 vk_eng_depth_packed(void* user, u32 depth, u32 remap, u32 rsx_fmt)
 {
     (void)user;
@@ -3703,7 +3718,7 @@ static u32 vk_eng_depth_packed(void* user, u32 depth, u32 remap, u32 rsx_fmt)
         if (vk_create_image(&t->im, VK_FORMAT_R8G8B8A8_UNORM, w, h,
                             VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT,
                             VK_IMAGE_ASPECT_COLOR_BIT) ||
-            vk_create_device_buffer(&buf, (VkDeviceSize)w * h * 4u,
+            vk_create_device_buffer(&buf, vk_pack_size(w, h),
                                     VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT) ||
             pvkAllocateDescriptorSets(s_vk.device, &ai, &set) != VK_SUCCESS) {
             vk_destroy_image(&t->im); memset(t, 0, sizeof *t);
@@ -3735,9 +3750,7 @@ static u32 vk_eng_depth_packed(void* user, u32 depth, u32 remap, u32 rsx_fmt)
     if (vk_batch_reserve(0)) return 0;
     vk_eng_obj* t = &s_eobj[s_pack.e[i].tex];
     vk_barrier_image(z->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
-    VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 },
-                                 .imageExtent = { w, h, 1 } };
-    pvkCmdCopyImageToBuffer(s_vk.cmd, z->im.img, VK_IMAGE_LAYOUT_GENERAL, s_pack.e[i].buf.buf, 1, &region);
+    const u32 stencil_at = vk_pack_copy(z->im.img, s_pack.e[i].buf.buf, w, h);
     VkBufferMemoryBarrier bb = {
         .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_SHADER_READ_BIT,
@@ -3749,7 +3762,7 @@ static u32 vk_eng_depth_packed(void* user, u32 depth, u32 remap, u32 rsx_fmt)
     pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_pack.pipe);
     pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_pack.layout, 0, 1,
                              &s_pack.e[i].set, 0, NULL);
-    const u32 pc[2] = { w, h };
+    const u32 pc[3] = { w, h, stencil_at };
     pvkCmdPushConstants(s_vk.cmd, s_pack.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
     pvkCmdDispatch(s_vk.cmd, (w + 15u) / 16u, (h + 15u) / 16u, 1);
     vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
@@ -4615,7 +4628,7 @@ static u32 vk_eng_depth_as_color(void* user, u32 depth, u32 w, u32 h, u32 rsx_fm
     if (!hd) return 0;
     z = vk_eng_get(depth, VK_ENG_DEPTH);
     vk_eng_obj* t = &s_eobj[hd];
-    const VkDeviceSize need = (VkDeviceSize)z->w * z->h * 4u;
+    const VkDeviceSize need = vk_pack_size(z->w, z->h);
     if (!s_dac[hd].set || s_dac[hd].buf.size < need) {
         if (s_dac[hd].set) { t->pooled = 1; return 0; }   /* a bigger target than this object's buffer */
         VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
@@ -4638,9 +4651,7 @@ static u32 vk_eng_depth_as_color(void* user, u32 depth, u32 w, u32 h, u32 rsx_fm
     }
     if (vk_batch_reserve(0)) { t->pooled = 1; return 0; }
     vk_barrier_image(z->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
-    VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 },
-                                 .imageExtent = { z->w, z->h, 1 } };
-    pvkCmdCopyImageToBuffer(s_vk.cmd, z->im.img, VK_IMAGE_LAYOUT_GENERAL, s_dac[hd].buf.buf, 1, &region);
+    const u32 stencil_at = vk_pack_copy(z->im.img, s_dac[hd].buf.buf, z->w, z->h);
     VkBufferMemoryBarrier bb = {
         .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_SHADER_READ_BIT,
@@ -4652,7 +4663,7 @@ static u32 vk_eng_depth_as_color(void* user, u32 depth, u32 w, u32 h, u32 rsx_fm
     pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_pack.pipe);
     pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_pack.layout, 0, 1,
                              &s_dac[hd].set, 0, NULL);
-    const u32 pc[2] = { z->w, z->h };   /* the buffer's row length; texels past w x h fall outside the image */
+    const u32 pc[3] = { z->w, z->h, stencil_at };   /* the buffer's row length; texels past w x h fall outside the image */
     pvkCmdPushConstants(s_vk.cmd, s_pack.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
     pvkCmdDispatch(s_vk.cmd, (iw + 15u) / 16u, (ih + 15u) / 16u, 1);
     vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
diff --git a/libs/video/vulkan/rsx_vk_depth_pack.comp b/libs/video/vulkan/rsx_vk_depth_pack.comp
index e13313f..dcb82a6 100644
--- a/libs/video/vulkan/rsx_vk_depth_pack.comp
+++ b/libs/video/vulkan/rsx_vk_depth_pack.comp
@@ -1,21 +1,27 @@
 #version 450
 // A depth target as the A8R8G8B8 texture a title reads its bytes as: the
-// guest word is (round(z * 0xFFFFFF) << 8) | stencil (0 here), big-endian, and
-// the engine's ARGB8 upload turns bytes A,R,G,B into R,G,B,A. The same values
+// guest word is (round(z * 0xFFFFFF) << 8) | stencil, big-endian, and the
+// engine's ARGB8 upload turns bytes A,R,G,B into R,G,B,A. The same values
 // rsx_draw_engine.c's eng_zdepth_to_guest stores, without the round trip.
+// The buffer holds the depth aspect (32-bit floats, w x h) and, when the target
+// has a stencil aspect, its bytes after them from word pc.stencil_at (0: none,
+// the byte reads 0). Killzone HD's glow source (a 640x360 pass, the glow texture
+// times this byte) needs the stencil its glow sprites write (ref 255, REPLACE).
 layout(local_size_x = 16, local_size_y = 16) in;
-layout(std430, set = 0, binding = 0) readonly buffer Depth { float d[]; };
+layout(std430, set = 0, binding = 0) readonly buffer Depth { uint d[]; };
 layout(set = 0, binding = 1, rgba8) uniform writeonly image2D packed_out;
-layout(push_constant) uniform Size { uint w; uint h; } pc;
+layout(push_constant) uniform Size { uint w; uint h; uint stencil_at; } pc;
 
 void main()
 {
     uvec2 p = gl_GlobalInvocationID.xy;
     if (p.x >= pc.w || p.y >= pc.h) return;
-    precise float z = clamp(d[p.y * pc.w + p.x], 0.0, 1.0);
+    const uint i = p.y * pc.w + p.x;
+    precise float z = clamp(uintBitsToFloat(d[i]), 0.0, 1.0);
     precise float s = z * 16777215.0;
     precise float r = s + 0.5;
     uint v = uint(r);
+    const uint st = pc.stencil_at != 0u ? (d[pc.stencil_at + (i >> 2)] >> (8u * (i & 3u))) & 255u : 0u;
     imageStore(packed_out, ivec2(p),
-               vec4(float((v >> 8) & 255u), float(v & 255u), 0.0, float(v >> 16)) / 255.0);
+               vec4(float((v >> 8) & 255u), float(v & 255u), float(st), float(v >> 16)) / 255.0);
 }
