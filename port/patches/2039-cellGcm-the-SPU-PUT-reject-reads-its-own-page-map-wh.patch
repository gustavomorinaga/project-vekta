From 698688b804eaf7cdc369a09d4412f3b7c1e7ba1c Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Fri, 30 Oct 2026 21:27:01 +0000
Subject: [PATCH] cellGcm: the SPU PUT reject reads its own page map, which
 unmaps never clear

Patch 2008 rejected an EA whose page in the offset table reads unmapped. An
unmap clears the pages of the mapping it removes, also those an overlapping
mapping still covers, so a PUT into the overlap was taken as not IO-mapped.
ps3recomp's test_gcm_ea2io_range (two overlapping ranges, the first unmapped)
failed on that. The reject now reads a map of the 1 MB pages any mapping has
covered since the tables were last reset (unaligned starts included), so it
only skips EAs the scan could never match. test_gcm_io_mappings, which
compiles populate_offset_table on its own, declares the map.
---
 libs/video/cellGcmSys.c       | 20 +++++++++++++++++---
 tools/test_gcm_io_mappings.py |  1 +
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 22411b8..f115125 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -213,6 +213,11 @@ static CellGcmControl s_control;
 uint32_t ppu_hle_inject_base = 0x20000000u;
 
 static u16 s_io_address_table[65536];
+/* 1 MB EA pages that any IO mapping has covered since the tables were last
+ * reset, never cleared by an unmap: gcm_ea2io_range rejects an EA on it
+ * before scanning the mappings. The offset table cannot answer that, since
+ * an unmap clears pages that an overlapping mapping still covers. */
+static u8 s_io_ea_seen[65536];
 static u16 s_ea_address_table[65536];
 
 #define GCM_OFFSET_TABLE_PAGES   4096u                 /* 4 GiB / 1 MiB       */
@@ -433,6 +438,11 @@ static void populate_offset_table(u32 ea, u32 io, u32 size)
     u32 ea_page = ea >> 20;
     u32 io_page = io >> 20;
 
+    if (size) {   /* every page the range touches, an unaligned start included */
+        const u64 last = ((u64)ea + size - 1u) >> 20;
+        for (u64 p = ea_page; p <= last && p < 65536u; p++) s_io_ea_seen[p] = 1;
+    }
+
     for (u32 i = 0; i < pages && (ea_page + i) < 65536 && (io_page + i) < 65536; i++) {
         s_io_address_table[ea_page + i] = (u16)(io_page + i);
         s_ea_address_table[io_page + i] = (u16)(ea_page + i);
@@ -524,6 +534,7 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
     s_report_dma = 0xFEED0000u;
     memset(s_labels, 0, sizeof(s_labels));
     memset(s_io_address_table, 0xFF, sizeof(s_io_address_table));
+    memset(s_io_ea_seen, 0, sizeof(s_io_ea_seen));
     memset(s_ea_address_table, 0xFF, sizeof(s_ea_address_table));
 
     /*
@@ -543,6 +554,7 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
      * this every unmapped EA page silently aliased io page 0 (and vice versa),
      * producing plausible-but-wrong offsets instead of a translation failure. */
     memset(s_io_address_table, 0xFF, sizeof(s_io_address_table));
+    memset(s_io_ea_seen, 0, sizeof(s_io_ea_seen));
     memset(s_ea_address_table, 0xFF, sizeof(s_ea_address_table));
     s_current_display_buffer_id = 0;
     s_flip_handler = NULL;
@@ -1714,12 +1726,12 @@ static int s_spu_blk_w = 0;
 static u32 gcm_ea2io_range(u32 ea, u32* room)
 {
     /* Called for every SPU PUT, and nearly all of them are not IO-mapped:
-     * reject those on the 1 MB page table first (scanning the mappings for
-     * each cost Killzone HD 3% of its SPU time). The table has
+     * reject those on the 1 MB pages no mapping has covered first (scanning
+     * the mappings for each cost Killzone HD 3% of its SPU time). The table has
      * CELL_GCM_MAX_IO_MAPPINGS slots and a title uses a handful, all below
      * the high-water mark; the first match in slot order is the one a full
      * scan returns. */
-    if (s_io_address_table[(ea >> 20) & 0xFFFFu] == 0xFFFFu) return 0xFFFFFFFFu;
+    if (!s_io_ea_seen[(ea >> 20) & 0xFFFFu]) return 0xFFFFFFFFu;
     const int n = __atomic_load_n(&s_io_mapping_hw, __ATOMIC_RELAXED);
     for (int i = 0; i < n; i++) {
         IoMapping* m = &s_io_mappings[i];
@@ -4351,6 +4363,7 @@ void cellGcmTerminate(void)
     s_report_dma = 0xFEED0000u;
     memset(s_labels, 0, sizeof(s_labels));
     memset(s_io_address_table, 0xFF, sizeof(s_io_address_table));
+    memset(s_io_ea_seen, 0, sizeof(s_io_ea_seen));
     memset(s_ea_address_table, 0xFF, sizeof(s_ea_address_table));
 
     s_flip_handler     = NULL;
@@ -4365,6 +4378,7 @@ void cellGcmTerminate(void)
      * this every unmapped EA page silently aliased io page 0 (and vice versa),
      * producing plausible-but-wrong offsets instead of a translation failure. */
     memset(s_io_address_table, 0xFF, sizeof(s_io_address_table));
+    memset(s_io_ea_seen, 0, sizeof(s_io_ea_seen));
     memset(s_ea_address_table, 0xFF, sizeof(s_ea_address_table));
     s_current_display_buffer_id = 0;
     s_last_flip_time = 0;
diff --git a/tools/test_gcm_io_mappings.py b/tools/test_gcm_io_mappings.py
index 10a24bf..ccb5245 100644
--- a/tools/test_gcm_io_mappings.py
+++ b/tools/test_gcm_io_mappings.py
@@ -79,6 +79,7 @@ static u32 rd32(u32 a) { return (u32)mem[a] << 24 | mem[a + 1] << 16 | mem[a + 2
 static int s_gcm_initialized = 0;
 static u16 s_ea_address_table[65536];   /* IO page -> EA page, 0xFFFF = free */
 static u16 s_io_address_table[65536];   /* EA page -> IO page */
+static u8 s_io_ea_seen[65536];          /* EA pages any mapping covered (the SPU PUT reject) */
 static int io_pages_used(void)
 {
     int n = 0;
