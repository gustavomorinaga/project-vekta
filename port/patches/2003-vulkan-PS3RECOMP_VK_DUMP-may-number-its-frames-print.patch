From 6a45e9c8015beeb9338ff934a085f4d48473c2c3 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 14 Oct 2026 02:53:14 -0300
Subject: [PATCH] vulkan: PS3RECOMP_VK_DUMP may number its frames (printf
 conversion in the path)

---
 libs/video/rsx_vulkan_backend.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index db64302e..cb422e75 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -1952,8 +1952,12 @@ static void vk_present_window(void)
 
 static void vk_dump_ppm(const unsigned char* rgba)
 {
-    FILE* f = fopen(s_vk.dump_path, "wb");
-    if (!f) { VK_LOG("cannot open %s for the frame dump\n", s_vk.dump_path); return; }
+    /* A path with a printf conversion (frame%06u.ppm) keeps every dump, numbered
+     * by present; without one each dump overwrites the last. */
+    char path[1024];
+    snprintf(path, sizeof path, s_vk.dump_path, (unsigned)s_vk.presented);
+    FILE* f = fopen(path, "wb");
+    if (!f) { VK_LOG("cannot open %s for the frame dump\n", path); return; }
     fprintf(f, "P6\n%u %u\n255\n", s_vk.width, s_vk.height);
     for (size_t i = 0; i < (size_t)s_vk.width * s_vk.height; i++)
         fwrite(rgba + i * 4, 1, 3, f);
-- 
2.56.0

