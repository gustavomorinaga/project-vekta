From 9808818d149414529811bc6c4581dd4816c4d47e Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 20 Oct 2026 15:58:09 -0300
Subject: [PATCH] RSX engine: alpha test enable and function as the
 hardware reads them; alpha to coverage

SET_ALPHA_TEST_ENABLE is on for any non-zero value and SET_ALPHA_FUNC is
read by its low bits: Killzone HD writes 0xC and 0x10004 (GREATER, ref 4)
for its foliage cards. Taken as bit 0 and a GL enum, the test was off and
every leaf card drew as an opaque quad (its park, Level 1's bushes).
Alpha to coverage (anti-aliasing control bit 4) with single-sample targets
is drawn as the alpha test it stands for, at 0.5.
Diagnostics: RSX_ENGINE_PS_DEBUG=5 shows the output's alpha as grey,
RSX_ENGINE_STATE_LOG=<pipeline> logs a pipeline's raw state registers.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/rsx_draw_engine.c | 44 +++++++++++++++++++++++++++++++-----
 libs/video/rsx_draw_engine.h |  1 +
 2 files changed, 39 insertions(+), 6 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index c1f5623b..c00a8cde 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -64,6 +64,7 @@ extern u32 ppu_vm_size;
 #define M_ALPHA_TEST_ENABLE   0x0304
 #define M_ALPHA_FUNC          0x0308
 #define M_ALPHA_REF           0x030C
+#define M_ANTI_ALIASING_CONTROL 0x1D7C
 #define M_BLEND_ENABLE        0x0310
 #define M_BLEND_SFACTOR       0x0314
 #define M_BLEND_DFACTOR       0x0318
@@ -319,9 +320,24 @@ void rsx_draw_engine_decode_render_state(const rsx_dispatch* rsx,
                                          rsx_be_render_state* rs)
 {
     memset(rs, 0, sizeof(*rs));
-    rs->alpha_test_enable = rsx_dsp_reg(rsx, M_ALPHA_TEST_ENABLE) & 1;
-    rs->alpha_func   = rsx_dsp_reg(rsx, M_ALPHA_FUNC);
+    /* Any non-zero value enables it, and the function's low bits are what
+     * the hardware reads: Killzone HD writes 0xC and 0x10004 (GREATER) for
+     * its foliage cards, whose alpha is 0 around every leaf. Read as bit 0
+     * and a GL enum, the test was off and the cards drew as opaque quads. */
+    rs->alpha_test_enable = rsx_dsp_reg(rsx, M_ALPHA_TEST_ENABLE) != 0;
+    { const u32 f = rsx_dsp_reg(rsx, M_ALPHA_FUNC);
+      rs->alpha_func = (f & 0xFu) < 8u ? 0x0200u | (f & 0xFu) : f; }
     rs->alpha_ref_raw = rsx_dsp_reg(rsx, M_ALPHA_REF);
+    /* Alpha to coverage (anti-aliasing control bit 4) turns a texture's alpha
+     * into the share of the pixel's samples written: cut-out foliage and
+     * fences are drawn with it and no alpha test. The targets here have one
+     * sample, so it becomes the alpha test it stands for, at 0.5; without it
+     * every leaf card drew as an opaque quad (Killzone HD's park). */
+    if ((rsx_dsp_reg(rsx, M_ANTI_ALIASING_CONTROL) & 0x10u) && !rs->alpha_test_enable) {
+        rs->alpha_test_enable = 1;
+        rs->alpha_func = 0x0206;   /* GEQUAL */
+        rs->alpha_to_coverage = 1;
+    }
     rsx_dsp_surface sf;
     rsx_dsp_get_surface(rsx, &sf);
     rs->alpha_ref_format = sf.color_format;
@@ -2122,16 +2138,18 @@ static u32 eng_pipeline_get(const rsx_vertex_layout_plan* layout,
             fi = -1;
     }
     /* RSX_ENGINE_PS_DEBUG: 1 magenta, 2 |tc0|, 3 the program's r0 unguarded,
-     * 4 tc2 as colour -- where a guest pixel program's colour goes missing. */
+     * 4 tc2 as colour, 5 the output's alpha as grey -- where a guest pixel
+     * program's colour (or transparency) goes missing. */
     { const char* e = getenv("RSX_ENGINE_PS_DEBUG"); char* at;
       if (!fixed && fi > 0 && e && (at = strstr(s_ps_hlsl, "    return _out;"))) {
           static const char* const k[] = { "",
               "    _out.t0 = float4(1,0,1,1);\n",
               "    _out.t0 = float4(abs(input.tc0.xyz), 1);\n",
               "    _out.t0 = float4(r[0].xyz, 1);\n",
-              "    _out.t0 = float4(frac(input.tc2.xy), 0, 1);\n" };
+              "    _out.t0 = float4(frac(input.tc2.xy), 0, 1);\n",
+              "    _out.t0 = float4(_out.t0.www, 1);\n" };
           const int m = atoi(e);
-          if (m > 0 && m < 5) {
+          if (m > 0 && m < 6) {
               char tail[64]; snprintf(tail, sizeof tail, "%s", at);
               snprintf(at, sizeof s_ps_hlsl - (size_t)(at - s_ps_hlsl), "%s%s", k[m], tail);
           } } }
@@ -3229,7 +3247,9 @@ static void sink_end(void* user, const rsx_dispatch* r)
     if (g.fp_constants.count)
         memcpy(g.fp_cb, g.fp_constants.values, g.fp_constants.count * 16u);
     { float* alpha = (float*)(g.fp_cb + nslots * 16u);
-      alpha[0] = rsx_fp_alpha_ref(rs.alpha_ref_raw, rs.alpha_ref_format);
+      alpha[0] = rs.alpha_to_coverage ? 0.5f : rsx_fp_alpha_ref(rs.alpha_ref_raw, rs.alpha_ref_format);
+      if (rs.alpha_to_coverage) { static int said;
+          if (!said++) fprintf(stderr, "[rsx engine] alpha to coverage drawn as an alpha test at 0.5\n"); }
       /* Window convention for WPOS (rsx_fp_decompiler.c, _rsx_wpos): SET_SHADER_WINDOW
        * height in bits 0-11, origin (1 = BOTTOM) in 12-15, pixel centers (1 = INTEGER)
        * in 16-19. */
@@ -3239,6 +3259,18 @@ static void sink_end(void* user, const rsx_dispatch* r)
       alpha[3] = 0.0f; }
 
     pd_note(targets, n_targets, zslot, &rs, pipeline, tex_mask);
+    /* RSX_ENGINE_STATE_LOG=<pipeline>: the raw state registers of that
+     * pipeline's first 4 draws (alpha test, blend, anti-aliasing, shader control). */
+    { static int want = -2; if (want == -2) { const char* e = getenv("RSX_ENGINE_STATE_LOG"); want = e ? atoi(e) : -1; }
+      static int n;
+      if (want >= 0 && (u32)want == pipeline && n++ < 4) {
+          fprintf(stderr, "[state] pipe %u:", pipeline);
+          for (u32 m = 0x0300; m <= 0x0320; m += 4) fprintf(stderr, " %03X=%X", m, rsx_dsp_reg(&g.rsx, m));
+          fprintf(stderr, " 1D7C=%X 1D60=%X 036C=%X fpconst3=", rsx_dsp_reg(&g.rsx, 0x1D7C), rsx_dsp_reg(&g.rsx, 0x1D60),
+                  rsx_dsp_reg(&g.rsx, 0x036C));
+          if (g.fp_constants.count > 3) { const float* c = (const float*)(g.fp_cb + 48); fprintf(stderr, "%g,%g,%g,%g", c[0], c[1], c[2], c[3]); }
+          fprintf(stderr, "\n");
+      } }
     /* Pass dump: each input's guest format and the first vertex as fetched. */
     if (s_pd.draws_log && pd_capturing()) {
         fprintf(s_pd.draws_log, "    verts %u:", dc.n_verts);
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
index 77ec778f..3ddc1de2 100644
--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -83,6 +83,7 @@ typedef struct rsx_be_sampler_desc {
  * not baked into the pipeline, and so is not part of the pipeline key. */
 typedef struct rsx_be_render_state {
     u32 alpha_test_enable, alpha_func, alpha_ref_raw, alpha_ref_format;
+    u32 alpha_to_coverage;   /* drawn as an alpha test at 0.5 (no MSAA here) */
     u32 blend_enable, sf_rgb, df_rgb, sf_a, df_a, eq_rgb, eq_a;
     u32 depth_test, depth_write, depth_func;
     u32 cull_enable, cull_face, front_face;
-- 
