--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -250,6 +250,10 @@ void spu_stop(spu_context* ctx)
  * lifted floating point must keep round to nearest with denormals. Double precision restores
  * the default around itself inside a run. arm64 only; elsewhere the exact forms always run.
  * Returns the FPCR to restore, or ~0 when nothing was changed. */
+/* SPU float mode for lifted code built with SPU_FAST_FLOAT on x86 (see below):
+ * set by the title's runner; applied around every SPU run on the running
+ * thread only, so PPU code keeps its own mode. */
+volatile int g_spu_float_mode = 0;
 static uint64_t spu_float_mode_enter(void)
 {
 #if defined(__aarch64__) && defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS)
@@ -266,6 +270,17 @@ static uint64_t spu_float_mode_enter(void)
     if (v == SPU_FPCR_RZFZ) return ~0ull;   /* nested run: the outer one restores */
     __asm__ volatile("msr fpcr, %0" :: "r"((uint64_t)SPU_FPCR_RZFZ));
     return v;
+#elif defined(__SSE__) || defined(_M_X64)
+    /* x86: lifted code built with SPU_FAST_FLOAT (host IEEE single ops,
+     * spu_helpers.h) runs under MXCSR round toward zero with flush-to-zero
+     * and denormals-are-zero, which is what the SPU's single-precision unit
+     * does. A runner turns it on with g_spu_float_mode = 1. */
+    if (!g_spu_float_mode) return ~0ull;
+    const unsigned csr = _mm_getcsr();
+    const unsigned want = (csr & ~0x6000u) | 0x6000u | 0x8040u;   /* RZ, FTZ, DAZ */
+    if (csr == want) return ~0ull;   /* nested run: the outer one restores */
+    _mm_setcsr(want);
+    return csr;
 #else
     return ~0ull;
 #endif
@@ -274,6 +289,8 @@ static void spu_float_mode_leave(uint64_t outer)
 {
 #if defined(__aarch64__) && defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS)
     if (outer != ~0ull) __asm__ volatile("msr fpcr, %0" :: "r"(outer));
+#elif defined(__SSE__) || defined(_M_X64)
+    if (outer != ~0ull) _mm_setcsr((unsigned)outer);
 #else
     (void)outer;
 #endif
