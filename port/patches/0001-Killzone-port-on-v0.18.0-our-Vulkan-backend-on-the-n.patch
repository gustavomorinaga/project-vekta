+static unsigned long long s_vk_submit_t;
 static int vk_submit_and_wait(void)
 {
+    vk_rp_close();
+    { struct timespec a; clock_gettime(CLOCK_MONOTONIC, &a);
+      s_vk_submit_t = a.tv_sec * 1000000000ull + a.tv_nsec; }
     VK_CHECK(pvkEndCommandBuffer(s_vk.cmd), "vkEndCommandBuffer");
     VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
                         .commandBufferCount = 1, .pCommandBuffers = &s_vk.cmd };
     VK_CHECK(pvkResetFences(s_vk.device, 1, &s_vk.fence), "vkResetFences");
-    VK_CHECK(vk_queue_submit(&si, s_vk.fence), "vkQueueSubmit");
+    VK_CHECK(pvkQueueSubmit(s_vk.queue, 1, &si, s_vk.fence), "vkQueueSubmit");
     { PS3_TRACE_BEGIN(_tr);
       VK_CHECK(pvkWaitForFences(s_vk.device, 1, &s_vk.fence, VK_TRUE, UINT64_MAX), "vkWaitForFences");
+      vk_slot_wait_other();
       PS3_TRACE_END(_tr, "gpu_wait", 0); }
+    /* RSX_VK_WAIT_STATS: submissions and the wall time spent waiting on them. */
+    static int on = -1;
+    if (on < 0) on = getenv("RSX_VK_WAIT_STATS") ? 1 : 0;
+    if (on) {
+        static unsigned long long n, ns, t0;
+        struct timespec a; clock_gettime(CLOCK_MONOTONIC, &a);
+        const unsigned long long now = a.tv_sec * 1000000000ull + a.tv_nsec;
+        ns += now - s_vk_submit_t; n++;
+        if (!t0) t0 = now;
+        if (now - t0 > 2000000000ull) {
+            fprintf(stderr, "[RSX vulkan] %llu submits, %.1f ms waiting in %.0f ms\n",
+                    n, ns / 1e6, (now - t0) / 1e6);
+            n = ns = 0; t0 = now;
+        }
+    }
+    return 0;
+}
+
+static void vk_slot_wait_other(void)
+{
+    const int o = s_cur ^ 1;
+    if (!s_slot[o].inflight) return;
+    pvkWaitForFences(s_vk.device, 1, &s_slot[o].fence, VK_TRUE, UINT64_MAX);
+    s_slot[o].inflight = 0;
+}
+
+/* Submits the open batch without waiting, and moves recording to the other
+ * slot (waiting for it if it is still in flight). Returns nonzero when it
+ * could not, having submitted and waited instead. */
+static int vk_submit_async(void)
+{
+    static int sync = -1;
+    if (sync < 0) sync = getenv("RSX_VK_SYNC") ? 1 : 0;
+    const int o = s_cur ^ 1;
+    if (!sync && !s_slot[o].cmd) {   /* the second slot, made on first use */
+        VkCommandBufferAllocateInfo cai = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+                                            .commandPool = s_vk.pool,
+                                            .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+                                            .commandBufferCount = 1 };
+        VkFenceCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        if (pvkAllocateCommandBuffers(s_vk.device, &cai, &s_slot[o].cmd) != VK_SUCCESS ||
+            pvkCreateFence(s_vk.device, &fci, NULL, &s_slot[o].fence) != VK_SUCCESS) {
+            VK_LOG("second command slot: allocation failed, frames are waited for\n");
+            s_slot[o].cmd = VK_NULL_HANDLE;
+            sync = 1;
+        }
+    }
+    if (sync) return vk_submit_and_wait();
+    vk_rp_close();
+    VK_CHECK(pvkEndCommandBuffer(s_vk.cmd), "vkEndCommandBuffer");
+    VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                        .commandBufferCount = 1, .pCommandBuffers = &s_vk.cmd };
+    VK_CHECK(pvkResetFences(s_vk.device, 1, &s_vk.fence), "vkResetFences");
+    VK_CHECK(pvkQueueSubmit(s_vk.queue, 1, &si, s_vk.fence), "vkQueueSubmit");
+    if (!s_slot[s_cur].cmd) { s_slot[s_cur].cmd = s_vk.cmd; s_slot[s_cur].fence = s_vk.fence; }
+    if (s_slot[o].inflight) {   /* the slot recorded into next: its last frame done */
+        PS3_TRACE_BEGIN(_tr);
+        pvkWaitForFences(s_vk.device, 1, &s_slot[o].fence, VK_TRUE, UINT64_MAX);
+        s_slot[o].inflight = 0;
+        PS3_TRACE_END(_tr, "gpu_wait", 0);
+    }
+    s_slot[s_cur].inflight = 1;
+    s_slot[s_cur].ring = s_bat.ring;
+    s_slot[s_cur].pool = s_bat.pool;
+    s_cur = o;
+    s_vk.cmd = s_slot[o].cmd;
+    s_vk.fence = s_slot[o].fence;
+    s_bat.ring = s_slot[o].ring;
+    s_bat.pool = s_slot[o].pool;
     return 0;
 }
 
