+/* Engine draws are recorded into one open command buffer (s_bat) instead of
+ * being submitted and waited on one by one: ~380 waits a frame in Killzone.
+ * Anything else that records or destroys a GPU object submits the open batch
+ * first, so the queue still sees every operation in guest order. */
+static struct {
+    int              open;
+    vk_buffer        ring;          /* vertices, indices and constants of open draws */
+    VkDeviceSize     ring_off, ubo_align;
+    VkDescriptorPool pool;
+    u32              sets;
+} s_bat;
+#define VK_BATCH_SETS 2048u
+/* Two recording slots: the frame's batch is submitted without waiting for
+ * it (vk_submit_async), and the next one is recorded into the other slot's
+ * command buffer, vertex ring and descriptor pool while the GPU runs it. A
+ * slot is waited for before it is recorded into again, and every other
+ * submission still waits -- for the slot in flight too -- so all that
+ * assumed an idle GPU after vk_submit_and_wait still may. Every command
+ * buffer starts with a full memory barrier (vk_begin_raw): that orders it
+ * after everything submitted before it, which the CPU wait used to do.
+ * RSX_VK_SYNC=1 waits for every frame as before. */
+static struct { VkCommandBuffer cmd; VkFence fence; vk_buffer ring; VkDescriptorPool pool; int inflight; } s_slot[2];
+static int s_cur;
+static void vk_slot_wait_other(void);
+/* The render pass the batch's last draw left open. Consecutive draws into the
+ * same framebuffer share it, with no barrier between them, unless a draw
+ * samples one of its attachments; anything else recorded into the batch
+ * closes it first (vk_rp_close). One render pass and one full barrier per
+ * draw kept the GPU idle between draws: ~365 a frame in Killzone HD. */
+static struct { int open; VkFramebuffer fb; VkRenderPass rp; } s_rpo;
+static void vk_rp_close(void);
+static int vk_batch_reserve(VkDeviceSize bytes);
+static int vk_batch_reserve_keep(VkDeviceSize bytes);
+static VkDeviceSize vk_batch_alloc(VkDeviceSize bytes, VkDeviceSize align);
+
+static void vk_rp_close(void)
+{
+    if (!s_rpo.open) return;
+    s_rpo.open = 0;
+    pvkCmdEndRenderPass(s_vk.cmd);
 }
 
