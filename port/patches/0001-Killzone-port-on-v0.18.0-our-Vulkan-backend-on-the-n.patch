+/* A host buffer kept for the waited-on copies (readbacks, depth snapshots):
+ * each made and freed its own, and the driver mapped and unmapped the memory
+ * every time (and destroying flushed the batch). One per usage, grown on
+ * demand; every user waits for its submission before returning, so they never
+ * overlap. NULL if it cannot be made. */
+static vk_buffer* vk_scratch_buffer(VkDeviceSize size, VkBufferUsageFlags usage)
+{
+    static vk_buffer s_dst, s_srcdst;
+    vk_buffer* b = usage == VK_BUFFER_USAGE_TRANSFER_DST_BIT ? &s_dst : &s_srcdst;
+    if (b->buf && b->size >= size) return b;
+    if (b->buf) vk_destroy_buffer(b);
+    VkDeviceSize want = 4u << 20;
+    while (want < size) want *= 2;
+    if (vk_create_host_buffer(b, want, usage)) { vk_destroy_buffer(b); return NULL; }
+    return b;
+}
