From 4d2775a4bdceb87cfc3f119eb33c6d293a8b6dcb Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 20 Oct 2026 11:52:06 -0300
Subject: [PATCH] SPU coherence: pinned lines (spu_coh_pin)

A line a host agent updates under the lock-line lock with plain stores can
be pinned: its reserved bit never drops, so every PPU store and
store-conditional to it takes the same lock instead of landing inside the
host's read-modify-write.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 runtime/spu/spu_coherency.c | 10 ++++++++++
 runtime/spu/spu_coherency.h |  2 ++
 2 files changed, 12 insertions(+)

diff --git a/runtime/spu/spu_coherency.c b/runtime/spu/spu_coherency.c
index ed2bcf58..1d96244f 100644
--- a/runtime/spu/spu_coherency.c
+++ b/runtime/spu/spu_coherency.c
@@ -398,3 +398,13 @@ void spu_coh_notify_write(uint32_t ea)
 #ifdef __cplusplus
 }
 #endif
+
+/* A line a host agent updates under the lock-line lock with plain stores
+ * (spu_coherency.h). Reserved bits are never cleared, so arming it once keeps
+ * every PPU store and store-conditional to it on the locked path. */
+void spu_coh_pin(uint32_t ea)
+{
+    spu_lockline_lock();
+    spu_coh_reserve(NULL, ea);
+    spu_lockline_unlock();
+}
diff --git a/runtime/spu/spu_coherency.h b/runtime/spu/spu_coherency.h
index ea2e8351..8e9f328a 100644
--- a/runtime/spu/spu_coherency.h
+++ b/runtime/spu/spu_coherency.h
@@ -50,6 +50,8 @@ void spu_lockline_unlock(void);
  * reserved again microseconds later, so unmarking would buy nothing; a stale
  * mark costs one locked PPU store to a line the kernel owns anyway. */
 void spu_coh_reserve(spu_context* ctx, uint32_t ea);
+/* Keeps the line's bit set for good: PPU stores to it always take the lock-line lock. */
+void spu_coh_pin(uint32_t ea);
 
 /* GETLLAR fast path: publish ctx's reservation of ea WITHOUT the lock-line
  * lock, when ctx is already a registered holder and ea's line already marked.
-- 
