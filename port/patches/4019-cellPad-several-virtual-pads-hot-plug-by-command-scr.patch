     /* Buttons a title hook presses (pad_inject), for that many reads within PAD_INJECT_MS. */
diff --git a/libs/input/pad_test_input.h b/libs/input/pad_test_input.h
new file mode 100644
index 0000000..a72efd4
--- /dev/null
+++ b/libs/input/pad_test_input.h
@@ -0,0 +1,56 @@
+/*
+ * cellPad's test inputs, the parts that are only text: the PAD_VIRTUAL list, a virtual pad's command file and the
+ * per-port variable names (PAD_FILE, PAD_FILE_1, ...). No SDL and no state, so a host test can run them.
+ */
+#ifndef PAD_TEST_INPUT_H
+#define PAD_TEST_INPUT_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The i-th entry of a comma list ("xbox,ps5"), without surrounding spaces, into out (cut to n - 1 characters).
+ * 0 when the list has no such entry or the entry is empty. */
+static inline int padv_list_item(const char* list, int i, char* out, size_t n)
+{
+    if (!list || !out || !n || i < 0) return 0;
+    const char* p = list;
+    for (; i > 0; i--) {
+        p = strchr(p, ',');
+        if (!p) return 0;
+        p++;
+    }
+    while (*p == ' ' || *p == '\t') p++;
+    size_t k = strcspn(p, ",");
+    while (k && (p[k - 1] == ' ' || p[k - 1] == '\t')) k--;
+    if (!k) return 0;
+    if (k >= n) k = n - 1;
+    memcpy(out, p, k);
+    out[k] = 0;
+    return 1;
+}
+
+/* The variable for port (or virtual pad) i: the base name for 0, "<base>_<i>" after it. */
+static inline void padv_env_name(const char* base, int i, char* out, size_t n)
+{
+    if (i > 0) snprintf(out, n, "%s_%d", base, i);
+    else       snprintf(out, n, "%s", base);
+}
+
+enum { PADV_NONE, PADV_STATE, PADV_ATTACH, PADV_DETACH };
+
+/* A virtual pad's command file: "detach" (unplug it), "attach" (plug it in again), or its state,
+ * "buttons lx ly rx ry lt rt" with buttons an SDL_CONTROLLER_BUTTON_* bit mask in hex, sticks -32768..32767 and
+ * triggers 0..32767; values left out are 0. PADV_NONE for anything else (an empty file). */
+static inline int padv_parse(const char* s, unsigned* buttons, int ax[6])
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    if (!strncmp(s, "detach", 6)) return PADV_DETACH;
+    if (!strncmp(s, "attach", 6)) return PADV_ATTACH;
+    *buttons = 0;
+    for (int i = 0; i < 6; i++) ax[i] = 0;
+    return sscanf(s, "%x %d %d %d %d %d %d", buttons, &ax[0], &ax[1], &ax[2], &ax[3], &ax[4], &ax[5]) >= 1
+               ? PADV_STATE : PADV_NONE;
+}
+
+#endif
