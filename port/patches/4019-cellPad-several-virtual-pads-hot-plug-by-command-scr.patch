+/* PAD_VIRTUAL_KEYS: virtual pad k as the keyboard holds it, by the key map
+ * (the mouse stays on port 0). Released while no window has the focus. */
+static void pad_virtual_keys(int k)
+{
+    if (!s_virt[k].js) return;
+    unsigned b = 0;
+    int ax[6] = {0};
+    const Uint8* keys = SDL_WasInit(SDL_INIT_VIDEO) && SDL_GetKeyboardFocus() ? SDL_GetKeyboardState(NULL) : NULL;
+    if (keys) {
+        if (s_nbinds < 0) pad_keymap_load();
+        PadHostState kb;
+        pad_host_release(&kb);
+        int st[9] = {0};
+        pad_binds_apply(&kb, BIND_KEY, keys, 0, st);
+        pad_sticks_from(&kb, st);
+        static const struct { u16 cell; int sdl; } m[] = {
+            {CELL_PAD_CTRL_CROSS,SDL_CONTROLLER_BUTTON_A},{CELL_PAD_CTRL_CIRCLE,SDL_CONTROLLER_BUTTON_B},
+            {CELL_PAD_CTRL_SQUARE,SDL_CONTROLLER_BUTTON_X},{CELL_PAD_CTRL_TRIANGLE,SDL_CONTROLLER_BUTTON_Y},
+            {CELL_PAD_CTRL_SELECT,SDL_CONTROLLER_BUTTON_BACK},{CELL_PAD_CTRL_START,SDL_CONTROLLER_BUTTON_START},
+            {CELL_PAD_CTRL_L3,SDL_CONTROLLER_BUTTON_LEFTSTICK},{CELL_PAD_CTRL_R3,SDL_CONTROLLER_BUTTON_RIGHTSTICK},
+            {CELL_PAD_CTRL_L1,SDL_CONTROLLER_BUTTON_LEFTSHOULDER},{CELL_PAD_CTRL_R1,SDL_CONTROLLER_BUTTON_RIGHTSHOULDER},
+            {CELL_PAD_CTRL_UP,SDL_CONTROLLER_BUTTON_DPAD_UP},{CELL_PAD_CTRL_DOWN,SDL_CONTROLLER_BUTTON_DPAD_DOWN},
+            {CELL_PAD_CTRL_LEFT,SDL_CONTROLLER_BUTTON_DPAD_LEFT},{CELL_PAD_CTRL_RIGHT,SDL_CONTROLLER_BUTTON_DPAD_RIGHT},
+        };
+        for (unsigned i = 0; i < sizeof m / sizeof m[0]; i++)
+            if (kb.buttons & m[i].cell) b |= 1u << m[i].sdl;
+        const u8 v[4] = { kb.analog_lx, kb.analog_ly, kb.analog_rx, kb.analog_ry };
+        for (int i = 0; i < 4; i++) ax[i] = (v[i] - 128) * 256 + (v[i] > 128 ? 255 : 0);   /* 0..255 -> -32768..32767 */
+        ax[4] = kb.buttons & CELL_PAD_CTRL_L2 ? 32767 : 0;
+        ax[5] = kb.buttons & CELL_PAD_CTRL_R2 ? 32767 : 0;
+    }
+    pad_virtual_set(s_virt[k].js, b, ax);
+}
 #endif
 
