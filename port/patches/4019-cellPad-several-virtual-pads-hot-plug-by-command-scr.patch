+/* PAD_VIRTUAL=<kind>[,<kind>...] (xbox|xbox360|ps4|ps5|switch|steam; default
+ * unset, none): virtual controllers of those kinds, in that order (no hardware
+ * needed). Pad 0 is driven by the file PAD_VIRTUAL_FILE, pad n by
+ * PAD_VIRTUAL_FILE_n: "buttons lx ly rx ry lt rt" with buttons an
+ * SDL_CONTROLLER_BUTTON_* bit mask (hex), sticks -32768..32767 and triggers
+ * 0..32767; "detach" unplugs that pad and "attach" plugs it in again (a
+ * hot-plug test: it comes back as a new instance with the same GUID, so into
+ * the port it had). PAD_VIRTUAL_KEYS=n (default unset): the keyboard, by the
+ * key map, drives virtual pad n instead of port 0, for a pad + pad test with
+ * one real controller. Test tools only: nothing sets them in a release. */
+#define PAD_MAX_VIRTUAL 4
+static struct {
+    SDL_VirtualJoystickDesc d;
+    SDL_Joystick* js;      /* open while plugged in */
+    SDL_JoystickID id;
+} s_virt[PAD_MAX_VIRTUAL];
+static int s_nvirt;
+static int s_virt_keys = -1;
+static void pad_virtual_keys(int k);
+
+static void pad_virtual_plug(int k)
+{
+    SDL_NumJoysticks();   /* refreshes sdl2-compat's index list */
+    const int idx = SDL_JoystickAttachVirtualEx(&s_virt[k].d);
+    SDL_Joystick* js = idx >= 0 ? SDL_JoystickOpen(idx) : NULL;
+    s_virt[k].js = js;
+    s_virt[k].id = js ? SDL_JoystickInstanceID(js) : -1;
+    printf("[cellPad] virtual %s controller: device %d (pad %d)%s%s\n", s_virt[k].d.name, idx, k,
+           js ? "" : " ", js ? "" : SDL_GetError());
+}
+static void pad_virtual_unplug(int k)
+{
+    if (!s_virt[k].js) return;
+    SDL_JoystickClose(s_virt[k].js);
+    s_virt[k].js = NULL;
+    const int n = SDL_NumJoysticks();
+    for (int j = 0; j < n; j++)
+        if (SDL_JoystickGetDeviceInstanceID(j) == s_virt[k].id) { SDL_JoystickDetachVirtual(j); break; }
+    printf("[cellPad] virtual controller %d detached (instance %d)\n", k, (int)s_virt[k].id);
+    s_virt[k].id = -1;
+}
