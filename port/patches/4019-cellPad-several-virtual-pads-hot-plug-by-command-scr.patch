-            SDL_JoystickSetVirtualAxis(js, i, (Sint16)(i < 4 ? ax[i] : ax[i] * 2 - 32768));
+    for (int k = 0; k < s_nvirt; k++) {
+        if (k == s_virt_keys) { pad_virtual_keys(k); continue; }
+        char var[40];
+        padv_env_name("PAD_VIRTUAL_FILE", k, var, sizeof var);
