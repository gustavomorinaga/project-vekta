+    const char* keys = getenv("PAD_VIRTUAL_KEYS");
+    if (keys && *keys) {
+        s_virt_keys = atoi(keys);
+        if (s_virt_keys < 0 || s_virt_keys >= s_nvirt) s_virt_keys = -1;
+        printf("[cellPad] PAD_VIRTUAL_KEYS: the keyboard drives %s\n", s_virt_keys < 0 ? "nothing (no such virtual pad)" : "a virtual pad");
