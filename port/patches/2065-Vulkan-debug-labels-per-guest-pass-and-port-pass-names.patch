+/* Debug names for a frame debugger (patch 2065). */
+static const char* eng_dbg_format(rsx_be_format f)
+{
+    switch (f) {
+    case RSX_BE_FMT_R8: return "R8";                 case RSX_BE_FMT_R8G8: return "RG8";
+    case RSX_BE_FMT_R8G8B8A8: return "RGBA8";        case RSX_BE_FMT_R16: return "R16";
+    case RSX_BE_FMT_R16G16: return "RG16";           case RSX_BE_FMT_R16G16F: return "RG16F";
+    case RSX_BE_FMT_R16G16B16A16F: return "RGBA16F"; case RSX_BE_FMT_R32F: return "R32F";
+    case RSX_BE_FMT_R32G32B32A32F: return "RGBA32F";
+    default: return "?";
+    }
+}
+
+static void eng_dbg_name_color(u32 handle, u32 location, u32 offset, u32 w, u32 h, rsx_be_format fmt)
+{
+    if (!g.dbg || !handle) return;
+    char t[96];
+    snprintf(t, sizeof t, "colour %u:0x%08X %ux%u %s", location, offset, w, h, eng_dbg_format(fmt));
+    g.be->debug_name(g.be->user, handle, t);
+}
+
+static void eng_dbg_name_depth(u32 handle, u32 location, u32 offset, u32 w, u32 h)
+{
+    if (!g.dbg || !handle) return;
+    char t[96];
+    snprintf(t, sizeof t, "zeta %u:0x%08X %ux%u", location, offset, w, h);
+    g.be->debug_name(g.be->user, handle, t);
+}
+
+static void eng_dbg_pass_text(char* t, size_t cap, u32 pass, const u32* targets, u32 n, u32 zslot)
+{
+    size_t k = (size_t)snprintf(t, cap, "pass %u:", pass);
+    for (u32 i = 0; i < n && k < cap; i++) {
+        const eng_surface* s = &g.surfaces[targets[i]];
+        k += (size_t)snprintf(t + k, cap - k, " %c 0x%08X %ux%u %s", 'A' + (int)i, s->offset, s->w, s->h,
+                              eng_dbg_format(s->fmt));
+    }
+    if (zslot != ENG_INVALID && k < cap) {
+        const eng_zdepth* z = &g.zdepths[zslot];
+        snprintf(t + k, cap - k, " | Z 0x%08X %ux%u", z->offset, z->w, z->h);
+    }
+}
+
+/* A draw or clear into this target set: a new name when the set changed
+ * (a clear does not look at the zeta: it may come before the zeta exists). */
+static void eng_dbg_note(const u32* targets, u32 n, u32 zslot, int clear)
+{
+    if (!g.dbg) return;
+    int same = g.dbg_n == n && (clear || g.dbg_z == zslot);
+    for (u32 k = 0; same && k < n; k++) same = g.dbg_targets[k] == targets[k];
+    if (same) return;
+    g.dbg_n = n; g.dbg_z = zslot;
+    memcpy(g.dbg_targets, targets, n * sizeof(u32));
+    char t[256];
+    eng_dbg_pass_text(t, sizeof t, g.dbg_pass++, targets, n, zslot);
+    g.be->debug_pass(g.be->user, t);
+}
+
+static void eng_dbg_frame_end(void)
+{
+    if (!g.dbg) return;
+    g.be->debug_pass(g.be->user, NULL);
+    g.dbg_n = 0; g.dbg_z = ENG_INVALID; g.dbg_pass = 0;
+}
