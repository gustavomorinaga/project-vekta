+/* ---------------------------------------------------------------------------
+ * Debug names (patch 2065): labelled regions in the command buffers and
+ * names on the engine's targets, for RenderDoc and the validation layer's
+ * messages. On with PS3RECOMP_VK_LABELS=1, or with PS3RECOMP_VK_VALIDATION=1
+ * unless PS3RECOMP_VK_LABELS=0, and only when VK_EXT_debug_utils is there;
+ * off, each place below costs one test of s_dbg.on.
+ *
+ * Regions: each guest pass (the draw engine names it by its targets, its
+ * Vulkan render passes inside), the MLAA, the motion blur, the temporal
+ * upscaler, FSR 1 and the present. A region is opened only on a command
+ * buffer being recorded and closed in the same function, so begin and end
+ * always pair.
+ * -------------------------------------------------------------------------*/
+static struct {
+    int want;     /* asked for (PS3RECOMP_VK_LABELS, or validation) */
+    int on;       /* the functions are there */
+    PFN_vkCmdBeginDebugUtilsLabelEXT begin;
+    PFN_vkCmdEndDebugUtilsLabelEXT end;
+    PFN_vkSetDebugUtilsObjectNameEXT name;
+    char pass[256];   /* the guest pass the next render pass belongs to */
+    int rp_open;      /* a guest pass region is open around the render pass */
+} s_dbg;
+
+static void vk_dbg_wanted(void)
+{
+    const int l = rsx_vk_env_flag(getenv("PS3RECOMP_VK_LABELS"));
+    const int unset = !getenv("PS3RECOMP_VK_LABELS");
+    if (l < 0) VK_LOG("PS3RECOMP_VK_LABELS=%s not understood (0 or 1), off\n", getenv("PS3RECOMP_VK_LABELS"));
+    s_dbg.want = l > 0 || (unset && rsx_vk_env_flag(getenv("PS3RECOMP_VK_VALIDATION")) > 0);
+}
+
+static void vk_dbg_start(VkInstance inst)
+{
+    if (!s_dbg.want || !s_val.utils) return;
+    s_dbg.begin = (PFN_vkCmdBeginDebugUtilsLabelEXT)pvkGetInstanceProcAddr(inst, "vkCmdBeginDebugUtilsLabelEXT");
+    s_dbg.end = (PFN_vkCmdEndDebugUtilsLabelEXT)pvkGetInstanceProcAddr(inst, "vkCmdEndDebugUtilsLabelEXT");
+    s_dbg.name = (PFN_vkSetDebugUtilsObjectNameEXT)pvkGetInstanceProcAddr(inst, "vkSetDebugUtilsObjectNameEXT");
+    s_dbg.on = s_dbg.begin && s_dbg.end && s_dbg.name;
+    VK_LOG("debug names: %s\n", s_dbg.on ? "on (passes, MLAA, motion blur, upscalers, present; target names)"
+                                          : "VK_EXT_debug_utils has no label functions, off");
+}
+
+static void vk_dbg_push(VkCommandBuffer cmd, const char* text)
+{
+    if (!s_dbg.on) return;
+    VkDebugUtilsLabelEXT l = { .sType = VK_STRUCTURE_TYPE_DEBUG_UTILS_LABEL_EXT, .pLabelName = text };
+    s_dbg.begin(cmd, &l);
+}
+
+static void vk_dbg_pop(VkCommandBuffer cmd)
+{
+    if (s_dbg.on) s_dbg.end(cmd);
+}
+
+static void vk_dbg_name_image(VkImage img, const char* text)
+{
+    if (!s_dbg.on || !img) return;
+    VkDebugUtilsObjectNameInfoEXT n = { .sType = VK_STRUCTURE_TYPE_DEBUG_UTILS_OBJECT_NAME_INFO_EXT,
+                                        .objectType = VK_OBJECT_TYPE_IMAGE,
+                                        .objectHandle = (uint64_t)(uintptr_t)img, .pObjectName = text };
+    s_dbg.name(s_vk.device, &n);
+}
