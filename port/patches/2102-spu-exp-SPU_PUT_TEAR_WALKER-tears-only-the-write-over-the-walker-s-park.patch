From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sat, 28 Nov 2026 03:00:00 -0300
Subject: [PATCH] spu: exp SPU_PUT_TEAR_WALKER tears only the write over the park
 the walker waits on (experiment, not for merge)

---
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -583,6 +583,8 @@
 
 /* Total PUTLLC attempts (all SPUs). The PM flow trace (spurs_policy.c) reads
  * the delta across one policy run to find the run that performed a claim. */
+/* Experiment (SPU_PUT_TEAR_WALKER, spu_dma.h): the EA of the park cellGcm's walker stopped on, 0 when it did not. */
+volatile uint32_t g_spu_walker_park_ea = 0;
 volatile unsigned g_spu_putllc_count = 0;
 /* PUTLLCs that hit the WATCHED sync line (g_barrier_sync_watch) -- isolates the
  * work-run on the stalled job queue from the dozen idle jobmanager instances. */
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -241,17 +241,19 @@
 }
 static inline void spu_put_copy(uint8_t* dst, const uint8_t* src, uint32_t size, uint32_t ea)
 {
-    static int cfg = -1;   /* bit 0: parks last; above it: the tear in ms */
+    static int cfg = -1;   /* bit 0: parks last; bit 1: tear at the walker only; above: the tear in ms */
     int c = __atomic_load_n(&cfg, __ATOMIC_RELAXED);
     if (__builtin_expect(c < 0, 0)) {
         const char* e = getenv("SPU_PUT_PARK_LAST");
         const char* t = getenv("SPU_PUT_TEAR_MS");
+        const char* w = getenv("SPU_PUT_TEAR_WALKER");
         int ms = t ? atoi(t) : 0;
         ms = ms < 0 ? 0 : ms > 1000 ? 1000 : ms;
-        c = ((e && *e == '0') ? 0 : 1) | (ms << 1);
+        c = ((e && *e == '0') ? 0 : 1) | ((w && atoi(w)) ? 2 : 0) | (ms << 2);
         __atomic_store_n(&cfg, c, __ATOMIC_RELAXED);
     }
-    const int last = c & 1, tear_ms = c >> 1;
+    const int last = c & 1;
+    int tear_ms = c >> 2;
     /* The line starts inside the write that hold a park now. */
     uint32_t parks[MFC_MAX_DMA_SIZE / 128u + 1u];
     uint32_t np = 0;
@@ -260,6 +262,25 @@
             if (spu_word_is_park(dst + (a - ea), a)) parks[np++] = a - ea;
     }
     if (!np) { memcpy(dst, src, size); return; }
+    /* SPU_PUT_TEAR_WALKER=1 (experiment, with SPU_PUT_TEAR_MS): tear only a write over the park cellGcm's walker
+     * is waiting on (g_spu_walker_park_ea), at most every 50 ms, so the game keeps its pace. */
+    if (tear_ms && (c & 2)) {
+        extern volatile uint32_t g_spu_walker_park_ea;
+        const uint32_t w = g_spu_walker_park_ea;
+        int at = 0;
+        for (uint32_t i = 0; i < np; i++) if (w && ea + parks[i] == w) { at = 1; break; }
+        static unsigned long long next_ms;
+        const unsigned long long now = GetTickCount64();
+        if (!at || now < next_ms) tear_ms = 0;
+        else {
+            next_ms = now + 50;
+            static unsigned nt;
+            const unsigned k = __atomic_add_fetch(&nt, 1u, __ATOMIC_RELAXED);
+            if (k <= 16u || (k & 0xFFu) == 0u)
+                fprintf(stderr, "[spu-put] tear #%u at the walker's park ea=%08X (size 0x%X)%s\n", k, w, size,
+                        last ? " (parks written last)" : " (one memcpy)");
+        }
+    }
     { static unsigned n = 0;
       const unsigned k = __atomic_add_fetch(&n, 1u, __ATOMIC_RELAXED);
       if (k <= 8u || (k & 0xFFFFu) == 0u)
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -3167,6 +3167,7 @@
                   }
                   why = "parked";
                   s_park_pass = 1;
+                  { extern volatile uint32_t g_spu_walker_park_ea; g_spu_walker_park_ea = gcm_io2ea(s_fifo_getoff); }
                   break;
               }
               if (tgt < s_fifo_getoff) s_fifo_back_jumps++;
@@ -3578,6 +3579,7 @@
      * ring start, and the resync dropped them: inFAMOUS 2 stopped presenting
      * for good that way in about one New Marais run in five ("stuck-get" at a
      * self-jump with no "jump-park" before it). */
+    { extern volatile uint32_t g_spu_walker_park_ea; if (!s_park_pass) g_spu_walker_park_ea = 0; }
     { static u32 last = 0xFFFFFFFFu; static int stuck = 0;
       if (s_sema_blocked_pass || s_park_pass || s_report_hold_pass) {
           stuck = 0; last = s_fifo_getoff;
-- 
