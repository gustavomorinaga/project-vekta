 /* Render breadcrumbs (patch 2084): the last 64 guest render passes, port passes, submits and presents given to
  * the GPU, oldest first, one line each ending in '\n' ("frame 812 batch 4410 done: pass 3: A 0x0C3A0000 640x360
--- a/libs/video/vulkan/rsx_vk_mlaa32.comp
+++ b/libs/video/vulkan/rsx_vk_mlaa32.comp
@@ -0,0 +1,550 @@
+#version 450
+// rsx_vk_mlaa.comp with the 64-bit integers of its float emulation as pairs of
+// 32-bit words, for drivers that do not build that one (#129: AMD's Windows
+// driver) and devices without shaderInt64 (vk_mlaa_spv picks the form).
+// Killzone HD's jm_post MLAA (SPU modules af58/85fc) on the GPU, the same rules
+// as the game port's C reference (port/kz1hd/native/mlaa_ref.c; the decoding
+// is in docs/wws-jm-post.md of the Killzone port). Stages, by push constant:
+//  0 LOAD    raw texels (4 bytes, alpha in byte 3) -> pixels, column-major
+//  1 FLAGS   every pixel's flags (b7 edge right, b6 edge down, b5/b4 brighter
+//            than right/down, low nibble (R+G+B)*1365 >> 16)
+//  2 FIX     a column job's own flags: column r0-1 (already blended) and, in
+//            the last job, column W-1 against column 1 and columns 1..3 after it
+//  3 REC1    a column job's runs -> per-pixel blend ops (thread per position)
+//  4 CHAIN1  the ops along each row: a thread per stretch of consecutive line
+//            pairs with ops (a pair without one starts the next line afresh)
+//  5 PREP2   pixels to row-major
+//  6 REC2    the row pass's runs -> ops
+//  7 CHAIN2  the ops down each column, one row job per dispatch
+//  8 STORE   pixels and flags -> raw texels
+//  9 SLOPES  the table of slopes for the usual height 0.5 (once)
+// The image is W x H (push constants): the game's 1280x720, or bigger under the
+// port's internal resolution scale (an ENHANCEMENT; the same rules with W and H,
+// and each pass in 5 jobs of CJ columns / RJ rows: 256 and 144 at 1280x720, as
+// the game's own jobs). A line pair's runs, records and slots live in the
+// scratch buffers (binding 7, 8), one slice per workgroup; each workgroup of
+// REC1/REC2 takes line pairs in turn (gl_NumWorkGroups apart).
+layout(local_size_x = 256) in;
+layout(std430, binding = 0) buffer Img { uint IMG[]; };   // raw texels, row-major
+layout(std430, binding = 1) buffer Pc  { uint PC[]; };    // pixels, column-major (x * H + y)
+layout(std430, binding = 2) buffer Pr  { uint PR[]; };    // pixels, row-major
+layout(std430, binding = 3) buffer Fl  { uint F0[]; };    // flags, image roles, row-major
+layout(std430, binding = 4) buffer Fc  { uint FC[]; };    // column pass's flags, its roles, column-major, + 3 lines
+layout(std430, binding = 5) buffer Op  { uint OPS[]; };   // 2 per line pair and position
+layout(std430, binding = 6) buffer Sl  { uint SL8[]; };   // slope(0x8000, L), filled by stage 9
+layout(std430, binding = 7) coherent buffer Sc { uint SCR[]; };   // per workgroup: heads (L), records (4 L)
+layout(std430, binding = 8) coherent buffer Ss { int SSL[]; };    // per workgroup: slots (9 (L / 3 + 2))
+layout(push_constant) uniform Push { int stage; int job; int w; int h; int cj; int rj; } pc;
+
+const int JOBS = 5;                       // jobs per pass
+const int MAXLEN1 = 8196;                 // the longest line (8192) + 1, rounded to 4
+int W, H, CJ, RJ;                         // image size, columns per column job, rows per row job
+
+// ---------------- SPU single precision as the port runs it (truncation, FTZ) ----------------
+// The 64-bit integers of this emulation are uvec2 (x the low word, y the high
+// word), with no shaderInt64: AMD's Windows driver (26.10.1) ended the process
+// inside its shader compiler on the uint64_t form of this shader (#129). Same
+// arithmetic, bit for bit (tools/mlaa_harness: GPU = C reference).
+uvec2 u64(uint v) { return uvec2(v, 0u); }
+bool u64z(uvec2 a) { return (a.x | a.y) == 0u; }
+bool u64gt(uvec2 a, uvec2 b) { return a.y > b.y || (a.y == b.y && a.x > b.x); }
+uvec2 u64add(uvec2 a, uvec2 b) { uint c; uint lo = uaddCarry(a.x, b.x, c); return uvec2(lo, a.y + b.y + c); }
+uvec2 u64sub(uvec2 a, uvec2 b) { uint br; uint lo = usubBorrow(a.x, b.x, br); return uvec2(lo, a.y - b.y - br); }
+uvec2 u64mul(uint a, uint b) { uint hi, lo; umulExtended(a, b, hi, lo); return uvec2(lo, hi); }
+// shifts by 0..63
+uvec2 u64shl(uvec2 a, uint n)
+{
+    if (n == 0u) return a;
+    if (n >= 32u) return uvec2(0u, a.x << (n - 32u));
+    return uvec2(a.x << n, (a.y << n) | (a.x >> (32u - n)));
+}
+uvec2 u64shr(uvec2 a, uint n)
+{
+    if (n == 0u) return a;
+    if (n >= 32u) return uvec2(a.y >> (n - 32u), 0u);
+    return uvec2((a.x >> n) | (a.y << (32u - n)), a.y >> n);
+}
+int msb64(uvec2 v) { return v.y != 0u ? 32 + findMSB(v.y) : findMSB(v.x); }
+// m * 2^e with sign s, rounded toward zero; below normal -> 0, above -> FLT_MAX
+uint fpack(uint s, uvec2 m, int e)
+{
+    if (u64z(m)) return s << 31;
+    int n = msb64(m);
+    uint man = n > 23 ? u64shr(m, uint(n - 23)).x : u64shl(m, uint(23 - n)).x;
+    int be = e + n + 127;
+    if (be <= 0) return s << 31;
+    if (be >= 255) return (s << 31) | 0x7F7FFFFFu;
+    return (s << 31) | (uint(be) << 23) | (man & 0x7FFFFFu);
+}
+bool fsplit(uint f, out uint s, out uint m, out int e)
+{
+    int be = int((f >> 23) & 0xFFu);
+    s = f >> 31;
+    if (be == 0) { m = 0u; e = 0; return false; }
+    m = (f & 0x7FFFFFu) | 0x800000u; e = be - 150;
+    return true;
+}
+uint fmul(uint a, uint b)
+{
+    uint sa, sb, ma, mb; int ea, eb;
+    bool na = fsplit(a, sa, ma, ea), nb = fsplit(b, sb, mb, eb);
+    if (!na || !nb) return (sa ^ sb) << 31;
+    return fpack(sa ^ sb, u64mul(ma, mb), ea + eb);
+}
+// m >> r with a sticky bit for what falls off (r >= 1); 1 when everything does
+uvec2 shr_sticky(uvec2 m, int r)
+{
+    if (r >= 64) return uvec2(1u, 0u);
+    uvec2 v = u64shr(m, uint(r));
+    if (!u64z(u64shl(m, uint(64 - r)))) v.x |= 1u;
+    return v;
+}
+// exact (sp mp 2^ep) + (sc mc 2^ec), truncated: the larger term's top bit at
+// bit 62, the other shifted to it with a sticky bit
+uint fsum(uint sp, uvec2 mp, int ep, uint sc, uvec2 mc, int ec)
+{
+    if (u64z(mp)) return !u64z(mc) ? fpack(sc, mc, ec) : ((sp & sc) << 31);
+    if (u64z(mc)) return fpack(sp, mp, ep);
+    int tp = ep + msb64(mp), tc = ec + msb64(mc);
+    int E = max(tp, tc) - 62;
+    uvec2 ap, ac;
+    int k = ep - E;                       // >= 0 for the larger, may be < 0 for the other
+    ap = k >= 0 ? u64shl(mp, uint(k)) : shr_sticky(mp, -k);
+    k = ec - E;
+    ac = k >= 0 ? u64shl(mc, uint(k)) : shr_sticky(mc, -k);
+    if (sp == sc) return fpack(sp, u64add(ap, ac), E);
+    if (ap == ac) return 0u;
+    return u64gt(ap, ac) ? fpack(sp, u64sub(ap, ac), E) : fpack(sc, u64sub(ac, ap), E);
+}
+uint ffma(uint a, uint b, uint c)
+{
+    uint sa, sb, sc, ma, mb, mc; int ea, eb, ec;
+    bool na = fsplit(a, sa, ma, ea), nb = fsplit(b, sb, mb, eb);
+    fsplit(c, sc, mc, ec);
+    if (!na || !nb) return fsum(sa ^ sb, uvec2(0u), 0, sc, u64(mc), ec);
+    return fsum(sa ^ sb, u64mul(ma, mb), ea + eb, sc, u64(mc), ec);
+}
+uint ffnms(uint a, uint b, uint c) { return ffma(a ^ 0x80000000u, b, c); }
+const uint FREST[32] = uint[32](
+    0x7FFBE0u, 0x7F87A6u, 0x70EF72u, 0x708B40u, 0x638B12u, 0x633AEAu, 0x5792C4u, 0x574AA0u,
+    0x4CCA7Eu, 0x4C9262u, 0x430A44u, 0x42D62Au, 0x3A2E12u, 0x39FDFAu, 0x3215E4u, 0x31F1D2u,
+    0x2AA9BEu, 0x2A85ACu, 0x23D59Au, 0x23BD8Eu, 0x1D8576u, 0x1D8576u, 0x17AD5Au, 0x17AD5Au,
+    0x124543u, 0x124543u, 0x0D392Du, 0x0D392Du, 0x08851Au, 0x08851Au, 0x041D07u, 0x041D07u);
+uint frest(uint a)
+{
+    uint e = (a >> 23) & 0xFFu, rexp = e == 0u ? 255u : (e >= 253u ? 0u : 253u - e);
+    return (a & 0x80000000u) | (rexp << 23) | (FREST[(a >> 18) & 0x1Fu] & 0x7FFFFFu);
+}
+uint ffi(uint a, uint est)
+{
+    int e = int((est >> 23) & 0xFFu);
+    if (e == 0) return 0u;
+    uvec2 m = u64sub(u64shl(u64(0x2000u | ((est >> 10) & 0x1FFFu)), 19u), u64mul(est & 0x3FFu, a & 0x7FFFFu));
+    if (m.y == 0u) { m = u64shl(m, 1u); e--; if (e == 0) return 0u; }
+    return (est & 0x80000000u) | (uint(e) << 23) | (u64shr(m, 9u).x & 0x7FFFFFu);
+}
+uint fcsflt(int v) { if (v == 0) return 0u; return fpack(v < 0 ? 1u : 0u, u64(uint(abs(v))), 0); }
+uint fcuflt(uint v, int scale) { return v != 0u ? fpack(0u, u64(v), -scale) : 0u; }
+uint fcfltu16(uint f)
+{
+    uint s, m; int e;
+    if (!fsplit(f, s, m, e) || s != 0u) return 0u;
+    int sh = e + 16;
+    if (sh >= 9) return 0xFFFFFFFFu;
+    return sh >= 0 ? m << uint(sh) : (sh <= -24 ? 0u : m >> uint(-sh));
+}
+// A060/8630 height num/den in 16 bits, or -1 outside [0, 1)
+int height_q(int num, int den)
+{
+    if (den == 0) return -1;
+    uint fn = fcsflt(num * 256), fd = fcsflt(den * 256);
+    uint r = ffi(fd, frest(fd));
+    uint q = fmul(ffma(ffnms(fd, r, 0x3F800001u), r, r), fn);
+    if (q >= 0x3F800000u) return -1;
+    return int(fcfltu16(q));
+}
+uint slope_f(uint h, uint L)
+{
+    uint a = ffnms(fcuflt(h, 16), 0x40000000u, 0x40000000u);
+    uint lf = fcuflt(L, 0);
+    return fcfltu16(fmul(a, ffi(lf, frest(lf))));
+}
+
+uint slope(uint h, uint L) { return h == 0x8000u && L <= 2048u ? SL8[L] : slope_f(h, L); }
+
+// ---------------- flags ----------------
+uint chan(uint px, int c) { return (px >> uint(8 * c)) & 0xFFu; }
+uint flag(uint p, uint r, uint d, bool hasd)
+{
+    int s = int(chan(p, 0) + chan(p, 1) + chan(p, 2));
+    uint f = uint((s * 1365) >> 16);
+    bool er = false, ed = false;
+    for (int c = 0; c < 3; c++) {
+        er = er || abs(int(chan(p, c)) - int(chan(r, c))) >= 18;
+        ed = ed || abs(int(chan(p, c)) - int(chan(d, c))) >= 18;
+    }
+    int sr = int(chan(r, 0) + chan(r, 1) + chan(r, 2)), sd = int(chan(d, 0) + chan(d, 1) + chan(d, 2));
+    if (er) f |= 0x80u;
+    if (s > sr) f |= 0x20u;
+    if (hasd) { if (ed) f |= 0x40u; if (s > sd) f |= 0x10u; }
+    return f;
+}
+uint pcol(int x, int y) { return PC[x * H + y]; }
+uint flag_at(int x, int xr, int y)
+{
+    bool hasd = y + 1 < H;
+    uint f = flag(pcol(x, y), pcol(xr, y), hasd ? pcol(x, y + 1) : 0u, hasd);
+    if (y >= H - 4) f = (f & 0xF0u) | 2u;
+    return f;
+}
+uint swapb(uint a) { return (a & 0x0Fu) | ((a >> 1) & 0x50u) | ((a << 1) & 0xA0u); }
+
+// ---------------- one line pair per workgroup (REC1, REC2) ----------------
+// The flags of lines y-1 .. y+2 (positions 0..len; len stands for the next
+// line's first pixel, as the SPU's row buffers lie), the records of the
+// pair's runs and, per position, its run's records.
+const uint F_EDGE = 0x40u, F_CROSS = 0x80u, F_POL = 0x10u;
+int LEN1;                                 // the longest line + 1, rounded to 4 (1284 at 1280x720)
+shared uint sA[MAXLEN1];                  // 4 lines of bytes
+// in this workgroup's slice of SCR: records x0|x1<<16, h2|h3<<16, sa, sb | U<<30 | top<<31 (at most one per position)
+// and, per position, first record | count<<16, 0x80000000 one-pixel run, ~0 none
+uint g_rec, g_head, g_slot;
+shared uint sNrec;
+// runs without corners at both ends and longer than 2 (8630), scanned by all
+// threads: per slot x0 | n << 16, then per lane (AL, AR, BL, BR) the first/last
+// crossing at all and the first/last one with a usable height, as pos << 16 |
+// height (atomicMin/atomicMax keep the pair). A line of len has at most len / 3 such runs.
+shared uint sNslot;
+int g_pass, g_len, g_y, g_minline, g_oprow;
+// from memory, as the pass sees it; a job has no line before its first one
+// (r0-1): its first pair sees no flags above it (unlike the job before it)
+uint loadAL(int l, int p)
+{
+    if (p >= g_len) { l++; p -= g_len; }
+    if (l < g_minline || p < 0) return 0u;
+    if (g_pass == 2) return l < H ? F0[l * W + p] : 0u;
+    return l < W + 3 ? FC[l * H + p] : 0u;
+}
+uint AL(int l, int p)                     // l in y-1 .. y+2, p in 0 .. len
+{
+    int i = (l - g_y + 1) * LEN1 + p;
+    return (sA[i >> 2] >> uint(8 * (i & 3))) & 0xFFu;
+}
+int lum(uint a) { return int(a & 15u); }
+int lane_h(int y, int lane, int pos, int M)
+{
+    int A = y, B = y + 1, Ym = y - 1, Yp = y + 2;
+    int r76, r75, r77; bool d;
+    if (lane == 0) { int s = pos, sm = s > 0 ? s - 1 : 0;
+        r76 = lum(AL(A, s)) - lum(AL(B, s)); r75 = lum(AL(Ym, sm)) - lum(AL(A, sm));
+        r77 = lum(AL(Ym, sm)) - lum(AL(B, s)); d = (AL(Ym, sm) & F_EDGE) != 0u;
+    } else if (lane == 2) { int s = pos, sm = s > 0 ? s - 1 : 0;
+        r76 = lum(AL(B, s)) - lum(AL(A, s)); r75 = lum(AL(Yp, sm)) - lum(AL(B, sm));
+        r77 = lum(AL(Yp, sm)) - lum(AL(A, s)); d = (AL(B, sm) & F_EDGE) != 0u;
+    } else if (lane == 1) { int e = pos;
+        r76 = lum(AL(A, e + 1)) - lum(AL(Ym, e + 1)); r75 = lum(AL(B, e)) - lum(AL(A, e));
+        r77 = lum(AL(B, e)) - lum(AL(Ym, e + 1)); d = (AL(Ym, e + 1) & F_EDGE) != 0u;
+    } else { int e = pos;
+        r76 = lum(AL(B, e + 1)) - lum(AL(Yp, e + 1)); r75 = lum(AL(A, e)) - lum(AL(B, e));
+        r77 = lum(AL(A, e)) - lum(AL(Yp, e + 1)); d = (AL(B, e + 1) & F_EDGE) != 0u;
+    }
+    if (!d) return -1;
+    return height_q(r77 * M + (r76 - r75), (r76 + r75) * M + (r76 - r75));
+}
+#define SYNC() { memoryBarrierBuffer(); memoryBarrierShared(); barrier(); }
+int s16(uint v) { return int(v << 16) >> 16; }
+// The float steps are long code: each heavy helper has one call site (the
+// driver compiles the shader from scratch on a cold cache).
+void addrec(uint i, int x0, int x1, uint h2, uint h3, uint flags)
+{
+    uint n = uint(x1 - x0 + 1), sl[2];
+    for (int j = 0; j < 2; j++) { uint h = j == 0 ? h2 : h3; sl[j] = h != 0u ? slope(h, n) : 0u; }
+    SCR[g_rec + i] = uint(x0) | (uint(x1) << 16);
+    SCR[g_rec + i + 1u] = h2 | (h3 << 16);
+    SCR[g_rec + i + 2u] = sl[0];
+    SCR[g_rec + i + 3u] = sl[1] | flags;
+}
+// the records of an entry: Z shapes (B start / A end, then A start / B end), or without them U shapes
+void make_records(int x0, int x1, int pos[4], int h[4])
+{
+    bool z1 = pos[0] >= 0 && pos[3] >= 0 && pos[0] <= pos[3];
+    bool z2 = pos[2] >= 0 && pos[1] >= 0 && pos[2] <= pos[1];
+    bool ua = pos[0] >= 0 && pos[1] >= 0 && pos[0] <= pos[1] && !z1 && !z2;
+    bool ub = pos[2] >= 0 && pos[3] >= 0 && pos[2] <= pos[3] && !z1 && !z2;
+    // candidates in order z2, z1, ub, ua: start lane, end lane, U, top
+    const int sl_[4] = int[4](2, 0, 2, 0), el_[4] = int[4](1, 3, 3, 1);
+    bool on[4] = bool[4](z2, z1, ub, ua);
+    uint cnt = uint(z1) + uint(z2) + uint(ua) + uint(ub);
+    if (cnt == 0u) return;
+    uint first = atomicAdd(sNrec, cnt), k = 0u;
+    for (int c = 0; c < 4; c++) {
+        if (!on[c]) continue;
+        addrec(4u * (first + k), pos[sl_[c]], pos[el_[c]], uint(h[sl_[c]]), uint(h[el_[c]]),
+               (c >= 2 ? 0x40000000u : 0u) | ((c & 1) != 0 ? 0x80000000u : 0u));
+        k++;
+    }
+    for (int x = x0; x <= x1; x++) SCR[g_head + x] = first | (cnt << 16);
+}
+// 8630's candidate for one lane at offset k of a run (pos, M), or false
+bool cand(int y, int x0, int n, int k, int lane, out int ps, out int M)
+{
+    int x = x0 + k, r = lane < 2 ? y : y + 1, xc;
+    if (lane == 0 || lane == 2) { xc = x > 0 ? x - 1 : 0; ps = x; M = n - k; }
+    else { if (k == n - 1) return false; xc = x + 1; ps = x + 1; M = k + 2; }
+    return (AL(r, xc) & F_CROSS) != 0u;
+}
+// a run's entry: A060 with corners at both ends; else (n > 2) a slot for 8630,
+// which all threads scan together
+void run_records(int y, int x0, int n)
+{
+    int x1 = x0 + n - 1, xl = x0 > 0 ? x0 - 1 : 0;
+    bool c[4] = bool[4]((AL(y, xl) & F_CROSS) != 0u, (AL(y, x1) & F_CROSS) != 0u,
+                        (AL(y + 1, xl) & F_CROSS) != 0u, (AL(y + 1, x1) & F_CROSS) != 0u);
+    if ((c[0] || c[2]) && (c[1] || c[3])) {
+        int pos[4], h[4], pp[4] = int[4](x0, x1, x0, x1);
+        for (int k = 0; k < 4; k++) {
+            pos[k] = c[k] ? pp[k] : -1;
+            int hh = c[k] ? lane_h(y, k, pp[k], n) : -1;
+            h[k] = hh >= 0 ? hh : 0x8000;
+        }
+        make_records(x0, x1, pos, h);
+        return;
+    }
+    if (n <= 2) return;
+    uint sl = atomicAdd(sNslot, 1u);
+    int b = int(sl) * 9;
+    SSL[g_slot + b] = x0 | (n << 16);
+    for (int lane = 0; lane < 4; lane++) {
+        bool left = lane == 0 || lane == 2;
+        SSL[g_slot + b + 1 + lane] = left ? 0x7FFFFFFF : -1;     // any
+        SSL[g_slot + b + 5 + lane] = left ? 0x7FFFFFFF : -1;     // usable: pos << 16 | height
+    }
+    for (int x = x0; x <= x1; x++) SCR[g_head + x] = 0x40000000u | sl;
+}
+int accl(uint h, uint sa, bool signed_lane, int i)
+{
+    int r59 = h != 0u ? int(h + (sa >> 1)) : 0xFFFF;
+    int l = i & 3, q = i >> 2;
+    int cur = r59 + (signed_lane ? s16(sa) : int(sa & 0xFFFFu)) * l;
+    if (q > 0) cur = min(cur + 4 * int(sa) * q, 0xFFFF);
+    return cur;
+}
+// the op one record makes at position p (0: none); second: the target is line y+1
+uint rec_op(uint k, int p)
+{
+    uint i = 4u * k;
+    int x0 = int(SCR[g_rec + i] & 0xFFFFu), x1 = int(SCR[g_rec + i] >> 16);
+    uint h2 = SCR[g_rec + i + 1u] & 0xFFFFu, h3 = SCR[g_rec + i + 1u] >> 16, sa = SCR[g_rec + i + 2u], w3 = SCR[g_rec + i + 3u];
+    uint sb = w3 & 0x3FFFFFFFu; bool u = (w3 & 0x40000000u) != 0u, top = (w3 & 0x80000000u) != 0u;
+    int mid = (x0 + x1) >> 1, start = h2 != 0u ? x0 : mid, end = h3 != 0u ? x1 : mid;
+    if (p < start || p > end) return 0u;
+    int idx = p - start;
+    uint w; bool second;
+    if (u) {                                  // 8288: only line A
+        uint r21 = h3 != 0u ? 0xFFFFu - sb : 0xFFFFu, nsb = 0u - sb;
+        w = (p > mid ? uint(s16(uint(p - mid - 1)) * s16(nsb) + int(r21)) : uint(accl(h2, sa, true, idx))) >> 8;
+        second = !top;
+    } else if (p <= mid) {                    // 8000: line A up to the middle
+        w = uint(accl(h2, sa, false, idx)) >> 8; second = !top;
+    } else {                                  // then line B
+        uint r58 = h3 != 0u ? sb : 0xFFFFu;
+        w = (0xFFFFu - ((uint(p - mid - 1) & 0xFFFFu) * (sb & 0xFFFFu) + r58)) >> 8; second = top;
+    }
+    if (s16(w) == 255) return 0u;             // identity
+    return 0x80000000u | (second ? 0x20000000u : 0u) | (w & 0xFFFFFFu);
+}
+// the whole pair y: ops for every position into OPS
+void rec_pair(int y)
+{
+    g_y = y;
+    uint t = gl_LocalInvocationID.x;
+    for (uint i = t; i < uint(LEN1); i += 256u) {             // flags of 4 lines as bytes
+        uint w = 0u;
+        for (uint b = 0u; b < 4u; b++) {
+            int e = int(4u * i + b), l = e / LEN1, p = e % LEN1;
+            if (p <= g_len) w |= loadAL(y - 1 + l, p) << (8u * b);
+        }
+        sA[i] = w;
+    }
+    for (int p = int(t); p < g_len; p += 256) SCR[g_head + p] = 0xFFFFFFFFu;
+    if (t == 0u) { sNrec = 0u; sNslot = 0u; }
+    SYNC();
+    for (int p = int(t); p < g_len; p += 256) {               // run heads
+        uint a = AL(y, p);
+        if ((a & F_EDGE) == 0u) continue;
+        uint pol = a & F_POL;
+        if (p > 0) { uint b2 = AL(y, p - 1); if ((b2 & F_EDGE) != 0u && (b2 & F_POL) == pol) continue; }
+        int q = p + 1;
+        while (q < g_len) { uint b2 = AL(y, q); if ((b2 & F_EDGE) == 0u || (b2 & F_POL) != pol) break; q++; }
+        if (q - p == 1) SCR[g_head + p] = 0x80000000u;
+        else run_records(y, p, q - p);
+    }
+    SYNC();
+    uint nslot = sNslot;
+    if (nslot > 0u) {                                         // 8630 scans, all threads
+        for (int p = int(t); p < g_len; p += 256) {
+            uint hd = SCR[g_head + p];
+            if ((hd & 0xC0000000u) != 0x40000000u) continue;
+            int b = int(hd & 0xFFFFu) * 9, x0 = SSL[g_slot + b] & 0xFFFF, n = SSL[g_slot + b] >> 16, k = p - x0;
+            for (int lane = 0; lane < 4; lane++) {
+                int ps, M;
+                if (!cand(y, x0, n, k, lane, ps, M)) continue;
+                bool left = lane == 0 || lane == 2;
+                if (left) atomicMin(SSL[g_slot + b + 1 + lane], ps); else atomicMax(SSL[g_slot + b + 1 + lane], ps);
+                int hh = lane_h(y, lane, ps, M);
+                if (hh < 0) continue;
+                if (left) atomicMin(SSL[g_slot + b + 5 + lane], (ps << 16) | hh); else atomicMax(SSL[g_slot + b + 5 + lane], (ps << 16) | hh);
+            }
+        }
+        SYNC();
+        for (uint sl = t; sl < nslot; sl += 256u) {
+            int b = int(sl) * 9, pos[4], h[4];
+            int x0 = SSL[g_slot + b] & 0xFFFF, n = SSL[g_slot + b] >> 16;
+            for (int lane = 0; lane < 4; lane++) {
+                int a = SSL[g_slot + b + 1 + lane], v = SSL[g_slot + b + 5 + lane];
+                bool left = lane == 0 || lane == 2;
+                bool hasv = left ? v != 0x7FFFFFFF : v >= 0, hasa = left ? a != 0x7FFFFFFF : a >= 0;
+                if (hasv) { pos[lane] = v >> 16; h[lane] = v & 0xFFFF; }
+                else if (hasa) { pos[lane] = a; h[lane] = 0x8000; }
+                else { pos[lane] = -1; h[lane] = 0; }
+            }
+            for (int x = x0; x < x0 + n; x++) SCR[g_head + x] = 0xFFFFFFFFu;
+            make_records(x0, x0 + n - 1, pos, h);
+        }
+        SYNC();
+    }
+    for (int p = int(t); p < g_len; p += 256) {               // ops per position
+        uint hd = SCR[g_head + p], o0 = 0u, o1 = 0u;
+        if (hd == 0x80000000u) o0 = 0xC0000000u;
+        else if (hd != 0xFFFFFFFFu) {
+            uint first = hd & 0xFFFFu, cnt = hd >> 16;
+            for (uint k = 0u; k < cnt; k++) {
+                uint o = rec_op(first + k, p);
+                if (o == 0u) continue;
+                if (o0 == 0u) o0 = o; else o1 = o;
+            }
+        }
+        uint i = uint(g_oprow * g_len + p) * 2u;
+        OPS[i] = o0; OPS[i + 1u] = o1;
+    }
+    SYNC();                                                   // the slice is the next pair's
+}
+
+// ---------------- applying ops ----------------
+uint mixpx(uint a, uint b, uint w)
+{
+    uint r = a & 0xFF000000u;
+    int ws = s16(w);
+    for (int c = 0; c < 3; c++) {
+        int va = int(chan(a, c)), vb = int(chan(b, c));
+        int v = vb * 256 + (va - vb) * ws + (va - vb);
+        r |= (uint(v >> 8) & 0xFFu) << uint(8 * c);
+    }
+    return r;
+}
+void apply(uint op, inout uint a, inout uint b)
+{
+    if (op == 0u) return;
+    if ((op & 0x40000000u) != 0u) {
+        uint na = a & 0xFF000000u, nb = b & 0xFF000000u;
+        for (int c = 0; c < 3; c++) {
+            uint va = chan(a, c), vb = chan(b, c);
+            na |= ((224u * va + 32u * vb) >> 8) << uint(8 * c);
+            nb |= ((224u * vb + 32u * va) >> 8) << uint(8 * c);
+        }
+        a = na; b = nb;
+    } else if ((op & 0x20000000u) != 0u) b = mixpx(b, a, op);
+    else a = mixpx(a, b, op);
+}
+
+void main()
+{
+    int gx = int(gl_GlobalInvocationID.x), gy = int(gl_GlobalInvocationID.y);
+    int st = pc.stage;
+    W = pc.w; H = pc.h; CJ = pc.cj; RJ = pc.rj;
+    int L = max(W, H);
+    LEN1 = (L + 4) & ~3;
+    g_head = gl_WorkGroupID.x * uint(5 * L); g_rec = g_head + uint(L);
+    g_slot = gl_WorkGroupID.x * uint(9 * (L / 3 + 2));
