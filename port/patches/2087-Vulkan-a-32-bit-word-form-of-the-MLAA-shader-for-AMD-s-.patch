+        if (pc.job > 0) { int x = CJ * pc.job - 1; FC[x * H + y] = swapb(flag_at(x, x + 1, y)); }
+        if (pc.job == JOBS - 1) {
+            uint f = flag_at(W - 1, 1, y);
+            FC[(W - 1) * H + y] = swapb(f); F0[y * W + W - 1] = f;        // also what it leaves in alpha
+            for (int k = 0; k < 3; k++) FC[(W + k) * H + y] = swapb(flag_at(1 + k, 2 + k, y));
+        }
+    } else if (st == 3) {                              // REC1: the job's line pairs, in turn
+        g_pass = 1; g_len = H;
+        int r0 = CJ * pc.job, lo = max(r0 - 1, 0), last = pc.job == JOBS - 1 ? W - 1 : r0 + CJ - 1;
+        g_minline = lo;
+        for (int k = int(gl_WorkGroupID.x); lo + k <= last; k += int(gl_NumWorkGroups.x)) {
+            g_oprow = lo + k;
+            rec_pair(lo + k);
+        }
+    } else if (st == 4) {                              // CHAIN1: gx row, gy line - lo
+        int row = gx, r0 = CJ * pc.job, r1 = r0 + CJ - 1, lo = max(r0 - 1, 0), last = pc.job == JOBS - 1 ? W - 1 : r1;
+        int l = lo + gy;
+        if (row >= H || l > last) return;
+        if (OPS[uint(l * H + row) * 2u] == 0u) return;
+        if (l > lo && OPS[uint((l - 1) * H + row) * 2u] != 0u) return;
+        uint cur = PC[l * H + row];
+        int m = l;
+        for (; m <= last; m++) {
+            uint i = uint(m * H + row) * 2u, o0 = OPS[i];
+            if (o0 == 0u) break;
+            int nl = m + 1 < W ? m + 1 : m + 1 - W + 1;          // past column W-1: column 1
+            uint nxt = PC[nl * H + row];
+            apply(o0, cur, nxt);
+            apply(OPS[i + 1u], cur, nxt);
+            if (m >= r0) PC[m * H + row] = cur;
+            cur = nxt;
+        }
+        if (m >= r0 && m <= r1) PC[m * H + row] = cur;
+    } else if (st == 5) {                              // PREP2
+        if (gx >= W || gy >= H) return;
+        PR[gy * W + gx] = PC[gx * H + gy];
+    } else if (st == 6) {                              // REC2: every pair, then each later row job's first, in turn
+        g_pass = 2; g_len = W;
+        for (int k = int(gl_WorkGroupID.x); k < H - 1 + JOBS - 1; k += int(gl_NumWorkGroups.x)) {
+            int y = k;
+            g_minline = 0; g_oprow = y;
+            if (y >= H - 1) {                         // a job's first pair, as that job sees it
+                int j = y - (H - 1) + 1;              // ops in row H + j - 1
+                g_oprow = H + j - 1; y = RJ * j - 1; g_minline = y;
+            }
+            rec_pair(y);
+        }
+    } else if (st == 7) {                              // CHAIN2: gx column, gy row - lo, one job
+        int x = gx, r0 = RJ * pc.job, r1 = r0 + RJ - 1, lo = max(r0 - 1, 0), last = min(r1, H - 2);
+        int y = lo + gy, seam = pc.job > 0 ? H + pc.job - 1 : lo;   // the first pair's own ops
+        if (x >= W || y > last) return;
+        if (OPS[uint((y == lo ? seam : y) * W + x) * 2u] == 0u) return;
+        if (y > lo && OPS[uint((y - 1 == lo ? seam : y - 1) * W + x) * 2u] != 0u) return;
+        uint cur = PR[y * W + x];
+        int m = y;
+        for (; m <= last; m++) {
+            uint i = uint((m == lo ? seam : m) * W + x) * 2u, o0 = OPS[i];
+            if (o0 == 0u) break;
+            uint nxt = PR[(m + 1) * W + x];
+            apply(o0, cur, nxt);
+            apply(OPS[i + 1u], cur, nxt);
+            if (m >= r0) PR[m * W + x] = cur;
+            cur = nxt;
+        }
+        if (m >= r0 && m <= r1) PR[m * W + x] = cur;
+    } else if (st == 9) {                              // SLOPES
+        if (gx < 2049) SL8[gx] = slope_f(0x8000u, uint(gx));
+    } else {                                           // STORE
+        if (gx >= W || gy >= H) return;
+        IMG[gy * W + gx] = (PR[gy * W + gx] & 0x00FFFFFFu) | (F0[gy * W + gx] << 24);
+    }
+}
