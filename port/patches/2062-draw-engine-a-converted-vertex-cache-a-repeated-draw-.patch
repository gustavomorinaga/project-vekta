--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -230,6 +230,14 @@ static struct {
     u32 index_cap;
 
     rsx_fp_constant_block fp_constants;
+
+    /* The converted-vertex cache, when the backend offers one. */
