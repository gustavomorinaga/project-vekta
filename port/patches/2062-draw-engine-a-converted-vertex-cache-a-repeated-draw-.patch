+"""Run the converted-vertex cache's C tests: its bookkeeping alone, and the draw engine with a stub backend."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    if os.name == "nt":
+        print("SKIP: neutral C fixture requires the POSIX toolchain; run on macOS/Linux")
+        return
+    root = Path(__file__).resolve().parents[1]
+    builds = {
+        "test_vertex_cache": ["tests/test_vertex_cache.c", "rsx_vertex_compact.c", "rsx_dispatch.c"],
+        "test_engine_vertex_cache": ["tests/test_engine_vertex_cache.c", "rsx_dispatch.c",
+                                     "rsx_vertex_compact.c", "rsx_texture_layout.c",
+                                     "rsx_vp_decompiler.c", "rsx_fp_decompiler.c",
+                                     "../../runtime/ps3_trace.c", "../../runtime/memory/vm_wtrack.c"],
+    }
+    with tempfile.TemporaryDirectory(prefix="rsx-vcache-") as directory:
+        for name, sources in builds.items():
+            binary = Path(directory) / name
+            subprocess.run([os.environ.get("CC", "cc"), "-std=gnu17", "-O1",
+                            "-Iinclude", "-Ilibs/video", "-Ilibs/video/tests", "-o", str(binary),
+                            *["libs/video/" + s for s in sources], "-lpthread"], cwd=root, check=True)
+            subprocess.run([str(binary)], cwd=root, check=True)
+
+
+if __name__ == "__main__":
+    main()
