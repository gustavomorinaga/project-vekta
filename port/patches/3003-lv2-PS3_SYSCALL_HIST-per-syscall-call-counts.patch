From 5836bffcbdaa8d6ba81bede150828d36f02796e0 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 05:29:13 -0300
Subject: [PATCH] lv2: PS3_SYSCALL_HIST per-syscall call counts

---
 runtime/syscalls/lv2_register.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/runtime/syscalls/lv2_register.c b/runtime/syscalls/lv2_register.c
index 96266731..05e04b28 100644
--- a/runtime/syscalls/lv2_register.c
+++ b/runtime/syscalls/lv2_register.c
@@ -10,6 +10,7 @@
  * remain available as direct C calls for the runtime to use.
  */
 
+#include <time.h>
 #include <stdlib.h>   /* calloc, free */
 #include "ps3emu/nid.h"   /* ps3_compute_nid (static inline) */
 #include "lv2_syscall_table.h"
@@ -2647,6 +2648,20 @@ int lv2_try_syscall(ppu_context* ctx)
     lv2_syscall_fn h = g_lv2_syscalls.handlers[num];
     if (!h || h == lv2_syscall_unimplemented)
         return 0;
+    /* PS3_SYSCALL_HIST=<s>: calls per syscall number every <s> seconds -- which
+     * timing calls a title makes per frame, for one. Unlocked counters. */
+    { static long s_h = -1; if (s_h < 0) { const char* e = getenv("PS3_SYSCALL_HIST"); s_h = e ? atol(e) : 0; }
+      if (s_h > 0) {
+        static unsigned long n[LV2_SYSCALL_MAX]; static time_t t0;
+        n[num]++;
+        time_t now = time(NULL);
+        if (!t0) t0 = now;
+        if (now - t0 >= s_h) {
+            t0 = now;
+            fprintf(stderr, "[syscalls] last %lds:", s_h);
+            for (unsigned i = 0; i < LV2_SYSCALL_MAX; i++) if (n[i]) { fprintf(stderr, " %u:%lu", i, n[i]); n[i] = 0; }
+            fputc(10, stderr);
+        } } }
     /* YDKJ diag: full event-syscall trace (#128..141) during SPURS init to find
      * why libsre asserts ESRCH in event_helper.c. Snapshot args BEFORE handler. */
     uint32_t _a3 = (uint32_t)ctx->gpr[3], _a4 = (uint32_t)ctx->gpr[4], _a5 = (uint32_t)ctx->gpr[5];
-- 
2.56.0

