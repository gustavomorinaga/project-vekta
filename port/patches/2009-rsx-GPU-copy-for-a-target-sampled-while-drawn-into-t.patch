diff --git a/runtime/ps3_trace.c b/runtime/ps3_trace.c
new file mode 100644
index 00000000..e3e0f831
--- /dev/null
+++ b/runtime/ps3_trace.c
@@ -0,0 +1,97 @@
+/* PS3_TRACE: see ps3_trace.h. */
+#include "ps3_trace.h"
+#ifdef _WIN32
+volatile int g_ps3_trace_on;
+uint64_t ps3_trace_now(void) { return 0; }
+void ps3_trace_span(const char* n, uint64_t a, uint64_t b, uint32_t c) { (void)n; (void)a; (void)b; (void)c; }
+void ps3_trace_arm(void) {}
+#else
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+volatile int g_ps3_trace_on;
+
+typedef struct { const char* name; uint64_t t0, t1; uint32_t arg; int tid; } span;
+enum { MAX_SPANS = 1 << 22 };
+static span* s_spans;
+static volatile unsigned s_n;
+static volatile uint64_t s_start_ns;
+static uint64_t s_end_ns;
+static char s_file[512] = "ps3_trace.json";
+static double s_secs;
+
+/* Start recording now, if PS3_TRACE asked for a start of 0 and it has not
+ * started yet: a port arms it when the scene it wants is on screen. */
+void ps3_trace_arm(void)
+{
+    if (!s_spans || s_start_ns) return;
+    s_end_ns = ps3_trace_now() + (uint64_t)(s_secs * 1e9);
+    __atomic_store_n(&s_start_ns, ps3_trace_now(), __ATOMIC_RELEASE);
+}
+
+uint64_t ps3_trace_now(void)
+{
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+
+static void* writer(void* p)
+{
+    (void)p;
+    uint64_t now = ps3_trace_now();
+    /* start 0: wait for ps3_trace_arm() */
+    while (!s_start_ns) { struct timespec ts = { 0, 10000000 }; nanosleep(&ts, NULL); now = ps3_trace_now(); }
+    if (s_start_ns > now) { uint64_t d = s_start_ns - now; struct timespec ts = { (time_t)(d / 1000000000ull), (long)(d % 1000000000ull) }; nanosleep(&ts, NULL); }
+    g_ps3_trace_on = 1;
+    fprintf(stderr, "[ps3-trace] recording\n");
+    now = ps3_trace_now();
+    if (s_end_ns > now) { uint64_t d = s_end_ns - now; struct timespec ts = { (time_t)(d / 1000000000ull), (long)(d % 1000000000ull) }; nanosleep(&ts, NULL); }
+    g_ps3_trace_on = 0;
+    struct timespec ts = { 0, 50000000 }; nanosleep(&ts, NULL);
+    FILE* f = fopen(s_file, "w");
+    if (!f) return NULL;
+    const unsigned n = s_n < MAX_SPANS ? s_n : MAX_SPANS;
+    fprintf(f, "{\"traceEvents\":[\n");
+    for (unsigned i = 0; i < n; i++) {
+        const span* e = &s_spans[i];
+        if (!e->name) continue;
+        fprintf(f, "%s{\"name\":\"%s\",\"ph\":\"X\",\"pid\":1,\"tid\":%d,\"ts\":%.3f,\"dur\":%.3f,\"args\":{\"a\":\"0x%X\"}}\n",
+                i ? "," : "", e->name, e->tid, (e->t0 - s_start_ns) / 1000.0, (e->t1 - e->t0) / 1000.0, e->arg);
+    }
+    fprintf(f, "]}\n");
+    fclose(f);
+    fprintf(stderr, "[ps3-trace] %u spans -> %s\n", n, s_file);
+    return NULL;
+}
+
+__attribute__((constructor)) static void ps3_trace_init(void)
+{
+    const char* e = getenv("PS3_TRACE");
+    if (!e) return;
+    double start = 0, secs = 5;
+    sscanf(e, "%lf,%lf,%511s", &start, &secs, s_file);
+    s_spans = (span*)calloc(MAX_SPANS, sizeof(span));
+    if (!s_spans) return;
+    s_secs = secs;
+    if (start > 0) {
+        s_end_ns = ps3_trace_now() + (uint64_t)((start + secs) * 1e9);
+        __atomic_store_n(&s_start_ns, ps3_trace_now() + (uint64_t)(start * 1e9), __ATOMIC_RELEASE);
+    }
+    pthread_t t; pthread_create(&t, NULL, writer, NULL); pthread_detach(t);
+}
+
+void ps3_trace_span(const char* name, uint64_t t0, uint64_t t1, uint32_t arg)
+{
+    const unsigned i = __sync_fetch_and_add(&s_n, 1);
+    if (i >= MAX_SPANS) return;
+    static __thread int tid;
+    if (!tid) tid = (int)syscall(SYS_gettid);
+    s_spans[i].t0 = t0; s_spans[i].t1 = t1; s_spans[i].arg = arg; s_spans[i].tid = tid;
+    __atomic_store_n(&s_spans[i].name, name, __ATOMIC_RELEASE);
+}
+#endif
diff --git a/runtime/ps3_trace.h b/runtime/ps3_trace.h
new file mode 100644
index 00000000..c9d72f99
--- /dev/null
+++ b/runtime/ps3_trace.h
@@ -0,0 +1,24 @@
+/*
+ * PS3_TRACE="<start s>,<seconds>[,<file>]" (start 0: when the port calls ps3_trace_arm): a timeline of what each host
+ * thread spends its time on, as Chrome trace JSON (chrome://tracing,
+ * ui.perfetto.dev). Spans are recorded from <start> seconds after launch for
+ * <seconds>, then written once (default ps3_trace.json). Off, a span is one
+ * load and a branch.
+ */
+#ifndef PS3_TRACE_H
+#define PS3_TRACE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern volatile int g_ps3_trace_on;
+uint64_t ps3_trace_now(void);
+void ps3_trace_span(const char* name, uint64_t t0_ns, uint64_t t1_ns, uint32_t arg);
+/* PS3_TRACE="0,<seconds>,...": recording waits for this call. */
+void ps3_trace_arm(void);
+#define PS3_TRACE_BEGIN(v) uint64_t v = g_ps3_trace_on ? ps3_trace_now() : 0
+#define PS3_TRACE_END(v, name, arg) do { if (v && g_ps3_trace_on) ps3_trace_span((name), (v), ps3_trace_now(), (uint32_t)(arg)); } while (0)
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/runtime/syscalls/sys_timer.c b/runtime/syscalls/sys_timer.c
index b8ac7133..a72d6c4d 100644
--- a/runtime/syscalls/sys_timer.c
+++ b/runtime/syscalls/sys_timer.c
@@ -5,6 +5,7 @@
 #ifndef _DEFAULT_SOURCE
 #define _DEFAULT_SOURCE /* tm_gmtoff on glibc */
 #endif
+#include "../ps3_trace.h"
 #include "sys_timer.h"
 #include "sys_ppu_thread.h"   /* ppu_thread_note_block */
 #include <time.h>
@@ -134,6 +135,11 @@ static void write_be64(uint32_t addr, uint64_t val)
  *
  * r3 = microseconds
  * -----------------------------------------------------------------------*/
+/* PS3_POLLTOP's real time per site: the sleep below is timed and charged to
+ * the site this call came from. */
+static unsigned long long s_pt_real_us[128];
+static __thread int t_pt_site = -1;
+
 int64_t sys_timer_usleep(ppu_context* ctx)
 {
     uint64_t usec = LV2_ARG_U64(ctx, 0);
@@ -176,7 +182,7 @@ int64_t sys_timer_usleep(ppu_context* ctx)
             pt_tid[pt_used] = (uint32_t)ctx->thread_id;
             pt_used++;
         }
-        if (i < PT_MAX) { pt_n[i]++; pt_us[i] += usec; }
+        if (i < PT_MAX) { pt_n[i]++; pt_us[i] += usec; t_pt_site = i; }
         { extern unsigned long long ps3_qpc_us(void);
           unsigned long long now = ps3_qpc_us();
           if (!pt_win) pt_win = now;
@@ -187,13 +193,14 @@ int64_t sys_timer_usleep(ppu_context* ctx)
               for (int j = 0; j < pt_used; j++)
                 if (pt_n[j] && (best < 0 || pt_n[j] > pt_n[best])) best = j;
               if (best < 0) break;
-              fprintf(stderr, "  %8u calls  %6llums slept  tid=%-3u lr=0x%08X\n",
+              fprintf(stderr, "  %8u calls  %6llums slept (%6llums real)  tid=%-3u lr=0x%08X\n",
                       pt_n[best], (unsigned long long)(pt_us[best] / 1000),
+                      s_pt_real_us[best] / 1000,
                       pt_tid[best], pt_lr[best]);
               pt_n[best] = 0;
             }
             fflush(stderr);
-            for (int j = 0; j < pt_used; j++) { pt_n[j] = 0; pt_us[j] = 0; }
+            for (int j = 0; j < pt_used; j++) { pt_n[j] = 0; pt_us[j] = 0; s_pt_real_us[j] = 0; }
             pt_win = now;
           } } } }
 
@@ -288,7 +295,16 @@ int64_t sys_timer_usleep(ppu_context* ctx)
         struct timespec ts;
         ts.tv_sec  = (time_t)(usec / 1000000);
         ts.tv_nsec = (long)((usec % 1000000) * 1000);
+        struct timespec a0, a1;
+        if (t_pt_site >= 0) clock_gettime(CLOCK_MONOTONIC, &a0);
+        PS3_TRACE_BEGIN(_tr);
         nanosleep(&ts, NULL);
+        PS3_TRACE_END(_tr, "usleep", ctx->lr);
+        if (t_pt_site >= 0) {
+            clock_gettime(CLOCK_MONOTONIC, &a1);
+            s_pt_real_us[t_pt_site] += (unsigned long long)((a1.tv_sec - a0.tv_sec) * 1000000 + (a1.tv_nsec - a0.tv_nsec) / 1000);
+            t_pt_site = -1;
+        }
     }
 #endif
 
