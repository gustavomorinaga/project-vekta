From f4318db3c0e61e30d1db636b7abf78c4f78e3110 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 28 Oct 2026 17:08:00 -0300
Subject: [PATCH] SPURS: PS3_SPURS_PM_SELECT=1 answers a policy module's
 selectWorkload poll with its current workload; PS3_SPURS_WANTED=2 is the real
 kernel's admission rule

After project-helghast's patch 1058 (MIT). Answered 0, every job manager but
wid 0's was told to switch after each job.

---
 libs/spurs/cellSpurs.c     |  7 ++++---
 runtime/spu/spu_channels.c | 10 +++++++++-
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 3ecfc154..993243d2 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -532,11 +532,12 @@ static void spurs_api_unlock(struct SpursInst* si)
 }
 
 /* PS3_SPURS_WANTED=1 (experiment): workloads run only when kicked or when they
- * asked for idle SPUs (cellSpursRequestIdleSpu), not on the idle probes. */
+ * asked for idle SPUs (cellSpursRequestIdleSpu), not on the idle probes;
+ * =2 only when kicked (a ready count or a signal), the real kernel's rule. */
 static int spurs_wanted_only(void)
 {
     static int on = -1;
-    if (on < 0) { const char* e = getenv("PS3_SPURS_WANTED"); on = e && *e == '1'; }
+    if (on < 0) { const char* e = getenv("PS3_SPURS_WANTED"); on = e ? atoi(e) : 0; }
     return on;
 }
 
@@ -1926,7 +1927,7 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
                      * patch 1074 ports it): an unkicked workload runs only on
                      * the idle SPUs it asked for, never on a probe */
                     const u32 idle_req = vm_read8(ea + SPURS_WKL_IDLE2 + wid);
-                    if (!(idle_req > si->active[wid])) continue;
+                    if (spurs_wanted_only() == 2 || !(idle_req > si->active[wid])) continue;
                 } else if (!kicked && (kick_pass || (si->pass_no & ((1u << si->idle[wid]) - 1))))
                     continue;
                 spu_lockline_lock();
diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index 60f0329f..636c6066 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -2683,7 +2683,15 @@ void spu_indirect_branch(spu_context* ctx)
               if (s_t && (n <= 4 || (n % 4096) == 0) && s_poll_logs++ < 64)
                   fprintf(stderr, "[spurs-pm] poll #%u (r3=0x%08X) -> continue\n",
                           n, ctx->gpr[3]._u32[0]); }
-            ctx->gpr[3] = spu_make_preferred_u32(0);
+            /* PS3_SPURS_PM_SELECT=1: answer the current workload id
+             * (wklCurrentId, LS 0x1DC), so a WWS job manager runs its jobs
+             * back to back; 0 told every one but wid 0 to switch, one job per
+             * kernel run (project-helghast's patch 1058, MIT). */
+            { static int cur_on = -1;
+              if (cur_on < 0) { const char* e = getenv("PS3_SPURS_PM_SELECT"); cur_on = e && *e == '1'; }
+              const uint32_t cur = cur_on ? ((uint32_t)ctx->ls[0x1DC] << 24 | (uint32_t)ctx->ls[0x1DD] << 16 |
+                                              (uint32_t)ctx->ls[0x1DE] << 8 | ctx->ls[0x1DF]) : 0;
+              ctx->gpr[3] = spu_make_preferred_u32(cur < 16 ? cur : 0); }
             ctx->pc = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
             return;
         }
