From ca2c9f37080d3f79a0ebfdf85aa38d762f816943 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 4 Nov 2026 19:55:13 -0300
Subject: [PATCH] vulkan: the sprint motion blur over a temporal
 upscaler's output

Under DLSS or FSR 3 the jm_post motion blur no longer drops out: its
image stages run on a 1280x720 copy of the upscaled output (blitted into
a staging image, then the MLAA's buffer), and a new stage 5 (BLEND_OUT)
blends its 640x360 layer over the output at the output's size,
upsampled bilinearly. The plain path is unchanged (its set's new storage
image binding is a 1x1 stand-in). The device also gets independentBlend
and format-less storage writes when an upscaler is on.

---
 libs/video/rsx_vulkan_backend.c        |  135 ++-
 libs/video/vulkan/rsx_vk_mb.comp       |   22 +-
 libs/video/vulkan/rsx_vk_mb_comp.spv.h | 1297 +++++++++++++-----------
 3 files changed, 859 insertions(+), 595 deletions(-)

diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 28cddf47..28f16801 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3697,6 +3697,14 @@ static struct {
     VkDescriptorSet       set;
     vk_buffer             buf[4];
     int                   ok;
+    /* under a temporal upscaler (vk_mb_record_out): the output's 1280x720
+     * copy, and a set for each output image (binding 5); the plain set's
+     * binding 5 is a 1x1 stand-in */
+    vk_image              dummy, small;
+    VkDescriptorSet       oset[4];
+    VkImage               oset_for[4];
+    int                   ow, oh;       /* BLEND_OUT's size for the next dispatches */
+    int                   dummy_ready;
 } s_mb;
 /* On unless PS3RECOMP_MB_ON=0; rsx_vulkan_set_motion_blur switches it at once
  * (a title's options screen). */
@@ -3710,12 +3718,13 @@ static int vk_mb_on(void)
 
 static int vk_mb_init(void)
 {
-    VkDescriptorSetLayoutBinding b[5];
+    VkDescriptorSetLayoutBinding b[6];
     for (u32 i = 0; i < 5; i++) b[i] = (VkDescriptorSetLayoutBinding){ i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    b[5] = (VkDescriptorSetLayoutBinding){ 5, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL };
     VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
-                                            .bindingCount = 5, .pBindings = b };
+                                            .bindingCount = 6, .pBindings = b };
     if (pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_mb.dsl) != VK_SUCCESS) return -1;
-    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 8 };
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 16 };
     VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
                                        .setLayoutCount = 1, .pSetLayouts = &s_mb.dsl,
                                        .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
@@ -3737,21 +3746,30 @@ static int vk_mb_init(void)
     for (u32 i = 0; i < 4; i++)
         if (vk_create_device_buffer(&s_mb.buf[i], sz[i], VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT |
                                     VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT)) return -1;
-    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 5 };
+    VkDescriptorPoolSize ps[2] = { { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 5 * 5 }, { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 5 } };
     VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
-                                      .maxSets = 1, .poolSizeCount = 1, .pPoolSizes = &ps };
+                                      .maxSets = 5, .poolSizeCount = 2, .pPoolSizes = ps };
     if (pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_mb.pool) != VK_SUCCESS) return -1;
-    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
-                                       .descriptorPool = s_mb.pool, .descriptorSetCount = 1, .pSetLayouts = &s_mb.dsl };
-    if (pvkAllocateDescriptorSets(s_vk.device, &ai, &s_mb.set) != VK_SUCCESS) return -1;
-    VkDescriptorBufferInfo dbi[5]; VkWriteDescriptorSet wr[5];
-    for (u32 i = 0; i < 5; i++) {
-        dbi[i] = (VkDescriptorBufferInfo){ i ? s_mb.buf[i - 1].buf : s_mlaa.buf[0].buf, 0, VK_WHOLE_SIZE };
-        wr[i] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_mb.set,
-                                        .dstBinding = i, .descriptorCount = 1,
-                                        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &dbi[i] };
+    /* made on the pipeline thread: laid out GENERAL on the RSX thread at first use (dummy_ready) */
+    if (vk_create_image(&s_mb.dummy, VK_FORMAT_R8G8B8A8_UNORM, 1, 1, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+    VkDescriptorSet* sets[5] = { &s_mb.set, &s_mb.oset[0], &s_mb.oset[1], &s_mb.oset[2], &s_mb.oset[3] };
+    for (u32 k = 0; k < 5; k++) {
+        VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                           .descriptorPool = s_mb.pool, .descriptorSetCount = 1, .pSetLayouts = &s_mb.dsl };
+        if (pvkAllocateDescriptorSets(s_vk.device, &ai, sets[k]) != VK_SUCCESS) return -1;
+        VkDescriptorBufferInfo dbi[5]; VkWriteDescriptorSet wr[6];
+        for (u32 i = 0; i < 5; i++) {
+            dbi[i] = (VkDescriptorBufferInfo){ i ? s_mb.buf[i - 1].buf : s_mlaa.buf[0].buf, 0, VK_WHOLE_SIZE };
+            wr[i] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = *sets[k],
+                                            .dstBinding = i, .descriptorCount = 1,
+                                            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &dbi[i] };
+        }
+        VkDescriptorImageInfo dii = { VK_NULL_HANDLE, s_mb.dummy.view, VK_IMAGE_LAYOUT_GENERAL };
+        wr[5] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = *sets[k],
+                                        .dstBinding = 5, .descriptorCount = 1,
+                                        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &dii };
+        pvkUpdateDescriptorSets(s_vk.device, 6, wr, 0, NULL);
     }
-    pvkUpdateDescriptorSets(s_vk.device, 5, wr, 0, NULL);
     s_mb.ok = 1;
     return 0;
 }
@@ -3858,7 +3876,7 @@ static void vk_mlaa_barrier(void)
 }
 static void vk_mb_stage(int stage, int job, u32 gx, int indirect)
 {
-    const int pc[2] = { stage, job };
+    const int pc[4] = { stage, job, s_mb.ow, s_mb.oh };
     pvkCmdPushConstants(s_vk.cmd, s_mb.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
     if (indirect >= 0) pvkCmdDispatchIndirect(s_vk.cmd, s_mb.buf[3].buf, (VkDeviceSize)indirect);
     else pvkCmdDispatch(s_vk.cmd, gx, 1, 1);
@@ -3867,9 +3885,18 @@ static void vk_mb_stage(int stage, int job, u32 gx, int indirect)
 /* The motion blur on s_mlaa.buf[0] (the MLAA's result, raw texels) with the
  * field target's top-left 640x360; none of its image stages run when the
  * field has no strength anywhere (indirect sizes of 0). */
+static void vk_mb_dummy_layout(void)
+{
+    if (s_mb.dummy_ready) return;
+    vk_barrier_image(s_mb.dummy.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    s_mb.dummy_ready = 1;
+}
+
 static void vk_mb_record(vk_eng_obj* f)
 {
     const u32 HW = 640, HH = 360;
+    vk_mb_dummy_layout();
+    s_mb.ow = s_mb.oh = 0;
     vk_barrier_image(f->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
     VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { HW, HH, 1 } };
     pvkCmdCopyImageToBuffer(s_vk.cmd, f->im.img, VK_IMAGE_LAYOUT_GENERAL, s_mb.buf[0].buf, 1, &region);
@@ -3884,6 +3911,59 @@ static void vk_mb_record(vk_eng_obj* f)
     vk_mb_stage(3, 0, 0, 16);                             /* BLEND */
     vk_barrier_image(f->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
 }
+/* Under a temporal upscaler: the motion blur over its output (ow x oh, slot
+ * `slot`'s image). The image stages run on a 1280x720 copy of it (blitted
+ * into `small`, then into s_mlaa.buf[0]); the blend runs at the output's size. */
+static void vk_mb_record_out(vk_eng_obj* f, VkImage out, VkImageView view, u32 ow, u32 oh, int slot)
+{
+    const u32 HW = 640, HH = 360, W = 1280, H = 720;
+    if (!s_mb.small.img) {
+        if (vk_create_image(&s_mb.small, VK_FORMAT_R8G8B8A8_UNORM, W, H,
+                            VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&s_mb.small); return;
+        }
+        if (vk_batch_reserve(0)) return;
+        vk_barrier_image(s_mb.small.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    }
+    if (s_mb.oset_for[slot] != out) {
+        vk_flush();   /* the set may be in a submission still */
+        VkDescriptorImageInfo dii = { VK_NULL_HANDLE, view, VK_IMAGE_LAYOUT_GENERAL };
+        VkWriteDescriptorSet wr = { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_mb.oset[slot],
+                                    .dstBinding = 5, .descriptorCount = 1,
+                                    .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &dii };
+        pvkUpdateDescriptorSets(s_vk.device, 1, &wr, 0, NULL);
+        s_mb.oset_for[slot] = out;
+    }
+    if (vk_batch_reserve(0)) return;
+    vk_barrier_image(out, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(s_mb.small.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit blit = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                         .srcOffsets = { { 0, 0, 0 }, { (int32_t)ow, (int32_t)oh, 1 } },
+                         .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                         .dstOffsets = { { 0, 0, 0 }, { (int32_t)W, (int32_t)H, 1 } } };
+    pvkCmdBlitImage(s_vk.cmd, out, VK_IMAGE_LAYOUT_GENERAL, s_mb.small.img, VK_IMAGE_LAYOUT_GENERAL, 1, &blit,
+                    ow == W && oh == H ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+    vk_barrier_image(s_mb.small.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkBufferImageCopy full = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { W, H, 1 } };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, s_mb.small.img, VK_IMAGE_LAYOUT_GENERAL, s_mlaa.buf[0].buf, 1, &full);
+    vk_barrier_image(f->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { HW, HH, 1 } };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, f->im.img, VK_IMAGE_LAYOUT_GENERAL, s_mb.buf[0].buf, 1, &region);
+    pvkCmdFillBuffer(s_vk.cmd, s_mb.buf[3].buf, 0, 64, 0);
+    vk_mlaa_barrier();
+    s_mb.ow = (int)ow; s_mb.oh = (int)oh;
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_mb.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_mb.layout, 0, 1, &s_mb.oset[slot], 0, NULL);
+    for (int k = 0; k < 4; k++) vk_mb_stage(0, k == 3 ? 3 : k & 1, HW * HH / 256, -1);   /* BLUR across, down, across, down */
+    vk_mb_stage(4, 0, 1, -1);                             /* ARM */
+    vk_mb_stage(1, 0, 0, 4);                              /* DOWN */
+    vk_mb_stage(2, 0, 0, 4);                              /* GATHER */
+    vk_mb_stage(5, 0, 0, 28);                             /* BLEND_OUT, over the output */
+    s_mb.ow = s_mb.oh = 0;
+    vk_barrier_image(out, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+}
+
 static void vk_mlaa_stage(int stage, int job, u32 gx, u32 gy)
 {
     const int pc[2] = { stage, job };
@@ -3893,11 +3973,11 @@ static void vk_mlaa_stage(int stage, int job, u32 gx, u32 gy)
 }
 
 /* 1 when it ran; 0 when the target is not a 1280x720 R8G8B8A8 one (or the device cannot) */
-static int vk_tm_scene_end(void* user, u32 surface);
+static int vk_tm_scene_end(void* user, u32 surface, u32 field);
 static int vk_eng_mlaa(void* user, u32 surface, u32 field)
 {
     (void)user;
-    if (vk_tm_scene_end(user, surface)) return 1;
+    if (vk_tm_scene_end(user, surface, field)) return 1;
     vk_eng_obj* o = vk_eng_get(surface, VK_ENG_COLOR);
     vk_eng_obj* fo = field ? vk_eng_get(field, VK_ENG_COLOR) : NULL;
     if (!o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM || o->w != 1280 || o->h != 720 || !vk_mlaa_ready() || vk_batch_reserve(0))
@@ -4222,7 +4302,7 @@ static void vk_tm_unswap(u32 surface)
 }
 
 static u64 vk_now_ns(void);
-static int vk_tm_scene_end(void* user, u32 surface)
+static int vk_tm_scene_end(void* user, u32 surface, u32 field)
 {
     const u32 frame = cellGcm_frame_reached();
     rsx_temporal_view v;
@@ -4393,6 +4473,14 @@ static int vk_tm_scene_end(void* user, u32 surface)
     s_tm.prev = v; s_tm.have_prev = 1;
     if (r) { s_tm.skipped++; return 0; }
     vk_barrier_image(s_tm.sw[slot].out.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    /* the sprint's motion blur, as the MLAA pass would have run it, over the output */
+    {
+        vk_eng_obj* fo = field ? vk_eng_get(field, VK_ENG_COLOR) : NULL;
+        if (fo && fo->fmt == VK_FORMAT_R8G8B8A8_UNORM && fo->w >= 640 && fo->h >= 360 && vk_mb_on() &&
+            vk_mlaa_ready() && s_mb.ok)
+        { vk_mb_record_out(fo, s_tm.sw[slot].out.img, s_tm.sw[slot].out.view, ow, oh, slot);
+          static int n; if (!n++) VK_LOG("temporal: the sprint motion blur runs over the %ux%u output\n", ow, oh); }
+    }
 
     /* the output becomes the display buffer's image until it is presented */
     o = vk_eng_get(surface, VK_ENG_COLOR);
@@ -6274,11 +6362,14 @@ static int vk_init_all(u32 width, u32 height, const char* title)
     want.shaderInt64 = have.shaderInt64;         /* the MLAA pass's float emulation */
     s_vk.int64_ok = have.shaderInt64 ? 1 : 0;
     s_vk.aniso_ok = have.samplerAnisotropy ? 1 : 0;
-    /* FSR 3's shaders use 16-bit types and storage images written without a format */
-    if (s_tm.want == 2) {
-        want.shaderInt16 = have.shaderInt16;
+    /* FSR 3's shaders use 16-bit types, and both upscalers storage images
+     * written without a format; the velocity variants blend their extra
+     * target apart from the title's */
+    if (s_tm.want) {
+        want.shaderInt16 = s_tm.want == 2 ? have.shaderInt16 : VK_FALSE;
         want.shaderStorageImageWriteWithoutFormat = have.shaderStorageImageWriteWithoutFormat;
         want.shaderStorageImageReadWithoutFormat = have.shaderStorageImageReadWithoutFormat;
+        want.independentBlend = have.independentBlend;
     }
     { VkPhysicalDeviceProperties dp; pvkGetPhysicalDeviceProperties(s_vk.phys, &dp);
       s_vk.aniso_max = dp.limits.maxSamplerAnisotropy >= 16.0f ? 16u : (u32)dp.limits.maxSamplerAnisotropy; }
diff --git a/libs/video/vulkan/rsx_vk_mb.comp b/libs/video/vulkan/rsx_vk_mb.comp
index ef2a44c3..711377f4 100644
--- a/libs/video/vulkan/rsx_vk_mb.comp
+++ b/libs/video/vulkan/rsx_vk_mb.comp
@@ -15,13 +15,17 @@
 //            divided by the weights' sum (the SPU reciprocal), times strength/256
 //            -> FB (strength in alpha)
 //  3 BLEND   FB upsampled 2x (9:3:3:1, edges repeated) over the image, premultiplied
+//  5 BLEND_OUT the same over an image of another size (a temporal upscaler's
+//            output; the image stages above then ran on its 1280x720 copy):
+//            FB upsampled bilinearly to ow x oh, edges repeated
 layout(local_size_x = 256) in;
 layout(std430, binding = 0) buffer Img { uint IMG[]; };   // 1280x720 raw texels
 layout(std430, binding = 1) buffer Fa  { uint FA[]; };    // the field, 640x360 raw texels
 layout(std430, binding = 2) buffer Fb  { uint FB[]; };
 layout(std430, binding = 3) buffer Hf  { uint HALF[]; };
 layout(std430, binding = 4) buffer Ct  { uint CTRL[]; };  // any strength; dispatch sizes (half, full)
-layout(push_constant) uniform Push { int stage; int job; } pc;
+layout(set = 0, binding = 5, rgba8) uniform image2D OUT;
+layout(push_constant) uniform Push { int stage; int job; int ow; int oh; } pc;
 
 const int W = 1280, H = 720, HW = 640, HH = 360;
 
@@ -111,6 +115,7 @@ void main()
         const uint on = CTRL[0];
         CTRL[1] = on * uint(HW * HH / 256); CTRL[2] = 1u; CTRL[3] = 1u;
         CTRL[4] = on * uint(W * H / 256);   CTRL[5] = 1u; CTRL[6] = 1u;
+        CTRL[7] = on * uint((pc.ow * pc.oh + 255) / 256); CTRL[8] = 1u; CTRL[9] = 1u;
     } else if (pc.stage == 1) {                            // DOWN
         if (i >= HW * HH) return;
         const int y = i / HW, x = i % HW, s = 2 * y * W + 2 * x;
@@ -154,5 +159,20 @@ void main()
         const uint t = IMG[i];
         for (int c = 0; c < 4; c++) o[c] = min(up[c] + ((ch(t, c) * (256u - up[0])) >> 8), 255u);
         IMG[i] = pack4(o);
+    } else if (pc.stage == 5) {                            // BLEND_OUT
+        if (i >= pc.ow * pc.oh) return;
+        const int y = i / pc.ow, x = i % pc.ow;
+        const float fx = (float(x) + 0.5) * float(HW) / float(pc.ow) - 0.5, fy = (float(y) + 0.5) * float(HH) / float(pc.oh) - 0.5;
+        const int x0 = int(floor(fx)), y0 = int(floor(fy));
+        const float wx = fx - float(x0), wy = fy - float(y0);
+        const int xa = clamp(x0, 0, HW - 1), xb = clamp(x0 + 1, 0, HW - 1), ya = clamp(y0, 0, HH - 1), yb = clamp(y0 + 1, 0, HH - 1);
+        const uint q00 = FB[ya * HW + xa], q01 = FB[ya * HW + xb], q10 = FB[yb * HW + xa], q11 = FB[yb * HW + xb];
+        float up[4];
+        for (int c = 0; c < 4; c++)
+            up[c] = mix(mix(float(ch(q00, c)), float(ch(q01, c)), wx), mix(float(ch(q10, c)), float(ch(q11, c)), wx), wy);
+        const vec4 t = imageLoad(OUT, ivec2(x, y)) * 255.0;      // r, g, b, a
+        const float keep = (256.0 - up[0]) / 256.0;
+        const vec4 o = min(vec4(up[1], up[2], up[3], up[0]) + floor(t * keep), vec4(255.0));
+        imageStore(OUT, ivec2(x, y), o / 255.0);
     }
 }
