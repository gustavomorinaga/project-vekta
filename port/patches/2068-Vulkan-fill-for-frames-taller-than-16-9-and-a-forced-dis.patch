From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 12 Nov 2026 22:30:00 -0300
Subject: [PATCH] Vulkan: fill for frames taller than 16:9, and a forced
 display aspect (PS3RECOMP_VK_ASPECT)

PS3RECOMP_VK_SCALE_FIT=fill scaled each axis to the window only when the
window was wider than the frame ("fill only widens"): a title that
renders its cameras to a 4:3 or 16:10 window got the fitted 16:9 frame,
with bars. Fill now takes both axes in either direction, so a taller
window gets a frame rendered anamorphic to its own aspect; the largest
dimension limit still applies. Fit and 16:9 windows are unchanged.

PS3RECOMP_VK_ASPECT=W:H (default none) shows the picture at that aspect
whatever the window's: the frame is scaled to the largest box of that
aspect in the window, and a stretched frame (rsx_vulkan_set_stretch)
fills that box, with bars around it, instead of the window. A frame that
is not stretched keeps its own shape as before.

The arithmetic is in rsx_fit_scale.h, header-only, for a host test.
---
diff --git a/libs/video/rsx_fit_scale.h b/libs/video/rsx_fit_scale.h
new file mode 100644
index 0000000..bf88deb
--- /dev/null
+++ b/libs/video/rsx_fit_scale.h
@@ -0,0 +1,41 @@
+/*
+ * The frame's render scale for the window (PS3RECOMP_VK_SCALE_FIT) and the
+ * box a forced display aspect leaves in it (PS3RECOMP_VK_ASPECT). Plain C,
+ * header-only, so a host test can check the arithmetic without a GPU.
+ */
+#ifndef RSX_FIT_SCALE_H
+#define RSX_FIT_SCALE_H
+#include <stdio.h>
+
+/* "W:H" or a ratio ("4:3", "21:9", "1.6"): the aspect, or 0 for none, junk
+ * or a value outside 1:1..4:1 */
+static inline float rsx_parse_aspect(const char* s)
+{
+    float a = 0.0f, b = 0.0f;
+    if (!s || !*s) return 0.0f;
+    const int n = sscanf(s, "%f:%f", &a, &b);
+    if (n == 2) a = b > 0.0f ? a / b : 0.0f;
+    else if (n != 1) return 0.0f;
+    return a >= 1.0f && a <= 4.0f ? a : 0.0f;
+}
+
+/* The largest box of `aspect` (0: the whole window) centred in w x h */
+static inline void rsx_aspect_box(int w, int h, float aspect, int* bw, int* bh)
+{
+    *bw = w; *bh = h;
+    if (!(aspect > 0.0f) || w <= 0 || h <= 0) return;
+    if ((float)w > (float)h * aspect) *bw = (int)((float)h * aspect + 0.5f);
+    else *bh = (int)((float)w / aspect + 0.5f);
+}
+
+/* The axes' scales for a gw x gh guest frame in a w x h box, times k: fill
+ * scales each axis to the box (a frame rendered anamorphic to its aspect,
+ * wider or taller than the frame's), fit keeps the frame's aspect (the
+ * largest frame the box holds). */
+static inline void rsx_fit_axes(int w, int h, unsigned gw, unsigned gh, float k, int fill, float* sx, float* sy)
+{
+    *sx = (float)w / (float)gw * k;
+    *sy = (float)h / (float)gh * k;
+    if (!fill) *sx = *sy = *sx < *sy ? *sx : *sy;
+}
+#endif
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index f2268df..731b393 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -51,6 +51,8 @@
 #include "rsx_shader_spirv.h"
 #include "rsx_draw_engine.h"
 #include "rsx_present_steps.h"
+#include "rsx_fit_scale.h"
+static float vk_forced_aspect(void);   /* PS3RECOMP_VK_ASPECT, at vk_fit_scale */
 #include "rsx_vk_cache_key.h"   /* the caches' keys hold the translator's id */
 #include "rsx_temporal.h"
 #include "rsx_blend_state.h"   /* independentBlend and the velocity target */
@@ -2545,7 +2547,10 @@ static void vk_present_window_body(void)
     int32_t dw = (int32_t)s_vk.sc_extent.width, dh = (int32_t)s_vk.sc_extent.height;
     const float crop = s_stretch == 1 ? s_crop : 1.0f;
     const int32_t sx0 = (int32_t)((float)s_vk.width * (1.0f - crop) * 0.5f), sx1 = (int32_t)s_vk.width - sx0;
-    if (s_stretch) dw = (int32_t)((float)dw * crop + 0.5f);   /* the whole window, or its share */
+    if (s_stretch) {   /* the whole window (or the forced aspect's box), or its share */
+        rsx_aspect_box(dw, dh, vk_forced_aspect(), &dw, &dh);
+        dw = (int32_t)((float)dw * crop + 0.5f);
+    }
     else {   /* at the guest frame's shape, even when it was rendered anamorphic */
         const int64_t fw = s_guest_w ? s_guest_w : s_vk.width, fh = s_guest_h ? s_guest_h : s_vk.height;
         if ((int64_t)dw * fh > (int64_t)dh * fw) dw = (int32_t)((int64_t)dh * fw / fh);
@@ -3026,7 +3031,19 @@ static void vk_read_scale(void)
  * in pixels (the display mode's, fullscreen) instead of from the guest frame,
  * times PS3RECOMP_VK_SCALE: fit keeps the frame's aspect (the largest frame
  * the window holds), fill scales each axis to the window, for a frame
- * rendered anamorphic to the window's aspect. */
+ * rendered anamorphic to the window's aspect, wider or taller than the
+ * frame's (rsx_fit_scale.h).
+ *
+ * PS3RECOMP_VK_ASPECT=W:H (or a ratio; default none): the picture is shown
+ * at that aspect whatever the window's, with bars, for a title that renders
+ * its cameras to it: the frame is scaled to that box, and a stretched frame
+ * (rsx_vulkan_set_stretch) fills the box instead of the window. Read once. */
+static float vk_forced_aspect(void)
+{
+    static float a = -1.0f;
+    if (a < 0.0f) a = rsx_parse_aspect(getenv("PS3RECOMP_VK_ASPECT"));
+    return a;
+}
 static void vk_fit_scale(void)
 {
     const char* e = getenv("PS3RECOMP_VK_SCALE_FIT");
@@ -3043,9 +3060,10 @@ static void vk_fit_scale(void)
     if (w <= 0 || h <= 0 || !s_guest_w || !s_guest_h) return;
     const char* f = getenv("PS3RECOMP_VK_SCALE");
     const float k = f && atof(f) >= 0.25 && atof(f) <= 4.0 ? (float)atof(f) : 1.0f;
-    float sx = (float)w / (float)s_guest_w * k, sy = (float)h / (float)s_guest_h * k;
-    /* fill only widens: a window narrower than the frame gets the fitted one */
-    if (strcmp(e, "fill") || sx < sy) sx = sy = sx < sy ? sx : sy;
+    /* a forced display aspect: the frame fills its box, not the window */
+    rsx_aspect_box(w, h, vk_forced_aspect(), &w, &h);
+    float sx, sy;
+    rsx_fit_axes(w, h, s_guest_w, s_guest_h, k, !strcmp(e, "fill"), &sx, &sy);
     while (vk_scx(s_guest_w) && ((float)s_guest_w * sx > (float)vk_max_dim() || (float)s_guest_h * sy > (float)vk_max_dim())) {
         sx *= 0.9f; sy *= 0.9f;
     }
