 libs/video/rsx_vulkan_backend.c | 175 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-
 libs/video/rsx_vulkan_backend.h |   3 ++
 3 files changed, 296 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_vk_debug.h b/libs/video/rsx_vk_debug.h
new file mode 100644
index 0000000000000000000000000000000000000000..bf0f06d8538834fd4d474471c9c0a6aa6363157a
--- /dev/null
+++ b/libs/video/rsx_vk_debug.h
@@ -0,0 +1,120 @@
+/* The Vulkan backend's debugging switches and its validation message filter
+ * (ps3recomp-vekta patch 2064). Plain C with no Vulkan types, so a host test
+ * can include it alone.
+ *
+ * PS3RECOMP_VK_VALIDATION=1 turns on VK_LAYER_KHRONOS_validation and a
+ * VK_EXT_debug_utils messenger whose messages go to the log. A frame repeats
+ * the same mistake hundreds of times, so each message is keyed by its ID (its
+ * name when the ID is 0): the first RSX_VK_MSG_FULL occurrences are logged in
+ * full, after that only a count line at 10, 100, 1000... occurrences, and the
+ * counts of every key are listed when the backend shuts down. */
+#ifndef RSX_VK_DEBUG_H
+#define RSX_VK_DEBUG_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* A switch's value: 1 for "1", "on", "yes", "true"; 0 for unset, "", "0",
+ * "off", "no", "false"; -1 for anything else (the caller says so and keeps
+ * it off). Case does not matter. */
+static inline int rsx_vk_env_flag(const char* v)
+{
+    static const char* const on[] = { "1", "on", "yes", "true" };
+    static const char* const off[] = { "", "0", "off", "no", "false" };
+    if (!v) return 0;
+    char low[8];
+    size_t n = 0;
+    for (; v[n] && n < sizeof low - 1; n++)
+        low[n] = (char)((v[n] >= 'A' && v[n] <= 'Z') ? v[n] - 'A' + 'a' : v[n]);
+    if (v[n]) return -1;   /* longer than any word above */
+    low[n] = 0;
+    for (size_t i = 0; i < sizeof on / sizeof on[0]; i++) if (!strcmp(low, on[i])) return 1;
+    for (size_t i = 0; i < sizeof off / sizeof off[0]; i++) if (!strcmp(low, off[i])) return 0;
+    return -1;
+}
+
+#define RSX_VK_MSG_SLOTS 256   /* distinct keys counted; later new ones only add to "other" */
+#define RSX_VK_MSG_FULL  3     /* occurrences of one key logged in full */
+
+typedef struct {
+    int32_t  id;          /* VkDebugUtilsMessengerCallbackDataEXT.messageIdNumber */
+    uint32_t severity;    /* the highest VkDebugUtilsMessageSeverityFlagBitsEXT seen */
+    uint64_t count;
+    char     name[64];    /* pMessageIdName, cut to fit */
+} rsx_vk_msg_slot;
+
+typedef struct {
+    rsx_vk_msg_slot slot[RSX_VK_MSG_SLOTS];
+    uint32_t used;
+    uint64_t total;       /* every message */
+    uint64_t other;       /* messages of keys that found no free slot */
+} rsx_vk_msg_filter;
+
+/* What to do with a message: */
+enum {
+    RSX_VK_MSG_QUIET = 0,   /* count it only */
+    RSX_VK_MSG_LOG   = 1,   /* log it in full */
+    RSX_VK_MSG_COUNT = 2    /* log one line: "<name> seen <count> times" */
+};
+
+static inline int rsx_vk_msg_same(const rsx_vk_msg_slot* s, int32_t id, const char* name)
+{
+    if (id) return s->id == id;
+    return s->id == 0 && !strncmp(s->name, name ? name : "", sizeof s->name - 1);
+}
+
+/* Counts one message and says what to do with it; *count gets how many times
+ * its key has been seen, this one included (0 when it went to "other"). The
+ * caller serialises calls: the messenger may be called from any thread. */
+static inline int rsx_vk_msg_note(rsx_vk_msg_filter* f, int32_t id, const char* name,
+                                  uint32_t severity, uint64_t* count)
+{
+    f->total++;
+    rsx_vk_msg_slot* s = NULL;
+    for (uint32_t i = 0; i < f->used; i++)
+        if (rsx_vk_msg_same(&f->slot[i], id, name)) { s = &f->slot[i]; break; }
+    if (!s) {
+        if (f->used == RSX_VK_MSG_SLOTS) {
+            f->other++;
+            if (count) *count = 0;
+            /* the first one that did not fit is shown, so the summary's
+             * "other" line has a face; the rest are counted */
+            return f->other == 1 ? RSX_VK_MSG_LOG : RSX_VK_MSG_QUIET;
+        }
+        s = &f->slot[f->used++];
+        memset(s, 0, sizeof *s);
+        s->id = id;
+        snprintf(s->name, sizeof s->name, "%s", name ? name : "");
+    }
+    s->count++;
+    if (severity > s->severity) s->severity = severity;
+    if (count) *count = s->count;
+    if (s->count <= RSX_VK_MSG_FULL) return RSX_VK_MSG_LOG;
+    uint64_t p = 10;
+    while (p < s->count && p <= UINT64_MAX / 10) p *= 10;
+    return p == s->count ? RSX_VK_MSG_COUNT : RSX_VK_MSG_QUIET;
+}
+
+/* The summary at shutdown: one line a key, most frequent first. */
+static inline void rsx_vk_msg_summary(const rsx_vk_msg_filter* f, FILE* out, const char* prefix)
+{
+    fprintf(out, "%svalidation: %llu message(s), %u distinct\n", prefix,
+            (unsigned long long)f->total, f->used);
+    uint8_t done[RSX_VK_MSG_SLOTS] = {0};
+    for (uint32_t k = 0; k < f->used; k++) {
+        int best = -1;
+        for (uint32_t i = 0; i < f->used; i++)
+            if (!done[i] && (best < 0 || f->slot[i].count > f->slot[best].count)) best = (int)i;
+        done[best] = 1;
+        const rsx_vk_msg_slot* s = &f->slot[best];
+        fprintf(out, "%s  %10llu  %-7s  0x%08X  %s\n", prefix, (unsigned long long)s->count,
+                s->severity >= 0x1000u ? "error" : s->severity >= 0x100u ? "warning" :
+                s->severity >= 0x10u ? "info" : "verbose",
+                (unsigned)s->id, s->name[0] ? s->name : "(no name)");
+    }
+    if (f->other)
+        fprintf(out, "%s  %10llu  other (no slot left)\n", prefix, (unsigned long long)f->other);
+}
+
+#endif
