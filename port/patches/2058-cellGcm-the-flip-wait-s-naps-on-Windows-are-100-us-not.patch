From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sat, 7 Nov 2026 19:51:24 -0300
Subject: [PATCH] cellGcm: the flip wait's naps on Windows are 100 us, not
 Sleep(1)

PS3_GCM_MAX_QUEUED_FLIPS's wait (patch 2055) checks between naps of
usleep(100) on POSIX but Sleep(1) on Windows, which sleeps at least 1 ms
(1056 us on average under Wine 11.21, 2026-11-07): at 144 Hz, 6.9 ms a
frame, the flip the title waits for was seen up to a millisecond late at
every frame (issue #18, the flip queue on Windows). The naps now wait on a
per-thread high-resolution waitable timer
(CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, Windows 10 1803 and later) for
100 us, 108 us on average under Wine; Sleep(1) stays as the fallback where
the timer cannot be made or set. After ps3recomp PR #628 (MaChInEgUn3,
MIT), which uses the same timer for sys_timer_usleep's sub-millisecond
sleeps.
---
 libs/video/gcm_flip_wait.h | 36 ++++++++++++++++++++++++++++++++++--
 1 file changed, 34 insertions(+), 2 deletions(-)

diff --git a/libs/video/gcm_flip_wait.h b/libs/video/gcm_flip_wait.h
index 36c7ce4..6b219ec 100644
--- a/libs/video/gcm_flip_wait.h
+++ b/libs/video/gcm_flip_wait.h
@@ -9,7 +9,8 @@
  * menus ran 430 to 650 flips (3 to 4 s) ahead of the screen, on a Radeon
  * 8060S (issue #18) and in the Windows build under Wine, while the Linux build
  * stayed at 2. The wait is now bounded by time on both, sleeping for real
- * between checks (Sleep(1); the port raises the timer resolution to 1 ms).
+ * between checks: about 100 us on both (patch 2058; a high-resolution timer
+ * on Windows, Sleep(1) where there is none).
  */
 #ifndef PS3RECOMP_GCM_FLIP_WAIT_H
 #define PS3RECOMP_GCM_FLIP_WAIT_H
@@ -24,7 +25,37 @@ static inline unsigned long long gcm_flip_wait_now_us(void)
     return (unsigned long long)(c.QuadPart / f.QuadPart) * 1000000ULL +
            (unsigned long long)(c.QuadPart % f.QuadPart) * 1000000ULL / (unsigned long long)f.QuadPart;
 }
-static inline void gcm_flip_wait_nap(void) { Sleep(1); }
+/* A nap of about 100 us, as on POSIX: a high-resolution waitable timer
+ * (Windows 10 1803 and later, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION), one per
+ * thread. Sleep(1), the fallback where the timer cannot be made or set,
+ * sleeps at least 1 ms (1056 us on average, against 108 us for the timer,
+ * under Wine 2026-11-07): at 144 Hz (6.9 ms a frame) the flip the title waits
+ * for was seen up to a millisecond late, at every frame. After
+ * ps3recomp PR #628 (MaChInEgUn3, MIT), the same timer for sys_timer_usleep's
+ * sub-millisecond sleeps. */
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+static inline HANDLE gcm_flip_wait_timer(void)
+{
+    static _Thread_local HANDLE timer;
+    static _Thread_local int tried;
+    if (!tried) {
+        tried = 1;
+        timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    }
+    return timer;
+}
+/* 1 when the naps use the high-resolution timer, 0 when they are Sleep(1). */
+static inline int gcm_flip_wait_hires(void) { return gcm_flip_wait_timer() != NULL; }
+static inline void gcm_flip_wait_nap(void)
+{
+    HANDLE t = gcm_flip_wait_timer();
+    LARGE_INTEGER due;
+    due.QuadPart = -1000;   /* 100 us, in 100 ns units, relative */
+    if (t && SetWaitableTimer(t, &due, 0, NULL, NULL, FALSE) && WaitForSingleObject(t, 100) == WAIT_OBJECT_0) return;
+    Sleep(1);
+}
 #else
 #include <time.h>
 #include <unistd.h>
@@ -34,6 +65,7 @@ static inline unsigned long long gcm_flip_wait_now_us(void)
     clock_gettime(CLOCK_MONOTONIC, &t);
     return (unsigned long long)t.tv_sec * 1000000ULL + (unsigned long long)t.tv_nsec / 1000ULL;
 }
+static inline int gcm_flip_wait_hires(void) { return 1; }
 static inline void gcm_flip_wait_nap(void) { usleep(100); }
 #endif
 
