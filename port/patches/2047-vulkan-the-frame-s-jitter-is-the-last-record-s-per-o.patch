+/* ---- velocity variants (temporal upscaling) ---------------------------------
+ * A temporal upscaler needs each pixel's motion. The camera's alone leaves
+ * whatever moves on its own (characters, doors, the first-person arms) with a
+ * trail, so a draw into the scene also runs its vertex program a second time
+ * with the constants the same draw had the frame before (VPPrev, register b2,
+ * written by vk_eng_write_descriptors), and its pixel program writes the
+ * difference of the two positions into one more target, in NDC (y up). A
+ * draw with no match last frame writes "unknown" (65504) and gets the
+ * camera's motion. The text transforms below work on the decompilers' HLSL;
+ * NULL when a program does not have the shape they expect (that pipeline
+ * then draws without velocity). */
+static char* vk_tm_insert(const char* s, const char* at, const char* what)
+{
+    const size_t a = (size_t)(at - s), w = strlen(what), n = strlen(s);
+    char* r = (char*)malloc(n + w + 1);
+    if (!r) return NULL;
+    memcpy(r, s, a); memcpy(r + a, what, w); memcpy(r + a + w, s + a, n - a + 1);
+    return r;
+}
+
+static char* vk_tm_vel_vs(const char* vs)
+{
+    static const char vout[] = "struct VSOutput {", cbuf[] = "cbuffer VPConst : register(b0) {",
+                      entry[] = "VSOutput main(VSInput input) {\n", tail[] = "    VSOutput Out;\n",
+                      ret[] = "    return Out;\n}";
+    const char* so = strstr(vs, vout);
+    const char* se = so ? strstr(so, "\n};\n") : NULL;
+    const char* cb = strstr(vs, cbuf);
+    const char* cbe = cb ? strstr(cb, "\n};\n") : NULL;
+    const char* m = strstr(vs, entry);
+    const char* body = m ? m + strlen(entry) : NULL;
+    const char* be = body ? strstr(body, tail) : NULL;
+    const char* r = NULL;
+    for (const char* q = vs; (q = strstr(q, ret)); q++) r = q;
+    if (!se || !cbe || !be || !r || r < be || strstr(vs, "vp_p[") || cbe > m || se > m) return NULL;
+    /* the last frame's position: the body again, on the last frame's constants */
+    size_t blen = (size_t)(be - body), extra = 0;
+    for (const char* q = body; (q = strstr(q, "vp_c[")) && q < be; q++) extra++;
+    char* prev = (char*)malloc(blen + extra + 256);
+    if (!prev) return NULL;
+    char* d = prev + sprintf(prev, "float4 _rsx_prev_hpos(VSInput input) {\n");
+    for (const char* q = body; q < be; ) {
+        if (!strncmp(q, "vp_c[", 5)) { memcpy(d, "vp_p[", 5); d += 5; q += 5; } else *d++ = *q++;
+    }
+    d += sprintf(d, "    return o[0];\n}\n");
+    *d = 0;
+    /* assembled back to front, so the earlier offsets stay good */
+    const size_t len = strlen(vs);
+    char* out = (char*)malloc(len + strlen(prev) + 1024);
+    if (!out) { free(prev); return NULL; }
+    char* o = out;
+#define VK_TM_COPY(from, to) do { memcpy(o, (from), (size_t)((to) - (from))); o += (to) - (from); } while (0)
+    VK_TM_COPY(vs, se);
+    o += sprintf(o, "\n    [[vk::location(13)]] float4 _vcur:TEXCOORD10;"
+                    " [[vk::location(14)]] float4 _vprev:TEXCOORD11;");
+    VK_TM_COPY(se, cbe + 4);
+    o += sprintf(o, "cbuffer VPPrev : register(b2) {\n    float4 vp_p[512];\n    float4 vp_pvalid;\n};\n");
+    VK_TM_COPY(cbe + 4, m);
+    o += sprintf(o, "%s", prev);
+    VK_TM_COPY(m, r);
+    o += sprintf(o, "    Out._vcur = Out.pos;\n"
+                    "    { float4 _q = _rsx_prev_hpos(input);\n"
+                    "      Out._vprev = vp_pvalid.x != 0.0 ? float4(_q.xyz * vp_posscale.xyz + _q.w * vp_posoffset.xyz, _q.w)"
+                    " : (float4)0; }\n");
+    VK_TM_COPY(r, vs + len + 1);
+#undef VK_TM_COPY
+    free(prev);
+    return out;
+}
