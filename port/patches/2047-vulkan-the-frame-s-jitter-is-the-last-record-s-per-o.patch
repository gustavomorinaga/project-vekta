+static char* vk_tm_vel_ps(const char* ps, u32 rt_count)
+{
+    static const char pin[] = "struct PSInput {", single[] = "float4 main(PSInput input) : SV_TARGET {",
+                      mrt[] = "PSOutput main(PSInput input) {";
+    const char* si = strstr(ps, pin);
+    const char* se = si ? strstr(si, "\n};\n") : NULL;
+    const char* m1 = strstr(ps, single);
+    const char* m2 = strstr(ps, mrt);
+    if (!se || (!m1 == !m2) || strstr(ps, "_rsx_color_main") || rt_count > RSX_BE_MAX_COLOR_TARGETS) return NULL;
+    if (m1 && rt_count != 1) return NULL;
+    char* a = vk_tm_insert(ps, se, "\n    [[vk::location(13)]] float4 _vcur:TEXCOORD10;"
+                                   " [[vk::location(14)]] float4 _vprev:TEXCOORD11;");
+    if (!a) return NULL;
+    char* e = strstr(a, m1 ? single : mrt);
+    const char* nm = m1 ? "float4 _rsx_color_main(PSInput input) {" : "PSOutput _rsx_color_main(PSInput input) {";
+    const size_t old = strlen(m1 ? single : mrt), nl = strlen(nm), len = strlen(a);
+    char* out = (char*)malloc(len + nl + 2048);
+    if (!out) { free(a); return NULL; }
+    char* o = out;
+    memcpy(o, a, (size_t)(e - a)); o += e - a;
+    memcpy(o, nm, nl); o += nl;
+    strcpy(o, e + old); o += strlen(o);
+    o += sprintf(o, "\nfloat4 _rsx_velocity(PSInput i) {\n"
+                    "    if (i._vprev.w <= 0.0 || i._vcur.w <= 0.0) return float4(65504.0, 65504.0, 0, 0);\n"
+                    "    return float4(i._vprev.xy / i._vprev.w - i._vcur.xy / i._vcur.w, 0, 0);\n}\n"
+                    "struct _RsxVelOut {\n");
+    for (u32 k = 0; k < rt_count; k++) o += sprintf(o, "    float4 t%u : SV_TARGET%u;\n", k, k);
+    o += sprintf(o, "    float4 vel : SV_TARGET%u;\n};\n_RsxVelOut main(PSInput input) {\n    _RsxVelOut _v;\n", rt_count);
+    if (m1) o += sprintf(o, "    _v.t0 = _rsx_color_main(input);\n");
+    else {
+        o += sprintf(o, "    PSOutput _c = _rsx_color_main(input);\n");
+        for (u32 k = 0; k < rt_count; k++) {
+            char field[64];
+            snprintf(field, sizeof field, "float4 t%u : SV_TARGET%u;", k, k);
+            o += sprintf(o, strstr(a, field) ? "    _v.t%u = _c.t%u;\n" : "    _v.t%u = (float4)0;\n", k, k);
+        }
+    }
+    o += sprintf(o, "    _v.vel = _rsx_velocity(input);\n    return _v;\n}\n");
+    free(a);
+    return out;
+}
