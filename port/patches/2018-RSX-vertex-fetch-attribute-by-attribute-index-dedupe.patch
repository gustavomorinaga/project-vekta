From 217d58af9e786873313ff267784f8021069c0906 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 21 Oct 2026 01:44:11 -0300
Subject: [PATCH] RSX: vertex fetch attribute by attribute; index dedupe
 without hashing

The draw engine decodes every vertex of every draw on the FIFO thread, which
limits Killzone HD's frame rate since the GPU stopped being waited for:

- rsx_vertex_fetch_all fetches the whole draw attribute by attribute, with the
  element type decided once instead of switched on per component, per
  attribute, per vertex. The same elements, defaults and failure as
  rsx_vertex_fetch_one (20000 random plans, invalid types, dividers and
  out-of-range elements included, matched it byte for byte).
- rsx_vertex_remap_build dedupes references with one base index and ids in a
  narrow range (an indexed mesh) through a table indexed by id, in the same
  first-occurrence order as the hash, which the rest still takes (20000
  random reference lists matched a reference implementation).

Killzone HD, Level 1 at the 144 Hz clock, the same binary alternated: 131.7
against 130.5 fps with the previous fetch and dedupe, within the benchmark's
noise (an earlier, unalternated comparison suggested more).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/rsx_draw_engine.c    |   4 +-
 libs/video/rsx_vertex_compact.c | 118 ++++++++++++++++++++++++++++++++
 libs/video/rsx_vertex_compact.h |  10 +++
 3 files changed, 130 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index c00a8cde..f334a15d 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2406,8 +2406,8 @@ static void dc_fetch(const rsx_vertex_layout_plan* layout, int allow_remap)
         dc.fetch_ok = 0;
         return;
     }
-    if (!rsx_vertex_fetch_many(&dc.fetch_plan, dc.refs, dc.n_refs,
-                               layout->stride ? dc.verts : NULL)) {
+    if (!rsx_vertex_fetch_all(&dc.fetch_plan, dc.refs, dc.n_refs,
+                              layout->stride ? dc.verts : NULL, layout->stride)) {
         dc.fetch_ok = 0;
         return;
     }
diff --git a/libs/video/rsx_vertex_compact.c b/libs/video/rsx_vertex_compact.c
index e31b6112..2953c748 100644
--- a/libs/video/rsx_vertex_compact.c
+++ b/libs/video/rsx_vertex_compact.c
@@ -396,6 +396,77 @@ int rsx_vertex_fetch_many(
 }
 #undef RSX_FETCH_LOOP
 
+/* rsx_vertex_decode_element with the type decided once: the same reads and
+ * conversions, component by component. */
+#define RSX_DEC_LOOP(EXPR)                                                    \
+    for (u32 c = 0; c < size && c < 4; c++) out[c] = (EXPR);
+static inline int rsx_vertex_decode_typed(u32 type, u32 size, const u8* source, float out[4])
+{
+    out[0] = out[1] = out[2] = 0.0f;
+    out[3] = 1.0f;
+    if (!size) return 1;
+    switch (type) {
+    case RSX_VTX_TYPE_FLOAT:   RSX_DEC_LOOP(rsx_compact_be_f32(source + c * 4)) return 1;
+    case RSX_VTX_TYPE_HALF:    RSX_DEC_LOOP(rsx_compact_be_f16(source + c * 2)) return 1;
+    case RSX_VTX_TYPE_UNORM8:  RSX_DEC_LOOP(source[c] / 255.0f) return 1;
+    case RSX_VTX_TYPE_UINT8:   RSX_DEC_LOOP((float)source[c]) return 1;
+    case RSX_VTX_TYPE_SNORM16: RSX_DEC_LOOP((s16)((source[c * 2] << 8) | source[c * 2 + 1]) / 32767.0f) return 1;
+    case RSX_VTX_TYPE_SINT16:  RSX_DEC_LOOP((float)(s16)((source[c * 2] << 8) | source[c * 2 + 1])) return 1;
+    case RSX_VTX_TYPE_CMP32:   return rsx_vertex_decode_element(type, size, source, out);
+    default:                   return 0;
+    }
+}
+#undef RSX_DEC_LOOP
+
+/* rsx_vertex_fetch_one for every reference at once, attribute by attribute:
+ * vertex i goes to out + i * out_stride. The same elements, the same
+ * defaults, the same failure (attribute 0 undecodable: returns 0). */
+int rsx_vertex_fetch_all(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count,
+    u8* out, u32 out_stride)
+{
+    if (!plan || (!refs && count))
+        return 0;
+    if (!plan->layout.stride) {
+        for (u32 i = 0; i < count; i++)
+            if (!rsx_vertex_fetch_one(plan, &refs[i], NULL)) return 0;
+        return 1;
+    }
+    if (!out)
+        return 0;
+    for (u32 slot = 0; slot < plan->layout.count; slot++) {
+        const u32 attr = plan->layout.attrs[slot];
+        const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
+        u8* dst = out + slot * 16u;
+        if (!fetch->desc.type || !fetch->desc.size) {
+            for (u32 i = 0; i < count; i++)
+                memcpy(dst + (size_t)i * out_stride, fetch->default_value, 16);
+            continue;
+        }
+        const u32 freq = fetch->desc.frequency, modulo = (plan->divider_mask >> attr) & 1u;
+        const u32 type = fetch->desc.type, size = fetch->desc.size;
+        for (u32 i = 0; i < count; i++) {
+            float* value = (float*)(dst + (size_t)i * out_stride);
+            const u32 element = rsx_vertex_element_index(refs[i].vertex_id, refs[i].base_index, freq, modulo);
+            const u8* source = NULL;
+            if (fetch->stable_base && element >= fetch->stable_first && element <= fetch->stable_last) {
+                source = fetch->stable_base + (u64)(element - fetch->stable_first) * fetch->stride;
+            } else if (plan->inline_data) {
+                source = NULL;
+            } else if (plan->guest_ptr) {
+                const u32 offset = plan->base_offset + fetch->desc.offset + element * fetch->stride;
+                source = plan->guest_ptr(plan->guest_user, fetch->desc.location, offset, fetch->elem_size);
+            }
+            if (source && rsx_vertex_decode_typed(type, size, source, value))
+                continue;
+            if (attr == 0)
+                return 0;
+            memcpy(value, fetch->default_value, 16);
+        }
+    }
+    return 1;
+}
+
 static u64 rsx_vertex_remap_hash(u64 value)
 {
     value ^= value >> 33;
@@ -425,6 +496,52 @@ int rsx_vertex_remap_build(
         remap->occurrence_capacity = count;
     }
 
+    /* The common case: one base index and ids within a narrow range (an
+     * indexed mesh's u16 indices). A table indexed by id - lowest gives the
+     * same first-occurrence order as the hash below, without hashing. */
+    {
+        const u32 base = refs[0].base_index;
+        u32 lo = refs[0].vertex_id, hi = lo, same = 1;
+        for (u32 i = 1; i < count; i++) {
+            const u32 id = refs[i].vertex_id;
+            if (refs[i].base_index != base) { same = 0; break; }
+            if (id < lo) lo = id;
+            if (id > hi) hi = id;
+        }
+        if (same && hi - lo < (1u << 20)) {
+            const u32 range = hi - lo + 1u;
+            if (range > remap->direct_capacity) {
+                u64* d = (u64*)realloc(remap->direct, (size_t)range * sizeof(u64));
+                if (!d)
+                    return 0;
+                memset(d, 0, (size_t)range * sizeof(u64));
+                remap->direct = d;
+                remap->direct_capacity = range;
+                remap->direct_generation = 0;
+            }
+            if (++remap->direct_generation == 0) {
+                memset(remap->direct, 0, (size_t)remap->direct_capacity * sizeof(u64));
+                remap->direct_generation = 1u;
+            }
+            const u64 tag = (u64)remap->direct_generation << 32;
+            u32 unique = 0;
+            for (u32 occurrence = 0; occurrence < count; occurrence++) {
+                const rsx_vertex_ref ref = refs[occurrence];
+                u64* e = &remap->direct[ref.vertex_id - lo];
+                if ((*e & 0xFFFFFFFF00000000ull) == tag) {
+                    remap->occurrence_to_unique[occurrence] = (u32)*e;
+                } else {
+                    *e = tag | unique;
+                    refs[unique] = ref;
+                    remap->occurrence_to_unique[occurrence] = unique;
+                    unique++;
+                }
+            }
+            *unique_count = unique;
+            return 1;
+        }
+    }
+
     if (count > UINT_MAX / 2u)
         return 0;
     u32 slot_capacity = 16u;
@@ -494,6 +611,7 @@ void rsx_vertex_remap_destroy(rsx_vertex_remap* remap)
         return;
     free(remap->occurrence_to_unique);
     free(remap->slots);
+    free(remap->direct);
     memset(remap, 0, sizeof(*remap));
 }
 
diff --git a/libs/video/rsx_vertex_compact.h b/libs/video/rsx_vertex_compact.h
index 6a12f6f0..4e88b1be 100644
--- a/libs/video/rsx_vertex_compact.h
+++ b/libs/video/rsx_vertex_compact.h
@@ -44,6 +44,12 @@ typedef struct rsx_vertex_remap {
     rsx_vertex_remap_slot* slots;
     u32 slot_capacity;
     u32 generation;
+    /* The direct table (one base index, a narrow range of ids): entry
+     * id - lowest holds the unique index in its low 32 bits and the
+     * generation that wrote it in the high 32. */
+    u64* direct;
+    u32 direct_capacity;
+    u32 direct_generation;
 } rsx_vertex_remap;
 
 typedef struct rsx_vertex_fetch_attr {
@@ -127,6 +133,10 @@ int rsx_vertex_fetch_many(
 /* Collapse repeated (vertex_id, base_index) references in first-use order.
  * refs is rewritten in place with the unique prefix.  The occurrence map
  * remains valid until the next call using the same remap object. */
+/* rsx_vertex_fetch_one for refs[0..count), vertex i at out + i * out_stride. */
+int rsx_vertex_fetch_all(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count,
+    u8* out, u32 out_stride);
 int rsx_vertex_remap_build(
     rsx_vertex_remap* remap, rsx_vertex_ref* refs, u32 count,
     u32* unique_count);
-- 
2.56.0

