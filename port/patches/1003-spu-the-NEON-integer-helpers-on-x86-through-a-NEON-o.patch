+SPU_NS __m128i vqtbl2q_u8(uint8x16x2_t t, __m128i idx) {
+    const __m128i past = _mm_cmpeq_epi8(_mm_max_epu8(idx, _mm_set1_epi8(32)), idx);
+    const __m128i i = _mm_or_si128(_mm_and_si128(idx, _mm_set1_epi8(0x0F)), past);
+    const __m128i hi = _mm_cmpeq_epi8(_mm_and_si128(idx, _mm_set1_epi8(0x10)), _mm_set1_epi8(0x10));
+    return _mm_blendv_epi8(_mm_shuffle_epi8(t.val[0], i), _mm_shuffle_epi8(t.val[1], i), hi);
+}
+#define vextq_u32(a, b, n) _mm_alignr_epi8((b), (a), 4 * (n))
+SPU_NS __m128i vtrn2q_u32(__m128i a, __m128i b) {
+    return _mm_blend_epi32(_mm_shuffle_epi32(a, 0xF5), _mm_shuffle_epi32(b, 0xF5), 0xA);
+}
+
+/* bit counts */
+SPU_NS __m128i vcntq_u8(__m128i a) {
+    const __m128i lut = _mm_setr_epi8(0,1,1,2, 1,2,2,3, 1,2,2,3, 2,3,3,4), m = _mm_set1_epi8(0x0F);
+    return _mm_add_epi8(_mm_shuffle_epi8(lut, _mm_and_si128(a, m)),
+                        _mm_shuffle_epi8(lut, _mm_and_si128(_mm_srli_epi16(a, 4), m)));
+}
+SPU_NS __m128i vclzq_u32(__m128i a) {
+    uint32_t w[4]; _mm_storeu_si128((__m128i*)w, a);
+    for (int i = 0; i < 4; i++) w[i] = w[i] ? (uint32_t)__builtin_clz(w[i]) : 32u;
+    return _mm_loadu_si128((const __m128i*)w);
+}
+#undef SPU_NS
+#endif /* SPU_NEON_SSE_H */
