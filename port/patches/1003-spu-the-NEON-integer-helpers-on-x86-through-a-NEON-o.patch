+SPU_NS __m128i vtstq_u16(__m128i a, __m128i b) { return vmvnq_u32(_mm_cmpeq_epi16(_mm_and_si128(a, b), _mm_setzero_si128())); }
+SPU_NS __m128i vtstq_u32(__m128i a, __m128i b) { return vmvnq_u32(_mm_cmpeq_epi32(_mm_and_si128(a, b), _mm_setzero_si128())); }
+
+/* byte permutes */
+SPU_NS __m128i vrev32q_u8(__m128i a) { return _mm_shuffle_epi8(a, _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12)); }
+SPU_NS __m128i vrev16q_u8(__m128i a) { return _mm_shuffle_epi8(a, _mm_setr_epi8(1,0, 3,2, 5,4, 7,6, 9,8, 11,10, 13,12, 15,14)); }
+/* table lookups: an index past the table gives 0 */
