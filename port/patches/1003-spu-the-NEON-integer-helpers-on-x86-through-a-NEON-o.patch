+++ b/runtime/spu/spu_neon_sse.h
@@ -0,0 +1,190 @@
+/* spu_neon_sse.h -- the NEON intrinsics spu_helpers.h's vectorised integer ops
+ * use, on x86 with AVX2 (x86-64-v3).
+ *
+ * spu_helpers.h has NEON forms of the per-lane and byte-permute integer ops and
+ * scalar references for everything else; on x86 the integer ops fell back to the
+ * scalar loops, a few of which the compiler vectorised badly and most of which
+ * it left as loops. Rather than a second hand-written x86 copy of every op, this
+ * maps the subset of NEON the integer ops use onto SSE4/AVX2, so the same NEON
+ * code compiles here. tests/test_spu_int_neon.c checks every op against its
+ * scalar reference on both architectures.
+ *
+ * Every NEON vector type is one __m128i (64-bit "d" types use the low half); the
+ * reinterpret casts are identities. Only what spu_helpers.h's integer ops need is
+ * here, with NEON's exact semantics for the operand ranges they are used with.
+ */
+#ifndef SPU_NEON_SSE_H
+#define SPU_NEON_SSE_H
+#include <immintrin.h>
+#include <stdint.h>
+
+typedef __m128i uint8x16_t, int8x16_t, uint16x8_t, int16x8_t, uint32x4_t, int32x4_t,
+                uint64x2_t, int64x2_t, uint8x8_t, uint32x2_t;
+typedef struct { __m128i val[2]; } uint8x16x2_t;
+
+#define SPU_NS static inline __attribute__((always_inline))
+
+/* reinterpret: identities */
+#define vreinterpretq_s16_u16(x) (x)
+#define vreinterpretq_s16_u32(x) (x)
+#define vreinterpretq_s32_u32(x) (x)
+#define vreinterpretq_s8_u32(x)  (x)
+#define vreinterpretq_u16_u32(x) (x)
+#define vreinterpretq_u32_s16(x) (x)
+#define vreinterpretq_u32_s32(x) (x)
+#define vreinterpretq_u32_u16(x) (x)
+#define vreinterpretq_u32_u64(x) (x)
+#define vreinterpretq_u32_u8(x)  (x)
+#define vreinterpretq_u8_u32(x)  (x)
+
+/* loads, stores, splats */
+SPU_NS __m128i vld1q_u8(const uint8_t* p)   { return _mm_loadu_si128((const __m128i*)p); }
+SPU_NS __m128i vld1q_u16(const uint16_t* p) { return _mm_loadu_si128((const __m128i*)p); }
+SPU_NS __m128i vld1q_u32(const uint32_t* p) { return _mm_loadu_si128((const __m128i*)p); }
+SPU_NS void vst1q_u8(uint8_t* p, __m128i v)   { _mm_storeu_si128((__m128i*)p, v); }
+SPU_NS void vst1q_u32(uint32_t* p, __m128i v) { _mm_storeu_si128((__m128i*)p, v); }
+SPU_NS __m128i vdupq_n_u8(uint8_t x)   { return _mm_set1_epi8((char)x); }
+SPU_NS __m128i vdupq_n_s8(int8_t x)    { return _mm_set1_epi8(x); }
+SPU_NS __m128i vdupq_n_u16(uint16_t x) { return _mm_set1_epi16((short)x); }
+SPU_NS __m128i vdupq_n_s16(int16_t x)  { return _mm_set1_epi16(x); }
+SPU_NS __m128i vdupq_n_u32(uint32_t x) { return _mm_set1_epi32((int)x); }
+SPU_NS __m128i vdupq_n_s32(int32_t x)  { return _mm_set1_epi32(x); }
+SPU_NS __m128i vdupq_n_u64(uint64_t x) { return _mm_set1_epi64x((long long)x); }
+SPU_NS __m128i vdup_n_u8(uint8_t x)    { return _mm_set1_epi8((char)x); }
+SPU_NS __m128i vcombine_u8(__m128i lo, __m128i hi) { return _mm_unpacklo_epi64(lo, hi); }
+SPU_NS __m128i vsetq_lane_u64(uint64_t x, __m128i v, const int lane) {
+    return lane ? _mm_insert_epi64(v, (long long)x, 1) : _mm_insert_epi64(v, (long long)x, 0);
+}
+
+/* bitwise */
+SPU_NS __m128i vandq_u8(__m128i a, __m128i b)  { return _mm_and_si128(a, b); }
+SPU_NS __m128i vandq_u16(__m128i a, __m128i b) { return _mm_and_si128(a, b); }
+SPU_NS __m128i vandq_u32(__m128i a, __m128i b) { return _mm_and_si128(a, b); }
+SPU_NS __m128i vorrq_u16(__m128i a, __m128i b) { return _mm_or_si128(a, b); }
+SPU_NS __m128i vorrq_u32(__m128i a, __m128i b) { return _mm_or_si128(a, b); }
+SPU_NS __m128i veorq_u8(__m128i a, __m128i b)  { return _mm_xor_si128(a, b); }
+SPU_NS __m128i veorq_u32(__m128i a, __m128i b) { return _mm_xor_si128(a, b); }
+SPU_NS __m128i vmvnq_u32(__m128i a) { return _mm_xor_si128(a, _mm_set1_epi32(-1)); }
+/* bit select: per BIT, m ? a : b */
+SPU_NS __m128i vbslq_u8(__m128i m, __m128i a, __m128i b)  { return _mm_or_si128(_mm_and_si128(m, a), _mm_andnot_si128(m, b)); }
+SPU_NS __m128i vbslq_u32(__m128i m, __m128i a, __m128i b) { return _mm_or_si128(_mm_and_si128(m, a), _mm_andnot_si128(m, b)); }
+
+/* arithmetic */
+SPU_NS __m128i vaddq_u8(__m128i a, __m128i b)  { return _mm_add_epi8(a, b); }
+SPU_NS __m128i vaddq_u16(__m128i a, __m128i b) { return _mm_add_epi16(a, b); }
+SPU_NS __m128i vaddq_u32(__m128i a, __m128i b) { return _mm_add_epi32(a, b); }
+SPU_NS __m128i vsubq_u8(__m128i a, __m128i b)  { return _mm_sub_epi8(a, b); }
+SPU_NS __m128i vsubq_u16(__m128i a, __m128i b) { return _mm_sub_epi16(a, b); }
+SPU_NS __m128i vsubq_s16(__m128i a, __m128i b) { return _mm_sub_epi16(a, b); }
+SPU_NS __m128i vsubq_u32(__m128i a, __m128i b) { return _mm_sub_epi32(a, b); }
+SPU_NS __m128i vsubq_s32(__m128i a, __m128i b) { return _mm_sub_epi32(a, b); }
+SPU_NS __m128i vnegq_s16(__m128i a) { return _mm_sub_epi16(_mm_setzero_si128(), a); }
+SPU_NS __m128i vnegq_s32(__m128i a) { return _mm_sub_epi32(_mm_setzero_si128(), a); }
+SPU_NS __m128i vmulq_u16(__m128i a, __m128i b) { return _mm_mullo_epi16(a, b); }
+SPU_NS __m128i vmulq_u32(__m128i a, __m128i b) { return _mm_mullo_epi32(a, b); }
+SPU_NS __m128i vmulq_s32(__m128i a, __m128i b) { return _mm_mullo_epi32(a, b); }
+SPU_NS __m128i vmlaq_u32(__m128i a, __m128i b, __m128i c) { return _mm_add_epi32(a, _mm_mullo_epi32(b, c)); }
+SPU_NS __m128i vabdq_u8(__m128i a, __m128i b) { return _mm_or_si128(_mm_subs_epu8(a, b), _mm_subs_epu8(b, a)); }
+SPU_NS __m128i vrhaddq_u8(__m128i a, __m128i b) { return _mm_avg_epu8(a, b); }
+/* pairwise add-long: u8 pairs -> u16, u16 pairs -> u32 */
+SPU_NS __m128i vpaddlq_u8(__m128i a)  { return _mm_maddubs_epi16(a, _mm_set1_epi8(1)); }
+SPU_NS __m128i vpaddlq_u16(__m128i a) { return _mm_add_epi32(_mm_and_si128(a, _mm_set1_epi32(0xFFFF)), _mm_srli_epi32(a, 16)); }
+/* pairwise add of adjacent bytes over a:b, wrapping to 8 bits */
+SPU_NS __m128i vpaddq_u8(__m128i a, __m128i b) {
+    const __m128i m = _mm_set1_epi16(0xFF);
+    return _mm_packus_epi16(_mm_and_si128(vpaddlq_u8(a), m), _mm_and_si128(vpaddlq_u8(b), m));
+}
+SPU_NS uint32_t vaddvq_u32(__m128i a) {
+    __m128i s = _mm_add_epi32(a, _mm_shuffle_epi32(a, 0x4E));
+    s = _mm_add_epi32(s, _mm_shuffle_epi32(s, 0xB1));
+    return (uint32_t)_mm_cvtsi128_si32(s);
+}
+SPU_NS uint16_t vaddvq_u16(__m128i a) { return (uint16_t)vaddvq_u32(vpaddlq_u16(a)); }
+
+/* shifts by immediate */
+#define vshlq_n_u32(a, n) _mm_slli_epi32((a), (n))
+#define vshlq_n_s32(a, n) _mm_slli_epi32((a), (n))
+#define vshlq_n_s16(a, n) _mm_slli_epi16((a), (n))
+#define vshrq_n_u32(a, n) _mm_srli_epi32((a), (n))
+#define vshrq_n_s32(a, n) _mm_srai_epi32((a), (n))
+#define vshrq_n_s16(a, n) _mm_srai_epi16((a), (n))
+
+/* shifts by vector: the low byte of each lane of b, signed; positive shifts
+ * left, negative right (logical for u, arithmetic for s); a count at or past
+ * the lane width gives 0 (sign fill for an arithmetic right shift). */
+SPU_NS __m128i spu__ns_cnt32(__m128i b) { return _mm_srai_epi32(_mm_slli_epi32(b, 24), 24); }
+SPU_NS __m128i vshlq_u32(__m128i a, __m128i b) {
+    const __m128i s = spu__ns_cnt32(b), neg = _mm_cmpgt_epi32(_mm_setzero_si128(), s);
+    return _mm_blendv_epi8(_mm_sllv_epi32(a, s), _mm_srlv_epi32(a, _mm_sub_epi32(_mm_setzero_si128(), s)), neg);
+}
+SPU_NS __m128i vshlq_s32(__m128i a, __m128i b) {
+    const __m128i s = spu__ns_cnt32(b), neg = _mm_cmpgt_epi32(_mm_setzero_si128(), s);
+    return _mm_blendv_epi8(_mm_sllv_epi32(a, s), _mm_srav_epi32(a, _mm_sub_epi32(_mm_setzero_si128(), s)), neg);
+}
+/* 16-bit lanes: each 32-bit lane's two halves shifted as 32-bit values. */
+SPU_NS __m128i spu__ns_sh16(__m128i x, __m128i s, int arith) {   /* x: one half per 32-bit lane, extended */
+    const __m128i neg = _mm_cmpgt_epi32(_mm_setzero_si128(), s);
+    const __m128i ns = _mm_sub_epi32(_mm_setzero_si128(), s);
+    const __m128i r = arith ? _mm_srav_epi32(x, ns) : _mm_srlv_epi32(x, ns);
+    return _mm_and_si128(_mm_blendv_epi8(_mm_sllv_epi32(x, s), r, neg), _mm_set1_epi32(0xFFFF));
+}
+SPU_NS __m128i vshlq_u16(__m128i a, __m128i b) {
+    const __m128i lo = spu__ns_sh16(_mm_and_si128(a, _mm_set1_epi32(0xFFFF)), _mm_srai_epi32(_mm_slli_epi32(b, 24), 24), 0);
+    const __m128i hi = spu__ns_sh16(_mm_srli_epi32(a, 16), _mm_srai_epi32(_mm_slli_epi32(b, 8), 24), 0);
+    return _mm_or_si128(lo, _mm_slli_epi32(hi, 16));
+}
+SPU_NS __m128i vshlq_s16(__m128i a, __m128i b) {
+    const __m128i lo = spu__ns_sh16(_mm_srai_epi32(_mm_slli_epi32(a, 16), 16), _mm_srai_epi32(_mm_slli_epi32(b, 24), 24), 1);
+    const __m128i hi = spu__ns_sh16(_mm_srai_epi32(a, 16), _mm_srai_epi32(_mm_slli_epi32(b, 8), 24), 1);
+    return _mm_or_si128(lo, _mm_slli_epi32(hi, 16));
+}
+
+/* compares: all-ones / zero lanes */
+SPU_NS __m128i vceqq_u8(__m128i a, __m128i b)  { return _mm_cmpeq_epi8(a, b); }
+SPU_NS __m128i vceqq_u16(__m128i a, __m128i b) { return _mm_cmpeq_epi16(a, b); }
+SPU_NS __m128i vceqq_s16(__m128i a, __m128i b) { return _mm_cmpeq_epi16(a, b); }
+SPU_NS __m128i vceqq_u32(__m128i a, __m128i b) { return _mm_cmpeq_epi32(a, b); }
+SPU_NS __m128i vcgtq_s8(__m128i a, __m128i b)  { return _mm_cmpgt_epi8(a, b); }
+SPU_NS __m128i vcgtq_s16(__m128i a, __m128i b) { return _mm_cmpgt_epi16(a, b); }
+SPU_NS __m128i vcgtq_s32(__m128i a, __m128i b) { return _mm_cmpgt_epi32(a, b); }
+SPU_NS __m128i vcgtq_u8(__m128i a, __m128i b)  { const __m128i k = _mm_set1_epi8((char)0x80); return _mm_cmpgt_epi8(_mm_xor_si128(a, k), _mm_xor_si128(b, k)); }
+SPU_NS __m128i vcgtq_u16(__m128i a, __m128i b) { const __m128i k = _mm_set1_epi16((short)0x8000); return _mm_cmpgt_epi16(_mm_xor_si128(a, k), _mm_xor_si128(b, k)); }
+SPU_NS __m128i vcgtq_u32(__m128i a, __m128i b) { const __m128i k = _mm_set1_epi32((int)0x80000000u); return _mm_cmpgt_epi32(_mm_xor_si128(a, k), _mm_xor_si128(b, k)); }
