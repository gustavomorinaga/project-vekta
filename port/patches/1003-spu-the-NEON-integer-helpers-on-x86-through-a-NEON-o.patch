From 5c71bb4e6b96d648352aadc6bd398c54e7dc5027 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 14 Oct 2026 20:11:20 -0300
Subject: [PATCH] spu: the NEON integer helpers on x86 through a
 NEON-on-SSE4/AVX2 shim

spu_helpers.h vectorised ~60 integer and byte-permute ops in NEON and left x86
on the scalar references, most of them loops. spu_neon_sse.h maps the subset
of NEON those ops use onto SSE4/AVX2, so the same code serves both;
SPU_NEON_INT selects it. test_spu_int_neon now runs on x86 too and passes
(1M random cases, every op against its reference); the float, shufb, helper
and numeric-semantics tests pass as well. A captured Killzone HD vertex job
runs 1.7x faster; the game goes from ~6.2 to ~9.8 fps in its first level.

---
 runtime/spu/spu_helpers.h             |  83 ++++++-----
 runtime/spu/spu_neon_sse.h            | 190 ++++++++++++++++++++++++++
 runtime/spu/tests/test_spu_int_neon.c |   2 +-
 3 files changed, 229 insertions(+), 46 deletions(-)
 create mode 100644 runtime/spu/spu_neon_sse.h

diff --git a/runtime/spu/spu_helpers.h b/runtime/spu/spu_helpers.h
index ec5594d0..df207654 100644
--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -63,8 +63,17 @@ static inline void spu_arch_fence(void) { __atomic_thread_fence(__ATOMIC_SEQ_CST
  * are unaffected (W is identity modulo the within-word reversal). */
 #define SPU_W(P) (((P) & ~3) | (3 - ((P) & 3)))
 
-#if defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS) && !defined(SPU_SCALAR_INT)
+/* SPU_NEON_INT: the vectorised integer ops below, written in NEON; on x86 the
+ * NEON subset they use comes from spu_neon_sse.h (SSE4/AVX2). */
+#if !defined(SPU_SCALAR_HELPERS) && !defined(SPU_SCALAR_INT) && (defined(__ARM_NEON) || defined(__AVX2__))
+#define SPU_NEON_INT 1
+#endif
+#if defined(SPU_NEON_INT)
+#if defined(__ARM_NEON)
 #include <arm_neon.h>
+#else
+#include "spu_neon_sse.h"
+#endif
 /* NEON forms of the hot integer ops. Each scalar definition stays as spu_X_ref
  * (tests/test_spu_int_neon.c compares them). */
 static inline uint32x4_t spu__ld(u128 a) { return vld1q_u32(a._u32); }
@@ -219,7 +228,7 @@ static inline u128 spu_zero(void) { u128 r; memset(&r,0,sizeof r); return r; }
 
 /* ---- integer arithmetic (SIMD) ---- */
