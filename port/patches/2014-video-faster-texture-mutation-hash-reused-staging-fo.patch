From ee886ff5b5df7ad090327b95fd1f599dd4b5f395 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Fri, 16 Oct 2026 15:50:45 -0300
Subject: [PATCH] video: faster texture mutation hash, reused staging for
 waited-on copies

The per-frame texture content hash ran one FNV multiply chain over every
cached texture (~11% of the FIFO thread in Killzone HD); four independent
lanes over 32-byte blocks run near memory speed. Colour and depth readbacks
and depth snapshots made, mapped and freed a host buffer each (the driver
mmap/munmap'd per call, and destroying one flushed the batch); they now
share one per usage, grown on demand.

---
 libs/video/rsx_draw_engine.c | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 41e6ad62..dd6333d2 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1191,14 +1191,18 @@ static u64 eng_texture_content_hash_body(u32 location, u32 offset, u32 span,
 {
     const u8* src = span ? eng_guest_ptr(NULL, location, offset, span) : NULL;
     if (!src) { *readable = 0; return 0; }
-    u64 hash = 1469598103934665603ull;
+    /* Four independent FNV lanes over 32-byte blocks: one chain of multiplies
+     * ran at a fraction of memory speed (~11% of the RSX thread in Killzone). */
+    u64 h[4] = { 1469598103934665603ull, 1469598103934665603ull ^ 1,
+                 1469598103934665603ull ^ 2, 1469598103934665603ull ^ 3 };
     u32 i = 0;
-    for (; i + 8 <= span; i += 8) {
-        u64 word;
-        memcpy(&word, src + i, sizeof(word));
-        hash ^= word;
-        hash *= 1099511628211ull;
-    }
+    for (; i + 32 <= span; i += 32)
+        for (int k = 0; k < 4; k++) {
+            u64 word;
+            memcpy(&word, src + i + 8 * k, sizeof(word));
+            h[k] = (h[k] ^ word) * 1099511628211ull;
+        }
+    u64 hash = h[0] ^ (h[1] * 31) ^ (h[2] * 961) ^ (h[3] * 29791);
     for (; i < span; i++) { hash ^= src[i]; hash *= 1099511628211ull; }
     *readable = 1;
     return hash;
-- 
