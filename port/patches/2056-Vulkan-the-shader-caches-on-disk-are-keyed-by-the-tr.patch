                       u32* words, u32 max_words, u32* out_words,
                       char* log, u32 log_size);
 
+/* The translator's id: the same for two builds only when they translate the
+ * same HLSL to the same SPIR-V. A hash of RSX_SPIRV_TRANSLATOR_ID (the build's
+ * hash of rsx_shader_spirv.cpp and this header, CMakeLists.txt; this file's
+ * compile time when a build does not define it) and of the version of the
+ * glslang it runs with. Caches of translated shaders kept by others (the
+ * Vulkan backend's, rsx_vk_cache_key.h) put it in their keys. 0 for the stub. */
+unsigned long long rsx_hlsl_to_spirv_id(void);
+
 /* The translation cache (rsx_shader_spirv.cpp). A request is answered from
  * memory, else from PS3RECOMP_SPIRV_CACHE's directory, else by glslang. */
 typedef struct RsxSpirvCacheStats {
diff --git a/libs/video/rsx_vk_cache_key.h b/libs/video/rsx_vk_cache_key.h
new file mode 100644
index 0000000..2dd60bc
--- /dev/null
+++ b/libs/video/rsx_vk_cache_key.h
@@ -0,0 +1,44 @@
+/*
+ * ps3recomp - the keys of the Vulkan backend's shader and pipeline caches on disk
+ *
+ * The backend keeps each program's SPIR-V in <cache>/<key>.spv and the list of
+ * pipelines it built in <cache>/pipelines.list (rsx_vulkan_backend.c). The
+ * SPIR-V key was the HLSL text, the stage and VK_CACHE_VERSION, a constant to
+ * bump by hand when the translator's output changes for the same source. A
+ * build whose translator (rsx_shader_spirv.cpp) or glslang changed without the
+ * bump read the older build's SPIR-V back as its own: a player who updates over
+ * an older install would run the old shaders against the new backend. Project
+ * Pyrrhus (undecuple's Killzone 2 port) lost the holographic sight's reticle
+ * and glow that way after an update (its issue #25; fixed by tying its cache
+ * to the translator in its patch 6047, MIT); written here from that report.
+ *
+ * Both keys now also hold rsx_hlsl_to_spirv_id(), the translator's id (the
+ * hash of its sources taken by the build, and the glslang version it runs
+ * with). Another translator finds none of the older files, and starts a new
+ * pipeline list.
+ */
+#ifndef PS3RECOMP_RSX_VK_CACHE_KEY_H
+#define PS3RECOMP_RSX_VK_CACHE_KEY_H
+
+#include <stdint.h>
+
+/* The name of a program's SPIR-V file. inv: Invariant position on
+ * (PS3RECOMP_SPIRV_INVARIANT, which translates differently). */
+static inline uint64_t rsx_vk_spv_key(const char* hlsl, int stage, int inv, uint32_t cache_version,
+                                      uint64_t translator_id)
+{
+    uint64_t h = (1469598103934665603ull ^ (cache_version + (inv ? 0u : 0x100u))) + (uint64_t)stage;
+    for (int i = 0; i < 8; i++) { h ^= (translator_id >> (8 * i)) & 0xFFu; h *= 1099511628211ull; }
+    for (const unsigned char* c = (const unsigned char*)hlsl; *c; c++) { h ^= *c; h *= 1099511628211ull; }
+    return h;
+}
+
+/* The fourth word of pipelines.list's header: a list written by another
+ * translator names SPIR-V files this build does not have, so it starts over. */
+static inline uint32_t rsx_vk_plist_translator_word(uint64_t translator_id)
+{
+    const uint32_t w = (uint32_t)(translator_id ^ (translator_id >> 32));
+    return w ? w : 1u;
+}
+
+#endif
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 834210d..c249dd5 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -51,6 +51,7 @@
 #include "rsx_shader_spirv.h"
 #include "rsx_draw_engine.h"
 #include "rsx_present_steps.h"
+#include "rsx_vk_cache_key.h"   /* the caches' keys hold the translator's id */
 #include "rsx_temporal.h"
 #include "rsx_vk_dlss.h"
 #include "rsx_vk_fsr3.h"
@@ -4839,8 +4840,10 @@ static VkStencilOpState vk_gcm_stencil_face(u32 func, u32 fail, u32 zfail, u32 z
  * translation and a driver pipeline compile: 70-250 ms hitches in Killzone's
  * Level 1. SPIR-V is kept per program source, and the driver's compiled
  * pipelines in one VkPipelineCache blob, under $PS3RECOMP_VK_CACHE (default
- * ~/.cache/ps3recomp-vk; "0" turns both off). Bump VK_CACHE_VERSION when the
- * translator's output changes for the same source. */
+ * ~/.cache/ps3recomp-vk; "0" turns both off). The keys hold the translator's
+ * id (rsx_vk_cache_key.h), so a build with another translator or glslang
+ * never reads an older build's SPIR-V; bump VK_CACHE_VERSION when the SPIR-V
+ * this file makes of the same translation changes. */
 #define VK_CACHE_VERSION 2u   /* 2: invariant position (rsx_shader_spirv.cpp) */
 static void vk_mkdir(const char* d)
 {
@@ -4973,8 +4976,12 @@ static int vk_eng_translate(const char* hlsl, int stage, VkShaderModule* out, u6
         /* PS3RECOMP_SPIRV_INVARIANT=0 translates differently: its own files */
         static int inv = -1;
         if (inv < 0) { const char* e = getenv("PS3RECOMP_SPIRV_INVARIANT"); inv = !(e && *e && atoi(e) == 0); }
-        u64 h = (1469598103934665603ull ^ (VK_CACHE_VERSION + (inv ? 0u : 0x100u))) + (u64)stage;
-        for (const unsigned char* c = (const unsigned char*)hlsl; *c; c++) { h ^= *c; h *= 1099511628211ull; }
+        static u64 tid;
+        if (!tid) {
+            tid = rsx_hlsl_to_spirv_id();
+            VK_LOG("shader cache: translator %016llx\n", (unsigned long long)tid);
+        }
+        const u64 h = rsx_vk_spv_key(hlsl, stage, inv, VK_CACHE_VERSION, tid);
         snprintf(path, sizeof path, "%s/%016llx.spv", dir, (unsigned long long)h);
         *file_hash = h;
         FILE* f = fopen(path, "rb");
@@ -5511,7 +5518,8 @@ static void vk_plist_start(void)
     char path[600];
     snprintf(path, sizeof path, "%s/pipelines.list", dir);
     u32 hdr[4] = { 0 };
-    const u32 want[4] = { 0x5453494Cu /* "LIST" */, VK_PLIST_VERSION, (u32)sizeof(vk_plist_rec), 0 };
+    const u32 want[4] = { 0x5453494Cu /* "LIST" */, VK_PLIST_VERSION, (u32)sizeof(vk_plist_rec),
+                          rsx_vk_plist_translator_word(rsx_hlsl_to_spirv_id()) };
     FILE* f = fopen(path, "rb");
     long size = 0;
     if (f) { fseek(f, 0, SEEK_END); size = ftell(f); fseek(f, 0, SEEK_SET); }
