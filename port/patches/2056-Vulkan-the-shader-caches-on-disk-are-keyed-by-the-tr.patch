 cmake/RsxSpirvTranslatorId.cmake | 18 +++++++++++++
 libs/video/rsx_shader_spirv.cpp  | 17 ++++++++++++
 libs/video/rsx_shader_spirv.h    |  8 ++++++
 libs/video/rsx_vk_cache_key.h    | 44 ++++++++++++++++++++++++++++++++
 libs/video/rsx_vulkan_backend.c  | 18 +++++++++----
 6 files changed, 108 insertions(+), 6 deletions(-)
 create mode 100644 cmake/RsxSpirvTranslatorId.cmake
 create mode 100644 libs/video/rsx_vk_cache_key.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bc3c391..0ec4513 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -369,9 +369,16 @@ if(PS3RECOMP_RSX_VULKAN)
         find_package(glslang CONFIG QUIET)
     endif()
     if(glslang_FOUND AND TARGET glslang::glslang AND TARGET glslang::SPIRV)
+        # The translator's id (cmake/RsxSpirvTranslatorId.cmake): caches of
