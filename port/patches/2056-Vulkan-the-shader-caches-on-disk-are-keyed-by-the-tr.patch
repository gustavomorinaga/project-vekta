diff --git a/cmake/RsxSpirvTranslatorId.cmake b/cmake/RsxSpirvTranslatorId.cmake
new file mode 100644
index 0000000..9aee1e4
--- /dev/null
+++ b/cmake/RsxSpirvTranslatorId.cmake
@@ -0,0 +1,18 @@
+# rsx_spirv_translator_id(<out-var> <file>...): the translator id that
+# libs/video/rsx_shader_spirv.cpp is built with (RSX_SPIRV_TRANSLATOR_ID): the
+# first 16 hex digits of a SHA-256 over the given files' contents and
+# glslang_VERSION. Two builds of the same sources get the same id, so a cache
+# of translated shaders survives a rebuild and a reinstall and is dropped only
+# when the translator changed. The files are added to CMAKE_CONFIGURE_DEPENDS:
+# an edit to one of them configures again, which takes the id again.
+function(rsx_spirv_translator_id out)
+    set(_all "glslang ${glslang_VERSION}")
+    foreach(_f IN LISTS ARGN)
+        file(SHA256 "${_f}" _h)
+        string(APPEND _all ";${_h}")
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_f}")
+    endforeach()
+    string(SHA256 _id "${_all}")
+    string(SUBSTRING "${_id}" 0 16 _id)
+    set(${out} "${_id}" PARENT_SCOPE)
+endfunction()
diff --git a/libs/video/rsx_shader_spirv.cpp b/libs/video/rsx_shader_spirv.cpp
index e615dd3..b55815d 100644
--- a/libs/video/rsx_shader_spirv.cpp
+++ b/libs/video/rsx_shader_spirv.cpp
@@ -268,6 +268,21 @@ void cache_store(const std::string& path, const std::string& key,
 
 extern "C" int rsx_hlsl_to_spirv_available(void) { return 1; }
 
+extern "C" unsigned long long rsx_hlsl_to_spirv_id(void)
+{
+#ifdef RSX_SPIRV_TRANSLATOR_ID
+    const char* src = RSX_SPIRV_TRANSLATOR_ID;
+#else
+    const char* src = kTranslatorBuild;
+#endif
+    const glslang::Version v = glslang::GetVersion();
+    char buf[160];
+    snprintf(buf, sizeof buf, "%s/glslang %d.%d.%d%s", src, v.major, v.minor, v.patch, v.flavor ? v.flavor : "");
+    unsigned long long h = 0xcbf29ce484222325ull;       /* FNV-1a 64 */
+    for (const unsigned char* c = (const unsigned char*)buf; *c; c++) { h ^= *c; h *= 0x100000001b3ull; }
+    return h ? h : 1;
+}
+
 extern "C" int rsx_hlsl_to_spirv(const char* hlsl, int stage,
                                  u32* words, u32 max_words, u32* out_words,
                                  char* log, u32 log_size)
@@ -335,6 +350,8 @@ extern "C" void rsx_hlsl_to_spirv_cache_reset(void)
 
 extern "C" int rsx_hlsl_to_spirv_available(void) { return 0; }
 
+extern "C" unsigned long long rsx_hlsl_to_spirv_id(void) { return 0; }
+
 extern "C" int rsx_hlsl_to_spirv(const char* hlsl, int stage,
                                  u32* words, u32 max_words, u32* out_words,
                                  char* log, u32 log_size)
