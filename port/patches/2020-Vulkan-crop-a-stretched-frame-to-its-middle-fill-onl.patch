From 2b7178f18e53e8a8fd47f898a236b24c581d7b82 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 21 Oct 2026 22:38:44 -0300
Subject: [PATCH] Vulkan: crop a stretched frame to its middle; fill only
 widens

rsx_vulkan_set_crop(f) shows only the middle f of a stretched frame's width,
at its own shape with bars at the sides (frame dumps show the same): a title
whose widened frame holds only a 16:9 picture this time (a menu, a movie)
then keeps no stale content at the sides. PS3RECOMP_VK_SCALE_FIT=fill gives
a window narrower than the frame the fitted size, and a frame that is not
stretched is letterboxed at the guest frame's shape, even when it was
rendered anamorphic.

---
 libs/video/rsx_vulkan_backend.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libs/video/rsx_vulkan_backend.h b/libs/video/rsx_vulkan_backend.h
index 03e73616..b9ce4ea5 100644
--- a/libs/video/rsx_vulkan_backend.h
+++ b/libs/video/rsx_vulkan_backend.h
@@ -81,6 +81,7 @@ void rsx_vulkan_set_display(const char* mode, int w, int h, int hz);
 void rsx_vulkan_set_present(const char* mode);
 int  rsx_vulkan_display_sizes(int (*out)[2], int max);
 void rsx_vulkan_set_stretch(int on);
+void rsx_vulkan_set_crop(float f);
 int  rsx_vulkan_output_size(int* w, int* h);
 
 /* Read the frame back to host memory (and to PS3RECOMP_VK_DUMP if set), and
-- 
