             printf("[sceNpTrophy] CreateContext(commId=\"%s\") -> ctx=%d\n",
                    commId_h->data, i);
@@ -432,10 +629,12 @@ s32 sceNpTrophyDestroyContext(SceNpTrophyContext context)
         !s_contexts[context].in_use)
         return SCE_NP_TROPHY_ERROR_INVALID_CONTEXT;
 
+    STORE_LOCK();
     if (s_contexts[context].registered)
         trophy_save(&s_contexts[context]);
 
     s_contexts[context].in_use = 0;
+    STORE_UNLOCK();
     printf("[sceNpTrophy] DestroyContext(ctx=%d)\n", context);
     return CELL_OK;
 }
@@ -500,8 +699,10 @@ s32 sceNpTrophyRegisterContext(SceNpTrophyContext context,
     if (!g_ps3_guest_caller) return SCE_NP_TROPHY_ERROR_UNKNOWN;
 
     /* Load any previously saved trophy data */
+    STORE_LOCK();
     trophy_load(&s_contexts[context]);
     s_contexts[context].registered = 1;
+    STORE_UNLOCK();
 
     printf("[sceNpTrophy] RegisterContext(ctx=%d, handle=%d, statusCb=0x%08X, "
            "arg=0x%08X) -> loaded saved data\n", context, handle, statusCb, arg);
@@ -666,11 +867,25 @@ s32 sceNpTrophyUnlockTrophy(SceNpTrophyContext context,
         return SCE_NP_TROPHY_ERROR_INVALID_ARGUMENT;
 
     TrophyContext* ctx = &s_contexts[context];
-    if (ctx->unlocked[trophyId])
+    STORE_LOCK();
+    if (ctx->unlocked[trophyId]) {
+        STORE_UNLOCK();
         return SCE_NP_TROPHY_ERROR_ALREADY_UNLOCKED;
+    }
     /* The platinum comes by itself, never from the title. */
-    if (ctx->have_trp && ctx->info[trophyId].grade == SCE_NP_TROPHY_GRADE_PLATINUM)
+    if (ctx->have_trp && ctx->info[trophyId].grade == SCE_NP_TROPHY_GRADE_PLATINUM) {
+        STORE_UNLOCK();
         return SCE_NP_TROPHY_ERROR_PLATINUM_CANNOT_UNLOCK;
+    }
+    /* A debug option that changes the game is on: not stored, not shown. The
+     * title is told it worked (it would retry, or stop, on an error). */
+    if (s_blocked) {
+        STORE_UNLOCK();
+        printf("[sceNpTrophy] #%d %s: blocked by debug option, not stored\n", (int)trophyId,
+               ctx->info[trophyId].name[0] ? ctx->info[trophyId].name : "?");
+        if (platinumId) vm_write32((u32)(uintptr_t)platinumId, (u32)SCE_NP_TROPHY_INVALID_TROPHY_ID);
+        return CELL_OK;
+    }
 
     ctx->unlocked[trophyId] = 1;
     ctx->unlock_time[trophyId] = (u64)time(NULL);
@@ -692,6 +907,13 @@ s32 sceNpTrophyUnlockTrophy(SceNpTrophyContext context,
         }
     }
     trophy_save(ctx);
+    const ps3_trophy_notify_fn fn = s_notify;
+    void* const user = s_notify_user;
+    STORE_UNLOCK();
+    if (fn) {
+        trophy_notify(fn, user, ctx, (u32)trophyId);
+        if (plat >= 0) trophy_notify(fn, user, ctx, (u32)plat);
+    }
     if (platinumId)
         vm_write32((u32)(uintptr_t)platinumId, (u32)plat);
 
@@ -722,6 +944,7 @@ s32 sceNpTrophyGetTrophyUnlockState(SceNpTrophyContext context,
     for (u32 o = 0; o < sizeof(SceNpTrophyFlagArray); o += 4)
         vm_write32(flags_ea + o, 0);
 
+    STORE_LOCK();
     for (u32 i = 0; i < s_contexts[context].total_trophies; i++) {
         if (s_contexts[context].unlocked[i])
             {
@@ -729,6 +952,7 @@ s32 sceNpTrophyGetTrophyUnlockState(SceNpTrophyContext context,
             vm_write32(word_ea, vm_read32(word_ea) | (1u << (i % 32)));
