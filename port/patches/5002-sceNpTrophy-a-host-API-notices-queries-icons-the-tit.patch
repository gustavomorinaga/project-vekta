+        if ((ltext = trp_entry(d, (size_t)n, want))) snprintf(sfm, sizeof sfm, "%s", want);
+    }
     free(d);
     if (!conf) { free(text); printf("[sceNpTrophy] %s: no TROPCONF.SFM\n", path); return; }
     u32 count = 0;
@@ -297,13 +365,24 @@ static void trophy_load_trp(TrophyContext* ctx)
             trp_text(t, next, "detail", ctx->info[id].detail, sizeof ctx->info[id].detail);
         }
     }
+    for (const char* t = ltext ? strstr(ltext, "<trophy ") : NULL; t; t = strstr(t + 1, "<trophy ")) {
