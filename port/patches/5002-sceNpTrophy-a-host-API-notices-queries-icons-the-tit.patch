+/* ---------------------------------------------------------------------------
+ * Host API (sceNpTrophy.h)
+ * -----------------------------------------------------------------------*/
+
+static ps3_trophy_notify_fn s_notify;
+static void* s_notify_user;
+static int s_blocked;
+
+void ps3_trophy_set_notify(ps3_trophy_notify_fn fn, void* user)
+{
+    STORE_LOCK();
+    s_notify = fn;
+    s_notify_user = user;
+    STORE_UNLOCK();
+}
+
+void ps3_trophy_set_blocked(int blocked)
+{
+    STORE_LOCK();
+    s_blocked = blocked != 0;
+    STORE_UNLOCK();
+}
+
+/* The title's context: the first one in use (a title has one trophy set). Under the lock. */
+static TrophyContext* trophy_host_ctx(void)
+{
+    for (int i = 1; i <= SCE_NP_TROPHY_MAX_CONTEXTS; i++)
+        if (s_contexts[i].in_use) return &s_contexts[i];
+    return NULL;
+}
+
+int ps3_trophy_count(void)
+{
+    STORE_LOCK();
+    const TrophyContext* ctx = trophy_host_ctx();
+    const int n = ctx && ctx->have_trp ? (int)ctx->total_trophies : 0;
+    STORE_UNLOCK();
+    return n;
+}
+
+int ps3_trophy_get(s32 id, ps3_trophy_def* out)
+{
+    if (!out) return -1;
+    STORE_LOCK();
+    const TrophyContext* ctx = trophy_host_ctx();
+    int r = -1;
+    if (ctx && ctx->have_trp && id >= 0 && (u32)id < ctx->total_trophies) {
+        const TrophyInfo* ti = &ctx->info[id];
+        memset(out, 0, sizeof *out);
+        out->id = id;
+        out->grade = (s32)ti->grade;
+        out->hidden = ti->hidden;
+        out->unlocked = ctx->unlocked[id];
+        out->timestamp = ctx->unlock_time[id];
+        snprintf(out->name, sizeof out->name, "%s", ti->lname[0] ? ti->lname : ti->name);
+        snprintf(out->detail, sizeof out->detail, "%s", ti->lname[0] ? ti->ldetail : ti->detail);
+        snprintf(out->name_en, sizeof out->name_en, "%s", ti->name);
+        r = 0;
+    }
+    STORE_UNLOCK();
+    return r;
+}
+
+void* ps3_trophy_icon(s32 id, size_t* size)
+{
+    if (size) *size = 0;
+    char path[1024] = "";
+    STORE_LOCK();
+    const TrophyContext* ctx = trophy_host_ctx();
+    const int ok = ctx && ctx->have_trp && id >= -1 && (id < 0 || (u32)id < ctx->total_trophies);
+    if (ok) snprintf(path, sizeof path, "%s", ctx->trp_path);
+    STORE_UNLOCK();
+    if (!ok || !path[0]) return NULL;
+    /* only the entry table and the one PNG are read */
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    char want[32];
+    if (id < 0) snprintf(want, sizeof want, "ICON0.PNG"); else snprintf(want, sizeof want, "TROP%03d.PNG", (int)id);
+    u8 h[0x40];
+    void* png = NULL;
+    if (fread(h, 1, sizeof h, f) == sizeof h && trp_be32(h) == 0xDCA24D00u) {
+        const u32 count = trp_be32(h + 0x10), esz = trp_be32(h + 0x14);
+        u8 e[0x40];
+        for (u32 i = 0; i < count && esz >= 0x30 && esz <= sizeof e; i++) {
+            if (fseek(f, (long)(0x40 + (u64)i * esz), SEEK_SET) || fread(e, 1, esz, f) != esz) break;
+            if (strncmp((const char*)e, want, 32) != 0) continue;
+            const u64 off = trp_be64(e + 0x20), sz = trp_be64(e + 0x28);
+            if (sz == 0 || sz > (16u << 20) || fseek(f, (long)off, SEEK_SET)) break;
+            png = malloc((size_t)sz);
+            if (png && fread(png, 1, (size_t)sz, f) != (size_t)sz) { free(png); png = NULL; }
+            if (png && size) *size = (size_t)sz;
+            break;
+        }
+    }
+    fclose(f);
+    return png;
+}
+
+/* The host's notice for one unlock; called with the lock released (the
+ * callback may query). The strings live in ctx->info, set at CreateContext. */
+static void trophy_notify(ps3_trophy_notify_fn fn, void* user, const TrophyContext* ctx, u32 id)
+{
+    const TrophyInfo* ti = &ctx->info[id];
+    ps3_trophy_notice n;
+    n.comm_id = ctx->comm_id;
+    n.id = (s32)id;
+    n.grade = (s32)ti->grade;
+    n.hidden = ti->hidden;
+    n.name = ti->lname[0] ? ti->lname : ti->name;
+    n.detail = ti->lname[0] ? ti->ldetail : ti->detail;
+    fn(&n, user);
+}
+
