diff --git a/libs/network/sceNpTrophy.h b/libs/network/sceNpTrophy.h
index 48faefd..587000c 100644
--- a/libs/network/sceNpTrophy.h
+++ b/libs/network/sceNpTrophy.h
@@ -10,6 +10,7 @@
 #include "ps3emu/ps3types.h"
 #include "ps3emu/error_codes.h"
 #include "sceNp.h"
+#include <stddef.h>
 
 #ifdef __cplusplus
 extern "C" {
@@ -169,6 +170,49 @@ s32 sceNpTrophyGetGameProgress(SceNpTrophyContext context,
 /* Set the trophy storage directory (defaults to "gamedata/trophies") */
 void sceNpTrophySetStoragePath(const char* path);
 
+/* ---------------------------------------------------------------------------
+ * Host API (for the port: a toast, a trophy list). Not guest functions.
+ * The notice's layout and ps3_trophy_set_notify follow Project Pyrrhus's
+ * patch 5004 (MIT), so a port written for one works with the other.
+ * -----------------------------------------------------------------------*/
+typedef struct ps3_trophy_notice {
+    const char* comm_id;   /* "NPWR03819" */
+    s32         id;
+    s32         grade;     /* SCE_NP_TROPHY_GRADE_* */
+    u8          hidden;
+    const char* name;      /* in the title's language when the set has it */
+    const char* detail;
+} ps3_trophy_notice;
+
+/* Called on the unlocking guest thread for each new unlock, then once more for
+ * a platinum it completes; never for an id already unlocked, nor while
+ * blocked. The strings are valid only during the call: copy, do not draw. */
+typedef void (*ps3_trophy_notify_fn)(const ps3_trophy_notice* notice, void* user);
+void ps3_trophy_set_notify(ps3_trophy_notify_fn fn, void* user);
+
+/* Nonzero: unlocks are logged ("blocked by debug option") and neither stored
+ * nor notified; the title is still told they worked. */
+void ps3_trophy_set_blocked(int blocked);
+
+/* The title's set (its first context): the count (0 before CreateContext, or
+ * without a TRP), one trophy by id (0 = filled, -1 = no such id). */
+typedef struct ps3_trophy_def {
+    s32  id;
+    s32  grade;
+    u8   hidden;
+    u8   unlocked;
+    u64  timestamp;        /* UNIX seconds, 0 = locked */
+    char name[SCE_NP_TROPHY_NAME_MAX_SIZE];      /* the title's language */
+    char detail[SCE_NP_TROPHY_DESC_MAX_SIZE];
+    char name_en[SCE_NP_TROPHY_NAME_MAX_SIZE];   /* TROP.SFM's, as the store keeps it */
+} ps3_trophy_def;
