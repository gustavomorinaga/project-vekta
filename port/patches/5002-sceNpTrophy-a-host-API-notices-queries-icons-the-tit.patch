     memcpy(out, a, len); out[len] = 0;
 }
 
+/* The TROP_<nn>.SFM of the language the title is told (PS3_LANG: a
+ * CELL_SYSUTIL_LANG_* number or its code, as cellSysutil reads it), when the
+ * set has it; else TROP.SFM (English). en and en-gb have no file of their own. */
+static int trophy_lang_id(void)
+{
+    static const char* const codes[] = { "ja", "en", "fr", "es", "de", "it", "nl", "pt", "ru", "ko", "zh-t",
+                                         "zh-s", "fi", "sv", "da", "no", "pl", "pt-br", "en-gb", "tr" };
+    const char* e = getenv("PS3_LANG");
+    if (!e || !*e) return 1;
+    char* end = NULL;
+    const long n = strtol(e, &end, 10);
+    if (end && *end == '\0') return n >= 0 && n < (long)(sizeof codes / sizeof codes[0]) ? (int)n : 1;
+    for (int i = 0; i < (int)(sizeof codes / sizeof codes[0]); i++) {
+        const char* a = e; const char* b = codes[i];
+        while (*a && *b && (*a | 0x20) == *b) { a++; b++; }
+        if (!*a && !*b) return i;
+    }
+    if (!strcmp(e, "en-us") || !strcmp(e, "EN-US")) return 1;
+    if (!strcmp(e, "pt-pt") || !strcmp(e, "PT-PT")) return 7;
+    return 1;
+}
