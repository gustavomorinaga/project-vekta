From 5c1ab29b3b558a436816705166bbdf8ad2488b5d Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 20 Oct 2026 22:31:01 -0300
Subject: [PATCH] PPU: one window compare on the guest store path

Every lifted store calls vm_write*, whose fast half tested three diagnostic
globals, the low guard page, the OOB bound, the raw SPU problem-state range
and the lock-line flag before the bitmap: about 35 instructions a store. The
store window [0x1000, 0x1000 + g_st_span) folds all but the bitmap into one
compare. It is computed from the same globals on the first store that misses
it, ends below the raw SPU area, and is closed whenever a store diagnostic
turns on (the null-store sweep clears it). The bitmap is all zeros until an
SPU reserves a line, so the window path skips g_spu_coh_armed. Stores outside
the window take the previous path unchanged.

Killzone HD, Level 1 at the 144 Hz clock: 99.3 -> 101.7 fps (three runs each).

---
 runtime/ppu/ppu_loader.cpp | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 5c4ed014..b14c1096 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -1448,6 +1448,7 @@ static inline int vm_oob(uint32_t a, uint32_t n)
 extern "C" PPU_THREAD_LOCAL ppu_context* g_active_ctx;
 extern "C" void ppu_dump_guest_stack(ppu_context*, const char*);
 extern "C" uint32_t g_null_sweep_hi = 0;   /* 0 = not sweeping */
+extern "C" uint32_t g_st_span;   /* the store window (below): closed with the sweep */
 static uint32_t g_null_sweep_last = 0;
 static unsigned g_null_sweep_tid = 0;
 static int vm_null_store_report(uint32_t a, uint32_t v, int width, void* ra)
@@ -1458,7 +1459,7 @@ static int vm_null_store_report(uint32_t a, uint32_t v, int width, void* ra)
     if (!en) return 0;                                    /* let it land */
     { static int sweep = -1;
       if (sweep < 0) { const char* e = getenv("PS3_NULL_SWEEP"); sweep = e ? 1 : 0; }
-      if (sweep) { g_null_sweep_hi = 1; g_null_sweep_last = a;
+      if (sweep) { g_null_sweep_hi = 1; g_st_span = 0; g_null_sweep_last = a;
                    g_null_sweep_tid = g_active_ctx
                                     ? (unsigned)g_active_ctx->thread_id : 0u; } }
     { static long n = 0;
@@ -2108,6 +2109,33 @@ static inline int vm_st_plain(uint32_t a, uint32_t n)
     return __builtin_expect((g_barrier_sync_watch | g_null_sweep_hi | (uint32_t)s_st_watch_env) == 0, 1) &&
            a >= 0x1000u && (ppu_vm_size == 0 || (uint64_t)a + n <= ppu_vm_size);
 }
+/* The store window: stores to [0x1000, 0x1000 + g_st_span) need only the
+ * lock-line check -- vm_st_plain holds for the whole window, and it ends below
+ * the raw SPU area. It is computed by vm_st_window_refresh from the same
+ * globals, on the first store that misses it, and closed (0) whenever a store
+ * diagnostic turns on: whoever sets g_null_sweep_hi or g_barrier_sync_watch
+ * clears g_st_span too. (The lock-line bitmap is all zeros until an SPU
+ * reserves a line, so the window path reads it without g_spu_coh_armed.) */
+extern "C" uint32_t g_st_span = 0;
+extern "C" void vm_st_window_refresh(void)
+{
+    if (g_barrier_sync_watch | g_null_sweep_hi | (uint32_t)s_st_watch_env) { g_st_span = 0; return; }
+    const uint32_t top = (ppu_vm_size && ppu_vm_size < SPU_RAW_BASE) ? ppu_vm_size : SPU_RAW_BASE;
+    g_st_span = top - 0x1000u - 8u;   /* room for the widest store */
+}
+#define VM_STORE_WINDOW(ea, val, n, bswap)                                    \
+    do {                                                                      \
+        if (__builtin_expect((ea) - 0x1000u < g_st_span, 1)) {                \
+            const auto raw_ = bswap(val);                                     \
+            const uint32_t line_ = (ea) >> 7;                                 \
+            if (__builtin_expect((g_spu_coh_bitmap[line_ >> 3] >> (line_ & 7)) & 1u, 0)) \
+                vm_store_coh((ea), (uint64_t)raw_, (n));                      \
+            else memcpy(vm_base + (ea), &raw_, (n));                          \
+            return;                                                           \
+        }                                                                     \
+        vm_st_window_refresh();                                               \
+    } while (0)
+static inline uint8_t vm_id8(uint8_t v) { return v; }
 static __attribute__((noinline)) void vm_write8_slow(uint64_t a, uint8_t  v, void* ra) { barrier_watch_hit((uint32_t)a, v, 1, ra); if (vm_oob((uint32_t)a,1) || vm_null_store((uint32_t)a, v, 1, ra)) return;
 #ifdef _WIN32
     /* PT detector: does this byte-write turn its word into the hunted truncated value? */
@@ -2138,6 +2166,7 @@ extern "C" int vm_block_plain(uint32_t ea, uint32_t n)
 }
 void vm_write8 (uint64_t a, uint8_t  v) {
     const uint32_t ea = (uint32_t)a;
+    VM_STORE_WINDOW(ea, v, 1, vm_id8);
     if (__builtin_expect(vm_st_plain(ea, 1) && !spu_raw_is_reg(ea), 1)) {
         const uint8_t raw = v;
         VM_STORE_FAST(ea, raw, 1);
@@ -2149,6 +2178,7 @@ static __attribute__((noinline)) void vm_write16_slow(uint64_t a, uint16_t v, vo
     v = __builtin_bswap16(v); VM_WRITE_COH(a, &v, 2); }
 void vm_write16(uint64_t a, uint16_t v) {
     const uint32_t ea = (uint32_t)a;
+    VM_STORE_WINDOW(ea, v, 2, __builtin_bswap16);
     if (__builtin_expect(vm_st_plain(ea, 2) && !spu_raw_is_reg(ea), 1)) {
         const uint16_t raw = __builtin_bswap16(v);
         VM_STORE_FAST(ea, raw, 2);
@@ -2170,6 +2200,7 @@ static __attribute__((noinline)) void vm_write32_slow(uint64_t a, uint32_t v, vo
       if (spu_raw_is_reg((uint32_t)a)) spu_raw_reg_store((uint32_t)a, _v, 4); } }
 void vm_write32(uint64_t a, uint32_t v) {
     const uint32_t ea = (uint32_t)a;
+    VM_STORE_WINDOW(ea, v, 4, __builtin_bswap32);
     if (__builtin_expect(vm_st_plain(ea, 4) && !spu_raw_is_reg(ea), 1)) {
         const uint32_t raw = __builtin_bswap32(v);
         VM_STORE_FAST(ea, raw, 4);
@@ -2189,6 +2220,7 @@ static __attribute__((noinline)) void vm_write64_slow(uint64_t a, uint64_t v, vo
     v = __builtin_bswap64(v); VM_WRITE_COH(a, &v, 8); }
 void vm_write64(uint64_t a, uint64_t v) {
     const uint32_t ea = (uint32_t)a;
+    VM_STORE_WINDOW(ea, v, 8, __builtin_bswap64);
     if (__builtin_expect(vm_st_plain(ea, 8), 1)) {
         const uint64_t raw = __builtin_bswap64(v);
         VM_STORE_FAST(ea, raw, 8);
-- 
