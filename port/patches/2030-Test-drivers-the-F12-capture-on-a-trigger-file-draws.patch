From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 28 Oct 2026 14:09:04 -0300
Subject: [PATCH] Test drivers: the F12 capture on a trigger file;
 draws.txt names each attribute's address

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/rsx_draw_engine.c    | 5 +++--
 libs/video/rsx_vulkan_backend.c | 8 ++++++++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 6d066797..219ccf26 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -3369,8 +3369,9 @@ static void sink_end(void* user, const rsx_dispatch* r)
         for (u32 k = 0; k < layout.count; k++) {
             const u32 a = layout.attrs[k];
             const float* f = (const float*)(dc.verts + k * 16u);
-            fprintf(s_pd.draws_log, " a%u[fmt %08X](%g %g %g %g)", a,
-                    rsx_dsp_reg(&g.rsx, 0x1740u + a * 4u), f[0], f[1], f[2], f[3]);
+            fprintf(s_pd.draws_log, " a%u[fmt %08X @%08X](%g %g %g %g)", a,
+                    rsx_dsp_reg(&g.rsx, 0x1740u + a * 4u), rsx_dsp_reg(&g.rsx, 0x1680u + a * 4u),
+                    f[0], f[1], f[2], f[3]);
         }
         fprintf(s_pd.draws_log, "\n");
         /* an F12 capture: every fetched vertex, as floats (attribute k of
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 540ac17f..358b8969 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -2300,6 +2300,14 @@ static void vk_cb_present(void* ud, u32 buffer_id)
 {
     (void)ud; (void)buffer_id;
     if (!s_vk.device) return;
+    /* PS3RECOMP_CAPTURE_TRIGGER=<file>: the F12 capture, when that file
+     * appears (it is removed): a test driver asks for one */
+    { static int on = -1; static char path[512];
+      if (on < 0) { const char* e = getenv("PS3RECOMP_CAPTURE_TRIGGER"); on = e && *e;
+                    if (on) snprintf(path, sizeof path, "%s", e); }
+      if (on && (s_vk.presented & 15) == 0 && remove(path) == 0) {
+          extern volatile int g_rsx_capture_request;   /* rsx_draw_engine.c */
+          g_rsx_capture_request = 1; } }
     s_dump_now = vk_dump_decide();
 
     /* The draw engine reads its own centre pixel; the frame comes back to the
-- 
