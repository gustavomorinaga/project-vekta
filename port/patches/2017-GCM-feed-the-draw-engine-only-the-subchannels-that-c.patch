From ca256ee6270fff9c5e8802f3f4d0dc3e049441a0 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 20 Oct 2026 18:03:11 -0300
Subject: [PATCH] GCM: feed the draw engine only the subchannels that
 carry NV4097

Every FIFO method went to the register-file engine with its subchannel
masked off, so the 2D objects' methods (NV3062 SET_COLOR_FORMAT 0x300,
SET_PITCH 0x304, ...) landed on the 3D registers at the same addresses --
the alpha test among them. Killzone HD's foliage lost its cut-outs, and
once the alpha test was read leniently (the previous change) its
characters lost texels instead. Now only subchannel 0, subchannel 1 (unless
GCM_SUBCH1_2D) and the driver methods reach it, as for rsx_process_method.

---
 libs/video/cellGcmSys.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 55d9ffac..612a550a 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2736,9 +2736,18 @@ static void gcm_rsx_process_fifo_unlocked(void)
                  * which is the macOS path under PS3RECOMP_RSX_ENGINE=dispatch.
                  * It wants the raw method with its subchannel bits for the
                  * same reason the live engine does, and masks them itself. */
+                /* Only the subchannels that carry NV4097 (the ones handed to
+                 * rsx_process_method below) and the driver methods: the 2D
+                 * objects' methods share the low addresses (NV3062's
+                 * SET_COLOR_FORMAT and SET_PITCH are 0x300 and 0x304), and fed
+                 * to the 3D register file they overwrote its alpha test --
+                 * Killzone HD's foliage then lost its cut-outs, and with the
+                 * test read leniently its characters lost half their texels. */
                 if (wdiag) { static int eng = -1;
                   if (eng < 0) eng = rsx_draw_engine_enabled();
-                  if (eng) rsx_draw_engine_method((subch << 13) | m, vm_read32(dea)); }
+                  if (s1_2d < 0) { const char* e = getenv("GCM_SUBCH1_2D"); s1_2d = e ? atoi(e) : 0; }
+                  if (eng && (subch == 0 || (subch == 1 && !s1_2d) || ((subch << 13) | m) >= 0xE000u))
+                      rsx_draw_engine_method((subch << 13) | m, vm_read32(dea)); }
 
                 /* RSX_LIVE_FEED_DBG=1: what the FIFO actually carries. Counted
                  * for any run, live engine or not, so the method stream and the
