From f5039deb24a8d87a671fafa7fa84b1dae9cefdd1 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 27 Oct 2026 19:24:37 -0300
Subject: [PATCH] spurs: the coordinator sleeps on a condition variable
 of its own

Kicks, API calls and freed slots woke every worker of the instance along with the coordinator: in KZ1 HD the main thread's ready-count stores were a broadcast to five threads each. Workers now wake only for work or stop. Level 7: 119.7 -> 126.9 fps (v0.14.0 base 130.5 in the same session).

---
 libs/spurs/cellSpurs.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index b1d4a21a47392f00ca2a651fcf22fadb637e2e01..f7e89fb081d3aca917812b05d69fc128dfbc8ab6 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -475,7 +475,10 @@ static struct SpursInst {
     int kernel_live, stopping, starting;
     int kick;   /* an SPU committed the request line since the coordinator last looked */
     SRWLOCK lock;
-    CONDITION_VARIABLE wake;
+    CONDITION_VARIABLE wake;   /* the workers: a slot was given work, or stop */
+    CONDITION_VARIABLE kwake;  /* the coordinator: a kick, an API change, a slot freed, or stop.
+                                * Its own variable, so the many kicks a frame do not wake
+                                * every worker too. */
     HANDLE coordinator;
     struct SpursPmSlot slots[6];
     u8 active[SPURS_MAX_WID], idle[SPURS_MAX_WID];
@@ -506,7 +509,7 @@ static void spurs_line_committed(uint32_t line)
         if (!ea || (ea & ~127u) != line || !__atomic_load_n(&si->kernel_live, __ATOMIC_ACQUIRE))
             continue;
         __atomic_store_n(&si->kick, 1, __ATOMIC_RELEASE);
-        WakeAllConditionVariable(&si->wake);
+        WakeAllConditionVariable(&si->kwake);
     }
 }
 static void spurs_commit_hook(uint32_t line)
@@ -583,7 +586,7 @@ static s32 spurs_api_lock(u32 ea, struct SpursInst** out)
 static void spurs_api_unlock(struct SpursInst* si)
 {
     ReleaseSRWLockExclusive(&s_workload_registry_lock);
-    WakeAllConditionVariable(&si->wake);
+    WakeAllConditionVariable(&si->kwake);
     ReleaseSRWLockExclusive(&si->lock);
 }
 
@@ -2064,7 +2067,7 @@ static DWORD WINAPI spurs_pm_worker(LPVOID p)
         if (polls) si->idle[wid] = 0;
         else if (si->idle[wid] < spurs_idle_max()) si->idle[wid]++;
         slot->busy = 0;
-        WakeAllConditionVariable(&si->wake);
+        WakeAllConditionVariable(&si->kwake);
     }
     ReleaseSRWLockExclusive(&si->lock);
     ps3_tprof_thread_exit();
@@ -2131,7 +2134,7 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
             AcquireSRWLockExclusive(&si->lock);
             (void)__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL);
         } else {
-            SleepConditionVariableSRW(&si->wake, &si->lock, (DWORD)(s_poll_us / 1000), 0);
+            SleepConditionVariableSRW(&si->kwake, &si->lock, (DWORD)(s_poll_us / 1000), 0);
             /* This full pass reads the line after any commit that woke it. */
             (void)__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL);
         }
@@ -2229,7 +2232,7 @@ static s32 spurs_scheduler_start(struct SpursInst* si)
     return CELL_OK;
 failed:
     AcquireSRWLockExclusive(&si->lock);
-    si->stopping = 1; WakeAllConditionVariable(&si->wake);
+    si->stopping = 1; WakeAllConditionVariable(&si->wake); WakeAllConditionVariable(&si->kwake);
     ReleaseSRWLockExclusive(&si->lock);
     for (u32 sn = 0; sn < si->nspus; sn++) {
         HANDLE h = si->slots[sn].thread;
@@ -2248,7 +2251,7 @@ static s32 spurs_scheduler_stop(struct SpursInst* si, u32 ea)
     if (si->stopping || si->starting) { ReleaseSRWLockExclusive(&si->lock); return CELL_SPURS_CORE_ERROR_BUSY; }
     for (u32 wid = 0; wid < SPURS_MAX_WID; wid++)
         if (si->active[wid]) { ReleaseSRWLockExclusive(&si->lock); return CELL_SPURS_CORE_ERROR_BUSY; }
-    si->stopping = 1; WakeAllConditionVariable(&si->wake);
+    si->stopping = 1; WakeAllConditionVariable(&si->wake); WakeAllConditionVariable(&si->kwake);
     ReleaseSRWLockExclusive(&si->lock);
     if (si->coordinator) { WaitForSingleObject(si->coordinator, INFINITE); CloseHandle(si->coordinator); si->coordinator = NULL; }
     for (u32 sn = 0; sn < si->nspus; sn++) {
-- 
