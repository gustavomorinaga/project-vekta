diff --git a/libs/video/vulkan/rsx_vk_glow.comp b/libs/video/vulkan/rsx_vk_glow.comp
new file mode 100644
index 0000000..ee27a57
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_glow.comp
@@ -0,0 +1,146 @@
+#version 450
+// Killzone HD's jm_post glow (SPU modules 8197, de0b, ab05, 6b71 and f601's
+// upsample and saturating add) on the GPU, the same rules as the game port's
+// C reference (port/kz1hd/native/glow_ref.c; the decoding is in
+// docs/dev/wws-jm-post.md of the Killzone port, "The glow"). It runs after the
+// MLAA and before the motion blur, as the SPU chain does, on the same 1280x720
+// buffer of raw texels (R, G, B, A from the low byte up; the rules treat the
+// four bytes alike). Stages, by push constant:
+//  0 DOWN    the 640x360 glow source SRC -> 320x180 QA (2x2 byte averages
+//            rounded up, down first); notes whether any colour is lit (an
+//            average rounded up is 0 only when its four pixels are)
+//  6 ARM     the indirect dispatch sizes of the stages below: the whole
+//            chain when the source has colour and the strength is above 0, or
+//            when its alpha is not uniform; otherwise only ALPHA (or
+//            ALPHA_OUT), since the add still saturates the image's alpha (the
+//            MLAA leaves its flags there, and the motion blur after weighs its
+//            taps by alpha)
+//  1 BLUR    7-tap binomial (1,6,15,20,15,6,1)/64, edges repeated, truncated:
+//            job 0 across QA -> QB, job 1 down QB -> QA
+//  2 MOD     QA = min(255, (QA * 3) >> 1)
+//  3 UP      QA doubled (9:3:3:1, edges repeated) -> 640x360 G
+//  4 ADD     G doubled the same way, added to the image, saturated; the colour
+//            bytes times strength/256 (exact at 256), the alpha byte always whole
+//  5 ADD_OUT the same over an image of another size (a temporal upscaler's
+//            output): G upsampled bilinearly to ow x oh, edges repeated
+//  7 ALPHA   the add's alpha alone, for a source of uniform alpha v: every
+//            stage keeps a uniform value uniform, so the glow's alpha is
+//            min(255, (3v) >> 1) everywhere
+//  8 ALPHA_OUT the same over the temporal upscaler's output
+layout(local_size_x = 256) in;
+layout(std430, binding = 0) buffer Img { uint IMG[]; };   // 1280x720 raw texels
+layout(std430, binding = 1) buffer Src { uint SRC[]; };   // the glow source, 640x360
+layout(std430, binding = 2) buffer Qa  { uint QA[]; };    // 320x180
+layout(std430, binding = 3) buffer Qb  { uint QB[]; };
+layout(std430, binding = 4) buffer Gl  { uint G[]; };     // the glow texture, 640x360
+layout(std430, binding = 5) buffer Ct  { uint CTRL[]; };  // lit; dispatch sizes (quarter, half, full, out); alpha not uniform; alpha-only sizes (full, out)
+layout(set = 0, binding = 6, rgba8) uniform image2D OUT;
+layout(push_constant) uniform Push { int stage; int job; int ow; int oh; int strength; } pc;
+
+const int W = 1280, H = 720, HW = 640, HH = 360, QW = 320, QH = 180;
+
+uint ch(uint t, int c) { return (t >> uint(8 * c)) & 0xFFu; }
+
+// one of the 2x2 upsample's outputs: m the pixel, mx its row neighbour, v the other row's, vx diagonal
+uint up4(uint m, uint mx, uint v, uint vx, int c)
+{
+    return (3u * (3u * ch(m, c) + ch(mx, c)) + (3u * ch(v, c) + ch(vx, c))) >> 4;
+}
+
+void main()
+{
+    const int i = int(gl_GlobalInvocationID.x);
+    if (pc.stage == 0) {                                   // DOWN
+        if (i >= QW * QH) return;
+        const int y = i / QW, x = i % QW, s = 2 * y * HW + 2 * x;
+        const uint a = SRC[s], b = SRC[s + 1], c = SRC[s + HW], d = SRC[s + HW + 1];
+        uint r = 0u;
+        for (int k = 0; k < 32; k += 8) {
+            const uint l = (((a >> k) & 0xFFu) + ((c >> k) & 0xFFu) + 1u) >> 1, rr = (((b >> k) & 0xFFu) + ((d >> k) & 0xFFu) + 1u) >> 1;
+            r |= ((l + rr + 1u) >> 1) << k;
+        }
+        QA[i] = r;
+        if ((r & 0x00FFFFFFu) != 0u) CTRL[0] = 1u;
+        const uint a0 = SRC[0] >> 24;
+        if ((a >> 24) != a0 || (b >> 24) != a0 || (c >> 24) != a0 || (d >> 24) != a0) CTRL[13] = 1u;
+    } else if (pc.stage == 6) {                            // ARM
+        if (i != 0) return;
+        const uint on = (CTRL[0] != 0u && pc.strength > 0) || CTRL[13] != 0u ? 1u : 0u;
+        CTRL[1] = on * uint((QW * QH + 255) / 256); CTRL[2] = 1u; CTRL[3] = 1u;
+        CTRL[4] = on * uint(HW * HH / 256);         CTRL[5] = 1u; CTRL[6] = 1u;
+        CTRL[7] = on * uint(W * H / 256);           CTRL[8] = 1u; CTRL[9] = 1u;
+        CTRL[10] = on * uint((pc.ow * pc.oh + 255) / 256); CTRL[11] = 1u; CTRL[12] = 1u;
+        CTRL[14] = (1u - on) * uint(W * H / 256);    CTRL[15] = 1u; CTRL[16] = 1u;
+        CTRL[17] = (1u - on) * uint((pc.ow * pc.oh + 255) / 256); CTRL[18] = 1u; CTRL[19] = 1u;
+    } else if (pc.stage == 1) {                            // BLUR
+        if (i >= QW * QH) return;
+        const bool across = pc.job == 0;
+        const int y = i / QW, x = i % QW, n = across ? QW : QH, p = across ? x : y;
+        uint t[7];
+        for (int k = -3; k <= 3; k++) {
+            const int q = clamp(p + k, 0, n - 1);
+            t[k + 3] = across ? QA[y * QW + q] : QB[q * QW + x];
+        }
+        uint r = 0u;
+        for (int c = 0; c < 4; c++) {
+            const uint v = (20u * ch(t[3], c) + 15u * (ch(t[2], c) + ch(t[4], c)) + 6u * (ch(t[1], c) + ch(t[5], c)) +
+                            ch(t[0], c) + ch(t[6], c)) >> 6;
+            r |= v << uint(8 * c);
+        }
+        if (across) QB[i] = r; else QA[i] = r;
+    } else if (pc.stage == 2) {                            // MOD
+        if (i >= QW * QH) return;
+        const uint t = QA[i];
+        uint r = 0u;
+        for (int c = 0; c < 4; c++) r |= min((ch(t, c) * 3u) >> 1, 255u) << uint(8 * c);
+        QA[i] = r;
+    } else if (pc.stage == 3) {                            // UP
+        if (i >= HW * HH) return;
+        const int y = i / HW, x = i % HW, sy = y >> 1, sx = x >> 1;
+        const int ny = (y & 1) != 0 ? min(sy + 1, QH - 1) : max(sy - 1, 0);
+        const int nx = (x & 1) != 0 ? min(sx + 1, QW - 1) : max(sx - 1, 0);
+        const uint m = QA[sy * QW + sx], mx = QA[sy * QW + nx], v = QA[ny * QW + sx], vx = QA[ny * QW + nx];
+        uint r = 0u;
+        for (int c = 0; c < 4; c++) r |= up4(m, mx, v, vx, c) << uint(8 * c);
+        G[i] = r;
+    } else if (pc.stage == 4) {                            // ADD
+        if (i >= W * H) return;
+        const int y = i / W, x = i % W, sy = y >> 1, sx = x >> 1;
+        const int ny = (y & 1) != 0 ? min(sy + 1, HH - 1) : max(sy - 1, 0);
+        const int nx = (x & 1) != 0 ? min(sx + 1, HW - 1) : max(sx - 1, 0);
+        const uint m = G[sy * HW + sx], mx = G[sy * HW + nx], v = G[ny * HW + sx], vx = G[ny * HW + nx];
+        const uint t = IMG[i];
+        uint r = 0u;
+        for (int c = 0; c < 4; c++) {
+            uint g = up4(m, mx, v, vx, c);
+            if (pc.strength != 256 && c != 3) g = (g * uint(pc.strength)) >> 8;
+            r |= min(ch(t, c) + g, 255u) << uint(8 * c);
+        }
+        IMG[i] = r;
+    } else if (pc.stage == 5) {                            // ADD_OUT
+        if (i >= pc.ow * pc.oh) return;
+        const int y = i / pc.ow, x = i % pc.ow;
+        const float fx = (float(x) + 0.5) * float(HW) / float(pc.ow) - 0.5, fy = (float(y) + 0.5) * float(HH) / float(pc.oh) - 0.5;
+        const int x0 = int(floor(fx)), y0 = int(floor(fy));
+        const float wx = fx - float(x0), wy = fy - float(y0);
+        const int xa = clamp(x0, 0, HW - 1), xb = clamp(x0 + 1, 0, HW - 1), ya = clamp(y0, 0, HH - 1), yb = clamp(y0 + 1, 0, HH - 1);
+        const uint q00 = G[ya * HW + xa], q01 = G[ya * HW + xb], q10 = G[yb * HW + xa], q11 = G[yb * HW + xb];
+        vec4 g;
+        for (int c = 0; c < 4; c++)
+            g[c] = mix(mix(float(ch(q00, c)), float(ch(q01, c)), wx), mix(float(ch(q10, c)), float(ch(q11, c)), wx), wy);
+        const vec4 t = floor(imageLoad(OUT, ivec2(x, y)) * 255.0 + 0.5);
+        const vec4 o = min(t + vec4(floor(g.rgb * float(pc.strength) / 256.0), floor(g.a)), vec4(255.0));
+        imageStore(OUT, ivec2(x, y), o / 255.0);
+    } else if (pc.stage == 7) {                            // ALPHA
+        if (i >= W * H) return;
+        const uint ga = min(((SRC[0] >> 24) * 3u) >> 1, 255u);
+        const uint t = IMG[i];
+        IMG[i] = (t & 0x00FFFFFFu) | (min((t >> 24) + ga, 255u) << 24);
+    } else if (pc.stage == 8) {                            // ALPHA_OUT
+        if (i >= pc.ow * pc.oh) return;
+        const ivec2 q = ivec2(i % pc.ow, i / pc.ow);
+        const float ga = float(min(((SRC[0] >> 24) * 3u) >> 1, 255u));
+        const vec4 t = imageLoad(OUT, q);
+        imageStore(OUT, q, vec4(t.rgb, min(floor(t.a * 255.0 + 0.5) + ga, 255.0) / 255.0));
+    }
+}
