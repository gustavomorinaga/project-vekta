From 791f5fb4abb0dc2c7a27a0671f6bbd83552635e1 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 12 Nov 2026 22:01:03 -0300
Subject: [PATCH] Killzone HD's glow on the GPU (PS3RECOMP_GLOW_GPU): after the
 MLAA, before the motion blur

vulkan/rsx_vk_glow.comp redoes jm_post's glow (SPU modules 8197, de0b, ab05,
6b71 and f601's upsample and saturating add) with the same rules as the
Killzone port's C reference (glow_ref.c, checked against the lifted modules):
the title's 640x360 glow source halved to 320x180, seven 7-tap binomial blur
pairs, a Modulate of 1.5, four more pairs, doubled twice and added to the
image, saturated, every byte. PS3RECOMP_GLOW_GPU=<IO offset> names the
main-memory target holding the source; rsx_draw_engine_glow_source hands it to
the backend (a new optional glow_source hook, so mlaa's signature stays) and
the backend's mlaa adds the glow to the MLAA's buffer before the motion blur,
as the SPU chain orders them; under a temporal upscaler (DLSS, FSR 3) it is
added over the output, bilinearly upsampled, before the motion blur there.
When the source has no colour (most frames) or the strength is 0, the stages
after the halving are dispatched indirectly with size 0 and only the add's
alpha runs (ALPHA): the SPU chain's saturating add still sets the image's
alpha, where the MLAA leaves its flags and which the motion blur after weighs
its taps by; for the title's uniform source alpha v the glow's alpha is
min(255, (3v) >> 1) everywhere (a source of uneven alpha runs the whole
chain). Strength in 1/256 of the colour added, the alpha always the title's;
256 (the default) the title's bit for bit:
PS3RECOMP_GLOW_STRENGTH=<percent> at start, rsx_vulkan_set_glow_strength at
once (an options screen). PS3RECOMP_MLAA_DUMP also writes the glow source
(seq_glow.argb); PS3RECOMP_MLAA_DUMP_GLOW=1 keeps only frames whose source
has some colour.
---
 libs/video/cellGcmSys.c                  |   6 +
 libs/video/rsx_draw_engine.c             |  38 +-
 libs/video/rsx_draw_engine.h             |   9 +
 libs/video/rsx_vulkan_backend.c          | 167 ++++-
 libs/video/rsx_vulkan_backend.h          |   4 +
 libs/video/tests/port_links.h            |   4 +-
 libs/video/vulkan/rsx_vk_glow.comp       | 146 +++++
 libs/video/vulkan/rsx_vk_glow_comp.spv.h | 797 +++++++++++++++++++++++
 8 files changed, 1163 insertions(+), 8 deletions(-)
 create mode 100644 libs/video/vulkan/rsx_vk_glow.comp
 create mode 100644 libs/video/vulkan/rsx_vk_glow_comp.spv.h

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 2a3fff9..5841756 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1557,6 +1557,12 @@ static void nv0039_copy(const u32* r)
              * is the title's motion field, and its motion blur follows the MLAA */
             static u32 mb = 0;
             if (!mb) { const char* e = getenv("PS3RECOMP_MB_GPU"); mb = e && *e ? (u32)strtoul(e, NULL, 0) : ~0u; if (!mb) mb = ~0u; }
+            /* PS3RECOMP_GLOW_GPU=<IO offset>: the 640x360 main-memory target there
+             * is the title's glow source; its glow follows the MLAA, before the
+             * motion blur (Killzone HD) */
+            static u32 glow = 0;
+            if (!glow) { const char* e = getenv("PS3RECOMP_GLOW_GPU"); glow = e && *e ? (u32)strtoul(e, NULL, 0) : ~0u; if (!glow) glow = ~0u; }
+            rsx_draw_engine_glow_source(RSX_LOCATION_MAIN, glow);
             const int ran = rsx_draw_engine_mlaa(loc_in, off_in, RSX_LOCATION_MAIN, mb);
             static int n, r; if (ran ? PS3_LOG_FIRST(r, 2) : PS3_LOG_FIRST(n, 2))
                 fprintf(stderr, "[NV0039] GPU MLAA on local 0x%08X: %s\n", off_in,
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index ddc2181..696e503 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1138,12 +1138,15 @@ u32 rsx_draw_engine_surface_pitch(u32 location, u32 offset)
 
 /* Killzone HD's jm_post MLAA on the colour surface based exactly at
  * location:offset (the display buffer the title copies to the SPUs), and its
- * motion blur with the field surface when there is one.
+ * glow (with the glow source rsx_draw_engine_glow_source gave) and motion
+ * blur with the field surface when there is one.
  * PS3RECOMP_MLAA_DUMP=<dir>: while <dir>/go exists, the surface before and
- * after and the field (seq_in.argb / seq_out.argb / seq_field.argb, A,R,G,B
- * bytes), for checking the passes against port/kz1hd/native/mlaa_ref.c and
- * mb_ref.c; 8 frames, then go is removed (PS3RECOMP_MLAA_DUMP_MOVING=1: only
- * frames whose field has some strength). */
+ * after, the glow source and the field (seq_in.argb / seq_out.argb /
+ * seq_glow.argb / seq_field.argb, A,R,G,B bytes), for checking the passes
+ * against port/kz1hd/native/mlaa_ref.c, glow_ref.c and mb_ref.c; 8 frames,
+ * then go is removed (PS3RECOMP_MLAA_DUMP_MOVING=1: only frames whose field
+ * has some strength; PS3RECOMP_MLAA_DUMP_GLOW=1: only frames whose glow
+ * source has some colour). */
 static int eng_mlaa_dump(u32 handle, const char* tag, u32 w, u32 h)
 {
     static const char* d = (const char*)-1; static unsigned seq;
@@ -1168,6 +1171,12 @@ static int eng_mlaa_dump(u32 handle, const char* tag, u32 w, u32 h)
         for (u32 i = 0; i < w * h; i++) if (rows[4 * i] > m) m = rows[4 * i];
         if (!m) { free(rows); return 0; }
     }
+    /* PS3RECOMP_MLAA_DUMP_GLOW=1: only frames whose glow source has some colour */
+    if (!strcmp(tag, "glow") && getenv("PS3RECOMP_MLAA_DUMP_GLOW")) {
+        u32 lit = 0;
+        for (u32 i = 0; i < w * h && !lit; i++) lit = rows[4 * i + 1] | rows[4 * i + 2] | rows[4 * i + 3];
+        if (!lit) { free(rows); return 0; }
+    }
     snprintf(path, sizeof path, "%s/%04u_%s.argb", d, seq, tag);
     f = fopen(path, "wb");
     if (f) { fwrite(rows, 4, (size_t)w * h, f); fclose(f); }
@@ -1176,6 +1185,22 @@ static int eng_mlaa_dump(u32 handle, const char* tag, u32 w, u32 h)
     return 1;
 }
 
+static u32 s_glow_src;   /* the glow source handed to the backend, for PS3RECOMP_MLAA_DUMP */
+void rsx_draw_engine_glow_source(u32 location, u32 offset)
+{
+    s_glow_src = 0;
+    if (!g.ready || !g.be->glow_source) return;
+    u32 src = 0;
+    if (offset != ~0u)
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const eng_surface* s = &g.surfaces[i];
+            if (s->handle && s->location == location && s->offset == offset &&
+                s->fmt == RSX_BE_FMT_R8G8B8A8 && s->w >= 640 && s->h >= 360) { src = s->handle; break; }
+        }
+    s_glow_src = src;
+    g.be->glow_source(g.be->user, src);
+}
+
 int rsx_draw_engine_mlaa(u32 location, u32 offset, u32 field_location, u32 field_offset)
 {
     if (!g.ready || !g.be->mlaa) return 0;
@@ -1189,7 +1214,8 @@ int rsx_draw_engine_mlaa(u32 location, u32 offset, u32 field_location, u32 field
     for (u32 i = 0; i < g.n_surfaces; i++) {
         const eng_surface* s = &g.surfaces[i];
         if (!s->handle || s->location != location || s->offset != offset || s->fmt != RSX_BE_FMT_R8G8B8A8) continue;
-        const int dump = (!field || eng_mlaa_dump(field, "field", 640, 360)) && eng_mlaa_dump(s->handle, "in", 1280, 720);
+        const int dump = (!s_glow_src || eng_mlaa_dump(s_glow_src, "glow", 640, 360)) &&
+                         (!field || eng_mlaa_dump(field, "field", 640, 360)) && eng_mlaa_dump(s->handle, "in", 1280, 720);
         const int ran = g.be->mlaa(g.be->user, s->handle, field);
         if (ran && dump) eng_mlaa_dump(s->handle, "out", 1280, 720);
         return ran;
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
index b7c9e59..cffed06 100644
--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -317,6 +317,11 @@ typedef struct rsx_draw_backend {
      * with one, its motion blur follows the MLAA (vulkan/rsx_vk_mb.comp). */
     int  (*mlaa)(void* user, u32 surface, u32 field);
 
+    /* Optional. Killzone HD's glow source for the next mlaa call: a 640x360
+     * colour target (the glow pyramid's input, vulkan/rsx_vk_glow.comp), or 0
+     * for none; the glow is added after the MLAA, before the motion blur. */
+    void (*glow_source)(void* user, u32 surface);
+
     /* Optional. Before each draw: what the draw is (its program, vertex count
      * and topology), so a backend can find the same draw's constants of the
      * frame before by key and order (temporal upscaling: per-object motion). */
@@ -407,6 +412,10 @@ u32 rsx_draw_engine_surface_pitch(u32 location, u32 offset);
  * field_offset (in field_location) != ~0u: the 640x360 surface there is the
  * motion field, and the motion blur follows (when the surface exists). */
 int rsx_draw_engine_mlaa(u32 location, u32 offset, u32 field_location, u32 field_offset);
+/* Killzone HD's glow source for the next rsx_draw_engine_mlaa: the 640x360
+ * colour surface at offset (in location), or none when offset is ~0u or no
+ * such surface exists. */
+void rsx_draw_engine_glow_source(u32 location, u32 offset);
 
 /* --- test hooks ---------------------------------------------------------- */
 
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index dc5f7b1..f539932 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -62,6 +62,7 @@
 #include "vulkan/rsx_vk_depth_pack_comp.spv.h"
 #include "vulkan/rsx_vk_mlaa_comp.spv.h"
 #include "vulkan/rsx_vk_mb_comp.spv.h"
+#include "vulkan/rsx_vk_glow_comp.spv.h"
 #include "vulkan/rsx_vk_fsr1_easu_comp.spv.h"
 #include "vulkan/rsx_vk_fsr1_rcas_comp.spv.h"
 #include "rsx_swapchain_retry.h"   /* a swapchain not recreated: skip, try again */
@@ -3874,6 +3875,97 @@ static int vk_mb_init(void)
     return 0;
 }
 
+/* Killzone HD's jm_post glow on the GPU (vulkan/rsx_vk_glow.comp): from the
+ * title's 640x360 glow source (rsx_draw_engine_glow_source) to an add over the
+ * MLAA's buffer, before the motion blur, as the SPU chain orders them; under a
+ * temporal upscaler, over its output. Buffers: the source, two 320x180, the
+ * 640x360 glow texture, the control words (lit flag, indirect sizes). */
+static struct {
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout      layout;
+    VkPipeline            pipe;
+    VkDescriptorPool      pool;
+    VkDescriptorSet       set, oset[4];
+    VkImage               oset_for[4];
+    vk_buffer             buf[5];
+    vk_image              dummy;
+    int                   ok, dummy_ready, ow, oh;
+    u32                   src;            /* the engine's glow source surface for this frame, or 0 */
+} s_glow;
+/* Strength in 1/256: 256 (the default) is the title's glow, bit for bit, 0 none.
+ * PS3RECOMP_GLOW_STRENGTH=<percent> sets the start; rsx_vulkan_set_glow_strength
+ * changes it at once (an options screen). */
+static volatile int s_glow_str = -1;
+void rsx_vulkan_set_glow_strength(int strength256) { s_glow_str = strength256 < 0 ? 0 : strength256 > 256 ? 256 : strength256; }
+static int vk_glow_strength(void)
+{
+    if (s_glow_str < 0) {
+        const char* e = getenv("PS3RECOMP_GLOW_STRENGTH");
+        const int pct = e && *e ? atoi(e) : 100;
+        s_glow_str = pct <= 0 ? 0 : pct >= 100 ? 256 : pct * 256 / 100;
+    }
+    return s_glow_str;
+}
+static void vk_eng_glow_source(void* user, u32 surface) { (void)user; s_glow.src = surface; }
+
+static int vk_glow_init(void)
+{
+    VkDescriptorSetLayoutBinding b[7];
+    for (u32 i = 0; i < 6; i++) b[i] = (VkDescriptorSetLayoutBinding){ i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    b[6] = (VkDescriptorSetLayoutBinding){ 6, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 7, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_glow.dsl) != VK_SUCCESS) return -1;
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 20 };
+    VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                       .setLayoutCount = 1, .pSetLayouts = &s_glow.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
+    if (pvkCreatePipelineLayout(s_vk.device, &lci, NULL, &s_glow.layout) != VK_SUCCESS) return -1;
+    VkShaderModuleCreateInfo mci = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                     .codeSize = sizeof rsx_vk_glow_comp_spv, .pCode = rsx_vk_glow_comp_spv };
+    VkShaderModule mod;
+    if (pvkCreateShaderModule(s_vk.device, &mci, NULL, &mod) != VK_SUCCESS) return -1;
+    VkComputePipelineCreateInfo pci = {
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                   .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = mod, .pName = "main" },
+        .layout = s_glow.layout,
+    };
+    const VkResult r = pvkCreateComputePipelines(s_vk.device, s_vk_pcache, 1, &pci, NULL, &s_glow.pipe);
+    pvkDestroyShaderModule(s_vk.device, mod, NULL);
+    if (r != VK_SUCCESS) return -1;
+    const VkDeviceSize sz[5] = { 640 * 360 * 4, 320 * 180 * 4, 320 * 180 * 4, 640 * 360 * 4, 128 };
+    for (u32 i = 0; i < 5; i++)
+        if (vk_create_device_buffer(&s_glow.buf[i], sz[i], VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT |
+                                    VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT)) return -1;
+    VkDescriptorPoolSize ps[2] = { { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 6 * 5 }, { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 5 } };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                      .maxSets = 5, .poolSizeCount = 2, .pPoolSizes = ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_glow.pool) != VK_SUCCESS) return -1;
+    /* made on the pipeline thread: laid out GENERAL on the RSX thread at first use (dummy_ready) */
+    if (vk_create_image(&s_glow.dummy, VK_FORMAT_R8G8B8A8_UNORM, 1, 1, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+    VkDescriptorSet* sets[5] = { &s_glow.set, &s_glow.oset[0], &s_glow.oset[1], &s_glow.oset[2], &s_glow.oset[3] };
+    for (u32 k = 0; k < 5; k++) {
+        VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                           .descriptorPool = s_glow.pool, .descriptorSetCount = 1, .pSetLayouts = &s_glow.dsl };
+        if (pvkAllocateDescriptorSets(s_vk.device, &ai, sets[k]) != VK_SUCCESS) return -1;
+        VkDescriptorBufferInfo dbi[6]; VkWriteDescriptorSet wr[7];
+        for (u32 i = 0; i < 6; i++) {
+            dbi[i] = (VkDescriptorBufferInfo){ i ? s_glow.buf[i - 1].buf : s_mlaa.buf[0].buf, 0, VK_WHOLE_SIZE };
+            wr[i] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = *sets[k],
+                                            .dstBinding = i, .descriptorCount = 1,
+                                            .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &dbi[i] };
+        }
+        VkDescriptorImageInfo dii = { VK_NULL_HANDLE, s_glow.dummy.view, VK_IMAGE_LAYOUT_GENERAL };
+        wr[6] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = *sets[k],
+                                        .dstBinding = 6, .descriptorCount = 1,
+                                        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &dii };
+        pvkUpdateDescriptorSets(s_vk.device, 7, wr, 0, NULL);
+    }
+    s_glow.ok = 1;
+    return 0;
+}
+
 static int vk_mlaa_init(void)
 {
     if (s_mlaa.pipe) return 0;
@@ -3925,6 +4017,7 @@ static int vk_mlaa_init(void)
     pvkUpdateDescriptorSets(s_vk.device, 7, wr, 0, NULL);
     s_mlaa.failed = 0;
     if (vk_mb_init()) fprintf(stderr, "[vk] the motion blur pass could not be built\n");
+    if (vk_glow_init()) fprintf(stderr, "[vk] the glow pass could not be built\n");
     return 0;
 }
 
@@ -4064,6 +4157,72 @@ static void vk_mb_record_out(vk_eng_obj* f, VkImage out, VkImageView view, u32 o
     vk_barrier_image(out, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
 }
 
+static void vk_glow_stage(int stage, int job, u32 gx, int indirect)
+{
+    const int pc[5] = { stage, job, s_glow.ow, s_glow.oh, vk_glow_strength() };
+    pvkCmdPushConstants(s_vk.cmd, s_glow.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    if (indirect >= 0) pvkCmdDispatchIndirect(s_vk.cmd, s_glow.buf[4].buf, (VkDeviceSize)indirect);
+    else pvkCmdDispatch(s_vk.cmd, gx, 1, 1);
+    vk_mlaa_barrier();
+}
+/* The glow source's top-left 640x360 into the source buffer, then the pyramid;
+ * none of the stages after DOWN and ARM run when the source has no colour or
+ * the strength is 0 (indirect sizes of 0): then only the add's alpha does
+ * (ALPHA / ALPHA_OUT), as the SPU chain's saturating add still sets it. */
+static void vk_glow_pyramid(vk_eng_obj* g)
+{
+    if (!s_glow.dummy_ready) { vk_barrier_image(s_glow.dummy.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED); s_glow.dummy_ready = 1; }
+    vk_barrier_image(g->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { 640, 360, 1 } };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, g->im.img, VK_IMAGE_LAYOUT_GENERAL, s_glow.buf[0].buf, 1, &region);
+    pvkCmdFillBuffer(s_vk.cmd, s_glow.buf[4].buf, 0, 128, 0);
+    vk_mlaa_barrier();
+    vk_glow_stage(0, 0, (320 * 180 + 255) / 256, -1);                  /* DOWN */
+    vk_glow_stage(6, 0, 1, -1);                                         /* ARM */
+    for (int k = 0; k < 7; k++) { vk_glow_stage(1, 0, 0, 4); vk_glow_stage(1, 1, 0, 4); }   /* BLUR across, down */
+    vk_glow_stage(2, 0, 0, 4);                                          /* MOD */
+    for (int k = 0; k < 4; k++) { vk_glow_stage(1, 0, 0, 4); vk_glow_stage(1, 1, 0, 4); }
+    vk_glow_stage(3, 0, 0, 16);                                         /* UP */
+}
+static int vk_glow_usable(vk_eng_obj** g)
+{
+    *g = s_glow.src ? vk_eng_get(s_glow.src, VK_ENG_COLOR) : NULL;
+    return *g && s_glow.ok && (*g)->fmt == VK_FORMAT_R8G8B8A8_UNORM && (*g)->w >= 640 && (*g)->h >= 360;
+}
+/* Over s_mlaa.buf[0] (the MLAA's result, raw texels). */
+static void vk_glow_record(vk_eng_obj* g)
+{
+    s_glow.ow = s_glow.oh = 0;
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_glow.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_glow.layout, 0, 1, &s_glow.set, 0, NULL);
+    vk_glow_pyramid(g);
+    vk_glow_stage(4, 0, 0, 28);                                         /* ADD */
+    vk_glow_stage(7, 0, 0, 56);                                         /* ALPHA, when ADD did not run */
+}
+/* Under a temporal upscaler: the add over its output (ow x oh, slot `slot`'s image). */
+static void vk_glow_record_out(vk_eng_obj* g, VkImage out, VkImageView view, u32 ow, u32 oh, int slot)
+{
+    if (s_glow.oset_for[slot] != out) {
+        vk_flush();   /* the set may be in a submission still */
+        VkDescriptorImageInfo dii = { VK_NULL_HANDLE, view, VK_IMAGE_LAYOUT_GENERAL };
+        VkWriteDescriptorSet wr = { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_glow.oset[slot],
+                                    .dstBinding = 6, .descriptorCount = 1,
+                                    .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &dii };
+        pvkUpdateDescriptorSets(s_vk.device, 1, &wr, 0, NULL);
+        s_glow.oset_for[slot] = out;
+    }
+    if (vk_batch_reserve(0)) return;
+    vk_barrier_image(out, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    s_glow.ow = (int)ow; s_glow.oh = (int)oh;
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_glow.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_glow.layout, 0, 1, &s_glow.oset[slot], 0, NULL);
+    vk_glow_pyramid(g);
+    vk_glow_stage(5, 0, 0, 40);                                         /* ADD_OUT, over the output */
+    vk_glow_stage(8, 0, 0, 68);                                         /* ALPHA_OUT, when ADD_OUT did not run */
+    s_glow.ow = s_glow.oh = 0;
+    vk_barrier_image(out, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+}
+
