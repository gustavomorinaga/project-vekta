From ef999568d6cf1f5063d713c6cc0a092da2b54d50 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sat, 17 Oct 2026 08:28:47 -0300
Subject: [PATCH] cellPad: mouse smoothing halves every poll (less lag),
 gain 10 to match

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/input/cellPad.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 876e08d6..c4b36578 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -718,7 +718,7 @@ static unsigned long long pad_now_ms(void)
 static void pad_poll_mouse(PadHostState* hs)
 {
     static int off = -1;
-    static float gain = 6.0f, decay = 0.7f, dz = 20.0f;
+    static float gain = 10.0f, decay = 0.5f, dz = 20.0f;
     if (off < 0) {
         const char* e;
         off = getenv("PAD_NO_MOUSE") ? 1 : 0;
-- 
