@@ -305,8 +305,10 @@ typedef struct rsx_draw_backend {
                                      u32 x, u32 y, u32 w, u32 h);
 
     /* Optional. Killzone HD's jm_post MLAA run in place on a colour target,
-     * recorded in command order (vulkan/rsx_vk_mlaa.comp); 1 when it ran. */
-    int  (*mlaa)(void* user, u32 surface);
+     * recorded in command order (vulkan/rsx_vk_mlaa.comp); 1 when it ran.
+     * field: a 640x360 colour target holding the title's motion field, or 0;
