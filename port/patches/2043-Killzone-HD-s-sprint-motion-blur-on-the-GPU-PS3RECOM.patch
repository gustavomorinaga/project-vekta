 } rsx_draw_backend;
 
@@ -375,8 +377,10 @@ void rsx_draw_engine_guest_wrote(u32 location, u32 offset, u32 pitch, u32 w, u32
 void rsx_draw_engine_label_released(void);
 /* The pitch of the colour surface based exactly at location:offset, or 0. */
 u32 rsx_draw_engine_surface_pitch(u32 location, u32 offset);
-/* The backend's MLAA on the colour surface based exactly at location:offset; 1 when it ran. */
-int rsx_draw_engine_mlaa(u32 location, u32 offset);
+/* The backend's MLAA on the colour surface based exactly at location:offset; 1 when it ran.
+ * field_offset (in field_location) != ~0u: the 640x360 surface there is the
+ * motion field, and the motion blur follows (when the surface exists). */
+int rsx_draw_engine_mlaa(u32 location, u32 offset, u32 field_location, u32 field_offset);
 
 /* --- test hooks ---------------------------------------------------------- */
 
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index dfa9598b4998f1af48edae013340ba3701fedd2a..fc47be021eeaf1f3a353f89313f26bb58fb9d9aa 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -54,6 +54,7 @@
 #include "vulkan/rsx_vk_fallback_frag.spv.h"
 #include "vulkan/rsx_vk_depth_pack_comp.spv.h"
 #include "vulkan/rsx_vk_mlaa_comp.spv.h"
+#include "vulkan/rsx_vk_mb_comp.spv.h"
 #include "vulkan/rsx_vk_fsr1_easu_comp.spv.h"
 #include "vulkan/rsx_vk_fsr1_rcas_comp.spv.h"
 /* FSR 1's constants, computed on the CPU (vulkan/ffx, MIT). */
@@ -136,7 +137,7 @@ static int dlclose(void* lib) { return FreeLibrary((HMODULE)lib) ? 0 : -1; }
     X(vkCmdSetViewport) X(vkCmdSetScissor) X(vkCmdDraw) \
     X(vkCmdSetStencilReference) X(vkCmdBindIndexBuffer) X(vkCmdDrawIndexed) \
     X(vkCreateSemaphore) X(vkDestroySemaphore) X(vkCmdBlitImage) \
-    X(vkCreateComputePipelines) X(vkCmdDispatch)
+    X(vkCreateComputePipelines) X(vkCmdDispatch) X(vkCmdDispatchIndirect) X(vkCmdFillBuffer)
 /* Window-system entry points, loaded only when a window was requested, so a
  * headless run never depends on a driver that can present. */
 #define VK_WSI_INSTANCE_FNS(X) \
@@ -3616,6 +3617,76 @@ static struct {
     int                   failed, slopes;
 } s_mlaa;
 
+/* Its motion blur (vulkan/rsx_vk_mb.comp), on the MLAA's buffer of texels
+ * before it goes back to the target: the field, a second field buffer, the
+ * half image, and the control words (any strength, indirect dispatch sizes). */
+static struct {
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout      layout;
+    VkPipeline            pipe;
+    VkDescriptorPool      pool;
+    VkDescriptorSet       set;
+    vk_buffer             buf[4];
+    int                   ok;
+} s_mb;
+/* On unless PS3RECOMP_MB_ON=0; rsx_vulkan_set_motion_blur switches it at once
+ * (a title's options screen). */
+static volatile int s_mb_on = -1;
+void rsx_vulkan_set_motion_blur(int on) { s_mb_on = on != 0; }
+static int vk_mb_on(void)
+{
+    if (s_mb_on < 0) { const char* e = getenv("PS3RECOMP_MB_ON"); s_mb_on = !e || atoi(e) != 0; }
+    return s_mb_on;
+}
+
+static int vk_mb_init(void)
+{
+    VkDescriptorSetLayoutBinding b[5];
+    for (u32 i = 0; i < 5; i++) b[i] = (VkDescriptorSetLayoutBinding){ i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL };
+    VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 5, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_mb.dsl) != VK_SUCCESS) return -1;
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 8 };
+    VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                       .setLayoutCount = 1, .pSetLayouts = &s_mb.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
+    if (pvkCreatePipelineLayout(s_vk.device, &lci, NULL, &s_mb.layout) != VK_SUCCESS) return -1;
+    VkShaderModuleCreateInfo mci = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                     .codeSize = sizeof rsx_vk_mb_comp_spv, .pCode = rsx_vk_mb_comp_spv };
+    VkShaderModule mod;
+    if (pvkCreateShaderModule(s_vk.device, &mci, NULL, &mod) != VK_SUCCESS) return -1;
+    VkComputePipelineCreateInfo pci = {
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                   .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = mod, .pName = "main" },
+        .layout = s_mb.layout,
+    };
+    const VkResult r = pvkCreateComputePipelines(s_vk.device, s_vk_pcache, 1, &pci, NULL, &s_mb.pipe);
+    pvkDestroyShaderModule(s_vk.device, mod, NULL);
+    if (r != VK_SUCCESS) return -1;
+    const VkDeviceSize sz[4] = { 640 * 360 * 4, 640 * 360 * 4, 640 * 360 * 4, 64 };
+    for (u32 i = 0; i < 4; i++)
+        if (vk_create_device_buffer(&s_mb.buf[i], sz[i], VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT |
+                                    VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT)) return -1;
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 5 };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                      .maxSets = 1, .poolSizeCount = 1, .pPoolSizes = &ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_mb.pool) != VK_SUCCESS) return -1;
+    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                       .descriptorPool = s_mb.pool, .descriptorSetCount = 1, .pSetLayouts = &s_mb.dsl };
+    if (pvkAllocateDescriptorSets(s_vk.device, &ai, &s_mb.set) != VK_SUCCESS) return -1;
+    VkDescriptorBufferInfo dbi[5]; VkWriteDescriptorSet wr[5];
+    for (u32 i = 0; i < 5; i++) {
+        dbi[i] = (VkDescriptorBufferInfo){ i ? s_mb.buf[i - 1].buf : s_mlaa.buf[0].buf, 0, VK_WHOLE_SIZE };
+        wr[i] = (VkWriteDescriptorSet){ .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_mb.set,
+                                        .dstBinding = i, .descriptorCount = 1,
+                                        .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, .pBufferInfo = &dbi[i] };
+    }
+    pvkUpdateDescriptorSets(s_vk.device, 5, wr, 0, NULL);
+    s_mb.ok = 1;
+    return 0;
+}
+
 static int vk_mlaa_init(void)
 {
     if (s_mlaa.pipe) return 0;
@@ -3666,6 +3737,7 @@ static int vk_mlaa_init(void)
     }
     pvkUpdateDescriptorSets(s_vk.device, 7, wr, 0, NULL);
     s_mlaa.failed = 0;
+    if (vk_mb_init()) fprintf(stderr, "[vk] the motion blur pass could not be built\n");
     return 0;
 }
 
@@ -3709,9 +3781,39 @@ static void vk_mlaa_barrier(void)
 {
     VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
                            .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
-                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT };
+                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT |
+                                            VK_ACCESS_INDIRECT_COMMAND_READ_BIT };
     pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
-                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+}
+static void vk_mb_stage(int stage, int job, u32 gx, int indirect)
+{
+    const int pc[2] = { stage, job };
+    pvkCmdPushConstants(s_vk.cmd, s_mb.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    if (indirect >= 0) pvkCmdDispatchIndirect(s_vk.cmd, s_mb.buf[3].buf, (VkDeviceSize)indirect);
+    else pvkCmdDispatch(s_vk.cmd, gx, 1, 1);
+    vk_mlaa_barrier();
+}
+/* The motion blur on s_mlaa.buf[0] (the MLAA's result, raw texels) with the
+ * field target's top-left 640x360; none of its image stages run when the
+ * field has no strength anywhere (indirect sizes of 0). */
+static void vk_mb_record(vk_eng_obj* f)
+{
+    const u32 HW = 640, HH = 360;
+    vk_barrier_image(f->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { HW, HH, 1 } };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, f->im.img, VK_IMAGE_LAYOUT_GENERAL, s_mb.buf[0].buf, 1, &region);
+    pvkCmdFillBuffer(s_vk.cmd, s_mb.buf[3].buf, 0, 64, 0);
+    vk_mlaa_barrier();
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_mb.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_mb.layout, 0, 1, &s_mb.set, 0, NULL);
+    for (int k = 0; k < 4; k++) vk_mb_stage(0, k == 3 ? 3 : k & 1, HW * HH / 256, -1);   /* BLUR across, down, across, down */
+    vk_mb_stage(4, 0, 1, -1);                             /* ARM */
+    vk_mb_stage(1, 0, 0, 4);                              /* DOWN */
+    vk_mb_stage(2, 0, 0, 4);                              /* GATHER */
+    vk_mb_stage(3, 0, 0, 16);                             /* BLEND */
+    vk_barrier_image(f->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
 }
 static void vk_mlaa_stage(int stage, int job, u32 gx, u32 gy)
 {
@@ -3722,10 +3824,11 @@ static void vk_mlaa_stage(int stage, int job, u32 gx, u32 gy)
 }
 
 /* 1 when it ran; 0 when the target is not a 1280x720 R8G8B8A8 one (or the device cannot) */
-static int vk_eng_mlaa(void* user, u32 surface)
+static int vk_eng_mlaa(void* user, u32 surface, u32 field)
 {
     (void)user;
     vk_eng_obj* o = vk_eng_get(surface, VK_ENG_COLOR);
+    vk_eng_obj* fo = field ? vk_eng_get(field, VK_ENG_COLOR) : NULL;
     if (!o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM || o->w != 1280 || o->h != 720 || !vk_mlaa_ready() || vk_batch_reserve(0))
         return 0;
     const u32 W = 1280, H = 720;
@@ -3751,6 +3854,10 @@ static int vk_eng_mlaa(void* user, u32 surface)
         vk_mlaa_stage(7, j, W / 256, last - lo + 1u);
     }
     vk_mlaa_stage(8, 0, W / 256, H);                      /* STORE */
+    if (fo && s_mb.ok && vk_mb_on() && fo->fmt == VK_FORMAT_R8G8B8A8_UNORM && fo->w >= 640 && fo->h >= 360) {
+        vk_mb_record(fo);
+        vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    }
     pvkCmdCopyBufferToImage(s_vk.cmd, s_mlaa.buf[0].buf, o->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &region);
     vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
     return 1;
diff --git a/libs/video/rsx_vulkan_backend.h b/libs/video/rsx_vulkan_backend.h
index 735c69688d3e9897614e8ef8674a63828f3ed9e7..8d704496bb11b9f2effcc57bb6e3401eb43e4e84 100644
--- a/libs/video/rsx_vulkan_backend.h
+++ b/libs/video/rsx_vulkan_backend.h
@@ -88,6 +88,9 @@ void rsx_vulkan_set_fsr(int on, float sharpness);
 /* NVIDIA Reflex (VK_NV_low_latency2): 0 off, 1 on, 2 on + boost. Needs
  * PS3RECOMP_VK_REFLEX set (any value) at start, for the device extension. */
 void rsx_vulkan_set_reflex(int mode);
+/* Killzone HD's motion blur after its MLAA (PS3RECOMP_MB_GPU): on or off from
+ * the next frame; PS3RECOMP_MB_ON=0 starts it off. */
+void rsx_vulkan_set_motion_blur(int on);
 int  rsx_vulkan_reflex_available(void);
