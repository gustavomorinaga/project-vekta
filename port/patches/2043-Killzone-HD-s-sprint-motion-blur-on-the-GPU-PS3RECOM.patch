index 0000000000000000000000000000000000000000..ef2a44c3157bf82677a6c9591d8aaf4807591eb7
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_mb.comp
@@ -0,0 +1,158 @@
+#version 450
+#extension GL_ARB_gpu_shader_int64 : require
+// Killzone HD's jm_post motion blur (SPU modules 8197, ab05, 6b71, de0b, 14e0
+// and f601's blend) on the GPU, the same rules as the game port's C reference
+// (port/kz1hd/native/mb_ref.c; the decoding is in docs/wws-jm-post.md of the
+// Killzone port). It runs after the MLAA, on the same 1280x720 buffer of raw
+// texels (R, G, B, A from the low byte up). Stages, by push constant:
+//  0 BLUR    the 640x360 field, 7-tap binomial: job 0 across FA -> FB, 1 down FB -> FA,
+//            3 the last pass down, which also notes whether any strength is left
+//            (edge pixels repeated, the strength's outer taps weighed twice, saturated)
+//  4 ARM     the indirect dispatch sizes of stages 1-3: none when the field is
+//            all zero strength (normal play: the blend would leave the image as it is)
+//  1 DOWN    the image -> 640x360 HALF (2x2 byte averages rounded up, down first)
+//  2 GATHER  14 taps of HALF along the field's vector, weighted 1 + alpha/16,
+//            divided by the weights' sum (the SPU reciprocal), times strength/256
+//            -> FB (strength in alpha)
+//  3 BLEND   FB upsampled 2x (9:3:3:1, edges repeated) over the image, premultiplied
+layout(local_size_x = 256) in;
+layout(std430, binding = 0) buffer Img { uint IMG[]; };   // 1280x720 raw texels
+layout(std430, binding = 1) buffer Fa  { uint FA[]; };    // the field, 640x360 raw texels
+layout(std430, binding = 2) buffer Fb  { uint FB[]; };
+layout(std430, binding = 3) buffer Hf  { uint HALF[]; };
+layout(std430, binding = 4) buffer Ct  { uint CTRL[]; };  // any strength; dispatch sizes (half, full)
+layout(push_constant) uniform Push { int stage; int job; } pc;
+
+const int W = 1280, H = 720, HW = 640, HH = 360;
+
+// ---------------- SPU single precision as the port runs it (truncation, FTZ) ----------------
+int msb64(uint64_t v) { uint hi = uint(v >> 32); return hi != 0u ? 32 + findMSB(hi) : findMSB(uint(v)); }
+uint fpack(uint s, uint64_t m, int e)
+{
+    if (m == 0ul) return s << 31;
+    int n = msb64(m);
+    uint man = n > 23 ? uint(m >> uint(n - 23)) : uint(m << uint(23 - n));
+    int be = e + n + 127;
+    if (be <= 0) return s << 31;
+    if (be >= 255) return (s << 31) | 0x7F7FFFFFu;
+    return (s << 31) | (uint(be) << 23) | (man & 0x7FFFFFu);
+}
+bool fsplit(uint f, out uint s, out uint m, out int e)
+{
+    int be = int((f >> 23) & 0xFFu);
+    s = f >> 31;
+    if (be == 0) { m = 0u; e = 0; return false; }
+    m = (f & 0x7FFFFFu) | 0x800000u; e = be - 150;
+    return true;
+}
+uint fmul(uint a, uint b)
+{
+    uint sa, sb, ma, mb; int ea, eb;
+    bool na = fsplit(a, sa, ma, ea), nb = fsplit(b, sb, mb, eb);
+    if (!na || !nb) return (sa ^ sb) << 31;
+    return fpack(sa ^ sb, uint64_t(ma) * uint64_t(mb), ea + eb);
+}
+const uint FREST[32] = uint[32](
+    0x7FFBE0u, 0x7F87A6u, 0x70EF72u, 0x708B40u, 0x638B12u, 0x633AEAu, 0x5792C4u, 0x574AA0u,
+    0x4CCA7Eu, 0x4C9262u, 0x430A44u, 0x42D62Au, 0x3A2E12u, 0x39FDFAu, 0x3215E4u, 0x31F1D2u,
+    0x2AA9BEu, 0x2A85ACu, 0x23D59Au, 0x23BD8Eu, 0x1D8576u, 0x1D8576u, 0x17AD5Au, 0x17AD5Au,
+    0x124543u, 0x124543u, 0x0D392Du, 0x0D392Du, 0x08851Au, 0x08851Au, 0x041D07u, 0x041D07u);
+uint frest(uint a)
+{
+    uint e = (a >> 23) & 0xFFu, rexp = e == 0u ? 255u : (e >= 253u ? 0u : 253u - e);
+    return (a & 0x80000000u) | (rexp << 23) | (FREST[(a >> 18) & 0x1Fu] & 0x7FFFFFu);
+}
+uint ffi(uint a, uint est)
+{
+    int e = int((est >> 23) & 0xFFu);
+    if (e == 0) return 0u;
+    uint64_t m = ((uint64_t(0x2000u | ((est >> 10) & 0x1FFFu))) << 19) - uint64_t(est & 0x3FFu) * uint64_t(a & 0x7FFFFu);
+    if (m < (1ul << 32)) { m <<= 1; e--; if (e == 0) return 0u; }
+    return (est & 0x80000000u) | (uint(e) << 23) | (uint(m >> 9) & 0x7FFFFFu);
+}
+uint fcuflt(uint v, int scale) { return v != 0u ? fpack(0u, uint64_t(v), -scale) : 0u; }
+uint fcfltu8(uint f)          // f * 256, truncated, saturated
+{
+    uint s, m; int e;
+    if (!fsplit(f, s, m, e) || s != 0u) return 0u;
+    int sh = e + 8;
+    if (sh >= 9) return 0xFFFFFFFFu;
+    return sh >= 0 ? m << uint(sh) : (sh <= -24 ? 0u : m >> uint(-sh));
+}
+
+// The C reference's channels: 0 = alpha (byte 3 of a texel), 1..3 = R, G, B
+uint ch(uint t, int c) { return (t >> uint(c == 0 ? 24 : 8 * (c - 1))) & 0xFFu; }
+uint pack4(uint v[4]) { return v[1] | (v[2] << 8) | (v[3] << 16) | (v[0] << 24); }
+
+uint fld(bool a, int i) { return a ? FA[i] : FB[i]; }
+
+void main()
+{
+    const int i = int(gl_GlobalInvocationID.x);
+    if (pc.stage == 0) {                                   // BLUR
+        if (i >= HW * HH) return;
+        const bool across = pc.job == 0;                    // across reads FA, down (1, 3) reads FB
+        const int y = i / HW, x = i % HW, n = across ? HW : HH, p = across ? x : y;
+        uint t[7];
+        for (int k = -3; k <= 3; k++) {
+            const int q = clamp(p + k, 0, n - 1);
+            t[k + 3] = fld(across, across ? y * HW + q : q * HW + x);
+        }
+        uint o[4];
+        for (int c = 0; c < 4; c++) {
+            const uint outer = 6u * (ch(t[1], c) + ch(t[5], c)) + ch(t[0], c) + ch(t[6], c);
+            const uint v = (20u * ch(t[3], c) + 15u * (ch(t[2], c) + ch(t[4], c)) + (c == 0 ? 2u : 1u) * outer) >> 6;
+            o[c] = min(v, 255u);
+        }
+        if (across) FB[i] = pack4(o); else FA[i] = pack4(o);
+        if (pc.job == 3 && o[0] != 0u) CTRL[0] = 1u;
+    } else if (pc.stage == 4) {                            // ARM
+        if (i != 0) return;
+        const uint on = CTRL[0];
+        CTRL[1] = on * uint(HW * HH / 256); CTRL[2] = 1u; CTRL[3] = 1u;
+        CTRL[4] = on * uint(W * H / 256);   CTRL[5] = 1u; CTRL[6] = 1u;
+    } else if (pc.stage == 1) {                            // DOWN
+        if (i >= HW * HH) return;
+        const int y = i / HW, x = i % HW, s = 2 * y * W + 2 * x;
+        const uint a = IMG[s], b = IMG[s + 1], c = IMG[s + W], d = IMG[s + W + 1];
+        uint r = 0u;
+        for (int k = 0; k < 32; k += 8) {
+            const uint l = (((a >> k) & 0xFFu) + ((c >> k) & 0xFFu) + 1u) >> 1, rr = (((b >> k) & 0xFFu) + ((d >> k) & 0xFFu) + 1u) >> 1;
+            r |= ((l + rr + 1u) >> 1) << k;
+        }
+        HALF[i] = r;
+    } else if (pc.stage == 2) {                            // GATHER
+        if (i >= HW * HH) return;
+        const int y = i / HW, x = i % HW;
+        const uint f = FA[i];
+        const int down = int(ch(f, 2)) - 128, across = int(ch(f, 1)) - 128;
+        const int KD[7] = int[7](157, 472, 787, 1102, 1417, 1722, 2222);
+        const int KA[7] = int[7](280, 840, 1400, 1960, 2520, 3020, 4020);
+        uint sum[4] = uint[4](0u, 0u, 0u, 0u);
+        for (int k = 0; k < 7; k++)
+            for (int s = 0; s < 2; s++) {
+                const int dy = ((s == 1 ? -down : down) * KD[k]) >> 16;          // SPU mpys: (a * b) >> 16
+                const int dx = (((s == 1 ? -across : across) * 16 * KA[k]) >> 16) >> 4;
+                const uint p = HALF[clamp(y + dy, 0, HH - 1) * HW + clamp(x + dx, 0, HW - 1)];
+                const uint w = 16u + ch(p, 0);
+                sum[0] += 255u * w;
+                for (int c = 1; c < 4; c++) sum[c] += ch(p, c) * w;
+            }
+        const uint s0 = fcuflt(sum[0], 12);
+        const uint r = ffi(s0, frest(s0)), m = fcuflt(ch(f, 0), 8);
+        uint o[4];
+        for (int c = 0; c < 4; c++) o[c] = min(fcfltu8(fmul(fmul(fcuflt(sum[c], 12), r), m)), 255u);
+        FB[i] = pack4(o);
+    } else if (pc.stage == 3) {                            // BLEND
+        if (i >= W * H) return;
+        const int y = i / W, x = i % W, sy = y >> 1, sx = x >> 1;
+        const int ny = (y & 1) != 0 ? min(sy + 1, HH - 1) : max(sy - 1, 0);
+        const int nx = (x & 1) != 0 ? min(sx + 1, HW - 1) : max(sx - 1, 0);
+        const uint m = FB[sy * HW + sx], mx = FB[sy * HW + nx], v = FB[ny * HW + sx], vx = FB[ny * HW + nx];
+        uint up[4], o[4];
+        for (int c = 0; c < 4; c++) up[c] = (3u * (3u * ch(m, c) + ch(mx, c)) + (3u * ch(v, c) + ch(vx, c))) >> 4;
+        const uint t = IMG[i];
+        for (int c = 0; c < 4; c++) o[c] = min(up[c] + ((ch(t, c) * (256u - up[0])) >> 8), 255u);
+        IMG[i] = pack4(o);
+    }
+}
