From 2e56be4de6046ae4620751bcd8b8c159266cb890 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Sat, 31 Oct 2026 07:06:19 -0300
Subject: [PATCH] Killzone HD's sprint motion blur on the GPU
 (PS3RECOMP_MB_GPU): after the MLAA, with the field the title draws

vulkan/rsx_vk_mb.comp redoes jm_post's motion blur (SPU modules 8197, ab05,
6b71, de0b, 14e0 and f601's blend) with the same rules as the Killzone port's
C reference (mb_ref.c): the 640x360 field blurred four times, the image
halved, 14 taps along the field's vector weighted by 1 + alpha/16 and divided
by the SPU reciprocal (frest + fi, in integers), upsampled and blended over
the image. PS3RECOMP_MB_GPU=<IO offset> names the main-memory target holding
the field; rsx_draw_engine_mlaa takes it and the backend's mlaa runs the pass
on the MLAA's buffer before it goes back. When the field has no strength (the
game's normal play) the image stages are dispatched indirectly with size 0.
PS3RECOMP_MB_ON=0 starts it off and rsx_vulkan_set_motion_blur switches it at
once (an options screen). PS3RECOMP_MLAA_DUMP also writes the field;
PS3RECOMP_MLAA_DUMP_MOVING=1 keeps only frames with some strength.

---
 libs/video/cellGcmSys.c                |   6 +-
 libs/video/rsx_draw_engine.c           |  52 +-
 libs/video/rsx_draw_engine.h           |  12 +-
 libs/video/rsx_vulkan_backend.c        | 115 ++++-
 libs/video/rsx_vulkan_backend.h        |   3 +
 libs/video/vulkan/rsx_vk_mb.comp       | 158 ++++++
 libs/video/vulkan/rsx_vk_mb_comp.spv.h | 869 +++++++++++++++++++++++++++++++++
 7 files changed, 1189 insertions(+), 26 deletions(-)

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index afc699b91219a2a9827b51f4ee1b0226d462e0e3..1d79f92f7cf5fbfdc86f33bbffbb60866e57cfb2 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1502,7 +1502,11 @@ static void nv0039_copy(const u32* r)
     const u32 loc_out = s_nv0039.dma_out == 0xFEED0001u ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
     if (mlaa_gpu_enabled()) {
         if (loc_in == RSX_LOCATION_LOCAL && loc_out == RSX_LOCATION_MAIN && len == 1280u * 720u * 4u && lines == 1u) {
-            const int ran = rsx_draw_engine_mlaa(loc_in, off_in);
+            /* PS3RECOMP_MB_GPU=<IO offset>: the 640x360 main-memory target there
+             * is the title's motion field, and its motion blur follows the MLAA */
+            static u32 mb = 0;
+            if (!mb) { const char* e = getenv("PS3RECOMP_MB_GPU"); mb = e && *e ? (u32)strtoul(e, NULL, 0) : ~0u; if (!mb) mb = ~0u; }
+            const int ran = rsx_draw_engine_mlaa(loc_in, off_in, RSX_LOCATION_MAIN, mb);
             static int n, r; if (ran ? PS3_LOG_FIRST(r, 2) : PS3_LOG_FIRST(n, 2))
                 fprintf(stderr, "[NV0039] GPU MLAA on local 0x%08X: %s\n", off_in,
                         ran ? "ran" : "not run (no 1280x720 R8G8B8A8 surface, or the pass is still being built)");
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 3d9dc8e057f55860ba86e41c7a0e8f991bfebdc8..02256be3cd255dea3bfb6bc279a64af265e37a9b 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1113,43 +1113,61 @@ u32 rsx_draw_engine_surface_pitch(u32 location, u32 offset)
 }
 
 /* Killzone HD's jm_post MLAA on the colour surface based exactly at
- * location:offset (the display buffer the title copies to the SPUs).
+ * location:offset (the display buffer the title copies to the SPUs), and its
+ * motion blur with the field surface when there is one.
  * PS3RECOMP_MLAA_DUMP=<dir>: while <dir>/go exists, the surface before and
- * after (seq_in.argb / seq_out.argb, A,R,G,B bytes), for checking the pass
- * against port/kz1hd/native/mlaa_ref.c; 8 frames, then go is removed. */
-static void eng_mlaa_dump(u32 handle, const char* tag)
+ * after and the field (seq_in.argb / seq_out.argb / seq_field.argb, A,R,G,B
+ * bytes), for checking the passes against port/kz1hd/native/mlaa_ref.c and
+ * mb_ref.c; 8 frames, then go is removed (PS3RECOMP_MLAA_DUMP_MOVING=1: only
+ * frames whose field has some strength). */
+static int eng_mlaa_dump(u32 handle, const char* tag, u32 w, u32 h)
 {
     static const char* d = (const char*)-1; static unsigned seq;
     if (d == (const char*)-1) d = getenv("PS3RECOMP_MLAA_DUMP");
-    if (!d || !g.be->readback) return;
+    if (!d || !g.be->readback) return 0;
     char path[1024]; snprintf(path, sizeof path, "%s/go", d);
     FILE* f = fopen(path, "rb");
-    if (!f) return;
+    if (!f) return 0;
     fclose(f);
-    u8* rows = (u8*)malloc(1280u * 720u * 4u);
-    if (!rows) return;
+    u8* rows = (u8*)malloc((size_t)w * h * 4u);
+    if (!rows) return 0;
     g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
-    g.be->readback(g.be->user, handle, 0, 0, 1280, 720, rows, 1280u * 4u);
-    for (u32 i = 0; i < 1280u * 720u; i++) {           /* R,G,B,A -> A,R,G,B */
+    g.be->readback(g.be->user, handle, 0, 0, w, h, rows, w * 4u);
+    for (u32 i = 0; i < w * h; i++) {                   /* R,G,B,A -> A,R,G,B */
         const u8 r = rows[4 * i], gg = rows[4 * i + 1], b = rows[4 * i + 2], a = rows[4 * i + 3];
         rows[4 * i] = a; rows[4 * i + 1] = r; rows[4 * i + 2] = gg; rows[4 * i + 3] = b;
     }
-    snprintf(path, sizeof path, "%s/%04u_%s.argb", d, seq / 2u, tag);
+    const int out = !strcmp(tag, "out");
+    /* PS3RECOMP_MLAA_DUMP_MOVING=1: only frames whose field has some strength */
+    if (!strcmp(tag, "field") && getenv("PS3RECOMP_MLAA_DUMP_MOVING")) {
+        u8 m = 0;
+        for (u32 i = 0; i < w * h; i++) if (rows[4 * i] > m) m = rows[4 * i];
+        if (!m) { free(rows); return 0; }
+    }
+    snprintf(path, sizeof path, "%s/%04u_%s.argb", d, seq, tag);
     f = fopen(path, "wb");
-    if (f) { fwrite(rows, 4, 1280u * 720u, f); fclose(f); }
+    if (f) { fwrite(rows, 4, (size_t)w * h, f); fclose(f); }
     free(rows);
-    if (++seq >= 16u) { snprintf(path, sizeof path, "%s/go", d); remove(path); seq = 0; }
+    if (out && ++seq >= 8u) { snprintf(path, sizeof path, "%s/go", d); remove(path); seq = 0; }
+    return 1;
 }
 
-int rsx_draw_engine_mlaa(u32 location, u32 offset)
+int rsx_draw_engine_mlaa(u32 location, u32 offset, u32 field_location, u32 field_offset)
 {
     if (!g.ready || !g.be->mlaa) return 0;
+    u32 field = 0;
+    if (field_offset != ~0u)
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const eng_surface* s = &g.surfaces[i];
+            if (s->handle && s->location == field_location && s->offset == field_offset &&
+                s->fmt == RSX_BE_FMT_R8G8B8A8 && s->w >= 640 && s->h >= 360) { field = s->handle; break; }
+        }
     for (u32 i = 0; i < g.n_surfaces; i++) {
         const eng_surface* s = &g.surfaces[i];
         if (!s->handle || s->location != location || s->offset != offset || s->fmt != RSX_BE_FMT_R8G8B8A8) continue;
-        eng_mlaa_dump(s->handle, "in");
-        const int ran = g.be->mlaa(g.be->user, s->handle);
-        if (ran) eng_mlaa_dump(s->handle, "out");
+        const int dump = (!field || eng_mlaa_dump(field, "field", 640, 360)) && eng_mlaa_dump(s->handle, "in", 1280, 720);
+        const int ran = g.be->mlaa(g.be->user, s->handle, field);
+        if (ran && dump) eng_mlaa_dump(s->handle, "out", 1280, 720);
         return ran;
     }
     return 0;
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
index e795d26d83c8d92a4de60275a0948d67771c263e..5c7d2d6c5eab4918f77a28aca90050b772192d7e 100644
--- a/libs/video/rsx_draw_engine.h
