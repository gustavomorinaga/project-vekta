     memcpy(s_overlay_buf.ptr, px, bytes);
     for (int i = 0; i < n; i++) {   /* clipped to the window; a rect whose rows leave the pixels is dropped */
         const int32_t x0 = r[i].x > 0 ? r[i].x : 0, y0 = r[i].y > 0 ? r[i].y : 0;
