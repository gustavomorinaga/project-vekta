+ * (up to max), with *pixels and *bytes: the rects' 4-byte pixels, each rect's rows at off, row_px pixels apart, the
+ * fourth byte alpha and the colour premultiplied by it. They are blended over the frame (colour + frame * (1 - alpha)),
+ * clipped to the window; on a surface whose images cannot be read back they are copied as they are. *pixels must stay
+ * valid until fn is called again. NULL turns it off. Not on a window format other than 8-bit BGRA or RGBA. */
 #define RSX_OVERLAY_MAX_RECTS 256
 typedef struct rsx_overlay_rect { int32_t x, y; uint32_t w, h, off, row_px; } rsx_overlay_rect;
 typedef int (*rsx_overlay_fn)(uint32_t win_w, uint32_t win_h, int bgra, const void** pixels, size_t* bytes,
diff --git a/libs/video/vulkan/rsx_vk_overlay.comp b/libs/video/vulkan/rsx_vk_overlay.comp
new file mode 100644
index 0000000..3978ea3
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_overlay.comp
@@ -0,0 +1,20 @@
+#version 450
+// The host overlay (rsx_vulkan_set_overlay) over the window's pixels: OV holds the overlay's 4-byte pixels with
+// premultiplied alpha in the fourth byte, FB the window's pixels under them, read back in the same layout. Each
+// word: FB = OV + FB * (255 - a) / 255, byte by byte (the byte order is the window's; only the fourth byte is alpha,
+// and the result's alpha is opaque). Regenerate the header with:
+//   glslangValidator -V --target-env vulkan1.0 --vn rsx_vk_overlay_comp_spv -o rsx_vk_overlay_comp.spv.h rsx_vk_overlay.comp
+layout(local_size_x = 256) in;
+layout(std430, binding = 0) readonly buffer Ov { uint ov[]; };
+layout(std430, binding = 1) buffer Fb { uint fb[]; };
+layout(push_constant) uniform P { uint count; } pc;
+
+void main()
+{
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= pc.count) return;
+    const uvec4 o = (uvec4(ov[i]) >> uvec4(0, 8, 16, 24)) & 255u;
+    const uvec4 f = (uvec4(fb[i]) >> uvec4(0, 8, 16, 24)) & 255u;
+    const uvec3 c = min(o.xyz + (f.xyz * (255u - o.w) + 127u) / 255u, uvec3(255u));
+    fb[i] = c.x | c.y << 8 | c.z << 16 | 0xFF000000u;
+}
