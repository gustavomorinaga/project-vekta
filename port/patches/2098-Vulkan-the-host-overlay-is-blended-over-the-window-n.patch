+/* rsx_vulkan_set_overlay: the host's overlay (ENHANCEMENT: a port's own notices), pixels with premultiplied alpha put
+ * over the window's image after the frame's blit and before the present, so every upscaler path is under it. The
+ * blend is one small compute pass on buffers (vulkan/rsx_vk_overlay.comp): the pixels under the rects are copied out
+ * of the swap chain image into s_overlay_fb in the overlay's own layout, blended there and copied back, so the swap
+ * chain needs no colour-attachment or storage use, no render pass and no graphics pipeline (only TRANSFER_SRC, which
+ * nearly every surface allows; without it, or if the pass cannot be made, the pixels are copied as they are). The hook
+ * runs here on the presenting thread, after the previous present's fence: the two buffers are free. */
 static rsx_overlay_fn s_overlay_fn;
-static vk_buffer s_overlay_buf;
+static vk_buffer s_overlay_buf, s_overlay_fb;
 static VkBufferImageCopy s_overlay_copy[RSX_OVERLAY_MAX_RECTS];
 static int s_overlay_n;
+static u32 s_overlay_words;
+static struct {
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout      layout;
+    VkPipeline            pipe;
+    VkDescriptorPool      pool;
+    VkDescriptorSet       set;
+    int                   tried, ok;
+} s_ovb;
 void rsx_vulkan_set_overlay(rsx_overlay_fn fn) { s_overlay_fn = fn; }
 
+static int vk_overlay_blend_init(void)
+{
+    if (s_ovb.tried) return s_ovb.ok;
+    s_ovb.tried = 1;
+    VkDescriptorSetLayoutBinding b[2] = {
+        { 0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL },
+        { 1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL },
+    };
+    VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 2, .pBindings = b };
+    VkPushConstantRange pr = { VK_SHADER_STAGE_COMPUTE_BIT, 0, 4 };
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2 };
+    VkDescriptorPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                      .maxSets = 1, .poolSizeCount = 1, .pPoolSizes = &ps };
+    VkShaderModuleCreateInfo mci = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                     .codeSize = sizeof rsx_vk_overlay_comp_spv, .pCode = rsx_vk_overlay_comp_spv };
+    VkShaderModule mod = VK_NULL_HANDLE;
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_ovb.dsl) != VK_SUCCESS) goto fail;
+    VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                       .setLayoutCount = 1, .pSetLayouts = &s_ovb.dsl,
+                                       .pushConstantRangeCount = 1, .pPushConstantRanges = &pr };
+    if (pvkCreatePipelineLayout(s_vk.device, &lci, NULL, &s_ovb.layout) != VK_SUCCESS) goto fail;
+    if (pvkCreateDescriptorPool(s_vk.device, &pi, NULL, &s_ovb.pool) != VK_SUCCESS) goto fail;
+    VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                       .descriptorPool = s_ovb.pool, .descriptorSetCount = 1, .pSetLayouts = &s_ovb.dsl };
+    if (pvkAllocateDescriptorSets(s_vk.device, &ai, &s_ovb.set) != VK_SUCCESS) goto fail;
+    if (pvkCreateShaderModule(s_vk.device, &mci, NULL, &mod) != VK_SUCCESS) goto fail;
+    VkComputePipelineCreateInfo pci = {
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                   .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = mod, .pName = "main" },
+        .layout = s_ovb.layout,
+    };
+    const VkResult r = pvkCreateComputePipelines(s_vk.device, VK_NULL_HANDLE, 1, &pci, NULL, &s_ovb.pipe);
+    pvkDestroyShaderModule(s_vk.device, mod, NULL);
+    if (r != VK_SUCCESS) goto fail;
+    s_ovb.ok = 1;
+    return 1;
+fail:
+    VK_LOG("overlay: no blend pass, the pixels are copied as they are\n");
+    return 0;
+}
