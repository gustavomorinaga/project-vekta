     };
     pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
                           0, 0, NULL, 0, NULL, 1, &b);
-    pvkCmdCopyBufferToImage(s_vk.cmd, s_overlay_buf.buf, img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
-                            (u32)s_overlay_n, s_overlay_copy);
+}
+
+static void vk_overlay_buffer_barrier(VkBuffer buf, VkPipelineStageFlags from, VkPipelineStageFlags to,
+                                      VkAccessFlags src, VkAccessFlags dst)
+{
+    VkBufferMemoryBarrier b = { .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER, .srcAccessMask = src,
+                                .dstAccessMask = dst, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .buffer = buf, .size = VK_WHOLE_SIZE };
+    pvkCmdPipelineBarrier(s_vk.cmd, from, to, 0, 0, NULL, 1, &b, 0, NULL);
+}
+
+/* after the blit, the image in TRANSFER_DST_OPTIMAL, and left so */
+static void vk_overlay_record(VkImage img)
+{
+    if (!s_overlay_n) return;
+    const VkAccessFlags rw = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    vk_overlay_image_barrier(img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
+                             VK_ACCESS_TRANSFER_WRITE_BIT, rw);
+    VkBuffer src = s_overlay_buf.buf;
+    if (s_overlay_words) {   /* the pixels under the rects out, blended, and back */
+        pvkCmdCopyImageToBuffer(s_vk.cmd, img, VK_IMAGE_LAYOUT_GENERAL, s_overlay_fb.buf, (u32)s_overlay_n,
+                                s_overlay_copy);
+        vk_overlay_buffer_barrier(s_overlay_fb.buf, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                  VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+        pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_ovb.pipe);
+        pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_ovb.layout, 0, 1, &s_ovb.set, 0, NULL);
+        pvkCmdPushConstants(s_vk.cmd, s_ovb.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, 4, &s_overlay_words);
+        pvkCmdDispatch(s_vk.cmd, (s_overlay_words + 255) / 256, 1, 1);
+        vk_overlay_buffer_barrier(s_overlay_fb.buf, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                  VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+        src = s_overlay_fb.buf;
+    }
+    pvkCmdCopyBufferToImage(s_vk.cmd, src, img, VK_IMAGE_LAYOUT_GENERAL, (u32)s_overlay_n, s_overlay_copy);
+    vk_overlay_image_barrier(img, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, rw,
+                             VK_ACCESS_TRANSFER_WRITE_BIT);
 }
 
