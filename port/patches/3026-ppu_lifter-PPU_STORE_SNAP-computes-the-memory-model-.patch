From f3a6b7e00c240dd1dbbed805875a3a82ad93457e Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Tue, 27 Oct 2026 19:46:17 -0300
Subject: [PATCH] ppu_lifter: PPU_STORE_SNAP computes the memory-model
 snapshot once and copies it

Each lifted function's PPU_MM_SNAP read eight globals and rebuilt the snapshot; under PPU_STORE_SNAP it is cached and recomputed only when the store watches or the bitmap pointer change. KZ1 HD Level 7 with PGO: 126.9 -> 131.4 fps (v0.14.0 base 135.9 in the same session).

---
 tools/ppu_lifter.py | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index 06d2ec10..480b7d14 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -194,7 +194,7 @@ extern const unsigned char* g_spu_coh_bits;   /* SPU-reserved lines, NULL until
  * they also turned away, the gcm ref-poll word, is only special to vm_read32,
  * so only the 32-bit load still tests it. */
 typedef struct ppu_mm { uint8_t* vb; int64_t ld_span, st_span; uint32_t poll; const unsigned char* bits; } ppu_mm;
-static inline __attribute__((always_inline)) ppu_mm ppu_mm_take(void)
+static inline __attribute__((always_inline)) ppu_mm ppu_mm_compute(void)
 {
     const uint32_t hi = (ppu_vm_size != 0 && ppu_vm_size < 0xE0000000u) ? ppu_vm_size : 0xE0000000u;
     const int64_t span = hi > 0x10000u ? (int64_t)(hi - 0x10000u) : 0;
@@ -216,6 +216,26 @@ static inline __attribute__((always_inline)) ppu_mm ppu_mm_take(void)
 #endif
     return m;
 }
+#if defined(PPU_STORE_SNAP) && defined(__cplusplus)
+/* PPU_STORE_SNAP: the snapshot is computed once and copied at every function
+ * entry. Its inputs are set before guest code runs, except the store watches
+ * (folded into st_span) and the bitmap pointer (NULL until the first
+ * reservation): a change of either makes the next entry compute it again. */
+inline ppu_mm g_ppu_mm_cache;
+inline uint32_t g_ppu_mm_cache_key = ~0u;
+inline const unsigned char* g_ppu_mm_cache_bits;
+static inline __attribute__((always_inline)) ppu_mm ppu_mm_take(void)
+{
+    const uint32_t key = g_barrier_sync_watch | g_null_sweep_hi;
+    if (__builtin_expect(key == g_ppu_mm_cache_key && g_spu_coh_bits == g_ppu_mm_cache_bits, 1))
+        return g_ppu_mm_cache;
+    const ppu_mm m = ppu_mm_compute();
+    g_ppu_mm_cache = m; g_ppu_mm_cache_bits = m.bits; g_ppu_mm_cache_key = key;
+    return m;
+}
+#else
+static inline __attribute__((always_inline)) ppu_mm ppu_mm_take(void) { return ppu_mm_compute(); }
+#endif
 /* [ea, ea + n) inside [0x10000, 0x10000 + span). Below 0x10000 the 32-bit
  * subtraction wraps past any span. Signed, so span - n is computed once per
  * function and a span of 0 still turns everything away. */
-- 
