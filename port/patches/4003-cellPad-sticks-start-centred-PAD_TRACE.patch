From 1310fb2dd32936944bad902141a465df34b75e19 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Wed, 14 Oct 2026 18:20:00 -0300
Subject: [PATCH] cellPad: sticks start centred; PAD_TRACE

The host state was zeroed at init, so the always-present virtual pad on
port 0 read both sticks pinned up-left until a device or input source
wrote them. PAD_TRACE=1 prints the reads and the last packet every 2 s.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/input/cellPad.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index d3785158..5b2533b9 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -1163,6 +1163,18 @@ emit:
      * attack firing once.
      *
      * PAD_ALWAYS_CHANGE=1 restores the old always-a-packet behaviour. */
+    {
+    }
+    /* PAD_TRACE=1: every 2 s, how many reads, how many carried a packet, and the last one. */
+    { static int tr = -1; static unsigned long long t_last = 0; static unsigned n = 0, nfull = 0;
+      if (tr < 0) tr = getenv("PAD_TRACE") ? 1 : 0;
+      if (tr) { n++; if (data->len) nfull++;
+        unsigned long long now = GetTickCount64();
+        if (now - t_last >= 2000) { t_last = now;
+          fprintf(stderr, "[pad-trace] port %u: %u reads, %u packets; len %d d1 %02X d2 %02X lx %u ly %u rx %u ry %u\n",
+                  port_no, n, nfull, (int)data->len, data->button[2], data->button[3],
+                  data->button[6], data->button[7], data->button[4], data->button[5]);
+          n = nfull = 0; } } }
     {
         unsigned int ea = (unsigned int)(uintptr_t)data_guest;
         vm_write32((unsigned long long)ea + 0, (unsigned int)data->len);   /* len (s32) */
-- 
