From 831d9b26a8ce72ed954301250803945eb710b688 Mon Sep 17 00:00:00 2001
From: Gustavo Morinaga <me@gustavomorinaga.dev>
Date: Thu, 15 Oct 2026 19:48:16 -0300
Subject: [PATCH] vulkan: pipeline cache saved on its own thread

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 libs/video/rsx_vulkan_backend.c | 46 +++++++++++++++++++++++++--------
 1 file changed, 35 insertions(+), 11 deletions(-)

diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 081a742d..121307e4 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -67,6 +67,10 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#ifndef _WIN32
+#include <pthread.h>
+#include <unistd.h>
+#endif
 
 /* ---------------------------------------------------------------------------
  * Run-time loaded entry points (Vulkan 1.0 core only)
@@ -2430,7 +2434,6 @@ static void vk_eng_clear_depth_stencil(void* user, u32 depth, u32 flags,
 
 /* The named surface becomes the frame: blit it onto the display image, then
  * the existing present does the readback, the PPM dump and the window. */
-static void vk_pipeline_cache_save(void);
 static void vk_eng_present(void* user, u32 surface)
 {
     (void)user;
@@ -2459,7 +2462,6 @@ static void vk_eng_present(void* user, u32 surface)
     pthread_mutex_unlock(&s_vk.present_mu);
     s_g.last_draws = s_g.draws;
     s_g.draws = 0;
-    vk_pipeline_cache_save();
 }
 
 /* Pixels a 2D transfer put into guest memory, pushed into the colour target
@@ -3022,6 +3024,25 @@ static void vk_cache_write(const char* path, const void* data, size_t size)
 static VkPipelineCache s_vk_pcache;
 static int s_vk_pcache_dirty;
 
+static void vk_pipeline_cache_save(void);
+#ifdef _WIN32
+static DWORD WINAPI vk_pipeline_cache_saver(LPVOID p)
+#else
+static void* vk_pipeline_cache_saver(void* p)
+#endif
+{
+    (void)p;
+    for (;;) {
+#ifdef _WIN32
+        Sleep(3000);
+#else
+        sleep(3);
+#endif
+        vk_pipeline_cache_save();
+    }
+    return 0;
+}
+
 static VkPipelineCache vk_pipeline_cache(void)
 {
     static int tried;
@@ -3051,20 +3072,23 @@ static VkPipelineCache vk_pipeline_cache(void)
             s_vk_pcache = VK_NULL_HANDLE;
     }
     free(data);
+    if (s_vk_pcache) {
+#ifdef _WIN32
+        CreateThread(NULL, 0, vk_pipeline_cache_saver, NULL, 0, NULL);
+#else
+        pthread_t th;
+        if (pthread_create(&th, NULL, vk_pipeline_cache_saver, NULL) == 0) pthread_detach(th);
+#endif
+    }
     return s_vk_pcache;
 }
 
-/* Saved from the present path at most every 2 s after new pipelines were
- * compiled: a title is usually killed, not shut down. */
+/* Saved every few seconds after new pipelines were compiled (a title is
+ * usually killed, not shut down), on a thread of its own: reading back and
+ * writing a blob of megabytes on the present path was a hitch each time. */
 static void vk_pipeline_cache_save(void)
 {
-    static unsigned long long last;
-    if (!s_vk_pcache || !s_vk_pcache_dirty) return;
-    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
-    const unsigned long long now = t.tv_sec * 1000ull + t.tv_nsec / 1000000;
-    if (now - last < 2000) return;
-    last = now;
-    s_vk_pcache_dirty = 0;
+    if (!s_vk_pcache || !__atomic_exchange_n(&s_vk_pcache_dirty, 0, __ATOMIC_ACQ_REL)) return;
     size_t size = 0;
     if (pvkGetPipelineCacheData(s_vk.device, s_vk_pcache, &size, NULL) != VK_SUCCESS || !size) return;
     void* data = malloc(size);
-- 
2.56.0

