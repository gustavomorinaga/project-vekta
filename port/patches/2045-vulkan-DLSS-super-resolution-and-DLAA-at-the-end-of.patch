+    if (rsx_dlss_init(s_vk.instance, s_vk.phys, s_vk.device, pvkGetInstanceProcAddr, pvkGetDeviceProcAddr, dir)) return;
+    s_tm.out_w = s_vk.width; s_tm.out_h = s_vk.height;
+    u32 rw, rh;
+    if (rsx_dlss_render_size(s_tm.mode, s_tm.out_w, s_tm.out_h, &rw, &rh)) { VK_LOG("temporal: no DLSS render size, off\n"); return; }
