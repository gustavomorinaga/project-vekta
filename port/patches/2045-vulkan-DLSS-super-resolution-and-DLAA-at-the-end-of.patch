+/* Copy of depth target `from` into the engine object *to (made or remade at
+ * its size), depth only. 0 on success. */
+static int vk_tm_copy_depth(void* user, u32 from, u32* to)
+{
+    vk_eng_obj* o = vk_eng_get(from, VK_ENG_DEPTH);
+    if (!o) return -1;
+    vk_eng_obj* w = *to ? vk_eng_get(*to, VK_ENG_DEPTH) : NULL;
+    if (w && (w->w != o->w || w->h != o->h)) { vk_eng_release(user, *to); *to = 0; w = NULL; }
+    if (!w && (*to = vk_eng_depth_target_create(user, o->lw, o->lh)) != 0) w = vk_eng_get(*to, VK_ENG_DEPTH);
+    o = vk_eng_get(from, VK_ENG_DEPTH);
+    if (!w || !o || vk_batch_reserve(0)) return -1;
+    vk_barrier_image(o->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(w->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageCopy c = { .srcSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 },
+                      .dstSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1 },
+                      .extent = { o->w, o->h, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL, w->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &c);
+    vk_barrier_image(w->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+    return 0;
+}
