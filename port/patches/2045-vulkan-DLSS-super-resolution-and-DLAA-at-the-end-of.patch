+    int want, ok, mode;
+    u32 out_w, out_h;                 /* the output (s_vk.width x height) */
+    float jsign_x, jsign_y;           /* PS3RECOMP_DLSS_JITTER_SIGN=<x>,<y> */
+    VkSampler samp;
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout layout;
+    VkPipeline pipe;
+    VkDescriptorPool pool;
+    VkDescriptorSet set;
+    VkImage set_for[3];               /* the images the set was written for */
+    vk_image mv; u32 mv_w, mv_h;
+    VkImageView zview[2]; VkImage zview_of[2];   /* depth-only views: world, final */
+    u32 fz;                           /* the final depth's copy (engine object) */
+    struct { u32 surface; vk_image out; u32 w, h; int swapped; vk_image keep; u32 kw, kh; } sw[VK_TM_SWAPS];
