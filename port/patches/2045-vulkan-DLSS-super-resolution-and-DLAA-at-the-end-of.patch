+/* A depth-only view of an engine depth object's image (DLSS and the motion
+ * pass sample depth, never stencil). */
+static VkImageView vk_tm_zview(int which, VkImage img)
+{
+    if (s_tm.zview_of[which] == img && s_tm.zview[which]) return s_tm.zview[which];
+    if (s_tm.zview[which]) { vk_flush(); pvkDestroyImageView(s_vk.device, s_tm.zview[which], NULL); s_tm.zview[which] = VK_NULL_HANDLE; }
+    VkImageViewCreateInfo vci = { .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = img,
+                                  .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = s_vk.depth_format,
+                                  .subresourceRange = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1 } };
+    if (pvkCreateImageView(s_vk.device, &vci, NULL, &s_tm.zview[which]) != VK_SUCCESS) { s_tm.zview[which] = VK_NULL_HANDLE; return VK_NULL_HANDLE; }
+    s_tm.zview_of[which] = img;
+    return s_tm.zview[which];
+}
