diff --git a/libs/video/rsx_temporal.c b/libs/video/rsx_temporal.c
new file mode 100644
index 00000000..634a3c95
--- /dev/null
+++ b/libs/video/rsx_temporal.c
@@ -0,0 +1,67 @@
+/* Per-frame camera data for temporal upscalers. See rsx_temporal.h. */
+#include "rsx_temporal.h"
+#include <string.h>
+
+#define TV_RING 8u
+
+/* Each slot: seq odd while being written (a seqlock: one writer, the guest's
+ * render thread; one reader, the RSX thread). */
+static struct { volatile uint32_t seq; rsx_temporal_view v; } s_ring[TV_RING];
+
+static volatile int s_on;
+static volatile float s_scale = 1.0f;
+
+void rsx_temporal_config(int on, float render_per_guest)
+{
+    s_scale = render_per_guest > 0.0f ? render_per_guest : 1.0f;
+    s_on = on;
+}
+
+static float tv_halton(uint32_t i, uint32_t base)
+{
+    float f = 1.0f, r = 0.0f;
+    for (; i; i /= base) { f /= (float)base; r += f * (float)(i % base); }
+    return r;
+}
+
+int rsx_temporal_next_jitter(float* jitter_x, float* jitter_y)
+{
+    static uint32_t n;
+    *jitter_x = *jitter_y = 0.0f;
+    if (!s_on) return 0;
+    /* 8 phases per output pixel: 8 at native, 32 at half resolution (the
+     * count the DLSS guide asks for) */
+    const float s = s_scale;
+    uint32_t phases = (uint32_t)(8.0f / (s * s) + 0.5f);
+    if (phases < 8u) phases = 8u;
+    const uint32_t i = n++ % phases + 1u;
+    *jitter_x = (tv_halton(i, 2) - 0.5f) / s;
+    *jitter_y = (tv_halton(i, 3) - 0.5f) / s;
+    return 1;
+}
+
+void rsx_temporal_set_view(const float vp[16], float jitter_x, float jitter_y)
+{
+    const uint32_t frame = cellGcm_frame_queued();
+    __typeof__(s_ring[0])* s = &s_ring[frame % TV_RING];
+    __atomic_store_n(&s->seq, s->seq + 1u, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+    s->v.frame = frame;
+    memcpy(s->v.vp, vp, sizeof s->v.vp);
+    s->v.jitter[0] = jitter_x;
+    s->v.jitter[1] = jitter_y;
+    __atomic_store_n(&s->seq, s->seq + 1u, __ATOMIC_RELEASE);
+}
+
+int rsx_temporal_get_view(uint32_t frame, rsx_temporal_view* out)
+{
+    const __typeof__(s_ring[0])* s = &s_ring[frame % TV_RING];
+    for (int tries = 0; tries < 4; tries++) {
+        const uint32_t a = __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE);
+        if (a & 1u) continue;
+        memcpy(out, (const void*)&s->v, sizeof *out);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&s->seq, __ATOMIC_RELAXED) == a) return out->frame == frame;
+    }
+    return 0;
+}
diff --git a/libs/video/rsx_temporal.h b/libs/video/rsx_temporal.h
new file mode 100644
index 00000000..88ccd104
--- /dev/null
+++ b/libs/video/rsx_temporal.h
@@ -0,0 +1,49 @@
+/*
+ * Per-frame camera data for temporal upscalers (DLSS, FSR 3): the guest's
+ * view-projection without jitter, and the jitter the frame was drawn with.
+ *
+ * The title's PPU builds frame N while the RSX may still be drawing frame
+ * N-1, so a record is tagged with the frame it belongs to: the count of flips
+ * the guest had queued when it was set (cellGcm_frame_queued), which is the
+ * count the drain has reached (cellGcm_frame_reached) while that frame's
+ * commands are drawn. A record whose tag does not match is not handed out.
+ */
+#ifndef RSX_TEMPORAL_H
+#define RSX_TEMPORAL_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct rsx_temporal_view {
+    uint32_t frame;      /* tag, see above */
+    /* world -> clip, column vectors (clip = vp * (x, y, z, 1)), x right and
+     * y up in NDC [-1, 1], z the depth the title's viewport maps */
+    float vp[16];
+    /* where the frame's samples sat, relative to the pixel centres, in pixels
+     * of the guest frame, x right and y down */
+    float jitter[2];
+} rsx_temporal_view;
+
+/* Guest thread: the frame being built now. */
+uint32_t cellGcm_frame_queued(void);
+/* RSX thread: the frame whose commands are being drawn now. */
+uint32_t cellGcm_frame_reached(void);
+
+/* Backend: a temporal upscaler is on (or off), rendering `render_per_guest`
+ * pixels for each pixel of the guest's frame in each direction. */
+void rsx_temporal_config(int on, float render_per_guest);
+/* Guest thread, once per frame before its world projection is built: the
+ * sub-pixel offset of its frustum, in pixels of the guest frame, x right and
+ * y up (a Halton 2,3 sequence over half a render pixel each way). 0 and no
+ * offset when no temporal upscaler is on. */
+int rsx_temporal_next_jitter(float* jitter_x, float* jitter_y);
+/* Guest thread, once per frame the world view is built (the last call wins). */
+void rsx_temporal_set_view(const float vp[16], float jitter_x, float jitter_y);
+/* RSX thread: the record of `frame`, 1 when there is one. */
+int rsx_temporal_get_view(uint32_t frame, rsx_temporal_view* out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_vk_dlss.cpp b/libs/video/rsx_vk_dlss.cpp
new file mode 100644
index 00000000..133b96df
--- /dev/null
+++ b/libs/video/rsx_vk_dlss.cpp
@@ -0,0 +1,171 @@
+/* NVIDIA DLSS through NGX. See rsx_vk_dlss.h. */
+#include "rsx_vk_dlss.h"
+#include <stdio.h>
+#include <string.h>
+
+#ifndef PS3RECOMP_DLSS
+
+extern "C" {
+void rsx_dlss_required_extensions(uint32_t* ni, const char* const** inst, uint32_t* nd, const char* const** dev)
+{ *ni = *nd = 0; *inst = *dev = nullptr; }
+int rsx_dlss_init(VkInstance, VkPhysicalDevice, VkDevice, PFN_vkGetInstanceProcAddr, PFN_vkGetDeviceProcAddr, const char*)
+{ return -1; }
+int rsx_dlss_render_size(int, uint32_t, uint32_t, uint32_t*, uint32_t*) { return -1; }
+int rsx_dlss_evaluate(VkCommandBuffer, int, const rsx_dlss_frame*) { return -1; }
+void rsx_dlss_shutdown(void) {}
+}
+
+#else
+
+#include <nvsdk_ngx_vk.h>
+#include <nvsdk_ngx_helpers.h>
+#include <nvsdk_ngx_helpers_vk.h>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct {
+    VkDevice device = VK_NULL_HANDLE;
+    NVSDK_NGX_Parameter* params = nullptr;
+    NVSDK_NGX_Handle* feature = nullptr;
+    int mode = -1;
+    uint32_t rw = 0, rh = 0, ow = 0, oh = 0;
+    bool ok = false;
+} s;
+
+#define DLSS_LOG(...) fprintf(stderr, "[RSX vulkan] DLSS: " __VA_ARGS__)
+
+std::wstring widen(const char* p)
+{
+    std::wstring w;
+    for (; p && *p; p++) w += (wchar_t)(unsigned char)*p;
+    return w;
+}
+
+NVSDK_NGX_Resource_VK resource(const rsx_dlss_image& im, bool depth, bool rw)
+{
+    VkImageSubresourceRange r = { depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    return NVSDK_NGX_Create_ImageView_Resource_VK(im.view, im.image, r, im.format, im.w, im.h, rw);
+}
+
+}  // namespace
+
+extern "C" {
+
+void rsx_dlss_required_extensions(uint32_t* ni, const char* const** inst, uint32_t* nd, const char* const** dev)
+{
+    unsigned int a = 0, b = 0;
+    const char** ia = nullptr;
+    const char** da = nullptr;
+    if (NVSDK_NGX_FAILED(NVSDK_NGX_VULKAN_RequiredExtensions(&a, &ia, &b, &da))) a = b = 0;
+    *ni = a; *inst = ia; *nd = b; *dev = da;
+}
+
+int rsx_dlss_init(VkInstance instance, VkPhysicalDevice phys, VkDevice device,
+                  PFN_vkGetInstanceProcAddr gipa, PFN_vkGetDeviceProcAddr gdpa, const char* data_dir)
+{
+    const std::wstring dir = widen(data_dir && *data_dir ? data_dir : ".");
+    /* the DLSS library next to the executable, or in data_dir */
+    const wchar_t* paths[] = { dir.c_str(), L"." };
+    NVSDK_NGX_FeatureCommonInfo info = {};
+    info.PathListInfo.Path = paths;
+    info.PathListInfo.Length = 2;
+    NVSDK_NGX_Result r = NVSDK_NGX_VULKAN_Init(0x4B5A31u /* any id: no NVIDIA project id */, dir.c_str(),
+                                               instance, phys, device, gipa, gdpa, &info);
+    if (NVSDK_NGX_FAILED(r)) { DLSS_LOG("NGX init failed (0x%08X)\n", (unsigned)r); return -1; }
+    s.device = device;
+    if (NVSDK_NGX_FAILED(NVSDK_NGX_VULKAN_GetCapabilityParameters(&s.params))) {
+        DLSS_LOG("no NGX capability parameters\n");
+        NVSDK_NGX_VULKAN_Shutdown1(device);
+        return -1;
+    }
+    int available = 0, needs_driver = 0;
+    unsigned int major = 0, minor = 0;
+    NVSDK_NGX_Result fr = NVSDK_NGX_Result_Fail;
+    s.params->Get(NVSDK_NGX_Parameter_SuperSampling_Available, &available);
+    s.params->Get(NVSDK_NGX_Parameter_SuperSampling_NeedsUpdatedDriver, &needs_driver);
+    s.params->Get(NVSDK_NGX_Parameter_SuperSampling_MinDriverVersionMajor, &major);
+    s.params->Get(NVSDK_NGX_Parameter_SuperSampling_MinDriverVersionMinor, &minor);
+    s.params->Get(NVSDK_NGX_Parameter_SuperSampling_FeatureInitResult, (int*)&fr);
+    if (!available) {
+        DLSS_LOG("not available (init result 0x%08X%s)\n", (unsigned)fr,
+                 needs_driver ? ", the driver is too old" : "");
+        if (needs_driver) DLSS_LOG("needs driver %u.%u\n", major, minor);
+        NVSDK_NGX_VULKAN_DestroyParameters(s.params); s.params = nullptr;
+        NVSDK_NGX_VULKAN_Shutdown1(device);
+        return -1;
+    }
+    s.ok = true;
+    DLSS_LOG("available\n");
+    return 0;
+}
+
+int rsx_dlss_render_size(int mode, uint32_t out_w, uint32_t out_h, uint32_t* w, uint32_t* h)
+{
+    if (!s.ok) return -1;
+    if (mode == RSX_DLSS_DLAA) { *w = out_w; *h = out_h; return 0; }
+    unsigned int rw = 0, rh = 0, maxw, maxh, minw, minh;
+    float sharp = 0.0f;
+    if (NVSDK_NGX_FAILED(NGX_DLSS_GET_OPTIMAL_SETTINGS(s.params, out_w, out_h, (NVSDK_NGX_PerfQuality_Value)mode,
+                                                       &rw, &rh, &maxw, &maxh, &minw, &minh, &sharp)) || !rw || !rh)
+        return -1;
+    *w = rw; *h = rh;
+    return 0;
+}
+
+int rsx_dlss_evaluate(VkCommandBuffer cmd, int mode, const rsx_dlss_frame* f)
+{
+    if (!s.ok) return -1;
+    const uint32_t rw = f->color.w, rh = f->color.h, ow = f->output.w, oh = f->output.h;
+    if (!s.feature || mode != s.mode || rw != s.rw || rh != s.rh || ow != s.ow || oh != s.oh) {
+        if (s.feature) { NVSDK_NGX_VULKAN_ReleaseFeature(s.feature); s.feature = nullptr; }
+        NVSDK_NGX_DLSS_Create_Params c = {};
+        c.Feature.InWidth = rw; c.Feature.InHeight = rh;
+        c.Feature.InTargetWidth = ow; c.Feature.InTargetHeight = oh;
+        c.Feature.InPerfQualityValue = (NVSDK_NGX_PerfQuality_Value)mode;
+        /* LDR colour, motion vectors at render resolution, regular depth */
+        c.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;
+        NVSDK_NGX_Result r = NGX_VULKAN_CREATE_DLSS_EXT1(s.device, cmd, 1, 1, &s.feature, s.params, &c);
+        if (NVSDK_NGX_FAILED(r)) {
+            DLSS_LOG("creating the feature (%ux%u -> %ux%u, mode %d) failed (0x%08X)\n", rw, rh, ow, oh, mode, (unsigned)r);
+            s.feature = nullptr; s.ok = false;
+            return -1;
+        }
+        s.mode = mode; s.rw = rw; s.rh = rh; s.ow = ow; s.oh = oh;
+        DLSS_LOG("%ux%u -> %ux%u, mode %d\n", rw, rh, ow, oh, mode);
+    }
+    NVSDK_NGX_Resource_VK color = resource(f->color, false, false), depth = resource(f->depth, true, false),
+                          mv = resource(f->motion, false, false), out = resource(f->output, false, true);
+    NVSDK_NGX_VK_DLSS_Eval_Params e = {};
+    e.Feature.pInColor = &color;
+    e.Feature.pInOutput = &out;
+    e.Feature.InSharpness = f->sharpness;
+    e.pInDepth = &depth;
+    e.pInMotionVectors = &mv;
+    e.InJitterOffsetX = f->jitter_x;
+    e.InJitterOffsetY = f->jitter_y;
+    e.InRenderSubrectDimensions.Width = rw;
+    e.InRenderSubrectDimensions.Height = rh;
+    e.InReset = f->reset;
+    e.InMVScaleX = f->mv_scale_x;
+    e.InMVScaleY = f->mv_scale_y;
+    const NVSDK_NGX_Result r = NGX_VULKAN_EVALUATE_DLSS_EXT(cmd, s.feature, s.params, &e);
+    if (NVSDK_NGX_FAILED(r)) {
+        static int n;
+        if (n++ < 4) DLSS_LOG("evaluate failed (0x%08X)\n", (unsigned)r);
+        return -1;
+    }
+    return 0;
+}
+
+void rsx_dlss_shutdown(void)
+{
+    if (s.feature) NVSDK_NGX_VULKAN_ReleaseFeature(s.feature);
+    if (s.params) NVSDK_NGX_VULKAN_DestroyParameters(s.params);
+    if (s.device) NVSDK_NGX_VULKAN_Shutdown1(s.device);
+    s = {};
+}
+
+}  // extern "C"
+#endif
diff --git a/libs/video/rsx_vk_dlss.h b/libs/video/rsx_vk_dlss.h
new file mode 100644
index 00000000..2f761199
--- /dev/null
+++ b/libs/video/rsx_vk_dlss.h
@@ -0,0 +1,58 @@
+/*
+ * NVIDIA DLSS (super resolution and DLAA) for the Vulkan backend, through the
+ * NGX SDK. Built only when CMake is given PS3RECOMP_DLSS_SDK (the SDK's
+ * folder; the SDK is not part of this repository); otherwise every call says
+ * DLSS is not there. At run time NGX loads libnvidia-ngx-dlss.so (Windows:
+ * nvngx_dlss.dll) from the executable's folder.
+ */
+#ifndef RSX_VK_DLSS_H
+#define RSX_VK_DLSS_H
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Extensions NGX needs on the instance and the device; 0 of each without the SDK. */
+void rsx_dlss_required_extensions(uint32_t* n_instance, const char* const** instance,
+                                  uint32_t* n_device, const char* const** device);
+
+/* After the device is made. 0 when DLSS can run on it. */
+int rsx_dlss_init(VkInstance instance, VkPhysicalDevice phys, VkDevice device,
+                  PFN_vkGetInstanceProcAddr gipa, PFN_vkGetDeviceProcAddr gdpa,
+                  const char* data_dir);
+
+/* Quality modes, as NGX numbers them. */
+enum { RSX_DLSS_PERFORMANCE = 0, RSX_DLSS_BALANCED = 1, RSX_DLSS_QUALITY = 2,
+       RSX_DLSS_ULTRA_PERFORMANCE = 3, RSX_DLSS_DLAA = 5 };
+
+/* The render size NGX picks for an output size and mode; 0 on success. */
+int rsx_dlss_render_size(int mode, uint32_t out_w, uint32_t out_h, uint32_t* w, uint32_t* h);
+
+typedef struct rsx_dlss_image {
+    VkImage image;
+    VkImageView view;     /* colour, or depth aspect only */
+    VkFormat format;
+    uint32_t w, h;        /* the part of it to use, from the top left */
+} rsx_dlss_image;
+
+typedef struct rsx_dlss_frame {
+    rsx_dlss_image color, depth, motion, output;
+    float jitter_x, jitter_y;   /* render pixels, as the samples sat */
+    float mv_scale_x, mv_scale_y;
+    int reset;                  /* history is not this picture's (a cut) */
+    float sharpness;
+} rsx_dlss_frame;
+
+/* Recorded into cmd. The feature is made on the first call and again when the
+ * sizes or the mode change: the caller has the device idle before a call
+ * whose sizes or mode differ from the last. 0 on success. */
+int rsx_dlss_evaluate(VkCommandBuffer cmd, int mode, const rsx_dlss_frame* f);
+
+/* Device idle. */
+void rsx_dlss_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 70c1166f..8516d87b 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -50,6 +50,9 @@
 #include "rsx_fp_decompiler.h"
 #include "rsx_shader_spirv.h"
 #include "rsx_draw_engine.h"
