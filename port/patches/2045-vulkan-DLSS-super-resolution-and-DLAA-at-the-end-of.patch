diff --git a/libs/video/vulkan/rsx_vk_motion.comp b/libs/video/vulkan/rsx_vk_motion.comp
new file mode 100644
index 00000000..e7f0af59
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_motion.comp
@@ -0,0 +1,34 @@
+#version 450
+// Motion vectors for a temporal upscaler, from the camera alone: each pixel's
+// world depth, taken back through this frame's view-projection and forward
+// through the last frame's, gives where it was. Pixels the first-person model
+// covers (it was drawn after the world's depth was cleared) move with the
+// camera: no motion. Written in render pixels, last position minus this one.
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(set = 0, binding = 0) uniform sampler2D world_z;
+layout(set = 0, binding = 1) uniform sampler2D final_z;
+layout(set = 0, binding = 2, rg16f) uniform writeonly image2D motion;
+layout(push_constant) uniform Params {
+    mat4 reproject;   // last frame's clip from this frame's NDC
+    vec4 size_z;      // width, height, NDC z = depth * z + w
+    float y_sign;     // NDC y of the top row
+} pc;
+
+void main()
+{
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    vec2 size = pc.size_z.xy;
+    if (p.x >= int(size.x) || p.y >= int(size.y)) return;
+    vec2 mv = vec2(0.0);
+    if (texelFetch(final_z, p, 0).r >= 1.0) {
+        float z = texelFetch(world_z, p, 0).r;
+        vec2 uv = (vec2(p) + 0.5) / size;
+        vec4 ndc = vec4(uv.x * 2.0 - 1.0, pc.y_sign * (1.0 - uv.y * 2.0), z * pc.size_z.z + pc.size_z.w, 1.0);
+        vec4 q = pc.reproject * ndc;
+        if (q.w > 1e-6) {
+            vec2 prev = vec2(q.x / q.w * 0.5 + 0.5, 0.5 - pc.y_sign * q.y / q.w * 0.5) * size;
+            mv = prev - (vec2(p) + 0.5);
+        }
+    }
+    imageStore(motion, p, vec4(mv, 0.0, 0.0));
+}
