+/* After the device: NGX, then the render size. The output is the frame size
+ * the scale gave (s_vk.width x height, the window's with
+ * PS3RECOMP_VK_SCALE_FIT); the scene is then drawn at DLSS's render size for
+ * it, which becomes the internal scale every target is made at. */
+static void vk_tm_init(void)
+{
+    char dir[1024] = ".";
+#ifdef _WIN32
+    { DWORD n = GetModuleFileNameA(NULL, dir, sizeof dir); if (n && n < sizeof dir) { char* s = strrchr(dir, '\\'); if (s) *s = 0; } }
+#else
+    { ssize_t n = readlink("/proc/self/exe", dir, sizeof dir - 1); if (n > 0) { dir[n] = 0; char* s = strrchr(dir, '/'); if (s) *s = 0; } else strcpy(dir, "."); }
