+static void vk_tm_dump(void* user, u32 surface, u32 frame, const rsx_temporal_view* v, int have, u32 wz)
+{
+    static const char* dump = (const char*)-1;
+    if (dump == (const char*)-1) { dump = getenv("PS3RECOMP_TEMPORAL_DUMP"); if (dump && !*dump) dump = NULL; }
+    if (!dump) return;
+    static u32 every = ~0u;
+    if (every == ~0u) { const char* e = getenv("PS3RECOMP_TEMPORAL_DUMP_EVERY"); every = e ? (u32)atoi(e) : 0; }
+    if (every && frame % every >= 3u) return;
+    char path[1024];
+    snprintf(path, sizeof path, "%s/go", dump);
+    FILE* g = fopen(path, "rb");
+    if (!g) return;
+    fclose(g);
+    vk_eng_obj* o = vk_eng_get(surface, VK_ENG_COLOR);
+    vk_eng_obj* z = wz ? vk_eng_get(wz, VK_ENG_DEPTH) : NULL;
+    if (!o || !z) return;
+    const u32 W = o->lw, H = o->lh, ZW = z->lw < W ? z->lw : W, ZH = z->lh < H ? z->lh : H;
+    u8* rgba = (u8*)malloc((size_t)W * H * 4u);
+    float* d = (float*)malloc((size_t)ZW * ZH * 4u);
+    if (rgba && d) {
+        vk_eng_readback(user, surface, 0, 0, W, H, rgba, W * 4u);
+        const int dz = vk_eng_depth_readback(user, wz, 0, 0, ZW, ZH, d, ZW * 4u);
+        snprintf(path, sizeof path, "%s/f%06u.bin", dump, frame);
+        FILE* f = fopen(path, "wb");
+        if (f) {
+            const u32 hdr[6] = { 0x314D5454u /* "TTM1" */, W, H, dz ? 0u : ZW, dz ? 0u : ZH, (u32)have };
+            fwrite(hdr, sizeof hdr, 1, f);
+            fwrite(v, sizeof *v, 1, f);
+            fwrite(rgba, (size_t)W * H * 4u, 1, f);
+            if (!dz) fwrite(d, (size_t)ZW * ZH * 4u, 1, f);
+            fclose(f);
+        }
+    }
+    free(rgba); free(d);
+}
