+++ b/libs/video/rsx_draw_engine.h
@@ -365,6 +365,8 @@ void rsx_draw_engine_guest_wrote(u32 location, u32 offset, u32 pitch, u32 w, u32
 /* A label release in the command stream: with PS3RECOMP_ENG_MAIN_COHERENCE,
