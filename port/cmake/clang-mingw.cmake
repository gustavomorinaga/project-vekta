# Cross build for Windows x64: the system clang/lld with the mingw-w64 sysroot
# (native TLS, unlike GCC's emulated TLS).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(_T x86_64-w64-windows-gnu)
set(_S /usr/x86_64-w64-mingw32)
file(GLOB _G LIST_DIRECTORIES true /usr/lib/gcc/x86_64-w64-mingw32/*)
list(GET _G 0 _GCC)
get_filename_component(_GCC_VER ${_GCC} NAME)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(CMAKE_C_COMPILER_TARGET ${_T})
set(CMAKE_CXX_COMPILER_TARGET ${_T})
set(CMAKE_SYSROOT ${_S})
set(CMAKE_CXX_FLAGS_INIT "-isystem ${_S}/include/c++/${_GCC_VER} -isystem ${_S}/include/c++/${_GCC_VER}/x86_64-w64-mingw32")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${_GCC}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -L${_GCC}")
set(CMAKE_FIND_ROOT_PATH ${_S})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
